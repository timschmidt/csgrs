  "change": {
    "authority": "BezierDenseTwoSquareRootExpression2::projection",
    "description": "Skip the second-generator norm when its two coefficient polynomials are stored zero after selected-source reduction. Skip the final norm when its radical coefficient is stored zero. Keep every radicand factor already present in the retained polynomial.",
    "production_lines_added_net": 16,
    "regression_lines_added_net": 210,
    "total_rust_lines_added_net": 226,
    "test_deduplication": "Four coefficient factories, including one pre-existing test factory, share one private cfg(test) helper.",
    "public_api_added": false,
    "compatibility_layers_added": false
  },
  "exactness": {
    "invariant": "For R + A sqrt(F) + B sqrt(S) + C sqrt(F S), eliminating an absent generator only introduces a redundant square. Removing that square preserves the union of conjugate-sheet zero sets. It does not preserve norm sign or artificial multiplicity; callers require neither.",
    "validations_retained": "Reduce the expression and both radicands against the selected-source relations before branching. Absent coefficients are recognized only by existing stored exact-rational zero checks; this adds no deep symbolic zero query.",
    "caller_audit": ["recursive_quadratic_polynomial_projection uses the base projection for zero certification or scalar-image/root enumeration. Sign decisions still replay the retained positive-root tower; a nonzero projection does not provide the expression's sign.", "chord_normal_dense_expression_parameters enumerates candidates from the projection, then replays transverse and signed authored-sheet evidence to reject foreign conjugates."],
    "regressions": [
      {
        "name": "dense_projection_does_not_square_an_absent_radical",
        "coverage": "Pure scalar repeated root retains degree two instead of eight; either single generator retains its quadratic norm; all-zero expression; cancellation with all four components present; a coefficient that vanishes only after selected-source reduction."
      },
      {
        "name": "dense_projection_keeps_roots_of_vanishing_radicands",
        "coverage": "First-only, second-only and product-only radical terms retain the roots of nonconstant radicands, including their exact endpoint zeros."
      },
      {
        "name": "dense_projection_single_radical_replays_the_authored_sheet",
        "coverage": "Eight cases across STRICT and APPROXIMATE_512, either radical and either sign retain only the authored root and reject the opposite conjugate."
      },
      {
        "name": "dense_projection_zero_set_matches_all_four_conjugates",
        "coverage": "1,008 zero-set comparisons: 16 component masks, three first-root values, three second-root values and seven exact rational sample points. Includes zero radicands and explicit evaluation of all four signed conjugates."
      }
    ],
    "existing_sheet_regressions": "Both chord_normal_dense_sheet_replay tests still pass, including even roots, zero components and rejection of foreign conjugates.",
