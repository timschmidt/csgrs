  "exactness": {
    "invariant": "Only a successful symbolic rational proof publishes its exact sign. Exhausted budgets and unsupported expressions remain inconclusive; neither numerical refinement nor approximate zero is used to manufacture a fact.",
    "native_regressions": [
      {
        "name": "computable::node::tests::rational_normal_form_retains_only_successful_sign_proofs",
        "coverage": "Thirty cases: budgets 48 and 64; cancelling pi, quadratic, and opaque affine atoms; zero, +/-7/9 and +/-2^-2000. Explicitly unknown initial root, zero-budget failure, exact normal form, immediate sign on root and clone, and sign_until(0) reuse without populating the numerical approximation cache. Distinct atan atoms stay inconclusive until ordinary negative-sign refinement."
      },
      {
        "name": "real::tests::tests::exact_normal_form_cancels_shared_opaque_affine_atoms",
        "coverage": "Retained determinant proof with negative, zero, and positive rational scales, plus a nonstructural exact-zero cancellation."
      }
    ],
    "before": {
