# target to preprocess a source file
integer.cpp.i:
	cd /tmp/ariadne-audit-build2 && $(MAKE) $(MAKESILENT) -f source/numeric/CMakeFiles/ariadne-numeric.dir/build.make source/numeric/CMakeFiles/ariadne-numeric.dir/integer.cpp.i
.PHONY : integer.cpp.i

integer.s: integer.cpp.s
.PHONY : integer.s

# target to generate assembly for a file
integer.cpp.s:
	cd /tmp/ariadne-audit-build2 && $(MAKE) $(MAKESILENT) -f source/numeric/CMakeFiles/ariadne-numeric.dir/build.make source/numeric/CMakeFiles/ariadne-numeric.dir/integer.cpp.s
.PHONY : integer.cpp.s

