# Build rule for target.
ariadne-algebra: cmake_check_build_system
	$(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 ariadne-algebra
.PHONY : ariadne-algebra

# fast build rule for target.
ariadne-algebra/fast:
	$(MAKE) $(MAKESILENT) -f source/algebra/CMakeFiles/ariadne-algebra.dir/build.make source/algebra/CMakeFiles/ariadne-algebra.dir/build
.PHONY : ariadne-algebra/fast

