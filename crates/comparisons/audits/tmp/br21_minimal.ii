namespace boost{
 namespace real{
  namespace detail{






   template<typename T>
   class reverse{
   private:
    T& iterable_;
   public:
    explicit reverse(T& iterable) : iterable_{iterable} {}
      auto begin() const { return std::rbegin(iterable_); }
      auto end() const { return std::rend(iterable_); }
   };
  }
 }
