    size_t pos;
    bool found = false;
    std::string_view num1, num2;
    pos = num.size();
    for(size_t i=0;i<num.size();++i){
     if(num[i]=='/'){
      found = true;
      pos = i;
      break;
     }
    }
    num1 = num.substr(0, pos);
    if(found)
     num2 = num.substr(pos+1, num.size());

    a = integer_number<T>(num1);

    if(found)
     b = integer_number<T>(num2);
    else
     b = one;

    if(b == zero)
     throw divide_by_zero();

    positive = !(a.positive ^ b.positive);
    a.positive = true;
    b.positive = true;
    simplify();
    return;
   }

