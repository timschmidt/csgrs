namespace boost {
    namespace real {







        template <typename T = int>
        struct interval {
            boost::real::exact_number<T> lower_bound;
            boost::real::exact_number<T> upper_bound;




            interval() = default;







            std::string as_string() const {

                std::string result = "";
                std::string lb = this->lower_bound.as_string();
                std::string ub = this->upper_bound.as_string();

                if (lb == ub) {
                    result = lb;
                } else {
                    result = '[' + lb + ", " + ub + ']';
                }

                return result;
            }





            void swap_bounds() {
                this->lower_bound.swap(this->upper_bound);
            }
