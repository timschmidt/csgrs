      {
       result.positive = true;
       return result;
      }
      else
      {
       result.positive = false;
       return result;
      }
     }
    }
   }


   integer_number<T> operator - (integer_number<T> other)
   {
    integer_number<T> result;

    if(positive == other.positive)
    {
     if(digits >= other.digits)
     {
      result = subtract_integer_number(other);
      result.positive = true;
      return result;
     }
     else
