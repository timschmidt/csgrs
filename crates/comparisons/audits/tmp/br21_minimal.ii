namespace boost {
    namespace real {

        template <typename T>
        struct optimization_data {


            int optimize_freq = -1;


            int num_vars = 0;

            int num_vars_at_last_optimize = 0;


            bool use_prev = false;

            std::pair<std::shared_ptr<real_data<T>>, std::map<std::shared_ptr<real_data<T>>, int>> prev_top;
        };
    }
