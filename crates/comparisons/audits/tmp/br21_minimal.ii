                        this->digits.push_back(0);
                        this->exponent = 0;
                    }
                    else {
                        while (this->digits.size() > this->exponent) {
                            this->digits.pop_back();
                        }
                    }
                }
                else {
                    if (this->exponent < 0) {
                        this->digits.clear();
                        this->digits.push_back(1);
                        this->exponent = 1;
                    }
                    else {
