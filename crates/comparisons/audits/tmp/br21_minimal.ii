  template<typename T>
  real_rational<T> operator / (integer_number<T> a, real_rational<T> b){
   real_rational<T> result;
   result.a = b.b;
   result.b = b.a;
   result.a *= a;
   result.simplify();
   result.positive = !(a.positive ^ b.positive);
   return result;
  }


