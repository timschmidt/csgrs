+        use std::sync::atomic::{AtomicBool, Ordering};
+        let input = Computable::rational(Rational::from(100))
+            .sin()
+            .multiply(Computable::rational(Rational::from(4)));
+        let value = input.atan();
+        let signal = Arc::new(AtomicBool::new(true));
