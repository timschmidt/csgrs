+        // The existing nested rules cover (x + c) - x. Also recognize the
+        // equivalent x + (c - x), without expanding unrelated expressions.
+        fn cancel_inner_negative(value: &Computable, sum: &Computable) -> Option<Computable> {
+            let Approximation::Add(left, right) = &sum.internal.approximation else {
+                return None;
+            };
+            if let Approximation::Negate(cancelled) = &left.internal.approximation
+                && Computable::internal_structural_eq(value, cancelled)
+            {
+                return Some(right.clone());
+            }
+            if let Approximation::Negate(cancelled) = &right.internal.approximation
+                && Computable::internal_structural_eq(value, cancelled)
+            {
+                return Some(left.clone());
+            }
+            None
+        }
