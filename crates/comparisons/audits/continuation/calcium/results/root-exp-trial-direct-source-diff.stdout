     /// Square root of this number.
     pub fn sqrt(self) -> Computable {
+        if let Approximation::PrescaledExp(exponent) = &self.internal.approximation {
+            // For every finite real exponent, exp(exponent / 2) is the
+            // positive square root. No approximate sign decision is needed.
+            return exponent.clone().shift_right(1).exp();
+        }
