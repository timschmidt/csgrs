  "retained_change": "Delete evaluate_coefficients and polynomial_evaluate and call Real::eval_poly directly from retained parameters, algebraic images and offsets. The scalar kernel now owns endpoint identities, fused rational Horner updates and a certified normalized quadratic-root residual. Its existing symbolic-coefficient splitting and balanced even/odd power ladder become available to all migrated curve callers.",
  "exactness": {
    "before_change_failure": "The new represented nested-quadratic-root regression was run against the unchanged scalar evaluator and failed: certified_sign_until returned None instead of Some(Zero). Blindly redirecting the curve callers would therefore lose an existing root certificate.",
    "certificate": "For a nonrational argument and a mixed quadratic, checked division forms v=-b/(2a) and c/a. The existing Computable::square kernel preserves the represented radical when evaluating (x-v)^2. Only a structural proof that (x-v)^2-(v^2-c/a) is exactly zero returns Real::zero(). Every nonzero or still-unproved residual falls through to native fused Horner. No floating tolerance can create a zero certificate.",
    "tests": {
      "new_scalar_tests": 5,
      "nested_roots": 8,
      "nonzero_600_bit_root_perturbations": 16,
      "factored_root_expressions": 30,
      "factored_root_assertion": "Reject false nonzero classifications and retain every direct fused-Horner zero certificate; the independent reference must supply at least 13 such certificates. This does not claim complete zero recognition for every computable expression.",
      "independent_wide_rational_horner_cases": 42,
      "endpoint_empty_constant_and_zero_leading_forms": true,
      "ill_conditioned_nonroot": "A 2^2000 coefficient scale and a sin(1)/2^4000 argument retain a positive sign at precision -64.",
      "existing_balanced_degree_128_exact_decomposition": true
    },
    "public_api_added": false,
    "compatibility_shims_added": false,
    "obsolete_helpers_remaining": false
  },
  "source_size": {
    "hypercurve_implementation_files_including_existing_tests_delta_lines": -77,
    "hyperreal_implementation_delta_lines": 28,
    "new_hyperreal_test_delta_lines": 117,
    "public_benchmark_delta_lines": 62,
    "combined_rust_delta_lines": 130,
    "prefix_accounting": "The parameter and offset prefixes before their conversion-test modules shrink by 61 and 13 lines; the image file is line-neutral. These implementation prefixes plus Hyperreal therefore shrink by 46 lines. Three additional removed lines are formatting within existing curve tests. New regression coverage and benchmark code account for the net total-source increase.",
