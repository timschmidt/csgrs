+                tangent_cross_sign: Some(RealSign::Zero),
+                location: BezierAlgebraicCuspSemicircleContactLocation2::Interior,
+                correlation: BezierAlgebraicCuspSemicircleParallelCorrelation2::Retained(
+                    retained.clone(),
