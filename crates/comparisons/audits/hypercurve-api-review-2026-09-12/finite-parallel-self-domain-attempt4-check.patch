+                        Point2::new(q(-7, 3), q(26, 3)),
+                        Point2::new(q(-7, 3), q(-26, 3)),
+                        p(3, 6),
+                    )
+                };
+                let parallel = source.parallel_left(Real::zero()).unwrap();
+                let fragment = BezierParallelFragment2::from_certified_range(
+                    parallel,
+                    BezierParameterRange2::new_validated(
