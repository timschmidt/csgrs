+                let result = context.result().unwrap();
+                assert!(result.is_complete(), "finite={finite}: {result:?}");
+                assert_eq!(result.contacts().len(), 1, "finite={finite}: {result:?}");
+                let contact = &result.contacts()[0];
+                for (actual, expected) in [
