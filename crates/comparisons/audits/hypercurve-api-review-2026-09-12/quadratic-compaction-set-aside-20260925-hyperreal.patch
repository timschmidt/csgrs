+#[test]
+fn repeated_quadratic_field_arithmetic_preserves_exact_cancellation() {
+    let root = Real::from(2).sqrt().unwrap();
+    let unit = Real::one() + &root;
+    let mut power = Real::one();
+    let mut a = Rational::one();
+    let mut b = Rational::zero();
+    for _ in 0..128 {
+        power *= &unit;
+        (a, b) = (&a + &b * Rational::from(2), &a + &b);
+        assert_eq!(
+            power.exact_quadratic_normal_form(),
+            Some((a.clone(), b.clone(), Rational::from(2))),
+        );
+        // The independently computed Pell norm is always +1 or -1, even
+        // when its expanded products have large, nearly cancelling values.
+        let conjugate = Real::new(a.clone()) - Real::new(b.clone()) * &root;
+        let norm = &power * conjugate;
+        assert_eq!(
+            norm.exact_rational_ref(),
+            Some(&(&a * &a - &b * &b * Rational::from(2))),
+        );
+    }
+}
+
+#[test]
+fn repeated_quadratic_fractional_transform_preserves_its_exact_fixed_point() {
+    let root = Real::from(2).sqrt().unwrap();
+    let mut value = root.clone();
+    for step in 0..256 {
+        let numerator = &value + Real::from(2);
+        let denominator = &value + Real::one();
+        value = match step % 4 {
+            0 => (numerator / &denominator).unwrap(),
+            1 => numerator * denominator.inverse().unwrap(),
+            2 => numerator * denominator.inverse_ref().unwrap(),
+            _ => numerator * denominator.inverse_ref_assuming_nonzero().unwrap(),
+        };
+        assert_eq!(
+            value.exact_quadratic_normal_form(),
+            Some((Rational::zero(), Rational::one(), Rational::from(2))),
+        );
+        assert_eq!((&value - &root).zero_status(), ZeroKnowledge::Zero);
+    }
+}
