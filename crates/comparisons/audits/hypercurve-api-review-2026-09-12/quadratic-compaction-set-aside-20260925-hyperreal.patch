+    /// Keep recognized quadratic arithmetic independent of its construction
+    /// history. The bounded normal form is an exact proof, never a numerical
+    /// approximation; unrecognized values retain their original graph.
+    fn arithmetic_from_computable(rational: Rational, computable: Computable) -> Self {
+        let (rational, computable) = match computable.exact_quadratic_surd_parts() {
+            Some((constant, scale, radicand)) => {
+                if scale.sign() == Sign::NoSign {
+                    return Self::new(rational * constant);
+                }
+                // Cancel the outer scale against both exact coefficients here.
+                // Keeping reciprocal contents on opposite sides of this
+                // boundary can inflate them under repeated field division.
+                let constant = constant * &rational;
+                let scale = scale * rational;
+                // Build through Computable, not Real arithmetic: this is the
+                // normalization boundary, so rebuilding must not invoke it
+                // recursively. Retain a generic class for arbitrary radicands.
+                let radical = Computable::rational(
+                    radicand.expect("a nonzero quadratic term has a radicand"),
+                )
+                .sqrt()
+                .multiply_rational(scale);
+                let computable = if constant.sign() == Sign::NoSign {
+                    radical
+                } else {
+                    radical.add(Computable::rational(constant))
+                };
+                (Rational::one(), computable)
+            }
+            None => (rational, computable),
+        };
+        Self {
+            rational,
+            class: Irrational,
+            computable: Some(computable),
+            primitive_approx_cache: AtomicPrimitiveApproxCache::new(PrimitiveApproxCache::Empty),
+        }
+    }
