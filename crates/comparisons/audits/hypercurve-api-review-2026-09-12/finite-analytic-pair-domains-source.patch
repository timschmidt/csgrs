+        for policy in [CurveContext::STRICT, CurveContext::APPROXIMATE_512] {
+            let cap = finite_parallel(
+                QuadraticBezier2::new(p(0, 4), Point2::new(q(1, 2), 2.into()), p(1, 1)),
