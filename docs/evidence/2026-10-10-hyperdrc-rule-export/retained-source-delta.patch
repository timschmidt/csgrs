+//! Span-based edits preserve custom rule text, comments, and ordering.
+
+use super::KicadDruError;
+use std::ops::Range;
+
+const OWNED_RULES: [&str; 6] = [
+    "hyperdrc-copper-clearance",
+    "hyperdrc-track-width",
+    "hyperdrc-annular-ring",
+    "hyperdrc-silk-clearance",
+    "hyperdrc-board-edge-clearance",
+    "hyperdrc-hole-clearance",
+];
+const LEGACY_COMMENTS: [&str; 8] = [
+    "Generated by HyperDRC. Review before merging with project-specific KiCad rules.",
+    "Units are millimeters.",
+    "Copper clearance exported from HyperDRC net_clearance.",
+    "Minimum copper width exported from HyperDRC min_width.",
+    "Minimum annular ring exported from HyperDRC annular_ring.",
+    "Silkscreen clearance exported from HyperDRC clearance.",
+    "Copper to board edge clearance exported from HyperDRC clearance.",
+    "Hole to copper clearance exported from HyperDRC drill_clearance.",
+];
+
+fn invalid(offset: usize, detail: &'static str) -> KicadDruError {
+    KicadDruError::InvalidDeck { offset, detail }
+}
+
+pub(super) fn merge(existing: &str, generated: &str) -> Result<String, KicadDruError> {
+    let mut removals: Vec<Range<usize>> = Vec::new();
+    let mut semicolons = Vec::new();
+    let mut block = None;
+    let mut depth = 0_usize;
+    let mut start = 0;
+    let mut items = Vec::new();
+    let mut item_count = 0;
+    let mut form_count = 0;
+    let mut version = false;
+    let mut position = 0;
+    let bytes = existing.as_bytes();
+    while position < bytes.len() {
+        let token_start = position;
+        match bytes[position] {
+            byte if byte.is_ascii_whitespace() => position += 1,
+            b'#' | b';' => {
+                let legacy = bytes[position] == b';';
+                let end = existing[position..]
+                    .find('\n')
+                    .map_or(bytes.len(), |offset| position + offset + 1);
+                let comment = existing[position + 1..end].trim();
+                let line_start = existing[..position].rfind('\n').map_or(0, |p| p + 1);
+                let standalone = existing[line_start..position].trim().is_empty();
+                let span = if standalone { line_start } else { position }..end;
+                match comment {
+                    "BEGIN HYPERDRC GENERATED RULES" => {
+                        if depth != 0 || !standalone || block.is_some() {
+                            return Err(invalid(position, "misplaced or nested generated block"));
+                        }
+                        block = Some(span.start);
+                    }
+                    "END HYPERDRC GENERATED RULES" => {
+                        if depth != 0 || !standalone {
+                            return Err(invalid(position, "misplaced generated block end"));
+                        }
+                        let begin = block.take().ok_or_else(|| {
+                            invalid(position, "generated block end has no matching beginning")
+                        })?;
+                        removals.push(begin..end);
+                    }
+                    _ if legacy && LEGACY_COMMENTS.contains(&comment) => removals.push(span),
+                    _ if legacy => semicolons.push(span),
+                    _ => {}
+                }
+                position = end;
+            }
+            b'(' => {
+                if depth == 0 {
+                    start = position;
+                    items.clear();
+                    item_count = 0;
+                } else if depth == 1 {
+                    // A nested list cannot be the version or rule name atom.
+                    if items.len() < 2 {
+                        items.push(None);
+                    }
+                    item_count += 1;
+                }
+                depth += 1;
+                position += 1;
+            }
+            b')' => {
+                depth = depth
+                    .checked_sub(1)
+                    .ok_or_else(|| invalid(position, "unexpected closing parenthesis"))?;
+                position += 1;
+                if depth == 0 {
+                    let head = items.first().and_then(Option::as_deref);
+                    let argument = items.get(1).and_then(Option::as_deref);
+                    match head {
+                        Some("version") => {
+                            if version
+                                || form_count != 0
+                                || block.is_some()
+                                || item_count != 2
+                                || argument != Some("1")
+                            {
+                                return Err(invalid(
+                                    start,
+                                    "expected one initial (version 1) header",
+                                ));
+                            }
+                            version = true;
+                        }
+                        Some("rule") if argument.is_some() => {
+                            if OWNED_RULES.contains(&argument.unwrap()) {
+                                removals.push(start..position);
+                            }
+                        }
+                        _ => return Err(invalid(start, "expected a version header or named rule")),
+                    }
+                    form_count += 1;
+                }
+            }
+            _ => {
+                if depth == 0 {
+                    return Err(invalid(position, "expected a top-level list"));
+                }
+                let quoted = matches!(bytes[position], b'\'' | b'"');
+                if quoted {
+                    let quote = bytes[position];
+                    position += 1;
+                    loop {
+                        let byte = *bytes
+                            .get(position)
+                            .ok_or_else(|| invalid(token_start, "unterminated quoted string"))?;
+                        if matches!(byte, b'\n' | b'\r') {
+                            return Err(invalid(position, "newline in quoted string"));
+                        }
+                        position += 1;
+                        if byte == quote {
+                            break;
+                        }
+                        if byte == b'\\' {
+                            match bytes.get(position) {
+                                None | Some(b'\n' | b'\r') => {
+                                    return Err(invalid(token_start, "unterminated quoted escape"));
+                                }
+                                _ => position += 1,
+                            }
+                        }
+                    }
+                } else {
+                    while position < bytes.len()
+                        && !bytes[position].is_ascii_whitespace()
+                        && !matches!(bytes[position], b'(' | b')')
+                    {
+                        position += 1;
+                    }
+                }
+                if depth == 1 {
+                    if items.len() < 2 {
+                        let raw = if quoted {
+                            &existing[token_start + 1..position - 1]
+                        } else {
+                            &existing[token_start..position]
+                        };
+                        let mut atom = String::new();
+                        let mut chars = raw.chars();
+                        while let Some(ch) = chars.next() {
+                            if quoted && ch == '\\' {
+                                // The lexical scan already proved the escape has a following character.
+                                atom.push(chars.next().expect("complete quoted escape"));
+                            } else {
+                                atom.push(ch);
+                            }
+                        }
+                        items.push(Some(atom));
+                    }
+                    item_count += 1;
+                }
+            }
+        }
+    }
+    if depth != 0 {
+        return Err(invalid(start, "unterminated list"));
+    }
+    if let Some(begin) = block {
+        return Err(invalid(begin, "unterminated generated block"));
+    }
+    removals.sort_by_key(|span| span.start);
+    for span in semicolons {
+        if !removals
+            .iter()
+            .any(|removed| removed.start <= span.start && removed.end >= span.end)
+        {
+            return Err(invalid(
+                span.start,
+                "unrecognized semicolon comment; KiCad comments use #",
+            ));
+        }
+    }
+    let mut text = String::new();
+    if !version {
+        text.push_str("(version 1)\n");
+    }
+    let mut cursor = 0;
+    for span in removals {
+        if span.start > cursor {
+            text.push_str(&existing[cursor..span.start]);
+        }
+        cursor = cursor.max(span.end);
+    }
+    text.push_str(&existing[cursor..]);
+    if !text.ends_with('\n') {
+        text.push('\n');
+    }
+    text.push_str("# BEGIN HYPERDRC GENERATED RULES\n");
+    text.push_str(
+        generated
+            .strip_prefix("(version 1)\n")
+            .expect("generated version header"),
+    );
+    text.push_str("# END HYPERDRC GENERATED RULES\n");
+    Ok(text)
+}
