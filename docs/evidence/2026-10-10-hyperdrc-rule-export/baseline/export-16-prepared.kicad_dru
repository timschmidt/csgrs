(version 1)
; Generated by HyperDRC. Review before merging with project-specific KiCad rules.
; Units are millimeters.

(rule "hyperdrc-copper-clearance"
  (severity warning)
  (constraint clearance (min 0.15mm))
  (condition "A.Type == 'track' || A.Type == 'via' || A.Type == 'pad'")
  ; Copper clearance exported from HyperDRC net_clearance.
)

(rule "hyperdrc-track-width"
  (severity warning)
  (constraint track_width (min 0mm))
  (condition "A.Type == 'track'")
  ; Minimum copper width exported from HyperDRC min_width.
)

(rule "hyperdrc-annular-ring"
  (severity warning)
  (constraint annular_width (min 0.15mm))
  (condition "A.Type == 'via' || A.Type == 'pad'")
  ; Minimum annular ring exported from HyperDRC annular_ring.
)

(rule "hyperdrc-silk-clearance"
  (severity warning)
  (constraint silk_clearance (min 0.25mm))
  (condition "A.Layer == 'F.SilkS' || A.Layer == 'B.SilkS'")
  ; Silkscreen clearance exported from HyperDRC clearance.
)

(rule "hyperdrc-board-edge-clearance"
  (severity warning)
  (constraint edge_clearance (min 0.25mm))
  (condition "A.Type == 'track' || A.Type == 'via' || A.Type == 'pad' || A.Type == 'zone'")
  ; Copper to board edge clearance exported from HyperDRC clearance.
)

(rule "hyperdrc-hole-clearance"
  (severity warning)
  (constraint hole_clearance (min 0.25mm))
  (condition "A.Type == 'via' || A.Type == 'pad'")
  ; Hole to copper clearance exported from HyperDRC drill_clearance.
)

