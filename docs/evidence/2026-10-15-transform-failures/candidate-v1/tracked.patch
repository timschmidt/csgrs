+#[test]
+fn retained_circular_charts_are_not_lines_after_promotion_and_restriction() {
+    let center = Point2::new(Real::pi(), Real::e());
+    for radius in [q(1, 7), r(2).sqrt().unwrap(), "1e100".parse().unwrap()] {
+        for clockwise in [false, true] {
+            let arc = CircularArc2::try_from_center(
+                Point2::new(center.x() + &radius, center.y().clone()),
+                Point2::new(center.x().clone(), center.y() + &radius),
+                center.clone(),
+                clockwise,
+            )
+            .unwrap();
+            for span in arc.rational_bezier_decomposition().unwrap().spans() {
+                let quadratic = span.curve();
+                let promoted = RationalBezier2::from(quadratic.clone());
+                let variants = [
+                    promoted.clone(),
+                    promoted.reversed(),
+                    promoted.elevated_to_degree(5).unwrap(),
+                    promoted.subcurve_between_exact(&q(1, 3), &q(2, 3)).unwrap(),
+                ];
+                for policy in [PredicatePolicy::STRICT, PredicatePolicy::APPROXIMATE_512] {
+                    let outcome = evaluate_with_budget(policy, WorkBudget::ZERO, || {
+                        assert!(matches!(
+                            quadratic.fit_exact_line_image().unwrap(),
+                            BezierLineImageFitRelation::NotLine
+                        ));
+                        for curve in &variants {
+                            assert!(matches!(
+                                curve.fit_exact_line_image().unwrap(),
+                                BezierLineImageFitRelation::NotLine
+                            ));
+                        }
+                    });
+                    assert!(outcome.result.unwrap().certified().is_some());
+                    assert_eq!(outcome.usage, WorkUsage::default());
+                }
+            }
+        }
+    }
