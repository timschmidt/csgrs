+#[test]
+fn materialized_single_boundary_windings_match_two_rays() {
+    // Nested, disjoint boundaries have independently known winding vectors:
+    // the outer diamond contains both inner loops, the circle contains the
+    // small diamond, and each oriented boundary changes only its own entry.
+    for policy in [CurveContext::STRICT, CurveContext::APPROXIMATE_512] {
+        for fill_rule in [FillRule::NonZero, FillRule::EvenOdd] {
+            for reversals in 0..8 {
+                let point = |x, y| Point2::from_values(x, y);
+                let diamond = |radius: i32| {
+                    let points = [
+                        point(-radius, 0),
+                        point(0, -radius),
+                        point(radius, 0),
+                        point(0, radius),
+                    ];
+                    (0..4)
+                        .map(|i| {
+                            Segment2::Line(
+                                LineSeg2::try_new(points[i].clone(), points[(i + 1) % 4].clone())
+                                    .unwrap(),
+                            )
+                        })
+                        .collect::<Vec<_>>()
+                };
+                let points = [point(3, 0), point(0, 3), point(-3, 0), point(0, -3)];
+                let circle = (0..4)
+                    .map(|i| {
+                        Segment2::Arc(
+                            crate::CircularArc2::try_from_center(
+                                points[i].clone(),
+                                points[(i + 1) % 4].clone(),
+                                point(0, 0),
+                                false,
+                            )
+                            .unwrap(),
+                        )
+                    })
+                    .collect::<Vec<_>>();
+                let contour = |index, mut segments: Vec<Segment2>| {
+                    if reversals & (1 << index) != 0 {
+                        segments = segments
+                            .into_iter()
+                            .rev()
+                            .map(|segment| segment.reversed())
+                            .collect();
+                    }
+                    crate::Contour2::try_new_with_fill_rule(segments, fill_rule).unwrap()
+                };
+                let region = CurveRegion2::try_from_native_contours_raw(
+                    vec![contour(0, diamond(6)), contour(1, diamond(1))],
+                    vec![contour(2, circle)],
+                    &policy,
+                )
+                .unwrap();
+                let context = CurveRegionBooleanContext::try_new_unary(&region, &policy).unwrap();
+                let topology = context.build_split_topology().unwrap();
+                assert!(topology.overlaps.is_empty());
+                let direction = |index| if reversals & (1 << index) == 0 { 1 } else { -1 };
+                let mut lines = 0;
+                let mut arcs = 0;
+                for (carrier_index, splits) in topology.split_fragments.iter().enumerate() {
+                    let loop_index = context.data.carriers[carrier_index].loop_index;
+                    for split in splits {
+                        if matches!(split.fragment, BezierSplitFragment2::Materialized { .. }) {
+                            if loop_index == 2 {
+                                arcs += 1;
+                            } else {
+                                lines += 1;
+                            }
+                        }
+                        let direct = context
+                            .regularized_fragment_geometric_decision(
+                                carrier_index,
+                                &split.fragment,
+                                false,
+                            )
+                            .unwrap();
+                        let derived = context
+                            .regularized_fragment_geometric_decision(
+                                carrier_index,
+                                &split.fragment,
+                                true,
+                            )
+                            .unwrap();
+                        let mut left = match loop_index {
+                            0 => vec![0, 0, 0],
+                            1 => vec![direction(0), 0, direction(2)],
+                            2 => vec![direction(0), 0, 0],
+                            _ => unreachable!(),
+                        };
+                        left[loop_index] = i32::from(direction(loop_index) > 0);
+                        let mut right = left.clone();
+                        right[loop_index] -= 1;
+                        assert_eq!(
+                            direct.side_windings,
+                            [left, right],
+                            "reversals={reversals}, loop={loop_index}"
+                        );
+                        assert_eq!(derived.side_windings, direct.side_windings);
+                        assert_eq!(derived.action, direct.action);
+                    }
+                }
+                assert!(
+                    lines > 0 && arcs > 0,
+                    "both materialized families must exercise the shortcut"
+                );
+            }
+        }
+    }
+}
