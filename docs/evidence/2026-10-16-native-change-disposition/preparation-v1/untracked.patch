+#[test]
+fn ordinary_butt_stroke_keeps_its_contract() {
+    let polygon = line_polygon([0.0, 0.0], [2.0, 0.0], 0.5).unwrap();
+    same(&polygon.try_area().unwrap(), &Scalar::one());
+    let region = polygons_to_profile(vec![polygon], None);
