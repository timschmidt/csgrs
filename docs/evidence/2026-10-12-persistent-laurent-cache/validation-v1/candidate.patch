+
+struct ClosedRadicalCoefficient {
+    rational: Rational,
+    radicals: Vec<(Rational, Rational)>,
+}
+
+impl ClosedPiLaurentPolynomial {
+    fn from_polynomial(polynomial: &PiLaurentPolynomial) -> Option<Self> {
+        if polynomial
+            .terms
+            .iter()
+            .any(|(_, coefficient)| !coefficient.atoms.is_empty())
+        {
+            return None;
+        }
+        Some(Self {
+            terms: polynomial
+                .terms
+                .iter()
+                .map(|(power, coefficient)| {
+                    (
+                        *power,
+                        ClosedRadicalCoefficient {
+                            rational: coefficient.rational.clone(),
+                            radicals: coefficient.radicals.clone(),
+                        },
+                    )
+                })
+                .collect(),
+        })
+    }
+
+    fn to_polynomial(&self) -> PiLaurentPolynomial {
+        PiLaurentPolynomial {
+            terms: self
+                .terms
+                .iter()
+                .map(|(power, coefficient)| {
+                    (
+                        *power,
+                        RadicalCoefficient {
+                            rational: coefficient.rational.clone(),
+                            radicals: coefficient.radicals.clone(),
+                            atoms: Vec::new(),
+                        },
+                    )
+                })
+                .collect(),
+        }
+    }
 }
 
