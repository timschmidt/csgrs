@@ -0,0 +1,186 @@
+use super::*;
+
+fn raw(approximation: Approximation) -> Computable {
+    Computable {
+        internal: Arc::new(Node::new(
+            approximation,
+            BoundCache::Invalid,
+            ExactSignCache::Unknown,
+        )),
+        signal: None,
+    }
+}
+
+fn rational(polynomial: PiLaurentPolynomial) -> Option<Rational> {
+    match polynomial.terms.as_slice() {
+        [] => Some(Rational::zero()),
+        [(0, coefficient)] if coefficient.radicals.is_empty() && coefficient.atoms.is_empty() => {
+            Some(coefficient.rational.clone())
+        }
+        _ => None,
+    }
+}
+
+fn retained_query(
+    value: &Computable,
+    depth: usize,
+    work: usize,
+) -> (Option<PiLaurentPolynomial>, usize, bool) {
+    let mut remaining = work;
+    let mut reused = false;
+    let result =
+        value.pi_laurent_polynomial_retained::<true>(depth, &mut remaining, &mut None, &mut reused);
+    (result, remaining, reused)
+}
+
+#[test]
+fn warm_proof_is_available_with_no_new_work() {
+    let value = raw(Approximation::Add(
+        Computable::rational(Rational::new(3)),
+        Computable::rational(Rational::new(5)),
+    ));
+    let clone = value.clone();
+    let owners = Arc::strong_count(&value.internal);
+    assert!(value.pi_laurent_polynomial(0).is_none());
+    assert!(retained_query(&value, 0, 0).0.is_none());
+    assert!(value.internal.cache.pi_laurent_polynomial().is_none());
+    assert_eq!(
+        retained_query(&value, 8, 512).0.and_then(rational),
+        Some(Rational::new(8))
+    );
+    let (proof, remaining, reused) = retained_query(&clone, 0, 0);
+    assert!(reused);
+    assert_eq!(remaining, 0);
+    assert_eq!(proof.and_then(rational), Some(Rational::new(8)));
+    assert_eq!(clone.bounded_laurent_rational(0), Some(Rational::new(8)));
+    assert_eq!(Arc::strong_count(&value.internal), owners);
+    assert!(value.cached().is_none());
+}
+
+#[test]
+fn opaque_coefficients_are_not_retained_and_nodes_are_reclaimed() {
+    let atom = raw(Approximation::AtanRational(
+        Rational::fraction(3, 4).unwrap(),
+    ));
+    let value = raw(Approximation::Add(atom.clone(), Computable::pi()));
+    let clone = value.clone();
+    let atom_weak = Arc::downgrade(&atom.internal);
+    let value_weak = Arc::downgrade(&value.internal);
+    let owners = Arc::strong_count(&atom.internal);
+    let polynomial = retained_query(&value, 64, 512).0.unwrap();
+    assert!(ClosedPiLaurentPolynomial::from_polynomial(&polynomial).is_none());
+    assert!(value.internal.cache.pi_laurent_polynomial().is_none());
+    drop(polynomial);
+    assert_eq!(Arc::strong_count(&atom.internal), owners);
+    drop(value);
+    drop(clone);
+    drop(atom);
+    assert!(value_weak.upgrade().is_none());
+    assert!(atom_weak.upgrade().is_none());
+}
+
+#[test]
+fn expansion_at_a_term_limit_retries_the_original_proof() {
+    let mut power = Computable::one();
+    let mut sum = Computable::zero();
+    for _ in 0..8 {
+        sum = raw(Approximation::Add(sum, power.clone()));
+        power = raw(Approximation::Multiply(power, Computable::pi()));
+    }
+    // ((x + y) - x) - y is zero. At depth four the cold recognizer can
+    // cancel opaque x/y atoms. Warming x/y expands nine distinct pi powers,
+    // exceeding the unchanged eight-term limit before cancellation.
+    let expression = raw(Approximation::Add(
+        raw(Approximation::Add(
+            raw(Approximation::Add(sum.clone(), power.clone())),
+            raw(Approximation::Negate(sum.clone())),
+        )),
+        raw(Approximation::Negate(power.clone())),
+    ));
+    assert_eq!(
+        expression.pi_laurent_polynomial(4).and_then(rational),
+        Some(Rational::zero())
+    );
+    assert!(retained_query(&sum, 64, 512).0.is_some());
+    assert!(retained_query(&power, 64, 512).0.is_some());
+    let (expanded, _, reused) = retained_query(&expression, 4, 512);
+    assert!(reused);
+    assert!(expanded.and_then(rational).is_none());
+    assert_eq!(
+        expression.bounded_laurent_rational(4),
+        Some(Rational::zero())
+    );
+    assert!(expression.cached().is_none());
+}
+
+#[test]
+fn successful_cold_rational_facts_survive_warming_and_cloning() {
+    for width in [1, 2, 7, 8, 9, 127, 255, 256, 257, 511, 512, 513] {
+        for depth in [0, 1, 2, 4, 8, 48, 64] {
+            let mut nodes = (0..width)
+                .map(|index| {
+                    raw(Approximation::Ratio(
+                        Rational::fraction(index + 1, 4099).unwrap(),
+                    ))
+                })
+                .collect::<Vec<_>>();
+            while nodes.len() > 1 {
+                let mut next = Vec::new();
+                let mut values = nodes.into_iter();
+                while let Some(left) = values.next() {
+                    next.push(match values.next() {
+                        Some(right) => raw(Approximation::Add(left, right)),
+                        None => left,
+                    });
+                }
+                nodes = next;
+            }
+            let value = nodes.pop().unwrap();
+            let clone = value.clone();
+            let cold = value.pi_laurent_polynomial(depth).and_then(rational);
+            let expected = Rational::fraction(width * (width + 1), 2 * 4099).unwrap();
+            for query in [&value, &clone, &value] {
+                let actual = query.bounded_laurent_rational(depth);
+                if let Some(cold) = &cold {
+                    assert_eq!(actual.as_ref(), Some(cold), "width={width}, depth={depth}");
+                }
+                if let Some(actual) = actual {
+                    assert_eq!(actual, expected, "width={width}, depth={depth}");
+                }
+                let _ = retained_query(query, 64, 512);
+            }
+            assert!(value.cached().is_none());
+        }
+    }
+}
+
+#[test]
+fn concurrent_publication_keeps_approximations_and_releases_the_graph() {
+    let value = raw(Approximation::Add(
+        Computable::rational(Rational::new(3)),
+        Computable::sqrt_rational(Rational::new(13)),
+    ));
+    let weak = Arc::downgrade(&value.internal);
+    std::thread::scope(|scope| {
+        for index in 0..8 {
+            let clone = value.clone();
+            scope.spawn(move || {
+                for _ in 0..8 {
+                    assert_eq!(
+                        clone.exact_quadratic_surd_parts(),
+                        Some((Rational::new(3), Rational::one(), Some(Rational::new(13))))
+                    );
+                    let _ = clone.approx(if index % 2 == 0 { -32 } else { -64 });
+                }
+            });
+        }
+    });
+    assert_eq!(value.cached().unwrap().0, -64);
+    assert!(value.internal.cache.pi_laurent_polynomial().is_some());
+    assert_eq!(
+        value.exact_quadratic_surd_parts(),
+        Some((Rational::new(3), Rational::one(), Some(Rational::new(13))))
+    );
+    drop(value);
+    assert!(weak.upgrade().is_none());
+}
