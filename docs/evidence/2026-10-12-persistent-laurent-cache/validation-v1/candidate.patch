+    fn project_pi_laurent_polynomial<T>(
+        &self,
+        budget: usize,
+        project: impl Fn(PiLaurentPolynomial) -> Option<T>,
+    ) -> Option<T> {
+        let mut memo = None;
+        let mut remaining_work = MAX_PI_LAURENT_NORMAL_FORM_NODES;
+        let mut reused = false;
+        if let Some(value) = self
+            .pi_laurent_polynomial_retained::<true>(
+                budget,
+                &mut remaining_work,
+                &mut memo,
+                &mut reused,
+            )
+            .and_then(&project)
+        {
+            return Some(value);
+        }
+        // A previously opaque child may have acquired a larger closed form.
+        // Expansion can then reach a term limit in a different place. Retry
+        // the original recognizer when retained certificates did not prove
+        // the requested fact, so warming cannot remove an earlier proof.
+        // Each pass has the original 512-node limit; a query performs at most
+        // two passes, and only a failed pass that reused a certificate retries.
+        // The first memo can own opaque expression references. Release it
+        // before retrying so it cannot change the original sharing decisions.
+        drop(memo);
+        if reused {
+            self.pi_laurent_polynomial(budget).and_then(project)
+        } else {
+            None
+        }
+    }
