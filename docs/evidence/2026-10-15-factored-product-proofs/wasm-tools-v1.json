[
  [
    "prepare-target",
    [
      "mkdir",
      "/tmp/csgrs-factored-product-proofs/wasm-tools-v1"
    ]
  ],
  [
    "installed-version",
    [
      "wasm-bindgen",
      "--version"
    ]
  ],
  [
    "install-locked-cli",
    [
      "env",
      "CARGO_NET_OFFLINE=false",
      "cargo",
      "install",
      "--locked",
      "wasm-bindgen-cli",
      "--version",
      "0.2.126",
      "--root",
      "/tmp/csgrs-factored-product-proofs/wasm-tools-v1/install"
    ]
  ],
  [
    "matching-version",
    [
      "/tmp/csgrs-factored-product-proofs/wasm-tools-v1/install/bin/wasm-bindgen",
      "--version"
    ]
  ]
]
