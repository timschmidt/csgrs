+#[test]
+fn every_aggregate_family_exposes_unknown_and_aborted_components() {
+    let mut aborted = Real::pi();
+    aborted.abort(Arc::new(AtomicBool::new(true)));
+    for (value, marker) in [
+        (unresolved_zero(), "[UnknownZero]"),
+        (aborted, "[Exhausted]"),
