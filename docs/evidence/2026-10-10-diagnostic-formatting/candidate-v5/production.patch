+    assert_eq!(
+        format!("{:#}", Vector2::new([ordinary.clone(), tiny.clone()])),
+        "[0.125, 1e-40]"
+    );
+    assert_eq!(
+        format!(
+            "{:#}",
+            Matrix3::new([
+                [ordinary, tiny, Real::zero()],
+                [Real::one(), Real::zero(), Real::one()],
+                [Real::zero(), Real::zero(), Real::one()],
+            ])
+        ),
+        "[[0.125, 1e-40, 0e0], [1, 0e0, 1], [0e0, 0e0, 1]]"
