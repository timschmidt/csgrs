+#[test]
+fn pure_radical_product_facts_survive_child_warming_and_cloning() {
+    for a in [-2, 1, 3] {
+        for b in [-1, 2] {
+            let first =
+                Computable::sqrt_rational(Rational::new(2)).multiply_rational(Rational::new(a));
+            let second =
+                Computable::sqrt_rational(Rational::new(3)).multiply_rational(Rational::new(b));
+            let left = raw(Approximation::Add(first.clone(), second.clone()));
+            let right = raw(Approximation::Add(
+                first,
+                raw(Approximation::Negate(second)),
+            ));
+            let make = || raw(Approximation::Multiply(left.clone(), right.clone()));
+            let cold = make();
+            let expected = Some(Rational::new(2 * a * a - 3 * b * b));
+            assert_eq!(cold.bounded_laurent_rational(64), expected);
+            assert!(cold.cached().is_none());
+            let _ = left.exact_quadratic_surd_parts();
+            let _ = right.exact_quadratic_surd_parts();
+            assert!(left.internal.cache.pi_laurent_polynomial().is_some());
+            assert!(right.internal.cache.pi_laurent_polynomial().is_some());
+            let warm = make();
+            let clone = warm.clone();
+            for query in [&warm, &clone, &warm] {
+                assert_eq!(query.bounded_laurent_rational(64), expected);
+                assert!(query.cached().is_none());
+            }
+        }
+    }
+}
+
+const RADICALS: [(i64, i64); 8] = [
+    (2, -3),
+    (3, 5),
+    (5, 7),
+    (7, -11),
+    (11, 13),
+    (13, -17),
+    (17, 19),
+    (19, -23),
+];
+const ATOMS: [i64; 4] = [-5, 11, 17, -19];
+
+fn raw(approximation: Approximation) -> Computable {
+    Computable {
+        internal: Arc::new(Node::new(
+            approximation,
+            BoundCache::Invalid,
+            ExactSignCache::Unknown,
+        )),
+        signal: None,
+    }
+}
+
+fn atom(index: usize) -> Computable {
+    raw(Approximation::AtanRational(
+        Rational::fraction(index as i64 + 1, 37).unwrap(),
+    ))
+}
+
+fn coefficient(shape: usize) -> RadicalCoefficient {
+    RadicalCoefficient {
+        rational: Rational::new(21),
+        radicals: if shape & 1 != 0 {
+            RADICALS
+                .into_iter()
+                .map(|(d, b)| (Rational::new(d), Rational::new(b)))
+                .collect()
+        } else {
+            Vec::new()
+        },
+        atoms: if shape & 2 != 0 {
+            ATOMS
+                .into_iter()
+                .enumerate()
+                .map(|(index, b)| (atom(index), Rational::new(b)))
+                .collect()
+        } else {
+            Vec::new()
+        },
+    }
+}
+
+#[test]
+fn rational_scaling_preserves_exact_components_in_both_directions() {
+    for shape in 0..4 {
+        for (numerator, denominator) in [(0, 1), (1, 1), (-1, 1), (3, 7), (-17, 13)] {
+            for reverse in [false, true] {
+                let value = coefficient(shape);
+                let scale = RadicalCoefficient::rational(
+                    Rational::fraction(numerator, denominator).unwrap(),
+                );
+                let result = if reverse {
+                    scale.multiply(&value)
+                } else {
+                    value.multiply(&scale)
+                }
+                .unwrap();
+                assert_eq!(
+                    result.rational,
+                    Rational::fraction(21 * numerator, denominator).unwrap()
+                );
+                let expected_radicals = if numerator != 0 && shape & 1 != 0 {
+                    RADICALS
+                        .into_iter()
+                        .map(|(d, b)| {
+                            (
+                                Rational::new(d),
+                                Rational::fraction(b * numerator, denominator).unwrap(),
+                            )
+                        })
+                        .collect()
+                } else {
+                    Vec::new()
+                };
+                assert_eq!(result.radicals, expected_radicals);
+                if numerator == 0 || shape & 2 == 0 {
+                    assert!(result.atoms.is_empty());
+                } else {
+                    assert_eq!(result.atoms.len(), ATOMS.len());
+                    for (index, (actual_atom, actual_coefficient)) in
+                        result.atoms.iter().enumerate()
+                    {
+                        assert!(Computable::internal_structural_eq(
+                            actual_atom,
+                            &atom(index)
+                        ));
+                        assert_eq!(
+                            *actual_coefficient,
+                            Rational::fraction(ATOMS[index] * numerator, denominator).unwrap()
+                        );
+                    }
+                }
+            }
+        }
+    }
+}
