+#[test]
+fn pure_radical_cross_products_keep_the_eight_nine_term_frontier() {
+    let radicals = |values: &[i64]| RadicalCoefficient {
+        rational: Rational::zero(),
+        radicals: values
+            .iter()
+            .map(|value| (Rational::new(*value), Rational::one()))
+            .collect(),
+        atoms: Vec::new(),
+    };
+    let eight = radicals(&[2, 3])
+        .multiply(&radicals(&[5, 7, 11, 13]))
+        .unwrap();
+    assert!(eight.rational.is_zero());
+    assert!(eight.atoms.is_empty());
+    assert_eq!(
+        eight.radicals,
+        [10, 14, 22, 26, 15, 21, 33, 39]
+            .into_iter()
+            .map(|radicand| (Rational::new(radicand), Rational::one()))
+            .collect::<Vec<_>>()
+    );
+    assert!(
+        radicals(&[2, 3, 5])
+            .multiply(&radicals(&[7, 11, 13]))
+            .is_none()
+    );
+    // Nonzero linear contributions can still fill the limit before cross-products.
+    let mut right = radicals(&[23, 29, 31]);
+    right.rational = Rational::one();
+    for constant in [0, 1] {
+        let mut left = radicals(&[2, 3, 5, 7, 11, 13, 17, 19]);
+        left.rational = Rational::new(constant);
+        assert!(left.multiply(&right).is_none());
+    }
+}
