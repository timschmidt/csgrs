+#[test]
+fn zero_and_nonzero_scaling_release_opaque_owners_in_both_directions() {
+    for numerator in [0, -3] {
+        for reverse in [false, true] {
+            let value = coefficient(3);
+            let weak = value
+                .atoms
+                .iter()
+                .map(|(atom, _)| Arc::downgrade(&atom.internal))
+                .collect::<Vec<_>>();
+            let scale = RadicalCoefficient::rational(Rational::fraction(numerator, 7).unwrap());
+            let result = if reverse {
+                let result = scale.multiply(&value).unwrap();
+                drop(value);
+                result
+            } else {
+                value.multiply(&scale).unwrap()
+            };
+            let expected_owners = usize::from(numerator != 0);
+            assert!(
+                weak.iter()
+                    .all(|owner| owner.strong_count() == expected_owners)
+            );
+            if numerator == 0 {
+                assert!(result.is_zero());
+            }
+            drop(result);
+            assert!(weak.iter().all(|owner| owner.upgrade().is_none()));
+        }
+    }
+}
