+#[test]
+fn mixed_radical_products_preserve_exact_components_and_insertion_order() {
+    // (a + 2 sqrt(2) + 3 sqrt(3)) (b - 5 sqrt(2) + 7 sqrt(5)).
+    // Independent integer coefficients give the complete expected expansion.
+    for a in [0, 2, -3] {
+        for b in [0, 5, -5] {
+            let left = RadicalCoefficient {
+                rational: Rational::new(a),
+                radicals: vec![
+                    (Rational::new(2), Rational::new(2)),
+                    (Rational::new(3), Rational::new(3)),
+                ],
+                atoms: Vec::new(),
+            };
+            let right = RadicalCoefficient {
+                rational: Rational::new(b),
+                radicals: vec![
+                    (Rational::new(2), Rational::new(-5)),
+                    (Rational::new(5), Rational::new(7)),
+                ],
+                atoms: Vec::new(),
+            };
+            let product = left.multiply(&right).unwrap();
+            assert_eq!(product.rational, Rational::new(a * b - 20));
+            let expected = [
+                (2, 2 * b - 5 * a),
+                (3, 3 * b),
+                (5, 7 * a),
+                (10, 14),
+                (6, -15),
+                (15, 21),
+            ]
+            .into_iter()
+            .filter(|(_, coefficient)| *coefficient != 0)
+            .map(|(radicand, coefficient)| (Rational::new(radicand), Rational::new(coefficient)))
+            .collect::<Vec<_>>();
+            assert_eq!(product.radicals, expected, "a={a}, b={b}");
+            assert!(product.atoms.is_empty());
+        }
+    }
+}
