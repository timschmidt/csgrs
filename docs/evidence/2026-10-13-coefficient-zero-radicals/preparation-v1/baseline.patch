+#[test]
+fn scaled_opaque_cancellation_keeps_cold_warm_and_cloned_quadratic_facts() {
+    for reverse in [false, true] {
+        let scale = Rational::fraction(-3, 7).unwrap();
+        let multiply = |value: Computable| {
+            let scalar = Computable::rational(scale.clone());
+            if reverse {
+                raw(Approximation::Multiply(scalar, value))
+            } else {
+                raw(Approximation::Multiply(value, scalar))
+            }
+        };
+        let opaque = atom(0);
+        let radical = Computable::sqrt_rational(Rational::new(13));
+        let sum = raw(Approximation::Add(
+            raw(Approximation::Add(Computable::pi(), radical)),
+            opaque.clone(),
+        ));
+        let value = raw(Approximation::Add(
+            raw(Approximation::Add(
+                multiply(sum.clone()),
+                raw(Approximation::Negate(multiply(Computable::pi()))),
+            )),
+            raw(Approximation::Negate(multiply(opaque))),
+        ));
+        let expected = Some((Rational::zero(), scale.clone(), Some(Rational::new(13))));
+        assert_eq!(value.exact_quadratic_surd_parts(), expected);
+        assert!(sum.exact_quadratic_surd_parts().is_none());
+        let cloned = value.clone();
+        for query in [&value, &cloned, &value] {
+            assert_eq!(query.exact_quadratic_surd_parts(), expected);
+            assert!(query.cached().is_none());
+        }
+    }
