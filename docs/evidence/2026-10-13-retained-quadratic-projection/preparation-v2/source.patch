+use super::*;
+use crate::retained_projection_diagnostic::Report;
+
+fn raw(approximation: Approximation) -> Computable {
+    Computable {
+        internal: Arc::new(Node::new(
+            approximation,
+            BoundCache::Invalid,
+            ExactSignCache::Unknown,
+        )),
+        signal: None,
+    }
