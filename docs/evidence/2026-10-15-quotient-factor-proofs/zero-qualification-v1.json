[
  [
    "workspace-fmt",
    [
      "cargo",
      "fmt",
      "--all",
      "--",
      "--check"
    ]
  ],
  [
    "scalar-default",
    [
      "cargo",
      "test",
      "--locked",
      "--release",
      "-p",
      "hyperreal",
      "--lib",
      "--tests",
      "--",
      "--test-threads=2"
    ]
  ],
  [
    "scalar-all-features",
    [
      "cargo",
      "test",
      "--locked",
      "--release",
      "-p",
      "hyperreal",
      "--all-features",
      "--lib",
      "--tests",
      "--",
      "--test-threads=2"
    ]
  ],
  [
    "scalar-clippy",
    [
      "cargo",
      "clippy",
      "--locked",
      "--release",
      "-p",
      "hyperreal",
      "--all-features",
      "--all-targets",
      "--",
      "-D",
      "warnings"
    ]
  ],
  [
    "scalar-docs",
    [
      "env",
      "RUSTDOCFLAGS=-D warnings",
      "cargo",
      "test",
      "--locked",
      "--release",
      "-p",
      "hyperreal",
      "--all-features",
      "--doc"
    ]
  ],
  [
    "root-curve-clippy",
    [
      "cargo",
      "clippy",
      "--locked",
      "--release",
      "-p",
      "csgrs",
      "--no-default-features",
      "--features",
      "curve",
      "--all-targets",
      "--",
      "-D",
      "warnings"
    ]
  ]
]
