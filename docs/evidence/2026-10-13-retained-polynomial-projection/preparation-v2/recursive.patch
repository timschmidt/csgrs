+#[test]
+fn affine_surd_queries_return_exact_signed_components() {
+    for constant in [0, 3] {
+        for scale in [-2, 1] {
+            for radicand in [2, 13] {
+                let value = add(
+                    rational(Rational::new(constant)),
+                    multiply(rational(Rational::new(scale)), root(radicand)),
