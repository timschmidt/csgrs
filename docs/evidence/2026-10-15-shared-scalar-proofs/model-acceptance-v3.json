      "-L",
      "dependency=/run/user/1000/csgrs-shared-scalar-proofs/scalar-and-drill-v1/release/deps",
      "tests/mesh_boolean_context.rs",
      "-o",
      "/tmp/csgrs-shared-scalar-proofs/model-acceptance-v3/context",
      "--extern",
      "hyperlattice=/run/user/1000/csgrs-shared-scalar-proofs/scalar-and-drill-v1/release/deps/libhyperlattice-5ffa110827bfce9d.rlib"
    ]
  ],
  [
    "context-regressions",
    [
      "/tmp/csgrs-shared-scalar-proofs/model-acceptance-v3/context",
      "--test-threads=2"
    ]
  ],
  [
    "workflow-build",
    [
      "rustc",
      "--test",
      "--edition=2024",
      "-C",
      "opt-level=3",
      "-D",
      "warnings",
      "--extern",
      "csgrs=/run/user/1000/csgrs-shared-scalar-proofs/scalar-and-drill-v1/release/libcsgrs.rlib",
      "--extern",
      "hypermesh=/run/user/1000/csgrs-shared-scalar-proofs/scalar-and-drill-v1/release/deps/libhypermesh-ae6470a5143cc580.rlib",
      "-L",
      "dependency=/run/user/1000/csgrs-shared-scalar-proofs/scalar-and-drill-v1/release/deps",
      "tests/strict_drilled_workflows.rs",
      "-o",
      "/tmp/csgrs-shared-scalar-proofs/model-acceptance-v3/workflows",
      "--extern",
      "hyperlattice=/run/user/1000/csgrs-shared-scalar-proofs/scalar-and-drill-v1/release/deps/libhyperlattice-5ffa110827bfce9d.rlib",
      "--extern",
      "hyperreal=/run/user/1000/csgrs-shared-scalar-proofs/scalar-and-drill-v1/release/deps/libhyperreal-bd1ab828184ac69a.rlib"
