[
  [
    "prepare-target",
    [
      "mkdir",
      "/tmp/csgrs-shared-scalar-proofs/model-acceptance-v3"
    ]
  ],
  [
    "workspace-fmt",
    [
      "cargo",
      "fmt",
      "--all",
      "--",
      "--check"
    ]
  ],
  [
    "context-build",
    [
      "rustc",
      "--test",
      "--edition=2024",
      "-C",
      "opt-level=3",
      "-D",
      "warnings",
