+    fn certified_ray_delta_survives_reversal_and_equal_endpoint_representations() {
+        let origin = Point2::new(
+            Real::pi() + Real::from(2).sqrt().unwrap(),
+            Real::e() + Real::from(3).sqrt().unwrap(),
+        );
+        let line = LineSeg2::from_certified_nonzero_delta(origin, Real::one(), Real::from(-2));
+        assert!(line.endpoints_decided_distinct());
+        for forward in [
+            line.clone(),
+            line.with_endpoint_representations(line.start().clone(), line.end().clone())
+                .unwrap(),
+        ] {
+            assert_eq!(forward.delta(), (Real::one(), Real::from(-2)));
+            for reverse in [forward.reversed(), forward.clone().into_reversed()] {
+                assert_eq!(reverse.delta(), (Real::from(-1), Real::from(2)));
+                assert_eq!(reverse.start(), forward.end());
+                assert_eq!(reverse.end(), forward.start());
+            }
+        }
+    }
+
+    #[test]
+    fn mapped_and_cut_lines_do_not_reuse_the_source_displacement() {
+        let line = LineSeg2::from_certified_nonzero_delta(
+            Point2::from_values(5, 7),
+            Real::from(2),
+            Real::from(4),
+        );
+        let mapped = line
+            .map_points(|point| Point2::new(point.x() * Real::from(3), -point.y()))
+            .unwrap();
+        assert_eq!(mapped.delta(), (Real::from(6), Real::from(-4)));
+        let cut = line.fragment_between_after_distinct_endpoints(
+            Point2::from_values(6, 9),
+            line.end().clone(),
+            line.fragment_support(),
+        );
+        assert_eq!(cut.delta(), (Real::one(), Real::from(2)));
+        assert_eq!(cut.support_delta(), (Real::from(2), Real::from(4)));
+    }
+
+    #[test]
+    fn repeated_parallel_offsets_retain_the_exact_source_displacement() {
+        let origin = Point2::new(Real::pi(), Real::e());
+        let mut line = LineSeg2::from_certified_nonzero_delta(origin, Real::one(), Real::from(2));
+        for distance in [Real::one(), Real::pi(), Real::from(-3)] {
+            let previous = line.clone();
+            line = line.offset_left(distance.clone()).unwrap();
+            assert!(line.endpoints_decided_distinct());
+            assert_eq!(line.delta(), (Real::one(), Real::from(2)));
+            assert_eq!(line.reversed().delta(), (Real::from(-1), Real::from(-2)));
+            let normal_scale = (distance / Real::from(5).sqrt().unwrap()).unwrap();
+            for (before, after) in [
+                (previous.start(), line.start()),
+                (previous.end(), line.end()),
+            ] {
+                for (actual, expected) in [
+                    (after.x(), before.x() - Real::from(2) * &normal_scale),
+                    (after.y(), before.y() + &normal_scale),
+                ] {
+                    assert_eq!(
+                        compare_reals(actual, &expected, &CurveContext::STRICT),
+                        Some(Ordering::Equal)
+                    );
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn equal_endpoint_representations_keep_parallel_offset_certificates() {
+        let source = LineSeg2::from_certified_nonzero_delta(
+            Point2::new(Real::pi(), Real::e()),
+            Real::one(),
+            Real::from(2),
+        );
+        let left = source.offset_left(Real::one()).unwrap();
+        let farther = source.offset_left(Real::from(2)).unwrap();
+        let rebuilt = left
+            .with_endpoint_representations(left.start().clone(), left.end().clone())
+            .unwrap();
+        for policy in [CurveContext::STRICT, CurveContext::APPROXIMATE_512] {
+            assert_eq!(
+                rebuilt.retained_offset_relation(&left, &policy),
+                Some(RetainedLineRelation2::Coincident)
+            );
+            assert_eq!(
+                rebuilt.retained_offset_relation(&farther, &policy),
+                Some(RetainedLineRelation2::ParallelDistinct)
+            );
+            assert_eq!(
+                rebuilt.reversed().retained_offset_relation(&left, &policy),
+                Some(RetainedLineRelation2::Coincident)
+            );
+            assert!(
+                rebuilt
+                    .intersect_line_with_policy(&farther, &policy)
+                    .unwrap()
+                    .is_none()
+            );
+        }
+    }
+
+    #[test]
+    fn split_support_preserves_direction_but_arbitrary_maps_recompute_it() {
+        let source = LineSeg2::from_certified_nonzero_delta(
+            Point2::new(Real::pi(), Real::e()),
+            Real::one(),
+            Real::from(2),
+        )
+        .offset_left(Real::one())
+        .unwrap();
+        let cut = source.fragment_between_after_distinct_endpoints(
+            source.point_at((Real::one() / Real::from(2)).unwrap()),
+            source.end().clone(),
+            source.fragment_support(),
+        );
+        assert!(Arc::ptr_eq(
+            cut.support.get().unwrap().retained_delta.as_ref().unwrap(),
+            source.retained_delta().unwrap(),
+        ));
+        assert_eq!(cut.support_delta(), (Real::one(), Real::from(2)));
+        assert_eq!(
+            cut.reversed().directed_support_delta(),
+            (Real::from(-1), Real::from(-2))
+        );
+        let mapped = cut
+            .map_points(|p| Point2::new(p.x() * Real::from(3), -p.y()))
+            .unwrap();
+        assert!(mapped.support.get().unwrap().retained_delta.is_none());
+        assert!(mapped.offset_provenance().is_none());
+        let (dx, dy) = mapped.support_delta();
+        assert_eq!(
+            compare_reals(&dx, &Real::from(3), &CurveContext::STRICT),
+            Some(Ordering::Equal)
+        );
+        assert_eq!(
+            compare_reals(&dy, &Real::from(-2), &CurveContext::STRICT),
+            Some(Ordering::Equal)
+        );
+    }
+}
