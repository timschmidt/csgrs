+fn radical_products_and_inverses_keep_exact_coefficients() {
+    let left = RadicalCoefficient::rational(Rational::new(2))
+        .add(RadicalCoefficient::radical(
+            Rational::new(3),
+            Rational::new(5),
+        ))
+        .unwrap();
+    let right = RadicalCoefficient::rational(Rational::new(7))
+        .add(RadicalCoefficient::radical(
