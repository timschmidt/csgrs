+        value
+            .insert(9, RadicalCoefficient::rational(Rational::one()))
+            .is_none()
+    );
+    assert_eq!(value.terms.len(), 8);
+    value
+        .insert(9, RadicalCoefficient::rational(Rational::zero()))
+        .unwrap();
