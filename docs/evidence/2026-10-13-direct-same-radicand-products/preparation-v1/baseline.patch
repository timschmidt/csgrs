+            expected
+                .1
+                .iter()
+                .map(|(root, amount)| (root.clone(), amount * &scale))
+                .collect::<Vec<_>>()
+        );
+        let mut cancelled = second;
+        cancelled.terms[0]
+            .1
+            .insert_radical(Rational::new(2), Rational::new(-1))
