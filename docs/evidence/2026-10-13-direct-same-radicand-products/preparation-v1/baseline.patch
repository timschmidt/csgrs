+                source.terms[0].1.radicals.as_ptr() == closed.terms[0].1.radicals.as_ptr();
+            let views_shared = closed.terms[0].1.radicals.as_ptr()
+                == first.terms[0].1.radicals.as_ptr()
+                && first.terms[0].1.radicals.as_ptr() == second.terms[0].1.radicals.as_ptr();
