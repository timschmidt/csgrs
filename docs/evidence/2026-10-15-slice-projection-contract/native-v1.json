[
  [
    "fmt",
    [
      "cargo",
      "fmt",
      "--all",
      "--",
      "--check"
    ]
  ],
  [
    "fuzz-fmt",
    [
      "cargo",
      "fmt",
      "--manifest-path",
      "fuzz/Cargo.toml",
      "--",
      "--check"
    ]
  ],
  [
    "hypermesh-default-tests",
    [
      "cargo",
      "test",
      "--locked",
      "--release",
      "-p",
      "hypermesh",
      "--",
      "--test-threads=1"
    ]
  ],
  [
    "hypermesh-all-tests",
    [
      "cargo",
      "test",
      "--locked",
      "--release",
      "-p",
      "hypermesh",
      "--all-features",
      "--",
      "--test-threads=1"
    ]
  ],
  [
    "hypermesh-docs",
    [
      "env",
      "RUSTDOCFLAGS=-D warnings",
      "cargo",
      "doc",
      "--locked",
      "--release",
      "-p",
      "hypermesh",
      "--all-features",
      "--no-deps"
    ]
  ],
  [
    "all-feature-clippy",
    [
      "cargo",
      "clippy",
      "--locked",
      "--release",
      "-p",
      "csgrs",
      "--all-features",
      "--all-targets",
      "--",
      "-D",
      "warnings"
    ]
  ],
  [
    "all-feature-tests",
    [
      "cargo",
      "test",
      "--locked",
      "--release",
      "-p",
      "csgrs",
      "--all-features",
      "--lib",
      "--tests",
      "--",
      "--test-threads=1"
    ]
  ],
  [
