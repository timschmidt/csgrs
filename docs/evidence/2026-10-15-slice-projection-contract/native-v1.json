      "--",
      "-D",
      "warnings"
    ]
  ],
  [
    "minimal-tests",
    [
      "cargo",
      "test",
      "--locked",
      "--release",
      "-p",
      "csgrs",
      "--no-default-features",
      "--lib",
      "--tests",
      "--",
      "--test-threads=1"
    ]
  ],
  [
    "curve-tests",
    [
      "cargo",
      "test",
      "--locked",
      "--release",
      "-p",
      "csgrs",
      "--no-default-features",
      "--features",
      "curve",
      "--lib",
      "--tests",
      "--",
      "--test-threads=1"
    ]
  ],
  [
    "docs",
    [
      "env",
      "RUSTDOCFLAGS=-D warnings",
      "cargo",
      "doc",
      "--locked",
      "--release",
      "-p",
      "csgrs",
      "--all-features",
      "--no-deps"
    ]
  ],
  [
    "doctests",
    [
      "cargo",
      "test",
      "--locked",
      "--release",
