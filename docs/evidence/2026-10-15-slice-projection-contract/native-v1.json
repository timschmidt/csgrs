      "--all-features",
      "--doc"
    ]
  ],
  [
    "projection-benchmarks",
    [
      "env",
      "CSGRS_BENCH_FILTER=feature/mesh_profile_projection/",
      "CSGRS_BENCH_SAMPLES=3",
      "CSGRS_BENCH_WARMUP=2",
      "cargo",
      "bench",
      "--locked",
      "-p",
      "csgrs",
      "--all-features",
      "--bench",
      "feature_pipeline"
