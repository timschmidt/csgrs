+                                carrier_index,
+                                &split.fragment,
+                                true,
+                            )
+                            .unwrap();
+                        let mut left = match loop_index {
+                            0 => vec![0, 0, 0],
+                            1 => vec![direction(0), 0, direction(2)],
+                            2 => vec![direction(0), 0, 0],
+                            _ => unreachable!(),
+                        };
+                        left[loop_index] = i32::from(direction(loop_index) > 0);
+                        let mut right = left.clone();
+                        right[loop_index] -= 1;
+                        assert_eq!(
+                            direct.side_windings,
+                            [left, right],
+                            "reversals={reversals}, loop={loop_index}"
+                        );
+                        assert_eq!(derived.side_windings, direct.side_windings);
+                        assert_eq!(derived.action, direct.action);
+                    }
+                }
+                assert!(
+                    lines > 0 && arcs > 0,
+                    "both materialized families must exercise the shortcut"
+                );
+            }
+        }
+    }
+}
