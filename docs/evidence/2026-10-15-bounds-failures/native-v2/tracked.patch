+/// A retained circle proves the radial is normal to the tangent, but not
+/// which way a possibly retraced chart visits an endpoint. The homogeneous
+/// endpoint derivative numerator supplies that local orientation. Its scale
+/// is `degree / endpoint_weight²`, which is positive for a finite endpoint.
+fn materialized_circle_endpoint_direction(
+    curve: &BezierSubcurve2,
+    at_start: bool,
+    policy: &CurveContext,
+) -> Option<(Real, Real)> {
+    match curve {
+        BezierSubcurve2::RationalQuadratic(curve) => curve.retained_circular_conic()?,
+        BezierSubcurve2::Rational(curve) => curve.retained_circular_conic()?,
+        BezierSubcurve2::Quadratic(_) | BezierSubcurve2::Cubic(_) => return None,
+    };
+    let rational = RationalBezier2::try_from_subcurve(curve).ok()?;
+    let circle = rational.retained_circular_conic()?;
+    if real_sign(&circle.radius_squared, policy) != Some(RealSign::Positive) {
+        return None;
+    }
+    let controls = rational.homogeneous_controls();
+    let (from, to, endpoint, weight) = if at_start {
+        (
+            &controls[0],
+            &controls[1],
+            rational.start(),
+            controls[0].weight(),
+        )
+    } else {
+        let end = controls.len() - 1;
+        (
+            &controls[end - 1],
+            &controls[end],
+            rational.end(),
+            controls[end].weight(),
+        )
+    };
+    if is_zero(weight, policy) != Some(false) {
+        return None;
+    }
+    let tx = Real::diff_of_products(to.x(), from.weight(), from.x(), to.weight());
+    let ty = Real::diff_of_products(to.y(), from.weight(), from.y(), to.weight());
+    let (dx, dy) = endpoint.delta_from(&circle.center);
+    match real_sign(&Real::diff_of_products(&dx, &ty, &dy, &tx), policy) {
+        Some(RealSign::Positive) => Some((-dy, dx)),
+        Some(RealSign::Negative) => Some((dy, -dx)),
+        // A stationary or undecided endpoint retains the derivative path.
+        Some(RealSign::Zero) | None => None,
+    }
