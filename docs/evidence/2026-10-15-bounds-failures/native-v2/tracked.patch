+                let direction = |index| if reversals & (1 << index) == 0 { 1 } else { -1 };
+                let mut lines = 0;
+                let mut arcs = 0;
+                for (carrier_index, splits) in topology.split_fragments.iter().enumerate() {
+                    let loop_index = context.data.carriers[carrier_index].loop_index;
+                    for split in splits {
+                        if matches!(split.fragment, BezierSplitFragment2::Materialized { .. }) {
+                            if loop_index == 2 {
