[
  [
    "fmt",
    [
      "cargo",
      "fmt",
      "--all",
      "--",
      "--check"
    ]
  ],
  [
    "fuzz-fmt",
    [
      "cargo",
      "fmt",
      "--manifest-path",
      "fuzz/Cargo.toml",
      "--",
      "--check"
    ]
  ],
  [
    "all-feature-tests",
    [
      "cargo",
      "test",
      "--locked",
      "--release",
      "-p",
      "csgrs",
      "--all-features",
      "--lib",
      "--tests",
      "--",
      "--test-threads=2"
    ]
  ],
  [
    "minimal-tests",
    [
      "cargo",
      "test",
      "--locked",
      "--release",
      "-p",
      "csgrs",
      "--no-default-features",
      "--lib",
      "--test",
      "bounds_failures",
      "--",
      "--test-threads=2"
    ]
  ],
  [
    "hypermesh-tests",
    [
      "cargo",
      "test",
      "--locked",
      "--release",
      "-p",
      "hypermesh",
      "--all-features",
      "--lib",
      "--tests",
      "--",
      "--test-threads=2"
    ]
  ],
  [
    "ffi-tests",
    [
      "cargo",
      "test",
      "--locked",
      "--release",
      "-p",
      "csgrs-ffi"
    ]
  ],
  [
    "strict-clippy",
    [
      "cargo",
      "clippy",
      "--locked",
      "--release",
      "-p",
      "hypermesh",
      "-p",
      "csgrs",
      "-p",
      "csgrs-ffi",
      "--all-targets",
      "--all-features",
      "--",
      "-D",
      "warnings"
    ]
  ],
  [
    "minimal-clippy",
    [
      "cargo",
      "clippy",
      "--locked",
      "--release",
      "-p",
      "csgrs",
      "--no-default-features",
      "--all-targets",
      "--",
      "-D",
      "warnings"
    ]
  ],
  [
    "fuzz-clippy",
    [
      "cargo",
      "clippy",
      "--locked",
      "--manifest-path",
      "fuzz/Cargo.toml",
      "--bins",
      "--",
      "-D",
      "warnings"
    ]
  ],
  [
    "docs",
    [
      "env",
      "RUSTDOCFLAGS=-D warnings",
      "cargo",
      "doc",
      "--locked",
      "-p",
      "hypermesh",
      "-p",
      "csgrs",
      "-p",
      "csgrs-ffi",
      "--all-features",
      "--no-deps"
