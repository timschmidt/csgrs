+use csgrs::{GeometryCertainty, GeometryContext, Real, solid};
+
+#[test]
+fn original_sampled_sphere_hulls_preserve_rows_after_cache_warming() {
+    for (radius, segments, stacks) in [(8_u8, 24, 12), (10, 32, 16), (8, 10, 7), (8, 7, 5)] {
+        solid::cache::clear();
+        let mesh = solid::sphere(Real::from(radius), segments, stacks);
+        // Retain all results. Querying or validating an earlier result here
+        // would introduce a different cache-warming sequence.
+        let cold = solid::convex_hull_with_context(&mesh, &GeometryContext::STRICT);
+        let warm = solid::convex_hull_with_context(&mesh, &GeometryContext::STRICT);
+        let replay = solid::convex_hull_with_context(&mesh, &GeometryContext::STRICT);
+        let outcomes = [
+            cold.expect("cold hull"),
+            warm.expect("warm hull"),
+            replay.expect("replay hull"),
+        ];
+        for outcome in &outcomes {
+            assert_eq!(outcome.certainty, GeometryCertainty::Certified);
+            assert_eq!(outcome.value.positions.len(), segments * (stacks - 1) + 2);
+            assert_eq!(outcome.value.triangles.len(), 2 * segments * (stacks - 1));
+            assert!(outcome.value.is_closed_manifold());
+        }
+        for outcome in &outcomes[1..] {
+            assert!(
+                outcomes[0].value.positions == outcome.value.positions,
+                "vertex row order changed for {segments}x{stacks}"
+            );
+            assert!(
+                outcomes[0].value.triangles == outcome.value.triangles,
+                "triangle rows changed for {segments}x{stacks}"
+            );
+        }
+    }
+    solid::cache::clear();
+}
