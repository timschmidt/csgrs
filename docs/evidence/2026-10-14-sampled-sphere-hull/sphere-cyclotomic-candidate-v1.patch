+//! Bounded exact-zero proofs in a cyclotomic field. No numerical evaluation.
+//!
+//! With zeta = exp(2 pi i / L), the exact sine and cosine formulas become
+//! rational polynomials in zeta. Phi_L(zeta) = 0 makes a zero polynomial
+//! remainder a certificate of equality. The modulus is built by exact monic
+//! division of X^d - 1 for divisors d of L, checking every remainder. Square
+//! roots 2 and 3 use 2 cos(pi/4) and 2 cos(pi/6), both positive; sqrt(6) is
+//! their product. No conclusion is drawn from a nonzero remainder.
+//!
+//! Checked i128 operations reject overflow. Field order, polynomial degree,
+//! graph visits, recursion depth and coefficient work have fixed ceilings.
+//! Rational leaves are read before canonicalization and fit in two u64 words.
+//! The query does not change scalar representations or publish cache facts.
+use super::{Approximation, Computable, SharedConstant};
+
+const MAX_ORDER: usize = 256;
+const MAX_DEGREE: usize = 128;
+const MAX_VISITS: usize = 512;
+const MAX_DEPTH: usize = 96;
+const MAX_WORK: usize = 262_144;
+
+#[derive(Clone, Copy)]
+struct Fraction {
+    numerator: i128,
+    denominator: i128,
+}
+
+fn gcd(mut a: u128, mut b: u128) -> u128 {
+    while b != 0 {
+        (a, b) = (b, a % b);
+    }
+    a
+}
+
+impl Fraction {
+    fn new(numerator: i128, denominator: i128) -> Option<Self> {
+        if denominator <= 0 {
+            return None;
+        }
+        let divisor = i128::try_from(gcd(numerator.unsigned_abs(), denominator as u128)).ok()?;
+        Some(Self {
+            numerator: numerator / divisor,
+            denominator: denominator / divisor,
+        })
+    }
+
+    fn add(self, other: Self) -> Option<Self> {
+        Self::new(
+            self.numerator
+                .checked_mul(other.denominator)?
+                .checked_add(other.numerator.checked_mul(self.denominator)?)?,
+            self.denominator.checked_mul(other.denominator)?,
+        )
+    }
+
+    fn mul(self, other: Self) -> Option<Self> {
+        Self::new(
+            self.numerator.checked_mul(other.numerator)?,
+            self.denominator.checked_mul(other.denominator)?,
+        )
+    }
+
+    fn binary_scale(shift: i32) -> Option<Self> {
+        if !(-63..=63).contains(&shift) {
+            return None;
+        }
+        Self::new(1_i128 << shift.max(0), 1_i128 << (-shift).max(0))
+    }
+}
+
+fn rational_leaf(node: &Computable) -> Option<Fraction> {
+    match &node.internal.approximation {
+        Approximation::One => Fraction::new(1, 1),
+        Approximation::Int(value) => {
+            if value.bits() > 64 {
+                return None;
+            }
+            Fraction::new(num::ToPrimitive::to_i128(value)?, 1)
+        }
+        Approximation::Ratio(value) => {
+            let (numerator, denominator) = value.bounded_raw_word_parts()?;
+            Fraction::new(numerator, denominator)
+        }
+        _ => None,
+    }
+}
+
+enum Expression {
+    Rational(Fraction),
+    Trig(Fraction, bool),
+    Root(u8),
+    Scale(usize, Fraction),
+    Add(usize, usize),
+    Multiply(usize, usize),
+    Inverse(usize),
+    Dot([usize; 3], [Fraction; 3]),
+}
+
+struct Plan {
+    expressions: Vec<Expression>,
+    identities: Vec<(usize, usize)>,
+    remaining: usize,
+    order: usize,
+    has_trig: bool,
+}
+
+impl Plan {
+    fn visit(&mut self, depth: usize) -> Option<()> {
+        if depth >= MAX_DEPTH {
+            return None;
+        }
+        self.remaining = self.remaining.checked_sub(1)?;
+        Some(())
+    }
+
+    fn include_order(&mut self, order: usize) -> Option<()> {
+        self.order =
+            (self.order / gcd(self.order as u128, order as u128) as usize).checked_mul(order)?;
+        (self.order <= MAX_ORDER).then_some(())
+    }
+
+    fn pi_multiple(&mut self, node: &Computable, depth: usize) -> Option<Fraction> {
+        self.visit(depth)?;
+        match &node.internal.approximation {
+            Approximation::Constant(SharedConstant::Pi) => Fraction::new(1, 1),
+            Approximation::Constant(SharedConstant::Tau) => Fraction::new(2, 1),
+            Approximation::Negate(child) => self
+                .pi_multiple(child, depth + 1)?
+                .mul(Fraction::new(-1, 1)?),
+            Approximation::Offset(child, shift) => self
+                .pi_multiple(child, depth + 1)?
+                .mul(Fraction::binary_scale(*shift)?),
+            Approximation::Add(left, right) => self
+                .pi_multiple(left, depth + 1)?
+                .add(self.pi_multiple(right, depth + 1)?),
+            Approximation::Multiply(left, right) => {
+                if let Some(scale) = rational_leaf(left) {
+                    self.pi_multiple(right, depth + 1)?.mul(scale)
+                } else {
+                    self.pi_multiple(left, depth + 1)?
+                        .mul(rational_leaf(right)?)
+                }
+            }
+            _ => None,
+        }
+    }
+
+    fn parse(&mut self, node: &Computable, depth: usize) -> Option<usize> {
+        self.visit(depth)?;
+        let identity = std::sync::Arc::as_ptr(&node.internal) as usize;
+        if let Some((_, index)) = self.identities.iter().find(|(key, _)| *key == identity) {
+            return Some(*index);
+        }
+        let expression = if let Some(value) = rational_leaf(node) {
+            Expression::Rational(value)
+        } else {
+            match &node.internal.approximation {
+                Approximation::PrescaledSin(argument) | Approximation::PrescaledCos(argument) => {
+                    let angle = self.pi_multiple(argument, depth + 1)?;
+                    let denominator = usize::try_from(angle.denominator).ok()?;
+                    self.include_order(denominator.checked_mul(2)?)?;
+                    self.has_trig = true;
+                    Expression::Trig(
+                        angle,
+                        matches!(&node.internal.approximation, Approximation::PrescaledSin(_)),
+                    )
+                }
+                Approximation::Constant(SharedConstant::Sqrt2) => {
+                    self.include_order(8)?;
+                    Expression::Root(2)
+                }
+                Approximation::Constant(SharedConstant::Sqrt3) => {
+                    self.include_order(12)?;
+                    Expression::Root(3)
+                }
+                Approximation::Sqrt(child) => {
+                    let square = rational_leaf(child)?;
+                    if square.denominator != 1 {
+                        return None;
+                    }
+                    let order = match square.numerator {
+                        2 => 8,
+                        3 => 12,
+                        6 => 24,
+                        _ => return None,
+                    };
+                    self.include_order(order)?;
+                    Expression::Root(square.numerator as u8)
+                }
+                Approximation::Negate(child) => {
+                    Expression::Scale(self.parse(child, depth + 1)?, Fraction::new(-1, 1)?)
+                }
+                Approximation::Offset(child, shift) => Expression::Scale(
+                    self.parse(child, depth + 1)?,
+                    Fraction::binary_scale(*shift)?,
+                ),
+                Approximation::Add(left, right) => {
+                    Expression::Add(self.parse(left, depth + 1)?, self.parse(right, depth + 1)?)
+                }
+                Approximation::Multiply(left, right) => Expression::Multiply(
+                    self.parse(left, depth + 1)?,
+                    self.parse(right, depth + 1)?,
+                ),
+                Approximation::Square(child) => {
+                    let child = self.parse(child, depth + 1)?;
+                    Expression::Multiply(child, child)
+                }
+                Approximation::Inverse(child) => Expression::Inverse(self.parse(child, depth + 1)?),
+                Approximation::LinearCombination3(dot) => {
+                    let mut nodes = [0; 3];
+                    let mut scales = [Fraction::new(0, 1)?; 3];
+                    for index in 0..3 {
+                        nodes[index] = self.parse(&dot.coefficients[index], depth + 1)?;
+                        let (numerator, denominator) =
+                            dot.values[index].bounded_raw_word_parts()?;
+                        scales[index] = Fraction::new(numerator, denominator)?;
+                    }
+                    Expression::Dot(nodes, scales)
+                }
+                _ => return None,
+            }
+        };
+        let index = self.expressions.len();
+        self.expressions.push(expression);
+        self.identities.push((identity, index));
+        Some(index)
+    }
+}
+
+struct Work(usize);
+
+impl Work {
+    fn charge(&mut self, amount: usize) -> Option<()> {
+        self.0 = self.0.checked_sub(amount)?;
+        Some(())
+    }
+}
+
+fn divide_monic(mut dividend: Vec<i128>, divisor: &[i128], work: &mut Work) -> Option<Vec<i128>> {
+    if divisor.last() != Some(&1) || dividend.len() < divisor.len() {
+        return None;
+    }
+    let mut quotient = vec![0; dividend.len() - divisor.len() + 1];
+    for index in (0..quotient.len()).rev() {
+        let leading = dividend[index + divisor.len() - 1];
+        quotient[index] = leading;
+        work.charge(divisor.len())?;
+        for (offset, coefficient) in divisor.iter().enumerate() {
+            dividend[index + offset] =
+                dividend[index + offset].checked_sub(leading.checked_mul(*coefficient)?)?;
+        }
+    }
+    dividend
+        .iter()
+        .all(|coefficient| *coefficient == 0)
+        .then_some(quotient)
+}
+
+fn cyclotomic(order: usize, work: &mut Work) -> Option<Vec<i128>> {
+    if order == 0 || order > MAX_ORDER {
+        return None;
+    }
+    let mut known: Vec<(usize, Vec<i128>)> = Vec::new();
+    for divisor in 1..=order {
+        if !order.is_multiple_of(divisor) {
+            continue;
+        }
+        let mut polynomial = vec![0; divisor + 1];
+        polynomial[0] = -1;
+        polynomial[divisor] = 1;
+        for (factor, minimal) in &known {
+            if divisor.is_multiple_of(*factor) {
+                polynomial = divide_monic(polynomial, minimal, work)?;
+            }
+        }
+        known.push((divisor, polynomial));
+    }
+    let (_, polynomial) = known.pop()?;
+    (polynomial.len() - 1 <= MAX_DEGREE).then_some(polynomial)
+}
+
+struct Polynomial {
+    coefficients: Vec<i128>,
+    denominator: i128,
+}
+
+impl Polynomial {
+    fn normalized(mut self) -> Option<Self> {
+        if self.denominator <= 0 {
+            return None;
+        }
+        let divisor = self
+            .coefficients
+            .iter()
+            .fold(self.denominator as u128, |divisor, coefficient| {
+                gcd(divisor, coefficient.unsigned_abs())
+            });
+        let divisor = i128::try_from(divisor).ok()?;
+        self.denominator /= divisor;
+        for coefficient in &mut self.coefficients {
+            *coefficient /= divisor;
+        }
+        Some(self)
+    }
+
+    fn rational(value: Fraction, degree: usize) -> Self {
+        let mut coefficients = vec![0; degree];
+        coefficients[0] = value.numerator;
+        Self {
+            coefficients,
+            denominator: value.denominator,
+        }
+    }
+
+    fn reduce(
+        mut coefficients: Vec<i128>,
+        denominator: i128,
+        modulus: &[i128],
+        work: &mut Work,
+    ) -> Option<Self> {
+        let degree = modulus.len() - 1;
+        if modulus.last() != Some(&1) || degree == 0 {
+            return None;
+        }
+        for index in (degree..coefficients.len()).rev() {
+            let leading = coefficients[index];
+            if leading != 0 {
+                work.charge(degree)?;
+                for offset in 0..degree {
+                    coefficients[index - degree + offset] =
+                        coefficients[index - degree + offset]
+                            .checked_sub(leading.checked_mul(modulus[offset])?)?;
+                }
+            }
+        }
+        coefficients.resize(degree, 0);
+        Self {
+            coefficients,
+            denominator,
+        }
+        .normalized()
+    }
+
+    fn scale(&self, scale: Fraction, work: &mut Work) -> Option<Self> {
+        work.charge(self.coefficients.len())?;
+        let coefficients = self
+            .coefficients
+            .iter()
+            .map(|value| value.checked_mul(scale.numerator))
+            .collect::<Option<Vec<_>>>()?;
+        Self {
+            coefficients,
+            denominator: self.denominator.checked_mul(scale.denominator)?,
+        }
+        .normalized()
+    }
+
+    fn add(&self, other: &Self, work: &mut Work) -> Option<Self> {
+        work.charge(self.coefficients.len())?;
+        let divisor = gcd(self.denominator as u128, other.denominator as u128) as i128;
+        let left = other.denominator / divisor;
+        let right = self.denominator / divisor;
+        let coefficients = self
+            .coefficients
+            .iter()
+            .zip(&other.coefficients)
+            .map(|(a, b)| a.checked_mul(left)?.checked_add(b.checked_mul(right)?))
+            .collect::<Option<Vec<_>>>()?;
+        Self {
+            coefficients,
+            denominator: self.denominator.checked_mul(left)?,
+        }
+        .normalized()
+    }
+
+    fn multiply(&self, other: &Self, modulus: &[i128], work: &mut Work) -> Option<Self> {
+        let degree = modulus.len() - 1;
+        work.charge(degree.checked_mul(degree)?)?;
+        let mut coefficients = vec![0_i128; 2 * degree - 1];
+        for (i, a) in self.coefficients.iter().enumerate() {
+            if *a == 0 {
+                continue;
+            }
+            for (j, b) in other.coefficients.iter().enumerate() {
+                coefficients[i + j] = coefficients[i + j].checked_add(a.checked_mul(*b)?)?;
+            }
+        }
+        Self::reduce(
+            coefficients,
+            self.denominator.checked_mul(other.denominator)?,
+            modulus,
+            work,
+        )
+    }
+
+    fn inverse_rational(&self) -> Option<Self> {
+        if self.coefficients[1..].iter().any(|value| *value != 0) || self.coefficients[0] == 0 {
+            return None;
+        }
+        let sign = self.coefficients[0].signum();
+        Some(Self::rational(
+            Fraction::new(
+                self.denominator.checked_mul(sign)?,
+                self.coefficients[0].checked_abs()?,
+            )?,
+            self.coefficients.len(),
+        ))
+    }
+
+    fn trig(
+        angle: Fraction,
+        sine: bool,
+        order: usize,
+        modulus: &[i128],
+        work: &mut Work,
+    ) -> Option<Self> {
+        let denominator = angle.denominator.checked_mul(2)?;
+        if (order as i128) % denominator != 0 {
+            return None;
+        }
+        let exponent = angle
+            .numerator
+            .checked_mul(order as i128 / denominator)?
+            .rem_euclid(order as i128) as usize;
+        let opposite = (order - exponent) % order;
+        let mut coefficients = vec![0_i128; order];
+        if sine {
+            let shift = order / 4;
+            coefficients[(exponent + shift) % order] -= 1;
+            coefficients[(opposite + shift) % order] += 1;
+        } else {
+            coefficients[exponent] += 1;
+            coefficients[opposite] += 1;
+        }
+        Self::reduce(coefficients, 2, modulus, work)
+    }
+
+    fn root(square: u8, order: usize, modulus: &[i128], work: &mut Work) -> Option<Self> {
+        let twice = Fraction::new(2, 1)?;
+        match square {
+            2 => Self::trig(Fraction::new(1, 4)?, false, order, modulus, work)?.scale(twice, work),
+            3 => Self::trig(Fraction::new(1, 6)?, false, order, modulus, work)?.scale(twice, work),
+            6 => {
+                let first = Self::root(2, order, modulus, work)?;
+                let second = Self::root(3, order, modulus, work)?;
+                first.multiply(&second, modulus, work)
+            }
+            _ => None,
+        }
+    }
+}
+
+fn prove_zero(node: &Computable) -> Option<()> {
+    let mut plan = Plan {
+        expressions: Vec::new(),
+        identities: Vec::new(),
+        remaining: MAX_VISITS,
+        order: 4,
+        has_trig: false,
+    };
+    let root = plan.parse(node, 0)?;
+    if !plan.has_trig {
+        return None;
+    }
+    let mut work = Work(MAX_WORK);
+    let modulus = cyclotomic(plan.order, &mut work)?;
+    let degree = modulus.len() - 1;
+    let mut values: Vec<Polynomial> = Vec::with_capacity(plan.expressions.len());
+    for expression in plan.expressions {
+        let value = match expression {
+            Expression::Rational(value) => Polynomial::rational(value, degree),
+            Expression::Trig(angle, sine) => {
+                Polynomial::trig(angle, sine, plan.order, &modulus, &mut work)?
+            }
+            Expression::Root(square) => Polynomial::root(square, plan.order, &modulus, &mut work)?,
+            Expression::Scale(child, scale) => values[child].scale(scale, &mut work)?,
+            Expression::Add(left, right) => values[left].add(&values[right], &mut work)?,
+            Expression::Multiply(left, right) => {
+                values[left].multiply(&values[right], &modulus, &mut work)?
+            }
+            Expression::Inverse(child) => values[child].inverse_rational()?,
+            Expression::Dot(nodes, scales) => {
+                let mut sum = Polynomial::rational(Fraction::new(0, 1)?, degree);
+                for index in 0..3 {
+                    sum = sum.add(
+                        &values[nodes[index]].scale(scales[index], &mut work)?,
+                        &mut work,
+                    )?;
+                }
+                sum
+            }
+        };
+        values.push(value);
+    }
+    values[root]
+        .coefficients
+        .iter()
+        .all(|coefficient| *coefficient == 0)
+        .then_some(())
+}
+
+impl Computable {
+    /// Certifies zero only for a bounded retained rational-angle expression.
+    /// Unsupported forms and every exhausted resource guard return false.
+    pub(crate) fn bounded_cyclotomic_zero(&self) -> bool {
+        if super::should_stop(&self.signal) || prove_zero(self).is_none() {
+            return false;
+        }
+        true
+    }
+}
