+use super::super::{BoundCache, ExactSignCache, Node};
+use super::*;
+use crate::{Rational, Real, RealSign};
+use std::sync::Arc;
+
+include!("witnesses.rs");
+
+fn raw(kind: Approximation) -> Computable {
+    Computable {
+        internal: Arc::new(Node::new(
+            kind,
+            BoundCache::Invalid,
+            ExactSignCache::Invalid,
+        )),
+        signal: None,
+    }
+}
+
+fn point(index: usize, segments: usize, stacks: usize) -> [Real; 3] {
+    if index == 0 {
+        return [Real::zero(), Real::one(), Real::zero()];
+    }
+    if index == segments * (stacks - 1) + 1 {
+        return [Real::zero(), -Real::one(), Real::zero()];
+    }
+    let longitude = (index - 1) / (stacks - 1);
+    let latitude = (index - 1) % (stacks - 1) + 1;
+    let theta = Real::new(Rational::fraction(2 * longitude, segments).unwrap());
+    let phi = Real::new(Rational::fraction(latitude, stacks).unwrap());
+    [
+        theta.clone().cos_pi() * phi.clone().sin_pi(),
+        phi.cos_pi(),
+        theta.sin_pi() * Real::new(Rational::fraction(latitude, stacks).unwrap()).sin_pi(),
+    ]
+}
+
+fn determinant(indices: [usize; 4], segments: usize, stacks: usize) -> Real {
+    let [a, b, c, d] = indices.map(|index| point(index, segments, stacks));
+    let ad = std::array::from_fn::<_, 3, _>(|i| &a[i] - &d[i]);
+    let bd = std::array::from_fn::<_, 3, _>(|i| &b[i] - &d[i]);
+    let cd = std::array::from_fn::<_, 3, _>(|i| &c[i] - &d[i]);
+    Real::signed_product_sum(
+        [true, false, true, false, true, false],
+        [
+            [&ad[0], &bd[1], &cd[2]],
+            [&ad[0], &bd[2], &cd[1]],
+            [&ad[1], &bd[2], &cd[0]],
+            [&ad[1], &bd[0], &cd[2]],
+            [&ad[2], &bd[0], &cd[1]],
+            [&ad[2], &bd[1], &cd[0]],
+        ],
+    )
+}
+
+#[test]
+fn cyclotomic_captured_exact_zero_determinants() {
+    for &(segments, stacks, indices) in CAPTURED_ZEROS {
+        let value = determinant(indices, segments, stacks);
+        assert_eq!(
+            value.exact_rational_normal_form(),
+            Some(Rational::zero()),
+            "{segments}x{stacks} {indices:?}"
+        );
+        assert_eq!(value.exact_rational_normal_form(), Some(Rational::zero()));
+    }
+}
+
+#[test]
+fn cyclotomic_nonzero_face_controls_and_signed_perturbations() {
+    for (segments, stacks, indices, control) in [
+        (32, 16, [0, 1, 368, 256], 2),
+        (10, 7, [2, 51, 56, 9], 0),
+        (7, 5, [2, 5, 22, 17], 0),
+    ] {
+        let mut nonzero = indices;
+        nonzero[3] = control;
+        assert!(
+            !determinant(nonzero, segments, stacks)
+                .fold_ref()
+                .bounded_cyclotomic_zero()
+        );
+        for numerator in [-1, 1] {
+            let value = determinant(indices, segments, stacks)
+                + Real::new(Rational::fraction(numerator, 1_048_576).unwrap());
+            assert!(!value.fold_ref().bounded_cyclotomic_zero());
+            let expected = if numerator < 0 {
+                RealSign::Negative
+            } else {
+                RealSign::Positive
+            };
+            assert_eq!(value.refine_sign_until(-128), Some(expected));
+            assert_eq!(value.refine_sign_until(0), Some(expected));
+        }
+    }
+}
+
+#[test]
+fn cyclotomic_moduli_and_root_branches() {
+    let mut work = Work(MAX_WORK);
+    let phi32 = cyclotomic(32, &mut work).unwrap();
+    let mut expected = vec![0; 17];
+    expected[0] = 1;
+    expected[16] = 1;
+    assert_eq!(phi32, expected);
+    assert!(cyclotomic(MAX_ORDER + 1, &mut work).is_none());
+    for square in [2_u8, 3, 6] {
+        let order = if square == 2 {
+            8
+        } else if square == 3 {
+            12
+        } else {
+            24
+        };
+        let modulus = cyclotomic(order, &mut work).unwrap();
+        let root = Polynomial::root(square, order, &modulus, &mut work).unwrap();
+        let squared = root.multiply(&root, &modulus, &mut work).unwrap();
+        assert_eq!(squared.denominator, 1);
+        assert_eq!(squared.coefficients[0], i128::from(square));
+        assert!(squared.coefficients[1..].iter().all(|c| *c == 0));
+    }
+}
