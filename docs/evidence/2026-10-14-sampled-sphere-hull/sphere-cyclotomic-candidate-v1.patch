+    std::thread::scope(|scope| {
+        for _ in 0..4 {
+            let value = value.clone();
+            scope.spawn(move || {
+                for _ in 0..8 {
+                    assert_eq!(value.exact_rational_normal_form(), Some(Rational::zero()));
+                    assert!(matches!(
+                        value.refine_sign_until(0),
+                        None | Some(RealSign::Zero)
+                    ));
+                }
+            });
+        }
+    });
