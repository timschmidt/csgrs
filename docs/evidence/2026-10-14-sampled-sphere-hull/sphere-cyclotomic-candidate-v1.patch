+#[test]
+fn cyclotomic_sine_pythagorean_and_angle_addition() {
+    for denominator in [5, 7, 16, 17, 35, 64] {
+        let angle = Real::new(Rational::fraction(1, denominator).unwrap());
+        let sine = angle.clone().sin_pi();
+        let cosine = angle.cos_pi();
+        let identity = &sine * &sine + &cosine * &cosine - Real::one();
+        assert_eq!(
+            identity.exact_rational_normal_form(),
+            Some(Rational::zero())
+        );
+        let double = Real::new(Rational::fraction(2, denominator).unwrap()).sin_pi();
+        let identity = double - Real::from(2) * sine * cosine;
+        assert_eq!(
+            identity.exact_rational_normal_form(),
+            Some(Rational::zero())
+        );
+    }
+}
