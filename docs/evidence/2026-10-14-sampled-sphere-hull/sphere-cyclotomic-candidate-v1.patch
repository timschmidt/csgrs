+#[test]
+fn cyclotomic_resource_guards_are_unknown() {
+    let angle = raw(Approximation::Multiply(
+        Computable::pi(),
+        Computable::rational(Rational::fraction(1, 7).unwrap()),
+    ));
+    let sine = raw(Approximation::PrescaledSin(angle));
+    let zero = raw(Approximation::Add(
+        sine.clone(),
+        raw(Approximation::Negate(sine.clone())),
+    ));
+    assert!(zero.bounded_cyclotomic_zero());
+    assert!(zero.cached().is_none());
+    let mut deep = sine.clone();
+    for _ in 0..MAX_DEPTH {
+        deep = raw(Approximation::Negate(deep));
+    }
+    assert!(!deep.bounded_cyclotomic_zero());
+    let huge = raw(Approximation::Offset(zero.clone(), 64));
+    assert!(!huge.bounded_cyclotomic_zero());
+    let outside = raw(Approximation::PrescaledSin(raw(Approximation::Multiply(
+        Computable::pi(),
+        Computable::rational(Rational::fraction(1, 257).unwrap()),
+    ))));
+    assert!(!outside.bounded_cyclotomic_zero());
+    let unsupported = raw(Approximation::Add(zero.clone(), Computable::pi()));
+    assert!(!unsupported.bounded_cyclotomic_zero());
+    let inverse_zero = raw(Approximation::Inverse(zero));
+    assert!(!inverse_zero.bounded_cyclotomic_zero());
+    assert!(
+        Fraction::new(i128::MAX, 1)
+            .unwrap()
+            .mul(Fraction::new(2, 1).unwrap())
+            .is_none()
+    );
+    assert!(Work(0).charge(1).is_none());
+    let mut work = Work(0);
+    assert!(cyclotomic(32, &mut work).is_none());
+}
