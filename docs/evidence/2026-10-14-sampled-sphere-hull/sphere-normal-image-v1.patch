+fn root_image(plan: &Plan, root: usize, work: &mut Work) -> Option<u64> {
+    if !plan.has_trig {
+        return None;
+    }
+    let image = Image::new(plan.order, work)?;
+    let values = image.evaluate(plan, work)?;
+    values[..plan.expressions.len()].get(root).copied()
+}
+
+pub(super) fn root_nonzero(plan: &Plan, root: usize) -> bool {
+    root_image(plan, root, &mut Work(MAX_IMAGE_WORK)).is_some_and(|value| value != 0)
+}
