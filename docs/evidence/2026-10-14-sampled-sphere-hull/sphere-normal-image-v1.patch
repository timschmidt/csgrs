+#[test]
+fn cyclotomic_root_images_reject_only_certified_nonzero_residues() {
+    let plan = make_plan(
+        28,
+        vec![Expression::Trig(Fraction::new(1, 7).unwrap(), true)],
+    );
+    assert!(root_nonzero(&plan, 0));
+    assert!(!root_nonzero(&plan, 1));
+    assert!(root_image(&plan, 0, &mut Work(0)).is_none());
+    let mut no_trig = make_plan(4, vec![Expression::Rational(Fraction::new(1, 1).unwrap())]);
+    no_trig.has_trig = false;
+    assert!(!root_nonzero(&no_trig, 0));
+    let oversized = make_plan(
+        28,
+        (0..=MAX_VISITS)
+            .map(|_| Expression::Trig(Fraction::new(1, 7).unwrap(), true))
+            .collect(),
+    );
+    assert!(!root_nonzero(&oversized, 0));
+}
