+#[test]
+fn cyclotomic_root_collisions_and_bad_units_keep_exact_zero_search() {
+    use crate::Computable;
+    use crate::computable::approximation::Approximation;
+    use crate::computable::node::{BoundCache, ExactSignCache, Node};
+    use std::sync::Arc;
+
+    fn raw(approximation: Approximation) -> Computable {
+        Computable {
+            internal: Arc::new(Node::new(
+                approximation,
+                BoundCache::Invalid,
+                ExactSignCache::Invalid,
+            )),
+            signal: None,
+        }
+    }
+
+    fn plan_for(node: &Computable) -> (Plan, usize) {
+        let mut plan = make_plan(4, Vec::new());
+        plan.has_trig = false;
+        let root = plan.parse(node, 0).unwrap();
+        (plan, root)
+    }
+
+    let image = Image::new(28, &mut Work(MAX_IMAGE_WORK)).unwrap();
+    let angle = raw(Approximation::Multiply(
+        Computable::pi(),
+        Computable::rational(Rational::fraction(1, 7).unwrap()),
+    ));
+    let sine = raw(Approximation::PrescaledSin(angle));
+    for multiple in [image.prime, image.prime + 1] {
+        let value = raw(Approximation::Multiply(
+            sine.clone(),
+            Computable::rational(Rational::from(multiple)),
+        ));
+        let (plan, root) = plan_for(&value);
+        let residue = root_image(&plan, root, &mut Work(MAX_IMAGE_WORK)).unwrap();
+        assert_eq!(residue == 0, multiple == image.prime);
+        assert_eq!(root_nonzero(&plan, root), multiple != image.prime);
+        // A zero residue for a nonzero expression must not manufacture zero.
+        assert!(!value.bounded_cyclotomic_zero());
+        assert!(value.cached().is_none());
+    }
+    let zero = raw(Approximation::Add(
+        sine.clone(),
+        raw(Approximation::Negate(sine)),
+    ));
+    let (plan, root) = plan_for(&zero);
+    assert_eq!(root_image(&plan, root, &mut Work(MAX_IMAGE_WORK)), Some(0));
+    assert!(!root_nonzero(&plan, root));
+    assert!(zero.bounded_cyclotomic_zero());
+    let bad_unit = raw(Approximation::Multiply(
+        Computable::rational(Rational::fraction(1, image.prime).unwrap()),
+        zero,
+    ));
+    let (plan, root) = plan_for(&bad_unit);
+    assert!(root_image(&plan, root, &mut Work(MAX_IMAGE_WORK)).is_none());
+    assert!(!root_nonzero(&plan, root));
+    assert!(bad_unit.bounded_cyclotomic_zero());
+    assert!(bad_unit.cached().is_none());
+}
