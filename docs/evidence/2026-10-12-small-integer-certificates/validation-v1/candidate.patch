+
+#[test]
+fn integer_leaf_values_survive_word_boundaries_warming_and_cloning() {
+    let mut integers = [-65_i64, -64, -2, -1, 0, 1, 2, 64, 65]
+        .into_iter()
+        .map(BigInt::from)
+        .collect::<Vec<_>>();
+    for bits in [7_usize, 63, 64, 127, 255, 1024] {
+        for offset in [-1_i32, 0, 1] {
+            let magnitude = (BigInt::one() << bits) + offset;
+            integers.push(magnitude.clone());
+            integers.push(-magnitude);
+        }
+    }
+    for integer in integers {
+        let value = raw(Approximation::Int(integer.clone()));
+        let clone = value.clone();
+        for query in [&value, &clone, &value] {
+            let exact = query.exact_rational().unwrap();
+            // Compare the independent integer payload, including values
+            // immediately outside signed conversion and canonical-table bounds.
+            assert_eq!(exact.to_big_integer().as_ref(), Some(&integer));
+            assert_eq!(query.bounded_laurent_rational(2).unwrap(), exact);
+        }
+        assert!(value.cached().is_none());
+        let weak = Arc::downgrade(&value.internal);
+        drop(clone);
+        drop(value);
+        assert!(weak.upgrade().is_none());
+    }
+}
