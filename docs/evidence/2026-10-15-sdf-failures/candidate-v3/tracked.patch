+    match curve {
+        BezierSubcurve2::RationalQuadratic(curve) => curve.retained_circular_conic()?,
+        BezierSubcurve2::Rational(curve) => curve.retained_circular_conic()?,
+        BezierSubcurve2::Quadratic(_) | BezierSubcurve2::Cubic(_) => return None,
+    };
+    let rational = RationalBezier2::try_from_subcurve(curve).ok()?;
+    let circle = rational.retained_circular_conic()?;
+    if real_sign(&circle.radius_squared, policy) != Some(RealSign::Positive) {
+        return None;
+    }
+    let controls = rational.homogeneous_controls();
+    let (from, to, endpoint, weight) = if at_start {
+        (
+            &controls[0],
+            &controls[1],
+            rational.start(),
+            controls[0].weight(),
+        )
+    } else {
+        let end = controls.len() - 1;
+        (
+            &controls[end - 1],
+            &controls[end],
+            rational.end(),
+            controls[end].weight(),
+        )
+    };
