+    let sdf = Sdf::new(expression);
+    sample_indexed(
+        |ix, iy, iz, x, y, z| {
+            sdf.evaluate_point(&HPoint3::new(x.clone(), y.clone(), z.clone()))
+                .map_err(|source| ValidationError::SdfSample {
+                    sample: [ix, iy, iz],
+                    source,
+                })
+        },
+        resolution,
+        min,
+        max,
+        iso_value,
+        collect_diagnostics,
+        preview_metric_status,
+        context,
+    )
 }
 
