+            for (vx, vy) in [(1, 0), (0, 1), (-1, 0), (0, -1), (dx, dy), (-dx, -dy)] {
+                let vector = CurveTangent2::RepresentedDirection((Real::from(vx), Real::from(vy)));
+                let cross = dx * vy - dy * vx;
+                let expected = match cross.cmp(&0) {
+                    Ordering::Less => RealSign::Negative,
+                    Ordering::Equal => RealSign::Zero,
+                    Ordering::Greater => RealSign::Positive,
+                };
+                assert_eq!(
