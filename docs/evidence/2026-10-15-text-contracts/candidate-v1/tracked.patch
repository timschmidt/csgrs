+        let line = LineSeg2::from_certified_nonzero_delta(
+            Point2::from_values(5, 7),
+            Real::from(2),
+            Real::from(4),
+        );
+        let mapped = line
+            .map_points(|point| Point2::new(point.x() * Real::from(3), -point.y()))
+            .unwrap();
+        assert_eq!(mapped.delta(), (Real::from(6), Real::from(-4)));
+        let cut = line.fragment_between_after_distinct_endpoints(
+            Point2::from_values(6, 9),
+            line.end().clone(),
+            line.fragment_support(),
+        );
+        assert_eq!(cut.delta(), (Real::one(), Real::from(2)));
+        assert_eq!(cut.support_delta(), (Real::from(2), Real::from(4)));
+    }
+
+    #[test]
+    fn repeated_parallel_offsets_retain_the_exact_source_displacement() {
+        let origin = Point2::new(Real::pi(), Real::e());
+        let mut line = LineSeg2::from_certified_nonzero_delta(origin, Real::one(), Real::from(2));
+        for distance in [Real::one(), Real::pi(), Real::from(-3)] {
+            let previous = line.clone();
+            line = line.offset_left(distance.clone()).unwrap();
+            assert!(line.endpoints_decided_distinct());
