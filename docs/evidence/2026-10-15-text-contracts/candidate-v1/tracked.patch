+fn native_boundary_tangents_keep_line_support_and_circle_radials() {
+    let check = |curve: BezierSubcurve2, expected: [(i32, i32); 2], policy: &CurveContext| {
+        let fragment = BezierSplitFragment2::Materialized {
+            start: BezierParameter2::Exact(Real::zero()),
+            end: BezierParameter2::Exact(Real::one()),
