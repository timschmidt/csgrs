	(gr_text_box "From {dblquote}7 Series FPGAs PCB Design Guide{dblquote} (UG483):\n\n{dblquote}The 0805 and 0603 capacitors cover the middle frequency range. Placement has some impact on their performance. The capacitors should be placed as close as possible to the FPGA. Any placement within two electrical inches of the device's point of load is acceptable.{dblquote}\n\n2 in = 50.8 mm"
		(start 89.75 36.25)
		(end 131 53)
		(margins 0.8 0.8 0.8 0.8)
		(layer "Cmts.User")
		(uuid "563397aa-862f-4b52-8a90-da9d1421836a")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
			(justify left top)
		)
		(border yes)
		(stroke
			(width 0.1)
			(type solid)
		)
		(knockout no)
	)
	(gr_text_box "Trace widths calculations from JLCPCB Impedance Calculator:\n\nLayer Stackup: JLC04161H-7628\n\n1. SMA: 50 Ohm Coplanar single ended:\nSignal layer: Layer 1\nBottom Ref: Layer 2\nTrace Width: 0.3472 mm\nImpedance trace to copper: 0.75 mm\n\n2. 50_ohm: 50 Ohm Coplanar single ended:\nSpace constrained\nSignal layer: Layer 1\nBottom Ref: Layer 2\nTrace Width:  mm\nImpedance trace to copper:  mm\n\n3. 50_ohm_narrow: 50 Ohm Coplanar single ended:\nSpace constrained\nSignal layer: Layer 1\nBottom Ref: Layer 2\nTrace Width: 0.1994 mm\nImpedance trace to copper: 0.1 mm\n\n4. SRAM: 50.835 Ohm Coplanar single ended:\nSpace constrained\nSignal layer: Layer 1\nBottom Ref: Layer 2\nTrace Width: 0.19 mm\nImpedance trace to copper: 0.1 mm\n\n5. USB: 90 Ohm Coplanar differential pair:\nSignal layer: Layer 1\nBottom Ref: Layer 2\nTrace Width: 0.2771 mm\nTrace Spacing: 0.220 mm\nImpedance trace to copper: 0.2 mm"
		(start 81.25 54.75)
		(end 131 115.2)
		(margins 0.8 0.8 0.8 0.8)
