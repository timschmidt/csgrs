+    assert_eq!(outcome.usage, hypercurve::WorkUsage::default());
+    let model = outcome.result.unwrap().certified().unwrap();
+    same(
+        &model.copper[0].region.try_area().unwrap(),
+        &(Scalar::from(10) + Scalar::pi()),
+    );
+}
