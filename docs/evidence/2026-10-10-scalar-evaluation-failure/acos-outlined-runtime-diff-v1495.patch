+// Keep coefficient arithmetic out of the dispatcher-facing kernel. Its caller
+// has already checked that the stored rational is strictly inside (-1, 1).
+#[inline(never)]
+fn acos_rational_half_angle(r: &Rational) -> Rational {
+    // Cancel the shared denominator before constructing either fraction.
+    // For signed n/d, (1-r)/(1+r) is (d-n)/(d+n).
+    let difference = r.denominator() - r.numerator();
+    let sum = r.denominator() + r.numerator();
+    let (numerator, denominator) = if r.sign() == Sign::Minus {
+        (sum, difference)
+    } else {
+        (difference, sum)
+    };
+    Rational::from_bigint_fraction(BigInt::from_biguint(Sign::Plus, numerator), denominator)
+        .expect("acos half-angle denominator is positive inside the unit interval")
+}
