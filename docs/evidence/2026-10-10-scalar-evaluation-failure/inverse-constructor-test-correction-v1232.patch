+    #[test]
+    fn inverse_constructor_opaque_domain_warming_preserves_signs() {
+        for kind in [0, 1] {
+            for bits in [8, 65, 256] {
+                for reversed in [false, true] {
+                    let value = opaque_offset_difference(bits, kind, reversed);
+                    let finite = value.has_finite_real_certificate();
+                    let budget = EvaluationBudget::new(1_000_000);
+                    let answer = value.sign_until_with_budget(0, &budget);
+                    let second = value.sign_until_with_budget(0, &budget);
+                    let unlimited = value.sign_until(0);
+                    let cold_unlimited =
+                        opaque_offset_difference(bits, kind, reversed).sign_until(0);
+                    eprintln!(
+                        "constructor domain diagnostic kind={kind}, bits={bits}, reversed={reversed}, finite={finite}, answer={answer:?}, second={second:?}, unlimited={unlimited:?}, cold_unlimited={cold_unlimited:?}, consumed={}",
+                        budget.consumed()
+                    );
+                    assert!(answer.is_none_or(|answer| answer == expected(reversed)));
+                    assert_eq!(second, Some(expected(reversed)));
+                    assert!(unlimited.is_none_or(|answer| answer == expected(reversed)));
+                    assert!(cold_unlimited.is_none_or(|answer| answer == expected(reversed)));
+                }
+            }
+        }
+    }
