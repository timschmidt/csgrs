+        fn integer_equal<const METERED: bool>(left: &BigInt, right: &BigInt) -> Option<bool> {
+            if METERED {
+                let bits = left.magnitude().bits();
+                if left.sign() != right.sign() || bits != right.magnitude().bits() {
+                    return Some(false);
+                }
+                // The node visit already pays the first unit. Debit the
+                // remaining payload work before scanning the integer limbs.
+                let extra = SymbolicWork::words(bits) - 1;
+                if extra != 0 && !crate::computable::budget::charge(extra) {
+                    return None;
+                }
+            }
+            Some(left == right)
+        }
