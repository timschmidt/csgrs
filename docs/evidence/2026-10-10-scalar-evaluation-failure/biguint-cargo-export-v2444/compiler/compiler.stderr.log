art":1,"highlight_end":100},{"text":"    requires determinant(a, b, c, d) == 1 || determinant(a, b, c, d) == -1,","highlight_start":1,"highlight_end":76},{"text":"    ensures gcd(abs(a * left + b * right), abs(c * left + d * right)) == gcd(left, right),","highlight_start":1,"highlight_end":91},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    let first = a * left + b * right;","highlight_start":1,"highlight_end":38},{"text":"    let second = c * left + d * right;","highlight_start":1,"highlight_end":39},{"text":"    let det = determinant(a, b, c, d);","highlight_start":1,"highlight_end":39},{"text":"    assert(d * (a * left + b * right) - b * (c * left + d * right)","highlight_start":1,"highlight_end":67},{"text":"        == (a * d - b * c) * left) by (nonlinear_arith);","highlight_start":1,"highlight_end":57},{"text":"    assert(-c * (a * left + b * right) + a * (c * left + d * right)","highlight_start":1,"highlight_end":68},{"text":"        == (a * d - b * c) * right) by (nonlinear_arith);","highlight_start":1,"highlight_end":58},{"text":"    assert(abs(det * left) == left && abs(det * right) == right) by (nonlinear_arith)","highlight_start":1,"highlight_end":86},{"text":"        requires det == 1 || det == -1, left >= 0, right >= 0;","highlight_start":1,"highlight_end":63},{"text":"    gcd_characterization(left, right);","highlight_start":1,"highlight_end":39},{"text":"    gcd_characterization(abs(first), abs(second));","highlight_start":1,"highlight_end":51},{"text":"    if left == 0 && right == 0 {","highlight_start":1,"highlight_end":33},{"text":"        assert(first == 0 && second == 0) by (nonlinear_arith)","highlight_start":1,"highlight_end":63},{"text":"            requires first == a * left + b * right, second == c * left + d * right,","highlight_start":1,"highlight_end":84},{"text":"                left == 0, right == 0;","highlight_start":1,"highlight_end":39},{"text":"    } else {","highlight_start":1,"highlight_end":13},{"text":"        