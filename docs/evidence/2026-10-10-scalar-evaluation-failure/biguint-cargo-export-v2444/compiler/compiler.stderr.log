0},{"text":"    }","highlight_start":1,"highlight_end":6},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"pub(crate) proof fn prefix_equal(left: Seq<u64>, right: Seq<u64>, length: int)","highlight_start":1,"highlight_end":79},{"text":"    requires 0 <= length <= left.len(), length <= right.len(),","highlight_start":1,"highlight_end":63},{"text":"        forall|index: int| 0 <= index < length ==> #[trigger] left[index] == right[index],","highlight_start":1,"highlight_end":91},{"text":"    ensures prefix(left, length) == prefix(right, length),","highlight_start":1,"highlight_end":59},{"text":"    decreases length,","highlight_start":1,"highlight_end":22},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    if length > 0 {","highlight_start":1,"highlight_end":20},{"text":"        prefix_equal(left, right, length - 1);","highlight_start":1,"highlight_end":47},{"text":"    }","highlight_start":1,"highlight_end":6},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"/// Equal higher limbs and unequal current limbs determine integer ordering,","highlight_start":1,"highlight_end":77},{"text":"/// regardless of all lower limbs.","highlight_start":1,"highlight_end":35},{"text":"proof fn prefix_less(left: Seq<u64>, right: Seq<u64>, index: int)","highlight_start":1,"highlight_end":66},{"text":"    requires 0 <= index < left.len(), left.len() == right.len(),","highlight_start":1,"highlight_end":65},{"text":"        left[index] < right[index],","highlight_start":1,"highlight_end":36},{"text":"        forall|higher: int| index < higher < left.len()","highlight_start":1,"highlight_end":56},{"text":"            ==> #[trigger] left[higher] == right[higher],","highlight_start":1,"highlight_end":58},{"text":"    ensures value(left) < value(right),","highlight_start":1,"highlight_end":40},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    prefix_bound(left, index);","highlight_start":1,"highlight_end":31},{"text":"    prefix_bound(right, index);","highlight_start":1,"highlight_end":32},{"text":"    weight_step(index as nat);","highlight_start":1,"highlight_end":31},{"text":"    assert(prefix(left, index + 1) < prefix(right, index + 1)) by (nonlinear_arith)","highlight_start":1,"highlight_end":84},{"text":"        requires 0 <= prefix(left, index) < weight(index as nat),","highlight_start":1,"highlight_end":66},{"text":"            0 <= prefix(right, index) < weight(index as nat),","highlight_start":1,"highlight_end":62},{"text":"            left[index] < right[index], weight(index as nat) > 0,","highlight_start":1,"highlight_end":66},{"text":"            prefix(left, index + 1) == prefix(left, index) + left[index] * weight(index as nat),","highlight_start":1,"highlight_end":97},{"text":"            prefix(right, index + 1) == prefix(right, index) + right[index] * weight(index as nat);","highlight_start":1,"highlight_end":100},{"text":"    extend_prefix_less(left, right, index + 1, left.len() as int);","highlight_start":1,"highlight_end":67},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"proof fn extend_prefix_less(left: Seq<u64>, right: Seq<u64>, start: int, end: int)","highlight_start":1,"highlight_end":83},{"text":"    requires 0 <= start <= end <= left.len(), left.len() == right.len(),","highlight_start":1,"highlight_end":73},{"text":"        prefix(left, start) < prefix(right, start),","highlight_start":1,"highlight_end":52},{"text":"        forall|index: int| start <= index < end ==> #[trigger] left[index] == right[index],","highlight_start":1,"highlight_end":92},{"text":"    ensures prefix(left, end) < prefix(right, end),","highlight_start":1,"highlight_end":52},{"text":"    decreases end - start,","highlight_start":1,"highlight_end":27},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    if start < end {","highlight_start":1,"highlight_end":21},{"text":"        extend_prefix_less(left, right, start, end - 1);","highlight_start":1,"highlight_end":57},{"text":"    }","highlight_start":1,"highlight_end":6},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"pub(crate) proof fn prefix_split(words: Seq<u64>, start: int, end: int)","highlight_start":1,"highlight_end":72},{"text":"    requires 0 <= start <= end <= words.len(),","highlight_start":1,"highlight_end":47},{"text":"    ensures prefix(words, end) == prefix(words, start)","highlight_start":1,"highlight_end":55},{"text":"        + weight(start as nat) * value(words.subrange(start, end)),","highlight_start":1,"highlight_end":68},{"text":"    decreases end - start,","highlight_start":1,"highlight_end":27},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    if start == end {","highlight_start":1,"highlight_end":22},{"text":"        assert(value(words.subrange(start, end)) == 0);","highlight_start":1,"highlight_end":56},{"text":"        assert(weight(start as nat) * 0nat == 0) by (nonlinear_arith);","highlight_start":1,"highlight_end":71},{"text":"    } else {","highlight_start":1,"highlight_end":13},{"text":"        prefix_split(words, start, end - 1);","highlight_start":1,"highlight_end":45},{"text":"        let tail = words.subrange(start, end);","highlight_start":1,"highlight_end":47},{"text":"        let previous = words.subrange(start, end - 1);","highlight_start":1,"highlight_end":55},{"text":"        prefix_equal(tail, previous, end - start - 1);","highlight_start":1,"highlight_end":55},{"text":"        weight_add(start as nat, (end - start - 1) as nat);","highlight_start":1,"highlight_end":60},{"text":"        assert(prefix(words, end) == prefix(words, start)","highlight_start":1,"highlight_end":58},{"text":"            + weight(start as nat) * value(tail)) by (nonlinear_arith)","highlight_start":1,"highlight_end":71},{"text":"            requires","highlight_st