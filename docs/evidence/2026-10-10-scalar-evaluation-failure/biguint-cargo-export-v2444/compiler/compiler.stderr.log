ros_u128_spec(value))","highlight_start":1,"highlight_end":67},{"text":"                * pow2(trailing_zeros_u128_spec(value) as nat)),","highlight_start":1,"highlight_end":65},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    let low = value as u64;","highlight_start":1,"highlight_end":28},{"text":"    let high = (value >> 64) as u64;","highlight_start":1,"highlight_end":37},{"text":"    axiom_u64_trailing_zeros(low);","highlight_start":1,"highlight_end":35},{"text":"    axiom_u64_trailing_zeros(high);","highlight_start":1,"highlight_end":36},{"text":"    let shift = trailing_zeros_u128_spec(value);","highlight_start":1,"highlight_end":49},{"text":"    assert(value == 0 <==> low == 0 && high == 0) by (bit_vector)","highlight_start":1,"highlight_end":66},{"text":"        requires low == value as u64, high == (value >> 64) as u64;","highlight_start":1,"highlight_end":68},{"text":"    if value > 0 {","highlight_start":1,"highlight_end":19},{"text":"        if low != 0 {","highlight_start":1,"highlight_end":22},{"text":"            assert(value << ((128 - shift) as u32) == 0) by (bit_vector)","highlight_start":1,"highlight_end":73},{"text":"                requires shift < 64, low == value as u64,","highlight_start":1,"highlight_end":58},{"text":"                    low << ((64 - shift) as u64) == 0;","highlight_start":1,"highlight_end":55},{"text":"            assert((value >> shift) & 1u128 == 1u128) by (bit_vector)","highlight_start":1,"highlight_end":70},{"text":"                requires shift < 64, low == value as u64,","highlight_start":1,"highlight_end":58},{"text":"                    (low >> shift) & 1u64 == 1u64;","highlight_start":1,"highlight_end":51},{"text":"        } else {","highlight_start":1,"highlight_end":17},{"text":"            let upper_shift = u64_trailing_zeros(high);","highlight_start":1,"highlight_end":56},{"text":"            assert(value << ((128 - shift) as u32) == 0) by (bit_vector)","highlight_start":1,"highlight_end":73},{"text":"                requires upper_shift < 64, shift == 64 + upper_shift,","highlight_start":1,"highlight_end":70},{"text":"                    value as u64 == 0, high == (value >> 64) as u64,","highlight_start":1,"highlight_end":69},{"text":"                    high << ((64 - upper_shift) as u64) == 0;","highlight_start":1,"highlight_end":62},{"text":"            assert((value >> shift) & 1u128 == 1u128) by (bit_vector)","highlight_start":1,"highlight_end":70},{"text":"                requires upper_shift < 64, shift == 64 + upper_shift,","highlight_start":1,"highlight_end":70},{"text":"                    high == (value >> 64) as u64,","highlight_start":1,"highlight_end":50},{"text":"                    (high >> upper_shift) & 1u64 == 1u64;","highlight_start":1,"highlight_end":58},{"text":"        }","highlight_start":1,"highlight_end":10},{"text":"        let odd = value >> shift;","highlight_start":1,"highlight_end":34},{"text":"        assert(0 < odd <= value && odd % 2 == 1) by (bit_vector)","highlight_start":1,"highlight_end":65},{"text":"            requires odd == value >> shift, odd & 1u128 == 1u128;","highlight_start":1,"highlight_end":66},{"text":"        lemma_pow2_pos(shift as nat);","highlight_start":1,"highlight_end":38},{"text":"        vstd::bits::lemma_u128_shr_is_div(value, shift as u128);","highlight_start":1,"highlight_end":65},{"text":"        lemma_fundamental_div_mod(value as int, pow2(shift as nat) as int);","highlight_start":1,"highlight_end":76},{"text":"        assert(odd * pow2(shift as nat) <= value) by (nonlinear_arith)","highlight_start":1,"highlight_end":71},{"text":"            requires odd == value as nat / pow2(shift as nat),","highlight_start":1,"highlight_end":63},{"text":"                value == pow2(shift as nat) * (value as nat / pow2(shift as nat))","highlight_start":1,"highlight_end":82},{"text":"                    + value as nat % pow2(shift as nat),","highlight_start":1,"highlight_end":57},{"text":"               