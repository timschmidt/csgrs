","highlight_start":1,"highlight_end":29},{"text":"    ensures","highlight_start":1,"highlight_end":12},{"text":"        (((low >> shift) | (high << (64 - shift))) as nat) * pow2(shift as nat)","highlight_start":1,"highlight_end":80},{"text":"            + (low as nat) % pow2(shift as nat)","highlight_start":1,"highlight_end":48},{"text":"            == low as nat + ((high as nat) % pow2(shift as nat)) * radix(),","highlight_start":1,"highlight_end":76},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    let factor = pow2(shift as nat);","highlight_start":1,"highlight_end":37},{"text":"    let other = pow2((64 - shift) as nat);","highlight_start":1,"highlight_end":43},{"text":"    lemma2_to64();","highlight_start":1,"highlight_end":19},{"text":"    lemma_pow2_pos(shift as nat);","highlight_start":1,"highlight_end":34},{"text":"    lemma_pow2_pos((64 - shift) as nat);","highlight_start":1,"highlight_end":41},{"text":"    lemma_pow2_adds(shift as nat, (64 - shift) as nat);","highlight_start":1,"highlight_end":56},{"text":"    vstd::bits::lemma_u64_pow2_no_overflow(shift as nat);","highlight_start":1,"highlight_end":58},{"text":"    super::word::one_shift_is_power_of_two(shift);","highlight_start":1,"highlight_end":51},{"text":"    assert((1u64 << shift) as u128 == (1u128 << shift)) by (bit_vector)","highlight_start":1,"highlight_end":72},{"text":"        requires shift < 64;","highlight_start":1,"highlight_end":29},{"text":"    vstd::bits::lemma_u64_low_bits_mask_is_mod(high, shift as nat);","highlight_start":1,"highlight_end":68},{"text":"    let bottom = high & ((factor - 1) as u64);","highlight_start":1,"highlight_end":47},{"text":"    assert(bottom == (high as nat) % factor);","highlight_start":1,"highlight_end":46},{"text":"    assert(bottom * other <= u64::MAX) by (nonlinear_arith)","highlight_start":1,"highlight_end":60},{"text":"        requires 0 <= bottom < factor, other > 0, factor * other == radix();","highlight_start":1,"highlight_end":77},{"text":"    vstd::bits::lemma_u64_shl_is_mul(bottom, (64 - shift) as u64);","highlight_start":1,"highlight_end":67},{"text":"    assert(high << ((64 - shift) as u32) == bottom << ((64 - shift) as u32)) by (bit_vector)","highlight_start":1,"highlight_end":93},{"text":"        requires 0 < shift < 64, bottom == high & (((1u64 << shift) - 1) as u64);","highlight_start":1,"highlight_end":82},{"text":"    vstd::bits::lemma_u64_shr_is_div(low, shift as u64);","highlight_start":1,"highlight_end":57},{"text":"    lemma_fundamental_div_mod(low as int, factor as int);","highlight_start":1,"highlight_end":58},{"text":"    let result = (low >> shift) | (high << ((64 - shift) as u32));","highlight_start":1,"highlight_end":67},{"text":"    assert(result as u128 == (low >> shift) as u128 + (high << ((64 - shift) as u32)) as u128)","highlight_start":1,"highlight_end":95},{"text":"        by (bit_vector)","highlight_start":1,"highlight_end":24},{"text":"        requires 0 < shift < 64,","highlight_start":1,"highlight_end":33},{"text":"            result == (low >> shift) | (high << ((64 - shift) as u32));","highlight_start":1,"highlight_end":72},{"text":"    assert(result * factor + (low as nat) % factor","highlight_start":1,"highlight_end":51},{"text":"        == low + ((high as nat) % factor) * radix()) by (nonlinear_arith)","highlight_start":1,"highlight_end":74},{"text":"        requires result == (low as nat) / factor + bottom * other,","highlight_start":1,"highlight_end":67},{"text":"            low == factor * ((low as nat) / factor) + (low as nat) % factor,","highlight_start":1,"highlight_end":77},{"text":"            bottom == (high as nat) % factor, factor * other == radix();","highlight_start":1,"highlight_end":73},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"pub(crate) proof fn extend_prefix_zero(words: Seq<u64>, start: int, end: int)","highlight_start":1,"highlight_end":78},{"text":"    requires 0 <= start <