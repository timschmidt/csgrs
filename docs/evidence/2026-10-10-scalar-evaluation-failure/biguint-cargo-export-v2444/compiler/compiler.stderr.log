tart":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"proof fn first_nonzero_factor(words: Seq<u64>, index: int)","highlight_start":1,"highlight_end":59},{"text":"    requires 0 <= index < words.len(), words[index] > 0,","highlight_start":1,"highlight_end":57},{"text":"        forall|lower: int| 0 <= lower < index ==> #[trigger] words[lower] == 0,","highlight_start":1,"highlight_end":80},{"text":"    ensures ({","highlight_start":1,"highlight_end":15},{"text":"        let shift = 64 * index as nat + u64_trailing_zeros(words[index]) as nat;","highlight_start":1,"highlight_end":81},{"text":"        shift < 64 * words.len()","highlight_start":1,"highlight_end":33},{"text":"            && value(words) / pow2(shift) > 0","highlight_start":1,"highlight_end":46},{"text":"            && (value(words) / pow2(shift)) % 2 == 1","highlight_start":1,"highlight_end":53},{"text":"            && value(words) == (value(words) / pow2(shift)) * pow2(shift)","highlight_start":1,"highlight_end":74},{"text":"    }),","highlight_start":1,"highlight_end":8},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    prefix_zero(words, index);","highlight_start":1,"highlight_end":31},{"text":"    prefix_split(words, index + 1, words.len() as int);","highlight_start":1,"highlight_end":56},{"text":"    weight_step(index as nat);","highlight_start":1,"highlight_end":31},{"text":"    let word = words[index];","highlight_start":1,"highlight_end":29},{"text":"    super::gcd::trailing_zeros_factor_u64(word);","highlight_start":1,"highlight_end":49},{"text":"    let shift = u64_trailing_zeros(word) as nat;","highlight_start":1,"highlight_end":49},{"text":"    let odd = (word >> u64_trailing_zeros(word)) as nat;","highlight_start":1,"highlight_end":57},{"text":"    let upper = value(words.subrange(index + 1, words.len() as int));","highlight_start":1,"highlight_end":70},{"text":"    let other = pow2((64 - shift) as nat);","highlight_start":1,"highlight_end":43},{"