end":1},{"text":"proof fn extend_prefix_less(left: Seq<u64>, right: Seq<u64>, start: int, end: int)","highlight_start":1,"highlight_end":83},{"text":"    requires 0 <= start <= end <= left.len(), left.len() == right.len(),","highlight_start":1,"highlight_end":73},{"text":"        prefix(left, start) < prefix(right, start),","highlight_start":1,"highlight_end":52},{"text":"        forall|index: int| start <= index < end ==> #[trigger] left[index] == right[index],","highlight_start":1,"highlight_end":92},{"text":"    ensures prefix(left, end) < prefix(right, end),","highlight_start":1,"highlight_end":52},{"text":"    decreases end - start,","highlight_start":1,"highlight_end":27},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    if start < end {","highlight_start":1,"highlight_end":21},{"text":"        extend_prefix_less(left, right, start, end - 1);","highlight_start":1,"highlight_end":57},{"text":"    }","highlight_start":1,"highlight_end":6},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"pub(crate) proof fn prefix_split(words: Seq<u64>, start: int, end: int)","highlight_start":1,"highlight_end":72},{"text":"    requires 0 <= start <= end <= words.len(),","highlight_start":1,"highlight_end":47},{"text":"    ensures prefix(words, end) == prefix(words, start)","highlight_start":1,"highlight_end":55},{"text":"        + weight(start as nat) * value(words.subrange(start, end)),","highlight_start":1,"highlight_end":68},{"text":"    decreases end - start,","highlight_start":1,"highlight_end":27},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    if start == end {","highlight_start":1,"highlight_end":22},{"text":"        assert(value(words.subrange(start, end)) == 0);","highlight_start":1,"highlight_end":56},{"text":"        assert(weight(start as nat) * 0nat == 0) by (nonlinear_arith);","highlight_start":1,"highlight_end":71},{"text":"    } else {","highlight_start":1,"highlight_end":13},{"text":"        prefix_split(words, start, end - 1);","highlight_start":1,"highlight_end":45},{"text":"        let tail = words.subrange(start, end);","highlight_start":1,"highlight_end":47},{"text":"        let previous = words.subrange(start, end - 1);","highlight_start":1,"highlight_end":55},{"text":"        prefix_equal(tail, previous, end - start - 1);","highlight_start":1,"highlight_end":55},{"text":"        weight_add(start as nat, (end - start - 1) as nat);","highlight_start":1,"highlight_end":60},{"text":"        assert(prefix(words, end) == prefix(words, start)","highlight_start":1,"highlight_end":58},{"text":"            + weight(start as nat) * value(tail)) by (nonlinear_arith)","highlight_start":1,"highlight_end":71},{"text":"            requires","highlight_start":1,"highlight_end":21},{"text":"                prefix(words, end) == prefix(words, end - 1)","highlight_start":1,"highlight_end":61},{"text":"                    + words[end - 1] * weight((end - 1) as nat),","highlight_start":1,"highlight_end":65},{"text":"                prefix(words, end - 1) == prefix(words, start)","highlight_start":1,"highlight_end":63},{"text":"                    + weight(start as nat) * value(previous),","highlight_start":1,"highlight_end":62},{"text":"                value(tail) == value(previous)","highlight_start":1,"highlight_end":47},{"text":"                    + words[end - 1] * weight((end - start - 1) as nat),","highlight_start":1,"highlight_end":73},{"text":"                weight((end - 1) as nat)","highlight_start":1,"highlight_end":41},{"text":"                    == weight(start as nat) * weight((end - start - 1) as nat);","highlight_start":1,"highlight_end":80},{"text":"    }","highlight_start":1,"highlight_end":6},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"pub(crate) proof fn prefix_zero(words: Seq<u64>, length: int)","highlight_start":1,"highlight_end":62},{"text":"    requires 0 