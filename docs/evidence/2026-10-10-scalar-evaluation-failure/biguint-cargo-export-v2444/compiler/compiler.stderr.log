) == 1 && binary_numerator(exponent - 1) == 1","highlight_start":1,"highlight_end":101},{"text":"                && binary_denominator(exponent - 1) == 2 * binary_denominator(exponent);","highlight_start":1,"highlight_end":89},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"/// Aligned bit lengths bound the ratio strictly between one half and two.","highlight_start":1,"highlight_end":75},{"text":"proof fn aligned_bit_length_bounds(numerator: nat, denominator: nat, numerator_bits: nat, denominator_bits: nat)","highlight_start":1,"highlight_end":113},{"text":"    requires has_bit_length(numerator, numerator_bits), has_bit_length(denominator, denominator_bits),","highlight_start":1,"highlight_end":103},{"text":"    ensures numerator > 0, denominator > 0,","highlight_start":1,"highlight_end":44},{"text":"        ({let e = numerator_bits as int - denominator_bits as int;","highlight_start":1,"highlight_end":67},{"text":"            &&& binary_numerator(e) * denominator < 2 * numerator * binary_denominator(e)","highlight_start":1,"highlight_end":90},{"text":"            &&& numerator * binary_denominator(e) < 2 * binary_numerator(e) * denominator}),","highlight_start":1,"highlight_end":93},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    vstd::arithmetic::power::lemma_pow0(2);","highlight_start":1,"highlight_end":44},{"text":"    lemma_pow2_pos((numerator_bits - 1) as nat);","highlight_start":1,"highlight_end":49},{"text":"    lemma_pow2_pos((denominator_bits - 1) as nat);","highlight_start":1,"highlight_end":51},{"text":"    lemma_pow2_unfold(numerator_bits);","highlight_start":1,"highlight_end":39},{"text":"    lemma_pow2_unfold(denominator_bits);","highlight_start":1,"highlight_end":41},{"text":"    let low_n = pow2((numerator_bits - 1) as nat);","highlight_start":1,"highlight_end":51},{"text":"    let low_d = pow2((denominator_bits - 1) as nat);","highlight_start":1,"highlight_end":53},{"text":"    if numerator_bits >= denominator_bits {","highlight_start":1,"highlight_end":44},{"text":"        let shift = (numerator_bits - denominator_bits) as nat;","highlight_start":1,"highlight_end":64},{"text":"        lemma_pow2_pos(shift);","highlight_start":1,"highlight_end":31},{"text":"        lemma_pow2_adds((denominator_bits - 1) as nat, shift);","highlight_start":1,"highlight_end":63},{"text":"        assert(low_n == low_d * pow2(shift));","highlight_start":1,"highlight_end":46},{"text":"        assert(pow2(shift) * denominator < 2 * numerator","highlight_start":1,"highlight_end":57},{"text":"            && numerator < 2 * pow2(shift) * denominator) by (nonlinear_arith)","highlight_start":1,"highlight_end":79},{"text":"            requires low_d > 0, pow2(shift) > 0, low_n == low_d * pow2(shift),","highlight_start":1,"highlight_end":79},{"text":"                low_n <= numerator, numerator < 2 * low_n,","highlight_start":1,"highlight_end":59},{"text":"                low_d <= denominator, denominator < 2 * low_d;","highlight_start":1,"highlight_end":63},{"text":"    } else {","highlight_start":1,"highlight_end":13},{"text":"        let shift = (denominator_bits - numerator_bits) as nat;","highlight_start":1,"highlight_end":64},{"text":"        lemma_pow2_pos(shift);","highlight_start":1,"highlight_end":31},{"text":"        lemma_pow2_adds((numerator_bits - 1) as nat, shift);","highlight_start":1,"highlight_end":61},{"text":"        assert(low_d == low_n * pow2(shift));","highlight_start":1,"highlight_end":46},{"text":"        assert(denominator < 2 * numerator * pow2(shift)","highlight_start":1,"highlight_end":57},{"text":"            && numerator * pow2(shift) < 2 * denominator) by (nonlinear_arith)","highlight_start":1,"highlight_end":79},{"text":"            requires low_n > 0, pow2(shift) > 0, low_d == low_n * pow2(shift),","highlight_start":1,"highlight_end":79},{"text":"                low_n <= numerator, numerator < 2 * low_n,","highlight_start":1,"highlight_end":59},{"text":"                low_d <= denominator, denominator < 2 * low_d;","highlight_start":1,"highlight_end":63},{"text":"    }","highlight_start":1,"highlight_end":6},{"text":"    let e = numerator_bits as int - denominator_bits as int;","highlight_start":1,"highlight_end":61},{"text":"    if numerator_bits >= denominator_bits {","highlight_start":1,"highlight_end":44},{"text":"        let shift = (numerator_bits - denominator_bits) as nat;","highlight_start":1,"highlight_end":64},{"text":"        assert(binary_numerator(e) == pow2(shift));","highlight_start":1,"highlight_end":52},{"text":"        assert(binary_denominator(e) == 1);","highlight_start":1,"highlight_end":44},{"text":"        assert(binary_numerator(e) * denominator < 2 * numerator * binary_denominator(e)","highlight_start":1,"highlight_end":89},{"text":"            && numerator * binary_denominator(e) < 2 * binary_numerator(e) * denominator) by (nonlinear_arith)","highlight_start":1,"highlight_end":111},{"text":"            requires binary_numerator(e) == pow2(shift), binary_denominator(e) == 1,","highlight_start":1,"highlight_end":85},{"text":"                pow2(shift) * denominator < 2 * numerator,","highlight_start":1,"highlight_end":59},{"text":"                numerator < 2 * pow2(shift) * denominator;","highlight_start":1,"highlight_end":59},{"text":"    } else {","highlight_start":1,"highlight_end":13},{"text":"        let shift = (denominator_bits - numerator_bits) as nat;","highlight_start":1,"highlight_end":64},{"text":"        assert(binary_numerator(e) == 1);","highlight_start":1,"highlight_end":42},{"text":"        assert(binary_denominator(e) == pow2(shift));","highlight_start":1,"highlight_end":54},{"text":"        assert(binary_numerator(e) * denominator < 2 * numerator * binary_denominator(e)","highlight_start":1,"highlight_end":89},{"text":"            && numerator * binary_denominator(e) < 2 * binary_numerator(e) * denominator) by (nonlinear_arith)","highlight_start":1,"highlight_end":111},{"text":"            requires binary_numerator(e) == 1, binary_denominator(e) == pow2(shift),","highlight_start":1,"highlight_end":85},{"text":"                denominator < 2 * numerator * pow2(shift),","highlight_start":1,"highlight_end":59},{"text":"                numerator * pow2(shift) < 2 * denominator;","highlight_start":1,"highlight_end":59},{"text":"    }","highlight_start":1,"highlight_end":6},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"/// The one-comparison correction returns the exact floor binary exponent.","highlight_start":1,"highlight_end":75},{"text":"/// Equality of the aligned operands certifies precisely a binary scale,","highlight_start":1,"highlight_end":73},{"text":"/// including unreduced numerator and denominator pairs.","highlight_start":1,"highlight_end":57},{"text":"pub proof fn bit_lengths_determine_binade(numerator: nat, denominator: nat, numerator_bits: nat, denominator_bits: nat)","highlight_start":1,"highlight_end":120},{"text":"    requires has_bit_length(numerator, numerator_bits), has_bit_length(denominator, denominator_bits),","highlight_start":1,"highlight_end":103},{"text":"    ensures","highlight_start":1,"highlight_end":12},{"text":"        in_binade(numerator, denominator, aligned_msd(numerator, denominator, numerator_bits, denominator_bits)),","highlight_start":1,"highlight_end":114},{"text":"        (is_binary_scale(numerator, denominator, aligned_msd(numerator, denominator, numerator_bits, denominator_bits))","highlight_start":1,"highlight_end":120},{"text":"            <==> numerator * binary_denominator(numerator_bits as int - denominator_bits as int)","highlight_start":1,"highlight_end":97},{"text":"                == binary_numerator(numerator_bits as int - denominator_bits as int) * denominator),","highlight_start":1,"highlight_end":101},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    aligned_bit_length_bounds(numerator, denominator, numerator_bits, denominator_bits);","highlight_start":1,"highlight_end":89},{"text":"    let difference = numerator_bits as int - denominator_bits as int;","highlight_start":1,"highlight_end":70},{"text":"    binary_positive(difference);","highlight_start":1,"highlight_end":33},{"text":"    if below_aligned(numerator, denominator, numerator_bits, denominator_bits) {","highlight_start":1,"highlight_end":81},{"text":"        binary_positive(difference - 1);","highlight_start":1,"highlight_end":41},{"text":"        binary_step(difference);","highlight_start":1,"highlight_end":33},{"text":"        let a = binary_numerator(difference);","highlight_start":1,"highlight_end":46},{"text":"        let b = binary_denominator(difference);","highlight_start":1,"highlight_end":48},{"text":"        let previous_a = binary_numerator(difference - 1);","highlight_start":1,"highlight_end":59},{"text":"        let previous_b = binary_denominator(difference - 1);","highlight_start":1,"highlight_end":61},{"text":"        assert(previous_a * denominator < numerator * previous_b","highlight_start":1,"highlight_end":65},{"text":"            && numerator * previous_b < 2 * previous_a * denominator) by (nonlinear_arith)","highlight_start":1,"highlight_end":91},{"text":"            requires a > 0, b > 0, previous_a > 0, previous_b > 0,","highlight_start":1,"highlight_end":67},{"text":"                a * previous_b == 2 * previous_a * b,","highlight_start":1,"highlight_end":54},{"text":"                a * denominator < 2 * numerator * b, numerator * b < a * denominator;","highlight_start":1,"highlight_end":86},{"text":"    }","highlight_start":1,"highlight_end":6},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"/// Signed binary scales compose for arbitrary integer exponents.","highlight_start":1,"highlight_end":66},{"text":"pub proof fn binary_scales_compose(left: int, right: int)","highlight_start":1,"highlight_end":58},{"text":"    ensures binary_numerator(left + right) * (binary_denominator(left) * binary_denominator(right))","highlight_start":1,"highlight_end":100},{"text":"        == (binary_numerator(left) * binary_numerator(right)) * binary_denominator(left + right),","highlight_start":1,"highlight_end":98},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    let lp = if left >= 0 { left as nat } else { 0 };","highlight_start":1,"highlight_end":54},{"text":"    let ln = if left < 0 { (-left) as nat } else { 0 };","highlight_start":1,"highlight_end":56},{"text":"    let rp = if right >= 0 { right as nat } else { 0 };","highlight_start":1,"highlight_end":56},{"text":"    let rn = if right < 0 { (-right) as nat } else { 0 };","highlight_start":1,"highlight_end":58},{"text":"    let sp = if left + right >= 0 { (left + right) as nat } else { 0 };","highlight_start":1,"highlight_end":72},{"text":"    let sn = if left + right < 0 { (-left - right) as nat } else { 0 };","highlight_start":1,"highlight_end":72},{"text":"    assert(sp + ln + rn == lp + rp + sn);","highlight_start":1,"highlight_end":42},{"text":"    lemma_pow2_adds(ln, rn);","highlight_start":1,"highlight_end":29},{"text":"    lemma_pow2_adds(sp, ln + rn);","highlight_start":1,"highlight_end":34},{"text":"    lemma_pow2_adds(lp, rp);","highlight_start":1,"highlight_end":29},{"text":"    lemma_pow2_adds(lp + rp, sn);","highlight_start":1,"highlight_end":34},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"/// Binary scaling moves a binade by exactly the signed scale exponent.","highlight_start":1,"highlight_end":72},{"text":"pub proof fn binary_scale_preserves_binade(numerator: nat, denominator: nat, exponent: int, offset: int)","highlight_start":1,"highlight_end":105},{"text":"    requires in_binade(numerator, denominator, exponent),","highlight_start":1,"highlight_end":58},{"text":"    ensures in_binade(numerator * binary_numerator(offset), denominator * binary_denominator(offset), exponent + offset),","highlight_start":1,"highlight_end":122},{"text":"        (is_binary_scale(numerator, denominator, exponent)","highlight_start":1,"highlight_end":59},{"text":"            <==> is_binary_scale(numerator * binary_numerator(offset), denominator * binary_denominator(offset), exponent + offset)),","highlight_start":1,"highlight_end":134},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    binary_positive(exponent);","highlight_start":1,"highlight_end":31},{"text":"    binary_positive(offset);","highlight_start":1,"highlight_end":29},{"text":"    binary_positive(exponent + offset);","highlight_start":1,"highlight_end":40},{"text":"    binary_scales_compose(exponent, offset);","highlight_start":1,"highlight_end":45},{"text":"    let a = binary_numerator(exponent);","highlight_start":1,"highlight_end":40},{"text":"    let b = binary_denominator(exponent);","highlight_start":1,"highlight_end":42},{"text":"    let c = binary_numerator(offset);","highlight_start":1,"highlight_end":38},{"text":"    let d = binary_denominator(offset);","highlight_start":1,"highlight_end":40},{"text":"    let p = binary_numerator(exponent + offset);","highlight_start":1,"highlight_end":49},{"text":"    let q = binary_denominator(exponent + offset);","highlight_start":1,"highlight_end":51},{"text":"    assert(denominator * d > 0) by (nonlinear_arith) requires denominator > 0, d > 0;","highlight_start":1,"highlight_end":86},{"text":"    assert(p * (denominator * d) <= (numerator * c) * q","highlight_start":1,"highlight_end":56},{"text":"        && (numerator * c) * q < 2 * p * (denominator * d)) by (nonlinear_arith)","highlight_start":1,"highlight_end":81},{"text":"        requires a > 0, b > 0, c > 0, d > 0, p > 0, q > 0,","highlight_start":1,"highlight_end":59},{"text":"            p * (b * d) == (a * c) * q,","highlight_start":1,"highlight_end":40},{"text":"            a * denominator <= numerator * b, numerator * b < 2 * a * denominator;","highlight_start":1,"highlight_end":83},{"text":"    assert((numerator * b == a * denominator)","highlight_start":1,"highlight_end":46},{"text":"        <==> (numerator * c) * q == p * (denominator * d)) by (nonlinear_arith)","highlight_start":1,"highlight_end":80},{"text":"        requires a > 0, b > 0, c > 0, d > 0, p > 0, q > 0,","highlight_start":1,"highlight_end":59},{"text":"            p * (b * d) == (a * c) * q;","highlight_start":1,"highlight_end":40},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"","highlight_start":1,"highlight_end":1},{"text":"proof fn separated_binary_scales(left: int, right: int)","highlight_start":1,"highlight_end":56},{"text":"    requires left < right,","highlight_start":1,"highlight_end":27},{"text":"    ensures 2 * binary_numerator(left) * binary_denominator(right)","highlight_start":1,"highlight_end":67},{"text":"        <= binary_numerator(right) * binary_denominator(left),","highlight_start":1,"highlight_end":63},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    let lp = if left >= 0 { left as nat } else { 0 };","highlight_start":1,"highlight_end":54},{"text":"    let ln = if left < 0 { (-left) as nat } else { 0 };","highlight_start":1,"highlight_end":56},{"text":"    let rp = if right >= 0 { right as nat } else { 0 };","highlight_start":1,"highlight_end":56},{"text":"    let rn = if right < 0 { (-right) as nat } else { 0 };","highlight_start":1,"highlight_end":58},{"text":"    assert(lp + rn + 1 <= rp + ln);","highlight_start":1,"highlight_end":36},{"text":"    lemma_pow2_adds(lp, rn);","highlight_start":1,"highlight_end":29},{"text":"    lemma_pow2_adds(rp, ln);","highlight_start":1,"highlight_end":29},{"text":"    lemma_pow2_unfold(lp + rn + 1);","highlight_start":1,"highlight_end":36},{"text":"    if lp + rn + 1 < rp + ln {","highlight_start":1,"highlight_end":31},{"text":"        lemma_pow2_strictly_increases(lp + rn + 1, rp + ln);","highlight_start":1,"highlight_end":61},{"text":"    }","highlight_start":1,"highlight_end":6},{"text":"    assert(2 * binary_numerator(left) * binary_denominator(right)","highlight_start":1,"highlight_end":66},{"text":"        <= binary_numerator(right) * binary_denominator(left)) by (nonlinear_arith)","highlight_start":1,"highlight_end":84},{"text":"        requires pow2(lp + rn + 1) == 2 * pow2(lp + rn),","highlight_start":1,"highlight_end":57},{"text":"            pow2(lp + rn + 1) <= pow2(rp + ln),","highlight_start":1,"highlight_end":48},{"text":"            pow2(lp + rn) == binary_numerator(left) * binary_denominator(right),","highlight_start":1,"highlight_end":81},{"text":"            pow2(rp + ln) == binary_numerator(right) * binary_denominator(left);","highlight_start":1,"highlight_end":81},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"/// Disjoint adjacent power-of-two intervals make the floor exponent unique.","highlight_start":1,"highlight_end":77},{"text":"pub proof fn binade_is_unique(numerator: nat, denominator: nat, left: int, right: int)","highlight_start":1,"highlight_end":87},{"text":"    requires in_binade(numerator, denominator, left), in_binade(numerator, denominator, right),","highlight_start":1,"highlight_end":96},{"text":"    ensures left == right,","highlight_start":1,"highlight_end":27},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    binary_positive(left);","highlight_start":1,"highlight_end":27},{"text":"    binary_positive(right);","highlight_start":1,"highlight_end":28},{"text":"    if left != right {","highlight_start":1,"highlight_end":23},{"text":"        let smaller = if left < right { left } else { right };","highlight_start":1,"highlight_end":63},{"text":"        let larger = if left < right { right } else { left };","highlight_start":1,"highlight_end":62},{"text":"        separated_binary_scales(smaller, larger);","highlight_start":1,"highlight_end":50},{"text":"        let a = binary_numerator(smaller);","highlight_start":1,"highlight_end":43},{"text":"        let b = binary_denominator(smaller);","highlight_start":1,"highlight_end":45},{"text":"        let c = binary_numerator(larger);","highlight_start":1,"highlight_end":42},{"text":"        let d = binary_denominator(larger);","highlight_start":1,"highlight_end":44},{"text":"        assert(false) by (nonlinear_arith)","highlight_start":1,"highlight_end":43},{"text":"            requires denominator > 0, b > 0, d > 0,","highlight_start":1,"highlight_end":52},{"text":"                2 * a * d <= c * b,","highlight_start":1,"highlight_end":36},{"text":"                numerator * b < 2 * a * denominator,","highlight_start":1,"highlight_end":53},{"text":"                c * denominator <= numerator * d;","highlight_start":1,"highlight_end":50},{"text":"    }","highlight_start":1,"highlight_end":6},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"/// Connect the executable helper's shared exponent specification to the","highlight_start":1,"highlight_end":73},{"text":"/// rational interval. The BigUint caller must still prove the two bit lengths","highlight_start":1,"highlight_end":79},{"text":"/// and the meaning of its borrowed shifted comparison.","highlight_start":1,"highlight_end":56},{"text":"pub(crate) proof fn checked_exponent_denotes_scaled_binade(","highlight_start":1,"highlight_end":60},{"text":"    numerator: nat, denominator: nat, numerator_bits: u64, denominator_bits: u64,","highlight_start":1,"highlight_end":82},{"text":"    below: bool, offset: i32,","highlight_start":1,"highlight_end":30},{"text":")","highlight_start":1,"highlight_end":2},{"text":"    requires has_bit_length(numerator, numerator_bits as nat),","highlight_start":1,"highlight_end":63},{"text":"        has_bit_length(denominator, denominator_bits as nat),","highlight_start":1,"highlight_end":62},{"text":"        below == below_aligned(numerator, denominator, numerator_bits as nat, denominator_bits as nat),","highlight_start":1,"highlight_end":104},{"text":"    ensures in_binade(numerator * binary_numerator(offset as int), denominator * binary_denominator(offset as int),","highlight_start":1,"highlight_end":116},{"text":"        crate::verified::word::bit_length_msd(numerator_bits, denominator_bits, below, offset)),","highlight_start":1,"highlight_end":97},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    bit_lengths_determine_binade(numerator, denominator, numerator_bits as nat, denominator_bits as nat);","highlight_start":1,"highlight_end":106},{"text":"    let exponent = aligned_msd(numerator, denominator, numerator_bits as nat, denominator_bits as nat);","highlight_start":1,"highlight_end":104},{"text":"    binary_scale_preserves_binade(numerator, denominator, exponent, offset as int);","highlight_start":1,"highlight_end":84},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"} // verus!","highlight_start":1,"highlight_end":2}],"label":null,"suggested_replacement":null,"suggestion_applicability":null,"expansion":{"span":{"file_name":"/home/tim/Documents/GitHub/workspace/csgrs/target/scalar-evaluation-candidate/source/crates/hyperreal/verification/magnitude_model.rs","byte_start":312,"byte_end":13800,"line_start":6,"line_end":269,"column_start":1,"column_end":2,"is_primary":false,"text":[{"text":"verus! {","highlight_start":1,"highlight_end":9},{"text":"","highlight_start":1,"highlight_end":1},{"text":"pub open spec fn binary_numerator(exponent: int) -> nat {","highlight_start":1,"highlight_end":58},{"text":"    pow2(if exponent >= 0 { exponent as nat } else { 0 })","highlight_start":1,"highlight_end":58},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"pub open spec fn binary_denominator(exponent: int) -> nat {","highlight_start":1,"highlight_end":60},{"text":"    pow2(if exponent < 0 { (-exponent) as nat } else { 0 })","highlight_start":1,"highlight_end":60},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"pub open spec fn has_bit_length(value: nat, bits: nat) -> bool {","highlight_start":1,"highlight_end":65},{"text":"    bits > 0 && pow2((bits - 1) as nat) <= value && value < pow2(bits)","highlight_start":1,"highlight_end":71},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"pub open spec fn in_binade(numerator: nat, denominator: nat, exponent: int) -> bool {","highlight_start":1,"highlight_end":86},{"text":"    denominator > 0","highlight_start":1,"highlight_end":20},{"text":"        && binary_numerator(exponent) * denominator <= numerator * binary_denominator(exponent)","highlight_start":1,"highlight_end":96},{"text":"        && numerator * binary_denominator(exponent) < 2 * binary_numerator(exponent) * denominator","highlight_start":1,"highlight_end":99},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"pub open spec fn is_binary_scale(numerator: nat, denominator: nat, exponent: int) -> bool {","highlight_start":1,"highlight_end":92},{"text":"    denominator > 0","highlight_start":1,"highlight_end":20},{"text":"        && numerator * binary_denominator(exponent) == binary_numerator(exponent) * denominator","highlight_start":1,"highlight_end":96},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"pub open spec fn below_aligned(numerator: nat, denominator: nat, numerator_bits: nat, denominator_bits: nat) -> bool {","highlight_start":1,"highlight_end":119},{"text":"    let difference = numerator_bits as int - denominator_bits as int;","highlight_start":1,"highlight_end":70},{"text":"    numerator * binary_denominator(difference) < binary_numerator(difference) * denominator","highlight_start":1,"highlight_end":92},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"pub open spec fn aligned_msd(numerator: nat, denominator: nat, numerator_bits: nat, denominator_bits: nat) -> int {","highlight_start":1,"highlight_end":116},{"text":"    numerator_bits as int - denominator_bits as int","highlight_start":1,"highlight_end":52},{"text":"        - if below_aligned(numerator, denominator, numerator_bits, denominator_bits) { 1int } else { 0int }","highlight_start":1,"highlight_end":108},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"proof fn binary_positive(exponent: int)","highlight_start":1,"highlight_end":40},{"text":"    ensures binary_numerator(exponent) > 0, binary_denominator(exponent) > 0,","highlight_start":1,"highlight_end":78},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    lemma_pow2_pos(if exponent >= 0 { exponent as nat } else { 0 });","highlight_start":1,"highlight_end":69},{"text":"    lemma_pow2_pos(if exponent < 0 { (-exponent) as nat } else { 0 });","highlight_start":1,"highlight_end":71},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"proof fn binary_step(exponent: int)","highlight_start":1,"highlight_end":36},{"text":"    ensures binary_numerator(exponent) * binary_denominator(exponent - 1)","highlight_start":1,"highlight_end":74},{"text":"        == 2 * binary_numerator(exponent - 1) * binary_denominator(exponent),","highlight_start":1,"highlight_end":78},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    vstd::arithmetic::power::lemma_pow0(2);","highlight_start":1,"highlight_end":44},{"text":"    if exponent > 0 {","highlight_start":1,"highlight_end":22},{"text":"        lemma_pow2_unfold(exponent as nat);","highlight_start":1,"highlight_end":44},{"text":"    } else if exponent == 0 {","highlight_start":1,"highlight_end":30},{"text":"        lemma_pow2_unfold(1);","highlight_start":1,"highlight_end":30},{"text":"    } else {","highlight_start":1,"highlight_end":13},{"text":"        lemma_pow2_unfold((1 - exponent) as nat);","highlight_start":1,"highlight_end":50},{"text":"    }","highlight_start":1,"highlight_end":6},{"text":"    assert(binary_numerator(exponent) * binary_denominator(exponent - 1)","highlight_start":1,"highlight_end":73},{"text":"        == 2 * binary_numerator(exponent - 1) * binary_denominator(exponent)) by (nonlinear_arith)","highlight_start":1,"highlight_end":99},{"text":"        requires pow2(0) == 1,","highlight_start":1,"highlight_end":31},{"text":"            exponent > 0 ==> binary_denominator(exponent) == 1 && binary_denominator(exponent - 1) == 1","highlight_start":1,"highlight_end":104},{"text":"                && binary_numerator(exponent) == 2 * binary_numerator(exponent - 1),","highlight_start":1,"highlight_end":85},{"text":"            exponent <= 0 ==> binary_numerator(exponent) == 1 && binary_numerator(exponent - 1) == 1","highlight_start":1,"highlight_end":101},{"text":"                && binary_denominator(exponent - 1) == 2 * binary_denominator(exponent);","highlight_start":1,"highlight_end":89},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"/// Aligned bit lengths bound the ratio strictly between one half and two.","highlight_start":1,"highlight_end":75},{"text":"proof fn aligned_bit_length_bounds(numerator: nat, denominator: nat, numerator_bits: nat, denominator_bits: nat)","highlight_start":1,"highlight_end":113},{"text":"    requires has_bit_length(numerator, numerator_bits), has_bit_length(denominator, denominator_bits),","highlight_start":1,"highlight_end":103},{"text":"    ensures numerator > 0, denominator > 0,","highlight_start":1,"highlight_end":44},{"text":"        ({let e = numerator_bits as int - denominator_bits as int;","highlight_start":1,"highlight_end":67},{"text":"            &&& binary_numerator(e) * denominator < 2 * numerator * binary_denominator(e)","highlight_start":1,"highlight_end":90},{"text":"            &&& numerator * binary_denominator(e) < 2 * binary_numerator(e) * denominator}),","highlight_start":1,"highlight_end":93},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    vstd::arithmetic::power::lemma_pow0(2);","highlight_start":1,"highlight_end":44},{"text":"    lemma_pow2_pos((numerator_bits - 1) as nat);","highlight_start":1,"highlight_end":49},{"text":"    lemma_pow2_pos((denominator_bits - 1) as nat);","highlight_start":1,"highlight_end":51},{"text":"    lemma_pow2_unfold(numerator_bits);","highlight_start":1,"highlight_end":39},{"text":"    lemma_pow2_unfold(denominator_bits);","highlight_start":1,"highlight_end":41},{"text":"    let low_n = pow2((numerator_bits - 1) as nat);","highlight_start":1,"highlight_end":51},{"text":"    let low_d = pow2((denominator_bits - 1) as nat);","highlight_start":1,"highlight_end":53},{"text":"    if numerator_bits >= denominator_bits {","highlight_start":1,"highlight_end":44},{"text":"        let shift = (numerator_bits - denominator_bits) as nat;","highlight_start":1,"highlight_end":64},{"text":"        lemma_pow2_pos(shift);","highlight_start":1,"highlight_end":31},{"text":"        lemma_pow2_adds((denominator_bits - 1) as nat, shift);","highlight_start":1,"highlight_end":63},{"text":"        assert(low_n == low_d * pow2(shift));","highlight_start":1,"highlight_end":46},{"text":"        assert(pow2(shift) * denominator < 2 * numerator","highlight_start":1,"highlight_end":57},{"text":"            && numerator < 2 * pow2(shift) * denominator) by (nonlinear_arith)","highlight_start":1,"highlight_end":79},{"text":"            requires low_d > 0, pow2(shift) > 0, low_n == low_d * pow2(shift),","highlight_start":1,"highlight_end":79},{"text":"                low_n <= numerator, numerator < 2 * low_n,","highlight_start":1,"highlight_end":59},{"text":"                low_d <= denominator, denominator < 2 * low_d;","highlight_start":1,"highlight_end":63},{"text":"    } else {","highlight_start":1,"highlight_end":13},{"text":"        let shift = (denominator_bits - numerator_bits) as nat;","highlight_start":1,"highlight_end":64},{"text":"        lemma_pow2_pos(shift);","highlight_start":1,"highlight_end":31},{"text":"        lemma_pow2_adds((numerator_bits - 1) as nat, shift);","highlight_start":1,"highlight_end":61},{"text":"        assert(low_d == low_n * pow2(shift));","highlight_start":1,"highlight_end":46},{"text":"        assert(denominator < 2 * numerator * pow2(shift)","highlight_start":1,"highlight_end":57},{"text":"            && numerator * pow2(shift) < 2 * denominator) by (nonlinear_arith)","highlight_start":1,"highlight_end":79},{"text":"            requires low_n > 0, pow2(shift) > 0, low_d == low_n * pow2(shift),","highlight_start":1,"highlight_end":79},{"text":"                low_n <= numerator, numerator < 2 * low_n,","highlight_start":1,"highlight_end":59},{"text":"                low_d <= denominator, denominator < 2 * low_d;","highlight_start":1,"highlight_end":63},{"text":"    }","highlight_start":1,"highlight_end":6},{"text":"    let e = numerator_bits as int - denominator_bits as int;","highlight_start":1,"highlight_end":61},{"text":"    if numerator_bits >= denominator_bits {","highlight_start":1,"highlight_end":44},{"text":"        let shift = (numerator_bits - denominator_bits) as nat;","highlight_start":1,"highlight_end":64},{"text":"        assert(binary_numerator(e) == pow2(shift));","highlight_start":1,"highlight_end":52},{"text":"        assert(binary_denominator(e) == 1);","highlight_start":1,"highlight_end":44},{"text":"        assert(binary_numerator(e) * denominator < 2 * numerator * binary_denominator(e)","highlight_start":1,"highlight_end":89},{"text":"            && numerator * binary_denominator(e) < 2 * binary_numerator(e) * denominator) by (nonlinear_arith)","highlight_start":1,"highlight_end":111},{"text":"            requires binary_numerator(e) == pow2(shift), binary_denominator(e) == 1,","highlight_start":1,"highlight_end":85},{"text":"                pow2(shift) * denominator < 2 * numerator,","highlight_start":1,"highlight_end":59},{"text":"                numerator < 2 * pow2(shift) * denominator;","highlight_start":1,"highlight_end":59},{"text":"    } else {","highlight_start":1,"highlight_end":13},{"text":"        let shift = (denominator_bits - numerator_bits) as nat;","highlight_start":1,"highlight_end":64},{"text":"        assert(binary_numerator(e) == 1);","highlight_start":1,"highlight_end":42},{"text":"        assert(binary_denominator(e) == pow2(shift));","highlight_start":1,"highlight_end":54},{"text":"        assert(binary_numerator(e) * denominator < 2 * numerator * binary_denominator(e)","highlight_start":1,"highlight_end":89},{"text":"            && numerator * binary_denominator(e) < 2 * binary_numerator(e) * denominator) by (nonlinear_arith)","highlight_start":1,"highlight_end":111},{"text":"            requires binary_numerator(e) == 1, binary_denominator(e) == pow2(shift),","highlight_start":1,"highlight_end":85},{"text":"                denominator < 2 * numerator * pow2(shift),","highlight_start":1,"highlight_end":59},{"text":"                numerator * pow2(shift) < 2 * denominator;","highlight_start":1,"highlight_end":59},{"text":"    }","highlight_start":1,"highlight_end":6},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"/// The one-comparison correction returns the exact floor binary exponent.","highlight_start":1,"highlight_end":75},{"text":"/// Equality of the aligned operands certifies precisely a binary scale,","highlight_start":1,"highlight_end":73},{"text":"/// including unreduced numerator and denominator pairs.","highlight_start":1,"highlight_end":57},{"text":"pub proof fn bit_lengths_determine_binade(numerator: nat, denominator: nat, numerator_bits: nat, denominator_bits: nat)","highlight_start":1,"highlight_end":120},{"text":"    requires has_bit_length(numerator, numerator_bits), has_bit_length(denominator, denominator_bits),","highlight_start":1,"highlight_end":103},{"text":"    ensures","highlight_start":1,"highlight_end":12},{"text":"        in_binade(numerator, denominator, aligned_msd(numerator, denominator, numerator_bits, denominator_bits)),","highlight_start":1,"highlight_end":114},{"text":"        (is_binary_scale(numerator, denominator, aligned_msd(numerator, denominator, numerator_bits, denominator_bits))","highlight_start":1,"highlight_end":120},{"text":"            <==> numerator * binary_denominator(numerator_bits as int - denominator_bits as int)","highlight_start":1,"highlight_end":97},{"text":"                == binary_numerator(numerator_bits as int - denominator_bits as int) * denominator),","highlight_start":1,"highlight_end":101},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    aligned_bit_length_bounds(numerator, denominator, numerator_bits, denominator_bits);","highlight_start":1,"highlight_end":89},{"text":"    let difference = numerator_bits as int - denominator_bits as int;","highlight_start":1,"highlight_end":70},{"text":"    binary_positive(difference);","highlight_start":1,"highlight_end":33},{"text":"    if below_aligned(numerator, denominator, numerator_bits, denominator_bits) {","highlight_start":1,"highlight_end":81},{"text":"        binary_positive(difference - 1);","highlight_start":1,"highlight_end":41},{"text":"        binary_step(difference);","highlight_start":1,"highlight_end":33},{"text":"        let a = binary_numerator(difference);","highlight_start":1,"highlight_end":46},{"text":"        let b = binary_denominator(difference);","highlight_start":1,"highlight_end":48},{"text":"        let previous_a = binary_numerator(difference - 1);","highlight_start":1,"highlight_end":59},{"text":"        let previous_b = binary_denominator(difference - 1);","highlight_start":1,"highlight_end":61},{"text":"        assert(previous_a * denominator < numerator * previous_b","highlight_start":1,"highlight_end":65},{"text":"            && numerator * previous_b < 2 * previous_a * denominator) by (nonlinear_arith)","highlight_start":1,"highlight_end":91},{"text":"            requires a > 0, b > 0, previous_a > 0, previous_b > 0,","highlight_start":1,"highlight_end":67},{"text":"                a * previous_b == 2 * previous_a * b,","highlight_start":1,"highlight_end":54},{"text":"                a * denominator < 2 * numerator * b, numerator * b < a * denominator;","highlight_start":1,"highlight_end":86},{"text":"    }","highlight_start":1,"highlight_end":6},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"/// Signed binary scales compose for arbitrary integer exponents.","highlight_start":1,"highlight_end":66},{"text":"pub proof fn binary_scales_compose(left: int, right: int)","highlight_start":1,"highlight_end":58},{"text":"    ensures binary_numerator(left + right) * (binary_denominator(left) * binary_denominator(right))","highlight_start":1,"highlight_end":100},{"text":"        == (binary_numerator(left) * binary_numerator(right)) * binary_denominator(left + right),","highlight_start":1,"highlight_end":98},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    let lp = if left >= 0 { left as nat } else { 0 };","highlight_start":1,"highlight_end":54},{"text":"    let ln = if left < 0 { (-left) as nat } else { 0 };","highlight_start":1,"highlight_end":56},{"text":"    let rp = if right >= 0 { right as nat } else { 0 };","highlight_start":1,"highlight_end":56},{"text":"    let rn = if right < 0 { (-right) as nat } else { 0 };","highlight_start":1,"highlight_end":58},{"text":"    let sp = if left + right >= 0 { (left + right) as nat } else { 0 };","highlight_start":1,"highlight_end":72},{"text":"    let sn = if left + right < 0 { (-left - right) as nat } else { 0 };","highlight_start":1,"highlight_end":72},{"text":"    assert(sp + ln + rn == lp + rp + sn);","highlight_start":1,"highlight_end":42},{"text":"    lemma_pow2_adds(ln, rn);","highlight_start":1,"highlight_end":29},{"text":"    lemma_pow2_adds(sp, ln + rn);","highlight_start":1,"highlight_end":34},{"text":"    lemma_pow2_adds(lp, rp);","highlight_start":1,"highlight_end":29},{"text":"    lemma_pow2_adds(lp + rp, sn);","highlight_start":1,"highlight_end":34},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"/// Binary scaling moves a binade by exactly the signed scale exponent.","highlight_start":1,"highlight_end":72},{"text":"pub proof fn binary_scale_preserves_binade(numerator: nat, denominator: nat, exponent: int, offset: int)","highlight_start":1,"highlight_end":105},{"text":"    requires in_binade(numerator, denominator, exponent),","highlight_start":1,"highlight_end":58},{"text":"    ensures in_binade(numerator * binary_numerator(offset), denominator * binary_denominator(offset), exponent + offset),","highlight_start":1,"highlight_end":122},{"text":"        (is_binary_scale(numerator, denominator, exponent)","highlight_start":1,"highlight_end":59},{"text":"            <==> is_binary_scale(numerator * binary_numerator(offset), denominator * binary_denominator(offset), exponent + offset)),","highlight_start":1,"highlight_end":134},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    binary_positive(exponent);","highlight_start":1,"highlight_end":31},{"text":"    binary_positive(offset);","highlight_start":1,"highlight_end":29},{"text":"    binary_positive(exponent + offset);","highlight_start":1,"highlight_end":40},{"text":"    binary_scales_compose(exponent, offset);","highlight_start":1,"highlight_end":45},{"text":"    let a = binary_numerator(exponent);","highlight_start":1,"highlight_end":40},{"text":"    let b = binary_denominator(exponent);","highlight_start