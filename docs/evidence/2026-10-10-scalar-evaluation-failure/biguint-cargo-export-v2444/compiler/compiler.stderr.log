","highlight_start":1,"highlight_end":29},{"text":"    ensures","highlight_start":1,"highlight_end":12},{"text":"        (((low >> shift) | (high << (64 - shift))) as nat) * pow2(shift as nat)","highlight_start":1,"highlight_end":80},{"text":"            + (low as nat) % pow2(shift as nat)","highlight_start":1,"highlight_end":48},{"text":"            == low as nat + ((high as nat) % pow2(shift as nat)) * radix(),","highlight_start":1,"highlight_end":76},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    let factor = pow2(shift as nat);","highlight_start":1,"highlight_end":37},{"text":"    let other = pow2((64 - shift) as nat);","highlight_start":1,"highlight_end":43},{"text":"    lemma2_to64();","highlight_start":1,"highlight_end":19},{"text":"    lemma_pow2_pos(shift as nat);","highlight_start":1,"highlight_end":34},{"text":"    lemma_pow2_pos((64 - shift) as nat);","highlight_start":1,"highlight_end":41},{"text":"    lemma_pow2_adds(shift as nat, (64 - shift) as nat);","highlight_start":1,"highlight_end":56},{"text":"    vstd::bits::lemma_u64_pow2_no_overflow(shift as nat);","highlight_start":1,"highlight_end":58},{"text":"    super::word::one_shift_is_power_of_two(shift);","highlight_start":1,"highlight_end":51},{"text":"    assert((1u64 << shift) as u128 == (1u128 << shift)) by (bit_vector)","highlight_start":1,"highlight_end":72},{"text":"        requires shift < 64;","highlight_start":1,"highlight_end":29},{"text":"    vstd::bits::lemma_u64_low_bits_mask_is_mod(high, shift as nat);","highlight_start":1,"highlight_end":68},{"text":"    let bottom = high & ((factor - 1) as u64);","highlight_start":1,"highlight_end":47},{"text":"    assert(bottom == (high as nat) % factor);","highlight_start":1,"highlight_end":46},{"text":"    assert(bottom * other <= u64::MAX) by (nonlinear_arith)","highlight_start":1,"highlight_end":60},{"text":"        requires 0 <= bottom < factor, other > 0, factor * other == radix();","highlight_start":1,"highlight_end":77},{"text":"    vstd::bits::lemma_u64_shl_is_mul(bottom, (64 - shift) as u64);","highlight_start":1,"highlight_end":67},{"text":"    assert(high << ((64 - shift) as u32) == bottom << ((64 - shift) as u32)) by (bit_vector)","highlight_start":1,"highlight_end":93},{"text":"        requires 0 < shift < 64, bottom == high & (((1u64 << shift) - 1) as u64);","highlight_start":1,"highlight_end":82},{"text":"    vstd::bits::lemma_u64_shr_is_div(low, shift as u64);","highlight_start":1,"highlight_end":57},{"text":"    lemma_fundamental_div_mod(low as int, factor as int);","highlight_start":1,"highlight_end":58},{"text":"    let result = (low >> shift) | (high << ((64 - shift) as u32));","highlight_start":1,"highlight_end":67},{"text":"    assert(result as u128 == (low >> shift) as u128 + (high << ((64 - shift) as u32)) as u128)","highlight_start":1,"highlight_end":95},{"text":"        by (bit_vector)","highlight_start":1,"highlight_end":24},{"text":"        requires 0 < shift < 64,","highlight_start":1,"highlight_end":33},{"text":"            result == (low >> shift) | (high << ((64 - shift) as u32));","highlight_start":1,"highlight_end":72},{"text":"    assert(result * factor + (low as nat) % factor","highlight_start":1,"highlight_end":51},{"text":"        == low + ((high as nat) % factor) * radix()) by (nonlinear_arith)","highlight_start":1,"highlight_end":74},{"text":"        requires result == (low as nat) / factor + bottom * other,","highlight_start":1,"highlight_end":67},{"text":"            low == factor * ((low as nat) / factor) + (low as nat) % factor,","highlight_start":1,"highlight_end":77},{"text":"            bottom == (high as nat) % factor, factor * other == radix();","highlight_start":1,"highlight_end":73},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"pub(crate) proof fn extend_prefix_zero(words: Seq<u64>, start: int, end: int)","highlight_start":1,"highlight_end":78},{"text":"    requires 0 <= start <= end <= words.len(),","highlight_start":1,"highlight_end":47},{"text":"        forall|index: int| start <= index < end ==> #[trigger] words[index] == 0,","highlight_start":1,"highlight_end":82},{"text":"    ensures prefix(words, start) == prefix(words, end),","highlight_start":1,"highlight_end":56},{"text":"    decreases end - start,","highlight_start":1,"highlight_end":27},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    if start < end {","highlight_start":1,"highlight_end":21},{"text":"        extend_prefix_zero(words, start, end - 1);","highlight_start":1,"highlight_end":51},{"text":"        assert(words[end - 1] * weight((end - 1) as nat) == 0)","highlight_start":1,"highlight_end":63},{"text":"            by (nonlinear_arith) requires words[end - 1] == 0;","highlight_start":1,"highlight_end":63},{"text":"    }","highlight_start":1,"highlight_end":6},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"spec fn word_shifted(words: Seq<u64>, shift: nat) -> Seq<u64> {","highlight_start":1,"highlight_end":64},{"text":"    Seq::new(words.len(), |index: int| limb(words, index + shift))","highlight_start":1,"highlight_end":67},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"spec fn shifted_limb(words: Seq<u64>, index: int, shift: u32) -> u64 {","highlight_start":1,"highlight_end":71},{"text":"    if shift == 0 { limb(words, index) }","highlight_start":1,"highlight_end":41},{"text":"    else { (limb(words, index) >> shift) | (limb(words, index + 1) << (64 - shift)) }","highlight_start":1,"highlight_end":86},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"proof fn word_shift_value(words: Seq<u64>, shift: nat)","highlight_start":1,"highlight_end":55},{"text":"    requires shift < words.len(),","highlight_start":1,"highlight_end":34},{"text":"    ensures value(word_shifted(words, shift)) == value(words) / weight(shift),","highlight_start":1,"highlight_end":79},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    let shifted = word_shifted(words, shift);","highlight_start":1,"highlight_end":46},{"text":"    let tail = words.subrange(shift as int, words.len() as int);","highlight_start":1,"highlight_end":65},{"text":"    prefix_equal(shifted, tail, tail.len() as int);","highlight_start":1,"highlight_end":52},{"text":"    extend_prefix_zero(shifted, tail.len() as int, shifted.len() as int);","highlight_start":1,"highlight_end":74},{"text":"    prefix_split(words, shift as int, words.len() as int);","highlight_start":1,"highlight_end":59},{"text":"    prefix_bound(words, shift as int);","highlight_start":1,"highlight_end":39},{"text":"    weight_step(shift);","highlight_start":1,"highlight_end":24},{"text":"    assert(value(words) == value(tail) * weight(shift) + prefix(words, shift as int))","highlight_start":1,"highlight_end":86},{"text":"        by (nonlinear_arith)","highlight_start":1,"highlight_end":29},{"text":"        requires value(words) == prefix(words, shift as int) + weight(shift) * value(tail);","highlight_start":1,"highlight_end":92},{"text":"    lemma_fundamental_div_mod_converse_div(value(words) as int, weight(shift) as int,","highlight_start":1,"highlight_end":86},{"text":"        value(tail) as int, prefix(words, shift as int) as int);","highlight_start":1,"highlight_end":65},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"proof fn shift_prefix_carry(source: Seq<u64>, output: Seq<u64>, factor: nat, length: int)","highlight_start":1,"highlight_end":90},{"text":"    requires factor > 0, source.len() == output.len(), 0 <= length <= source.len(),","highlight_start":1,"highlight_end":84},{"text":"        forall|index: int| 0 <= index < length ==>","highlight_start":1,"highlight_end":51},{"text":"            #[trigger] output[index] * factor + (source[index] as nat) % factor","highlight_start":1,"highlight_end":80},{"text":"                == source[index] + ((limb(source, index + 1) as nat) % factor) * radix(),","highlight_start":1,"highlight_end":90},{"text":"    ensures prefix(output, length) * factor + (limb(source, 0) as nat) % factor","highlight_start":1,"highlight_end":80},{"text":"        == prefix(source, length) + ((limb(source, length) as nat) % factor) * weight(length as nat),","highlight_start":1,"highlight_end":102},{"text":"    decreases length,","highlight_start":1,"highlight_end":22},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    if length == 0 {","highlight_start":1,"highlight_end":21},{"text":"        lemma2_to64();","highlight_start":1,"highlight_end":23},{"text":"        let remainder = (limb(source, 0) as nat) % factor;","highlight_start":1,"highlight_end":59},{"text":"        assert(prefix(output, 0) * factor == 0) by (nonlinear_arith)","highlight_start":1,"highlight_end":69},{"text":"            requires prefix(output, 0) == 0;","highlight_start":1,"highlight_end":45},{"text":"        assert(remainder * weight(0) == remainder) by (nonlinear_arith)","highlight_start":1,"highlight_end":72},{"text":"            requires weight(0) == 1;","highlight_start":1,"highlight_end":37},{"text":"    } else {","highlight_start":1,"highlight_end":13},{"text":"        shift_prefix_carry(source, output, factor, length - 1);","highlight_start":1,"highlight_end":64},{"text":"        weight_step((length - 1) as nat);","highlight_start":1,"highlight_end":42},{"text":"        let w = weight((length - 1) as nat);","highlight_start":1,"highlight_end":45},{"text":"        let next_w = weight(length as nat);","highlight_start":1,"highlight_end":44},{"text":"        let carry = (source[length - 1] as nat) % factor;","highlight_start":1,"highlight_end":58},{"text":"        let next_carry = (limb(source, length) as nat) % factor;","highlight_start":1,"highlight_end":65},{"text":"        let remainder = (limb(so