minator) > 0,","highlight_start":1,"highlight_end":41},{"text":"        numerator / gcd(numerator, denominator) * gcd(numerator, denominator) == numerator,","highlight_start":1,"highlight_end":92},{"text":"        denominator / gcd(numerator, denominator) * gcd(numerator, denominator) == denominator,","highlight_start":1,"highlight_end":96},{"text":"        0 < denominator / gcd(numerator, denominator) <= denominator,","highlight_start":1,"highlight_end":70},{"text":"        numerator / gcd(numerator, denominator) <= numerator,","highlight_start":1,"highlight_end":62},{"text":"        gcd(numerator / gcd(numerator, denominator), denominator / gcd(numerator, denominator)) == 1,","highlight_start":1,"highlight_end":102},{"text":"        numerator / gcd(numerator, denominator) * denominator","highlight_start":1,"highlight_end":62},{"text":"            == numerator * (denominator / gcd(numerator, denominator)),","highlight_start":1,"highlight_end":72},{"text":"        (numerator / gcd(numerator, denominator) == 0 <==> numerator == 0),","highlight_start":1,"highlight_end":76},{"text":"        numerator == 0 ==> denominator / gcd(numerator, denominator) == 1,","highlight_start":1,"highlight_end":75},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    gcd_characterization(numerator, denominator);","highlight_start":1,"highlight_end":50},{"text":"    let divisor = gcd(numerator, denominator);","highlight_start":1,"highlight_end":47},{"text":"    let reduced_numerator = numerator / divisor;","highlight_start":1,"highlight_end":49},{"text":"    let reduced_denominator = denominator / divisor;","highlight_start":1,"highlight_end":53},{"text":"    lemma_fundamental_div_mod(numerator as int, divisor as int);","highlight_start":1,"highlight_end":65},{"text":"    lemma_fundamental_div_mod(denominator as int, divisor as int);","highlight_start":1,"highlight_end":67},{"text":"    assert(numerator == reduced_numerator * divisor","highlight_start":1,"highlight_end":52},{"text":"        && denominator == reduced_denominator * divisor) by (nonlinear_arith)","highlight_start":1,"highlight_end":78},{"text":"        requires numerator == divisor * reduced_numerator, denominator == divisor * reduced_denominator;","highlight_start":1,"highlight_end":105},{"text":"    assert(0 < reduced_denominator <= denominator && reduced_numerator <= numerator","highlight_start":1,"highlight_end":84},{"text":"        && (reduced_numerator == 0 <==> numerator == 0)) by (nonlinear_arith)","highlight_start":1,"highlight_end":78},{"text":"        requires divisor > 0, denominator > 0, reduced_numerator >= 0, reduced_denominator >= 0,","highlight_start":1,"highlight_end":97},{"text":"            numerator == reduced_numerator * divisor, denominator == reduced_denominator * divisor;","highlight_start":1,"highlight_end":100},{"text":"    gcd_scaled(reduced_numerator, reduced_denominator, divisor);","highlight_start":1,"highlight_end":65},{"text":"    assert(gcd(reduced_numerator, reduced_denominator) == 1) by (nonlinear_arith)","highlight_start":1,"highlight_end":82},{"text":"        requires divisor > 0, divisor == gcd(reduced_numerator, reduced_denominator) * divisor;","highlight_start":1,"highlight_end":96},{"text":"    assert(reduced_numerator * denominator == numerator * reduced_denominator) by (nonlinear_arith)","highlight_start":1,"highlight_end":100},{"text":"        requires numerator == reduced_numerator * divisor, denominator == reduced_denominator * divisor;","highlight_start":1,"highlight_end":105},{"text":"    if numerator == 0 {","highlight_start":1,"highlight_end":24},{"text":"        lemma_small_mod(0, denominator);","highlight_start":1,"highlight_end":41},{"text":"        reveal_with_fuel(gcd, 2);","highlight_start":1,"highlight_end":34},{"text":"        assert(divisor == denominator);","highlight_start":1,"highlight_end":40},{"text":"        lemma_div_by_self(denominator as int);","highlight_start":1,"highlight_end":47},{"text":"    }","highlight_start":1,"highlight_end":6},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"pub(crate) proof fn gcd_bound(left: nat, right: nat)","highlight_start":1,"highlight_end":53},{"text":"    ensures","highlight_start":1,"highlight_end":12},{"text":"        left > 0 ==> gcd(left, right) <= left,","highlight_start":1,"highlight_end":47},{"text":"        right > 0 ==> gcd(left, right) <= right,","highlight_start":1,"highlight_end":49},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    gcd_characterization(left, right);","highlight_start":1,"highlight_end":39},{"text":"    let divisor = gcd(left, right);","highlight_start":1,"highlight_end":36},{"text":"    if left > 0 && divisor > left {","highlight_start":1,"highlight_end":36},{"text":"        lemma_small_mod(left, divisor);","highlight_start":1,"highlight_end":40},{"text":"    }","highlight_start":1,"highlight_end":6},{"text":"    if right > 0 && divisor > right {","highlight_start":1,"highlight_end":38},{"text":"        lemma_small_mod(right, divisor);","highlight_start":1,"highlight_end":41},{"text":"    }","highlight_start":1,"highlight_end":6},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"proof fn divisor_of_odd_is_odd(value: nat, divisor: nat)","highlight_start":1,"highlight_end":57},{"text":"    requires value % 2 == 1, divisor > 0, value % divisor == 0,","highlight_start":1,"highlight_end":64},{"text":"    ensures divisor % 2 == 1,","highlight_start":1,"highlight_end":30},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    lemma_fundamental_div_mod(value as int, divisor as int);","highlight_start":1,"highlight_end":61},{"text":"    assert(value == (value / divisor) * divisor) by (nonlinear_arith)","highlight_start":1,"highlight_end":70},{"text":"        requires value == divisor * (value / divisor) + value % divisor, value % divisor == 0;","highlight_start":1,"highlight_end":95},{"text":"    lemma_mul_mod_noop((value / divisor) as int, divisor as int, 2);","highlight_start":1,"highlight_end":69},{"text":"    if divisor % 2 == 0 {","highlight_start":1,"highlight_end":26},{"text":"        assert(((value / divisor) % 2) * (divisor % 2) == 0) by (nonlinear_arith)","highlight_start":1,"highlight_end":82},{"text":"            requires divisor % 2 == 0;","highlight_start":1,"highlight_end":39},{"text":"        assert(value % 2 == 0);","highlight_start":1,"highlight_end":32},{"text":"    }","highlight_start":1,"highlight_end":6},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"proof fn odd_divisor_cancels_two(value: nat, divisor: nat)","highlight_start":1,"highlight_end":59},{"text":"    requires divisor > 0, divisor % 2 == 1, (2 * value) % divisor == 0,","highlight_start":1,"highlight_end":72},{"text":"    ensures value % divisor == 0,","highlight_start":1,"highlight_end":34},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    let quotient = 2 * value / divisor;","highlight_start":1,"highlight_end":40},{"text":"    lemma_fundamental_div_mod((2 * value) as int, divisor as int);","highlight_start":1,"highlight_end":67},{"text":"    lemma_mul_mod_noop(quotient as int, divisor as int, 2);","highlight_start":1,"highlight_end":60},{"text":"    lemma_mod_multiples_basic(value as int, 2);","highlight_start":1,"highlight_end":48},{"text":"    lemma_fundamental_div_mod(quotient as int, 2);","highlight_start":1,"highlight_end":51},{"text":"    assert(value == (quotient / 2) * divisor) by (nonlinear_arith)","highlight_start":1,"highlight_end":67},{"text":"        requires 2 * value == quotient * divisor, quotient == 2 * (quotient / 2);","highlight_start":1,"highlight_end":82},{"text":"    lemma_mod_multiples_basic((quotient / 2) as int, divisor as int);","highlight_start":1,"highlight_end":70},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"proof fn gcd_odd_double(left: nat, right: nat)","highlight_start":1,"highlight_end":47},{"text":"    requires left % 2 == 1,","highlight_start":1,"highlight_end":28},{"text":"    ensures gcd(left, 2 * right) == gcd(left, right),","highlight_start":1,"highlight_end":54},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    gcd_characterization(left, right);","highlight_start":1,"highlight_end":39},{"text":"    gcd_characterization(left, 2 * right);","highlight_start":1,"highlight_end":43},{"text":"    let original = gcd(left, right);","highlight_start":1,"highlight_end":37},{"text":"    let doubled = gcd(left, 2 * right);","highlight_start":1,"highlight_end":40},{"text":"    lemma_mul_mod_noop_right(2, right as int, original as int);","highlight_start":1,"highlight_end":64},{"text":"    lemma_small_mod(0, original);","highlight_start":1,"highlight_end":34},{"text":"    assert((2 * right) % original == 0);","highlight_start":1,"highlight_end":41},{"text":"    divisor_of_odd_is_odd(left, doubled);","highlight_start":1,"highlight_end":42},{"text":"    odd_divisor_cancels_two(right, doubled);","highlight_start":1,"highlight_end":45},{"text":"    assert(original <= doubled);","highlight_start":1,"highlight_end":33},{"text":"    assert(doubled <= original);","highlight_start":1,"highlight_end":33},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"pub(crate) proof fn gcd_odd_power_two(left: nat, right: nat, shift: nat)","highlight_start":1,"highlight_end":73},{"text":"    requires left % 2 == 1,","highlight_start":1,"highlight_end":28},{"text":"    ensures gcd(left, right * pow2(shift)) == gcd(left, right),","highlight_start":1,"highlight_end":64},{"text":"    decreases shift,","highlight_start":1,"highlight_end":21},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    if shift == 0 {","highlight_start":1,"highlight_end":20},{"text":"        lemma_pow0(2);","highlight_start":1,"highlight_end":23},{"text":"        assert(pow2(shift) == 1);","highlight_start":1,"highlight_end":34},{"text":"        assert(right * pow2(shift) == right) by (nonlinear_arith)","highlight_start":1,"highlight_end":66},{"text":"            requires pow2(shift) == 1;","highlight_start":1,"highlight_end":39},{"text":"    } else {","highlight_start":1,"highlight_end":13},{"text":"        lemma_pow2_unfold(shift);","highlight_start":1,"highlight_end":34},{"text":"        let previous = pow2((shift - 1) as nat);","highlight_start":1,"highlight_end":49},{"text":"        assert(right * pow2(shift) == 2 * (right * previous)) by (nonlinear_arith)","highlight_start":1,"highlight_end":83},{"text":"            requires pow2(shift) == 2 * previous;","highlight_start":1,"highlight_end":50},{"text":"        gcd_odd_double(left, right * previous);","highlight_start":1,"highlight_end":48},{"text":"        gcd_odd_power_two(left, right, (shift - 1) as nat);","highlight_start":1,"highlight_end":60},{"text":"        assert(gcd(left, right * pow2(shift)) == gcd(left, right * previous));","highlight_start":1,"highlight_end":79},{"text":"        assert(gcd(left, right * previous) == gcd(left, right));","highlight_start":1,"highlight_end":65},{"text":"    }","highlight_start":1,"highlight_end":6},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"proof fn gcd_power_two_factors_ordered(left: nat, right: nat, low: nat, high: nat)","highlight_start":1,"highlight_end":83},{"text":"    requires left % 2 == 1, low <= high,","highlight_start":1,"highlight_end":41},{"text":"    ensures gcd(left * pow2(low), right * pow2(high)) == gcd(left, right) * pow2(low),","highlight_start":1,"highlight_end":87},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    let extra = (high - low) as nat;","highlight_start":1,"highlight_end":37},{"text":"    lemma_pow2_pos(low);","highlight_start":1,"highlight_end":25},{"text":"    lemma_pow2_adds(extra, low);","highlight_start":1,"highlight_end":33},{"text":"    assert(right * pow2(high) == (right * pow2(extra)) * pow2(low))","highlight_start":1,"highlight_end":68},{"text":"        by (nonlinear_arith) requires pow2(high) == pow2(extra) * pow2(low);","highlight_start":1,"highlight_end":77},{"text":"    gcd_scaled(left, right * pow2(extra), pow2(low));","highlight_start":1,"highlight_end":54},{"text":"    gcd_odd_power_two(left, right, extra);","highlight_start":1,"highlight_end":43},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"pub(crate) proof fn gcd_power_two_factors(left: nat, right: nat, left_shift: nat, right_shift: nat)","highlight_start":1,"highlight_end":100},{"text":"    requires left % 2 == 1, right % 2 == 1,","highlight_start":1,"highlight_end":44},{"text":"    ensures gcd(left * pow2(left_shift), right * pow2(right_shift))","highlight_start":1,"highlight_end":68},{"text":"        == gcd(left, right) * pow2(if left_shift < right_shift { left_shift } else { right_shift }),","highlight_start":1,"highlight_end":101},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    if left_shift <= right_shift {","highlight_start":1,"highlight_end":35},{"text":"        gcd_power_two_factors_ordered(left, right, left_shift, right_shift);","highlight_start":1,"highlight_end":77},{"text":"    } else {","highlight_start":1,"highlight_end":13},{"text":"        gcd_power_two_factors_ordered(right, left, right_shift, left_shift);","highlight_start":1,"highlight_end":77},{"text":"        gcd_symmetric(left * pow2(left_shift), right * pow2(right_shift));","highlight_start":1,"highlight_end":75},{"text":"        gcd_symmetric(left, right);","highlight_start":1,"highlight_end":36},{"text":"    }","highlight_start":1,"highlight_end":6},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"/// Connect the standard-library trailing-zero specification to exact division","highlight_start":1,"highlight_end":79},{"text":"/// by a mathematical power of two, including the value's odd remaining part.","highlight_start":1,"highlight_end":78},{"text":"pub(crate) proof fn trailing_zeros_factor_u64(value: u64)","highlight_start":1,"highlight_end":58},{"text":"    requires value > 0,","highlight_start":1,"highlight_end":24},{"text":"    ensures","highlight_start":1,"highlight_end":12},{"text":"        u64_trailing_zeros(value) < 64,","highlight_start":1,"highlight_end":40},{"text":"        0 < (value >> u64_trailing_zeros(value)) <= value,","highlight_start":1,"highlight_end":59},{"text":"        (value >> u64_trailing_zeros(value)) % 2 == 1,","highlight_start":1,"highlight_end":55},{"text":"        value == (value >> u64_trailing_zeros(value)) * pow2(u64_trailing_zeros(value) as nat),","highlight_start":1,"highlight_end":96},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    axiom_u64_trailing_zeros(value);","highlight_start":1,"highlight_end":37},{"text":"    let shift = u64_trailing_zeros(value) as u64;","highlight_start":1,"highlight_end":50},{"text":"    let odd = value >> shift;","highlight_start":1,"highlight_end":30},{"text":"    assert((value >> shift) % 2 == 1) by (bit_vector)","highlight_start":1,"highlight_end":54},{"text":"        requires (value >> shift) & 1u64 == 1u64;","highlight_start":1,"highlight_end":50},{"text":"    assert(0 < odd <= value) by (bit_vector)","highlight_start":1,"highlight_end":45},{"text":"        requires odd == value >> shift, odd % 2 == 1;","highlight_start":1,"highlight_end":54},{"text":"    vstd::bits::lemma_u64_mul_pow2_le_max_iff_max_shr(odd, shift, value);","highlight_start":1,"highlight_end":74},{"text":"    vstd::bits::lemma_u64_shl_is_mul(odd, shift);","highlight_start":1,"highlight_end":50},{"text":"    assert((value >> shift) << shift == value) by (bit_vector)","highlight_start":1,"highlight_end":63},{"text":"        requires shift < 64, value << ((64 - shift) as u64) == 0;","highlight_start":1,"highlight_end":66},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"pub(crate) open spec fn trailing_zeros_u128_spec(value: u128) -> u32 {","highlight_start":1,"highlight_end":71},{"text":"    if value as u64 != 0 {","highlight_start":1,"highlight_end":27},{"text":"        u64_trailing_zeros(value as u64)","highlight_start":1,"highlight_end":41},{"text":"    } else {","highlight_start":1,"highlight_end":13},{"text":"        (64 + u64_trailing_zeros((value >> 64) as u64)) as u32","highlight_start":1,"highlight_end":63},{"text":"    }","highlight_start":1,"highlight_end":6},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"pub(crate) proof fn trailing_zeros_factor_u128(value: u128)","highlight_start":1,"highlight_end":60},{"text":"    ensures","highlight_start":1,"highlight_end":12},{"text":"        trailing_zeros_u128_spec(value) <= 128,","highlight_start":1,"highlight_end":48},{"text":"        (trailing_zeros_u128_spec(value) == 128 <==> value == 0),","highlight_start":1,"highlight_end":66},{"text":"        value > 0 ==> (","highlight_start":1,"highlight_end":24},{"text":"            0 < (value >> trailing_zeros_u128_spec(value)) <= value","highlight_start":1,"highlight_end":68},{"text":"            && (value >> trailing_zeros_u128_spec(value)) % 2 == 1","highlight_start":1,"highlight_end":67},{"text":"            && value == (value >> trailing_zeros_u128_spec(value))","highlight_start":1,"highlight_end":67},{"text":"                * pow2(trailing_zeros_u128_spec(value) as nat)),","highlight_start":1,"highlight_end":65},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    let low = value as u64;","highlight_start":1,"highlight_end":28},{"text":"    let high = (value >> 64) as u64;","highlight_start":1,"highlight_end":37},{"text":"    axiom_u64_trailing_zeros(low);","highlight_start":1,"highlight_end":35},{"text":"    axiom_u64_trailing_zeros(high);","highlight_start":1,"highlight_end":36},{"text":"    let shift = trailing_zeros_u128_spec(value);","highlight_start":1,"highlight_end":49},{"text":"    assert(value == 0 <==> low == 0 && high == 0) by (bit_vector)","highlight_start":1,"highlight_end":66},{"text":"        requires low == value as u64, high == (value >> 64) as u64;","highlight_start":1,"highlight_end":68},{"text":"    if value > 0 {","highlight_start":1,"highlight_end":19},{"text":"        if low != 0 {","highlight_start":1,"highlight_end":22},{"text":"            assert(value << ((128 - shift) as u32) == 0) by (bit_vector)","highlight_start":1,"highlight_end":73},{"text":"                requires shift < 64, low == value as u64,","highlight_start":1,"highlight_end":58},{"text":"                    low << ((64 - shift) as u64) == 0;","highlight_start":1,"highlight_end":55},{"text":"            assert((value >> shift) & 1u128 == 1u128) by (bit_vector)","highlight_start":1,"highlight_end":70},{"text":"                requires shift < 64, low == value as u64,","highlight_start":1,"highlight_end":58},{"text":"                    (low >> shift) & 1u64 == 1u64;","highlight_start":1,"highlight_end":51},{"text":"        } else {","highlight_start":1,"highlight_end":17},{"text":"            let upper_shift = u64_trailing_zeros(high);","highlight_start":1,"highlight_end":56},{"text":"            assert(value << ((128 - shift) as u32) == 0) by (bit_vector)","highlight_start":1,"highlight_end":73},{"text":"                requires upper_shift < 64, shift == 64 + upper_shift,","highlight_start":1,"highlight_end":70},{"text":"                    value as u64 == 0, high == (value >> 64) as u64,","highlight_start":1,"highlight_end":69},{"text":"                    high << ((64 - upper_shift) as u64) == 0;","highlight_start":1,"highlight_end":62},{"text":"            assert((value >> shift) & 1u128 == 1u128) by (bit_vector)","highlight_start":1,"highlight_end":70},{"text":"                requires upper_shift < 64, shift == 64 + upper_shift,","highlight_start":1,"highlight_end":70},{"text":"                    high == (value >> 64) as u64,","highlight_start":1,"highlight_end":50},{"text":"                    (high >> upper_shift) & 1u64 == 1u64;","highlight_start":1,"highlight_end":58},{"text":"        }","highlight_start":1,"highlight_end":10},{"text":"        let odd = value >> shift;","highlight_start":1,"highlight_end":34},{"text":"        assert(0 < odd <= value && odd % 2 == 1) by (bit_vector)","highlight_start":1,"highlight_end":65},{"text":"            requires odd == value >> shift, odd & 1u128 == 1u128;","highlight_start":1,"highlight_end":66},{"text":"        lemma_pow2_pos(shift as nat);","highlight_start":1,"highlight_end":38},{"text":"        vstd::bits::lemma_u128_shr_is_div(value, shift as u128);","highlight_start":1,"highlight_end":65},{"text":"        lemma_fundamental_div_mod(value as int, pow2(shift as nat) as int);","highlight_start":1,"highlight_end":76},{"text":"        assert(odd * pow2(shift as nat) <= value) by (nonlinear_arith)","highlight_start":1,"highlight_end":71},{"text":"            requires odd == value as nat / pow2(shift as nat),","highlight_start":1,"highlight_end":63},{"text":"                value == pow2(shift as nat) * (value as nat / pow2(shift as nat))","highlight_start":1,"highlight_end":82},{"text":"                    + value as nat % pow2(shift as nat),","highlight_start":1,"highlight_end":57},{"text":"                value as nat % pow2(shift as nat) >= 0;","highlight_start":1,"highlight_end":56},{"text":"        super::word::shift_left_u128_is_mul(odd, shift);","highlight_start":1,"highlight_end":57},{"text":"        assert((value >> shift) << shift == value) by (bit_vector)","highlight_start":1,"highlight_end":67},{"text":"            requires shift < 128, value << ((128 - shift) as u32) == 0;","highlight_start":1,"highlight_end":72},{"text":"    }","highlight_start"