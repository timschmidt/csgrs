d":30},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"pub(crate) open spec fn finish(a: int, b: int, c: int, d: int, steps: nat) -> Option<(int, int, int, int)> {","highlight_start":1,"highlight_end":109},{"text":"    if steps >= 2 { Some((a, b, c, d)) } else { None }","highlight_start":1,"highlight_end":55},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"/// A bounded recursive model of endpoint agreement using mathematical","highlight_start":1,"highlight_end":71},{"text":"/// integers. Coefficient growth proves that 129 guard evaluations suffice;","highlight_start":1,"highlight_end":76},{"text":"/// the executable loop never exhausts this model's recursion budget.","highlight_start":1,"highlight_end":70},{"text":"#[verifier::opaque]","highlight_start":1,"highlight_end":20},{"text":"pub(crate) open spec fn batch_spec(","highlight_start":1,"highlight_end":36},{"text":"    larger: int, smaller: int, a: int, b: int, c: int, d: int, steps: nat, fuel: nat,","highlight_start":1,"highlight_end":86},{"text":") -> Option<(int, int, int, int)>","highlight_start":1,"highlight_end":34},{"text":"    decreases fuel,","highlight_start":1,"highlight_end":20},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    if fuel == 0 || larger < 0 || smaller <= 0","highlight_start":1,"highlight_end":47},{"text":"        || larger + a < 0 || larger + b < 0 || smaller + c <= 0 || smaller + d <= 0 {","highlight_start":1,"highlight_end":86},{"text":"        finish(a, b, c, d, steps)","highlight_start":1,"highlight_end":34},{"text":"    } else {","highlight_start":1,"highlight_end":13},{"text":"        let quotient = (larger + a) / (smaller + c);","highlight_start":1,"highlight_end":53},{"text":"        let next_c = a - quotient * c;","highlight_start":1,"highlight_end":39},{"text":"        let next_d = b - quotient * d;","highlight_start":1,"highlight_end":39},{"text":"        let next_smaller = larger - quotient * smaller;","highlight_start":1,"highlight_end":56},{"text":"        if quotient == 0 || quotient != (larger + b) / (smaller + d)","highlight_start":1,"highlight_end":69},{"text":"            || next_smaller < 0 || abs(c) > u64::MAX || abs(d) > u64::MAX","highlight_start":1,"highlight_end":74},{"text":"            || abs(next_c) > u64::MAX || abs(next_d) > u64::MAX {","highlight_start":1,"highlight_end":66},{"text":"            finish(a, b, c, d, steps)","highlight_start":1,"highlight_end":38},{"text":"        } else {","highlight_start":1,"highlight_end":17},{"text":"            batch_spec(smaller, next_smaller, c, d, next_c, next_d, steps + 1, (fuel - 1) as nat)","highlight_start":1,"highlight_end":98},{"text":"        }","highlight_start":1,"highlight_end":10},{"text":"    }","highlight_start":1,"highlight_end":6},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"pub(crate) open spec fn matrix_view(result: Option<[i128; 4]>) -> Option<(int, int, int, int)> {","highlight_start":1,"highlight_end":97},{"text":"    match result {","highlight_start":1,"highlight_end":19},{"text":"        Some(matrix) => Some((matrix[0] as int, matrix[1] as int, matrix[2] as int, matrix[3] as int)),","highlight_start":1,"highlight_end":104},{"text":"        None => None,","highlight_start":1,"highlight_end":22},{"text":"    }","highlight_start":1,"highlight_end":6},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"proof fn quotient_bound(larger: int, smaller: int, a: int, b: int, c: int, d: int)","highlight_start":1,"highlight_end":83},{"text":"    requires larger >= 0, smaller >= 0, alternating(a, b, c, d),","highlight_start":1,"highlight_end":65},{"text":"        larger + a >= 0, larger + b >= 0, smaller + c > 0, smaller + d > 0,","highlight_start":1,"highlight_end":76},{"text":"        (larger + a) / (smaller + c) == (larger + b) / (smaller + d),","highlight_start":1,"highlight_end":70},{"text":"    ensures 0 <= (larger + a) / (smaller + c) <= larger,","highlight_start":1,"highlight_end":57},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    if a <= 0 && c >= 0 {","highlight_start":1,"highlight_end":26},{"text":"        lemma_div_nonincreasing(larger + a, smaller + c);","highlight_start":1,"highlight_end":58},{"text":"    } else {","highlight_start":1,"highlight_end":13},{"text":"        lemma_div_nonincreasing(larger + b, smaller + d);","highlight_start":1,"highlight_end":58},{"text":"    }","highlight_start":1,"highlight_end":6},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"}","highlight_start":1,"highlight_end":2}],"label":null,"suggested_replacement":null,"suggestion_applicability":null,"expansion":{"span":{"file_name":"/home/tim/Documents/GitHub/workspace/csgrs/target/scalar-evaluation-candidate/source/crates/hyperreal/src/verified/lehmer.rs","byte_start":459,"byte_end":9959,"line_start":13,"line_end":229,"column_start":1,"column_end":2,"is_primary":false,"text":[{"text":"verus! {","highlight_start":1,"highlight_end":9},{"text":"pub(crate) open spec fn determinant(a: int, b: int, c: int, d: int) -> int {","highlight_start":1,"highlight_end":77},{"text":"    a * d - b * c","highlight_start":1,"highlight_end":18},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"proof fn abs_divisibility(value: int, divisor: nat)","highlight_start":1,"highlight_end":52},{"text":"    requires divisor > 0,","highlight_start":1,"highlight_end":26},{"text":"    ensures abs(value) % divisor == 0 <==> value % (divisor as int) == 0,","highlight_start":1,"highlight_end":74},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    if value < 0 {","highlight_start":1,"highlight_end":19},{"text":"        lemma_mul_mod_noop_right(-1, value, divisor as int);","highlight_start":1,"highlight_end":61},{"text":"