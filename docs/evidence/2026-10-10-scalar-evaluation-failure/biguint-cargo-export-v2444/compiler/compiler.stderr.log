 nat) % factor","highlight_start":1,"highlight_end":80},{"text":"                == source[index] + ((limb(source, index + 1) as nat) % factor) * radix(),","highlight_start":1,"highlight_end":90},{"text":"    ensures prefix(output, length) * factor + (limb(source, 0) as nat) % factor","highlight_start":1,"highlight_end":80},{"text":"        == prefix(source, length) + ((limb(source, length) as nat) % factor) * weight(length as nat),","highlight_start":1,"highlight_end":102},{"text":"    decreases length,","highlight_start":1,"highlight_end":22},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    if length == 0 {","highlight_start":1,"highlight_end":21},{"text":"        lemma2_to64();","highlight_start":1,"highlight_end":23},{"text":"        let remainder = (limb(source, 0) as nat) % factor;","highlight_start":1,"highlight_end":59},{"text":"        assert(prefix(output, 0) * factor == 0) by (nonlinear_arith)","highlight_start":1,"highlight_end":69},{"text":"            requires prefix(output, 0) == 0;","highlight_start":1,"highlight_end":45},{"text":"        assert(remainder * weight(0) == remainder) by (nonlinear_arith)","highlight_start":1,"highlight_end":72},{"text":"            requires weight(0) == 1;","highlight_start":1,"highlight_end":37},{"text":"    } else {","highlight_start":1,"highlight_end":13},{"text":"        shift_prefix_carry(source, output, factor, length - 1);","highlight_start":1,"highlight_end":64},{"text":"        weight_step((length - 1) as nat);","highlight_start":1,"highlight_end":42},{"text":"        let w = weight((length - 1) as nat);","highlight_start":1,"highlight_end":45},{"text":"        let next_w = weight(length as nat);","highlight_start":1,"highlight_end":44},{"text":"        let carry = (source[length - 1] as nat) % factor;","highlight_start":1,"highlight_end":58},{"text":"        let next_carry = (limb(source, length) as nat) % factor;","highlight_start":1,"highlight_end":65},{"text":"        let remainder = (limb(so