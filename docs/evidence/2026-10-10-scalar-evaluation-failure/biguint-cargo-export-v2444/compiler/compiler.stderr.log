tart":1,"highlight_end":68},{"text":"    requires quotient > 0, (a >= 0 && c <= 0) || (a <= 0 && c >= 0),","highlight_start":1,"highlight_end":69},{"text":"    ensures abs(a - quotient * c) == abs(a) + quotient * abs(c),","highlight_start":1,"highlight_end":65},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    assert(abs(a - quotient * c) == abs(a) + quotient * abs(c)) by (nonlinear_arith)","highlight_start":1,"highlight_end":85},{"text":"        requires quotient > 0, (a >= 0 && c <= 0) || (a <= 0 && c >= 0);","highlight_start":1,"highlight_end":73},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"proof fn row_growth(a: int, b: int, c: int, d: int, quotient: int, steps: nat)","highlight_start":1,"highlight_end":79},{"text":"    requires quotient > 0, alternating(a, b, c, d),","highlight_start":1,"highlight_end":52},{"text":"        abs(a) + abs(b) >= pow2(steps / 2),","highlight_start":1,"highlight_end":44},{"text":"        abs(c) + abs(d) >= pow2((steps + 1) / 2),","highlight_start":1,"highlight_end":50},{"text":"    ensures","highlight_start":1,"highlight_end":12},{"text":"        alternating(c, d, a - quotient * c, b - quotient * d),","highlight_start":1,"highlight_end":63},{"text":"        abs(c) + abs(d) >= pow2((steps + 1) / 2),","highlight_start":1,"highlight_end":50},{"text":"        abs(a - quotient * c) + abs(b - quotient * d) >= pow2((steps + 2) / 2),","highlight_start":1,"highlight_end":80},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    opposite_coefficient_growth(a, c, quotient);","highlight_start":1,"highlight_end":49},{"text":"    opposite_coefficient_growth(b, d, quotient);","highlight_start":1,"highlight_end":49},{"text":"    assert(alternating(c, d, a - quotient * c, b - quotient * d)) by (nonlinear_arith)","highlight_start":1,"highlight_end":87},{"text":"        requires quotient > 0, alternating(a, b, c, d);","highlight_start":1,"highlight_end":56},{"text":"    if steps % 2 == 0 {","highlight_start":1,"highlight_end":24},{"text":"        lemma_pow2_unfold((steps + 2) / 2);","highlight_start":1,"highlight_end":44},{"text":"    }","highlight_start":1,"highlight_end":6},{"text":"    let top = abs(a) + abs(b);","highlight_start":1,"highlight_end":31},{"text":"    let bottom = abs(c) + abs(d);","highlight_start":1,"highlight_end":34},{"text":"    let next = abs(a - quotient * c) + abs(b - quotient * d);","highlight_start":1,"highlight_end":62},{"text":"    assert(next == top + quotient * bottom) by (nonlinear_arith)","highlight_start":1,"highlight_end":65},{"text":"        requires abs(a - quotient * c) == abs(a) + quotient * abs(c),","highlight_start":1,"highlight_end":70},{"text":"            abs(b - quotient * d) == abs(b) + quotient * abs(d),","highlight_start":1,"highlight_end":65},{"text":"            next == abs(a - quotient * c) + abs(b - quotient * d),","highlight_start":1,"highlight_end":67},{"text":"            top == abs(a) + abs(b), bottom == abs(c) + abs(d);","highlight_start":1,"highlight_end":63},{"text":"    if steps % 2 == 0 {","highlight_start":1,"highlight_end":24},{"text":"        assert(next >= pow2((steps + 2) / 2)) by (nonlinear_arith)","highlight_start":1,"highlight_end":67},{"text":"            requires next == top + quotient * bottom, quotient >= 1,","highlight_start":1,"highlight_end":69},{"text":"                top >= pow2(steps / 2), bottom >= pow2(steps / 2), bottom >= 0,","highlight_start":1,"highlight_end":80},{"text":"                pow2((steps + 2) / 2) == 2 * pow2(steps / 2);","highlight_start":1,"highlight_end":62},{"text":"    } else {","highlight_start":1,"highlight_end":13},{"text":"        assert(next >= bottom) by (nonlinear_arith)","highlight_start":1,"highlight_end":52},{"text":"            requires next == top + quotient * bottom, quotient >= 1, top >= 0, bottom >= 0;","highlight_start":1,"highlight_end":92},{"text":"    }","highlight_start":1,"highlight_end":6},{"text":"}",