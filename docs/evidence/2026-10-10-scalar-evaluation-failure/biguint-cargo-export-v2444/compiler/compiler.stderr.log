   requires quotient == odd + other * upper,","highlight_start":1,"highlight_end":50},{"text":"            value == (odd * lower_unit + pow2(width) * upper) * pow2(offset),","highlight_start":1,"highlight_end":78},{"text":"            pow2(width) == lower_unit * other, unit == pow2(offset) * lower_unit;","highlight_start":1,"highlight_end":82},{"text":"    assert(quotient > 0) by (nonlinear_arith)","highlight_start":1,"highlight_end":46},{"text":"        requires quotient == odd + other * upper, odd > 0, other > 0, upper >= 0;","highlight_start":1,"highlight_end":82},{"text":"    lemma_pow2_unfold((width - shift) as nat);","highlight_start":1,"highlight_end":47},{"text":"    let half = pow2((width - shift - 1) as nat);","highlight_start":1,"highlight_end":49},{"text":"    assert(quotient == 2 * (half * upper) + odd) by (nonlinear_arith)","highlight_start":1,"highlight_end":70},{"text":"        requires quotient == odd + other * upper, other == 2 * half;","highlight_start":1,"highlight_end":69},{"text":"    lemma_mod_multiples_vanish((half * upper) as int, odd as int, 2);","highlight_start":1,"highlight_end":70},{"text":"    lemma_fundamental_div_mod_converse_div(value as int, unit as int, quotient as int, 0);","highlight_start":1,"highlight_end":91},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"// This is the None branch of a first-nonmaximal-digit scan, including empty storage.","highlight_start":1,"highlight_end":86},{"text":"pub(crate) proof fn all_full_digits_factor(digits: Seq<nat>, width: nat)","highlight_start":1,"highlight_end":73},{"text":"    requires forall|index: int| 0 <= index < digits.len()","highlight_start":1,"highlight_end":58},{"text":"        ==> #[trigger] digits[index] + 1 == pow2(width),","highlight_start":1,"highlight_end":57},{"text":"    ensures has_odd_factor(digit_value(digits, width) + 1, width * digits.len()),","highlight_start":1,"highlight_end":82},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    digit_prefix_full(digits, width, digits.len() as int);","highlight_start":1,"highlight_end":59},{"text":"    lemma_pow2_pos(width * digits.len());","highlight_start":1,"highlight_end":42},{"text":"    lemma_div_by_self(pow2(width * digits.len()) as int);","highlight_start":1,"highlight_end":58},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"pub(crate) proof fn first_nonzero_digit_factor(","highlight_start":1,"highlight_end":48},{"text":"    digits: Seq<nat>, width: nat, index: int, zeros: nat, odd: nat,","highlight_start":1,"highlight_end":68},{"text":")","highlight_start":1,"highlight_end":2},{"text":"    requires width > 0, 0 <= index < digits.len(), zeros < width,","highlight_start":1,"highlight_end":66},{"text":"        forall|lower: int| 0 <= lower < index ==> #[trigger] digits[lower] == 0,","highlight_start":1,"highlight_end":81},{"text":"        odd > 0, odd % 2 == 1, digits[index] == odd * pow2(zeros),","highlight_start":1,"highlight_end":67},{"text":"    ensures has_odd_factor(digit_value(digits, width), width * index as nat + zeros),","highlight_start":1,"highlight_end":86},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    digit_prefix_zero(digits, width, index);","highlight_start":1,"highlight_end":45},{"text":"    digit_prefix_split(digits, width, index + 1, digits.len() as int);","highlight_start":1,"highlight_end":71},{"text":"    digit_weight_step(width, index as nat);","highlight_start":1,"highlight_end":44},{"text":"    let upper = digit_value(digits.subrange(index + 1, digits.len() as int), width);","highlight_start":1,"highlight_end":85},{"text":"    let offset = width * index as nat;","highlight_start":1,"highlight_end":39},{"text":"    assert(digit_value(digits, width)","highlight_start":1,"highlight_end":38},{"text":"        == (odd * pow2(zeros) + pow2(width) * upper) * pow2(offset))","highlight_start":1,"highlight_end":69},{"text":"        by (nonlinear_arith)","highlight_start":1,"highlight_end":29},{"text":"        requires digit_prefix(digits, width, index) == 0,","highlight_start":1,"highlight_end":58},{"text":"            digit_value(digits, width) == digit_prefix(digits, width, index + 1)","highlight_start":1,"highlight_end":81},{"text":"                + digit_weight(width, index as nat + 1) * upper,","highlight_start":1,"highlight_end":65},{"text":"            digit_prefix(digits, width, index + 1) == digit_prefix(digits, width, index)","highlight_start":1,"highlight_end":89},{"text":"                + digits[index] * digit_weight(width, index as nat),","highlight_start":1,"highlight_end":69},{"text":"            digits[index] == odd * pow2(zeros), digit_weight(width, index as nat) == pow2(offset),","highlight_start":1,"highlight_end":99},{"text":"            digit_weight(width, index as nat + 1) == digit_weight(width, index as nat) * pow2(width);","highlight_start":1,"highlight_end":102},{"text":"    upper_digits_preserve_odd_factor(odd, zeros, width, upper, offset);","highlight_start":1,"highlight_end":72},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"pub(crate) proof fn first_nonmaximal_digit_factor(","highlight_start":1,"highlight_end":51},{"text":"    digits: Seq<nat>, width: nat, index: int, ones: nat, odd: nat,","highlight_start":1,"highlight_end":67},{"text":")","highlight_start":1,"highlight_end":2},{"text":"    requires width > 0, 0 <= index < digits.len(), ones <= width,","highlight_start":1,"highlight_end":66},{"text":"        forall|lower: int| 0 <= lower < index ==> #[trigger] digits[lower] + 1 == pow2(width),","highlight_start":1,"highlight_end":95},{"text":"        digits[index] + 1 < pow2(width),","highlight_start":1,"highlight_end":41},{"text":"        odd > 0, odd % 2 == 1, digits[index] + 1 == odd * pow2(ones),","highlight_start":1,"highlight_end":70},{"text":"    ensures has_odd_factor(digit_value(digits, width) + 1, width * index as nat + ones),","highlight_start":1,"highlight_end":89},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    lemma_pow2_pos(width);","highlight_start":1,"highlight_end":27},{"text":"    if ones == width {","highlight_start":1,"highlight_end":23},{"text":"        assert(false) by (nonlinear_arith)","highlight_start":1,"highlight_end":43},{"text":"            requires digits[index] + 1 == odd * pow2(width),","highlight_start":1,"highlight_end":61},{"text":"                digits[index] + 1 < pow2(width), odd > 0, pow2(width) > 0;","highlight_start":1,"highlight_end":75},{"text":"    }","highlight_start":1,"highlight_end":6},{"text":"    digit_prefix_full(digits, width, index);","highlight_start":1,"highlight_end":45},{"text":"    digit_prefix_split(digits, width, index + 1, digits.len() as int);","highlight_start":1,"highlight_end":71},{"text":"    digit_weight_step(width, index as nat);","highlight_start":1,"highlight_end":44},{"text":"    let upper = digit_value(digits.subrange(index + 1, digits.len() as int), width);","highlight_start":1,"highlight_end":85},{"text":"    let offset = width * index as nat;","highlight_start":1,"highlight_end":39},{"text":"    assert(digit_value(digits, width) + 1","highlight_start":1,"highlight_end":42},{"text":"        == (odd * pow2(ones) + pow2(width) * upper) * pow2(offset))","highlight_start":1,"highlight_end":68},{"text":"        by (nonlinear_arith)","highlight_start":1,"highlight_end":29},{"text":"        requires digit_prefix(digits, width, index) + 1 == digit_weight(width, index as nat),","highlight_start":1,"highlight_end":94},{"text":"            digit_value(digits, width) == digit_prefix(digits, width, index + 1)","highlight_start":1,"highlight_end":81},{"text":"                + digit_weight(width, index as nat + 1) * upper,","highlight_start":1,"highlight_end":65},{"text":"            digit_prefix(digits, width, index + 1) == digit_prefix(digits, width, index)","highlight_start":1,"highlight_end":89},{"text":"                + digits[index] * digit_weight(width, index as nat),","highlight_start":1,"highlight_end":69},{"text":"            digits[index] + 1 == odd * pow2(ones), digit_weight(width, index as nat) == pow2(offset),","highlight_start":1,"highlight_end":102},{"text":"            digit_weight(width, index as nat + 1) == digit_weight(width, index as nat) * pow2(width);","highlight_start":1,"highlight_end":102},{"text":"    upper_digits_preserve_odd_factor(odd, ones, width, upper, offset);","highlight_start":1,"highlight_end":71},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"pub(crate) open spec fn normalized_digits(digits: Seq<nat>, width: nat) -> bool {","highlight_start":1,"highlight_end":82},{"text":"    (forall|index: int| 0 <= index < digits.len() ==> #[trigger] digits[index] < pow2(width))","highlight_start":1,"highlight_end":94},{"text":"        && (digits.len() == 0 || digits[digits.len() - 1] > 0)","highlight_start":1,"highlight_end":63},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"pub(crate) proof fn normalized_zero_iff_empty(digits: Seq<nat>, width: nat)","highlight_start":1,"highlight_end":76},{"text":"    requires normalized_digits(digits, width),","highlight_start":1,"highlight_end":47},{"text":"    ensures digit_value(digits, width) == 0 <==> digits.len() == 0,","highlight_start":1,"highlight_end":68},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    digit_prefix_zero(digits, width, digits.len() as int);","highlight_start":1,"highlight_end":59},{"text":"    if digits.len() > 0 && digit_value(digits, width) == 0 {","highlight_start":1,"highlight_end":61},{"text":"        assert(digits[digits.len() - 1] == 0);","highlight_start":1,"highlight_end":47},{"text":"    }","highlight_start":1,"highlight_end":6},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"pub(crate) proof fn normalized_digit_bit_length(digits: Seq<nat>, width: nat, top_bits: nat)","highlight_start":1,"highlight_end":93},{"text":"    requires normalized_digits(digits, width), digits.len() > 0,","highlight_start":1,"highlight_end":65},{"text":"        crate::magnitude_model::has_bit_length(digits[digits.len() - 1], top_bits),","highlight_start":1,"highlight_end":84},{"text":"    ensures crate::magnitude_model::has_bit_length(digit_value(digits, width),","highlight_start":1,"highlight_end":79},{"text":"        width * ((digits.len() - 1) as nat) + top_bits),","highlight_start":1,"highlight_end":57},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    let last = digits.len() as int - 1;","highlight_start":1,"highlight_end":40},{"text":"    let top = digits[last];","highlight_start":1,"highlight_end":28},{"text":"    let lower = digit_prefix(digits, width, last);","highlight_start":1,"highlight_end":51},{"text":"    let offset = width * last as nat;","highlight_start":1,"highlight_end":38},{"text":"    let unit = digit_weight(width, last as nat);","highlight_start":1,"highlight_end":49},{"text":"    let bits = offset + top_bits;","highlight_start":1,"highlight_end":34},{"text":"    digit_prefix_bound(digits, width, last);","highlight_start":1,"highlight_end":45},{"text":"    lemma_pow2_pos(offset);","highlight_start":1,"highlight_end":28},{"text":"    lemma_pow2_adds(offset, (top_bits - 1) as nat);","highlight_start":1,"highlight_end":52},{"text":"    lemma_pow2_adds(offset, top_bits);","highlight_start":1,"highlight_end":39},{"text":"    assert(pow2((bits - 1) as nat) <= digit_value(digits, width)","highlight_start":1,"highlight_end":65},{"text":"        && digit_value(digits, width) < pow2(bits)) by (nonlinear_arith)","highlight_start":1,"highlight_end":73},{"text":"        requires unit > 0, 0 <= lower < unit,","highlight_start":1,"highlight_end":46},{"text":"            pow2((top_bits - 1) as nat) <= top, top < pow2(top_bits),","highlight_start":1,"highlight_end":70},{"text":"            digit_value(digits, width) == lower + top * unit,","highlight_start":1,"highlight_end":62},{"text":"            pow2((bits - 1) as nat) == unit * pow2((top_bits - 1) as nat),","highlight_start":1,"highlight_end":75},{"text":"            pow2(bits) == unit * pow2(top_bits);","highlight_start":1,"highlight_end":49},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"pub(crate) proof fn zero_scan_determines_power_of_two(","highlight_start":1,"highlight_end":55},{"text":"    digits: Seq<nat>, width: nat, index: int, zeros: nat, odd: nat, bits: nat,","highlight_start":1,"highlight_end":79},{"text":")","highlight_start":1,"highlight_end":2},{"text":"    requires width > 0, 0 <= index < digits.len(), zeros < width,","highlight_start":1,"highlight_end":66},{"text":"        forall|lower: int| 0 <= lower < index ==> #[trigger] digits[lower] == 0,","highlight_start":1,"highlight_end":81},{"text":"        odd > 0, odd % 2 == 1, digits[index] == odd * pow2(zeros),","highlight_start":1,"highlight_end":67},{"text":"        crate::magnitude_model::has_bit_length(digit_value(digits, width), bits),","highlight_start":1,"highlight_end":82},{"text":"    ensures (width * index as nat + zeros == (bits - 1) as nat)","highlight_start":1,"highlight_end":64},{"text":"        == (digit_value(digits, width) == pow2((bits - 1) as nat)),","highlight_start":1,"highlight_end":68},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    first_nonzero_digit_factor(digits, width, index, zeros, odd);","highlight_start":1,"highlight_end":66},{"text":"    let count = width * index as nat + zeros;","highlight_start":1,"highlight_end":46},{"text":"    let value = digit_value(digits, width);","highlight_start":1,"highlight_end":44},{"text":"    crate::bit_length_model::trailing_zeros_determine_power_of_two(","highlight_start":1,"highlight_end":68},{"text":"        value, bits, count, value / pow2(count));","highlight_start":1,"highlight_end":50},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"pub(crate) proof fn one_scan_determines_all_ones(","highlight_start":1,"highlight_end":50},{"text":"    digits: Seq<nat>, width: nat, index: int, ones: nat, odd: nat, bits: nat,","highlight_start":1,"highlight_end":78},{"text":")","highlight_start":1,"highlight_end":2},{"text":"    requires width > 0, 0 <= index < digits.len(), ones <= width,","highlight_start":1,"highlight_end":66},{"text":"        forall|lower: int| 0 <= lower < index ==> #[trigger] digits[lower] + 1 == pow2(width),","highlight_start":1,"highlight_end":95},{"text":"        digits[index] + 1 < pow2(width),","highlight_start":1,"highlight_end":41},{"text":"        odd > 0, odd % 2 == 1, digits[index] + 1 == odd * pow2(ones),","highlight_start":1,"highlight_end":70},{"text":"        crate::magnitude_model::has_bit_length(digit_value(digits, width), bits),","highlight_start":1,"highlight_end":82},{"text":"    ensures (width * index as nat + ones == bits)","highlight_start":1,"highlight_end":50},{"text":"        == (digit_value(digits, width) + 1 == pow2(bits)),","highlight_start":1,"highlight_end":59},{"text":"{","highlight_start":1,"highlight_end":2},{"text":"    first_nonmaximal_digit_factor(digits, width, index, ones, odd);","highlight_start":1,"highlight_end":68},{"text":"    let count = width * index as nat + ones;","highlight_start":1,"highlight_end":45},{"text":"    let value = digit_value(digits, width);","highlight_start":1,"highlight_end":44},{"text":"    crate::bit_length_model::trailing_ones_determine_all_ones(","highlight_start":1,"highlight_end":63},{"text":"        value, bits, count, (value + 1) / pow2(count));","highlight_start":1,"highlight_end":56},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"pub(crate) proof fn full_d