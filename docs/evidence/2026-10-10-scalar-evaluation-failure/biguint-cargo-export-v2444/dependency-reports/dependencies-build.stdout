st_nonzero_u64(words, index),"},{"highlight_end":50,"highlight_start":1,"text":"    ensures has_odd_factor(word_value_u64(words),"},{"highlight_end":74,"highlight_start":1,"text":"            64 * index as nat + u64_trailing_zeros(words[index]) as nat),"},{"highlight_end":90,"highlight_start":1,"text":"        64 * index as nat + (u64_trailing_zeros(words[index]) as nat) < 64 * words.len(),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":41,"highlight_start":1,"text":"    let digits = word_digits_u64(words);"},{"highlight_end":29,"highlight_start":1,"text":"    let word = words[index];"},{"highlight_end":59,"highlight_start":1,"text":"    crate::verified::gcd::trailing_zeros_factor_u64(word);"},{"highlight_end":49,"highlight_start":1,"text":"    let zeros = u64_trailing_zeros(word) as nat;"},{"highlight_end":57,"highlight_start":1,"text":"    let odd = (word >> u64_trailing_zeros(word)) as nat;"},{"highlight_end":92,"highlight_start":1,"text":"    assert forall|lower: int| 0 <= lower < index implies #[trigger] digits[lower] == 0 by {"},{"highlight_end":35,"highlight_start":1,"text":"        assert(words[lower] == 0);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":63,"highlight_start":1,"text":"    first_nonzero_digit_factor(digits, 64, index, zeros, odd);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":68,"highlight_start":1,"text":"pub(crate) proof fn typed_one_scan_u64(words: Seq<u64>, index: int)"},{"highlight_end":49,"highlight_start":1,"text":"    requires first_nonmaximal_u64(words, index),"},{"highlight_end":54,"highlight_start":1,"text":"    ensures has_odd_factor(word_value_u64(words) + 1,"},{"highlight_end":73,"highlight_start":1,"text":"            64 * index as nat + u64_trailing_ones(words[index]) as nat),"},{"highlight_end":89,"highlight_start":1,"text":"        64 * index as nat + (u64_trailing_ones(words[index]) as nat) < 64 * words.len(),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":41,"highlight_start":1,"text":"    let digits = word_digits_u64(words);"},{"highlight_end":29,"highlight_start":1,"text":"    let word = words[index];"},{"highlight_end":61,"highlight_start":1,"text":"    crate::bit_length_model::trailing_ones_factor_u64(word);"},{"highlight_end":35,"highlight_start":1,"text":"    axiom_u64_trailing_ones(word);"},{"highlight_end":19,"highlight_start":1,"text":"    lemma2_to64();"},{"highlight_end":47,"highlight_start":1,"text":"    let ones = u64_trailing_ones(word) as nat;"},{"highlight_end":46,"highlight_start":1,"text":"    let odd = (word as nat + 1) / pow2(ones);"},{"highlight_end":103,"highlight_start":1,"text":"    assert forall|lower: int| 0 <= lower < index implies #[trigger] digits[lower] + 1 == pow2(64) by {"},{"highlight_end":42,"highlight_start":1,"text":"        assert(words[lower] == u64::MAX);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":65,"highlight_start":1,"text":"    first_nonmaximal_digit_factor(digits, 64, index, ones, odd);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":62,"highlight_start":1,"text":"pub(crate) proof fn typed_zero_scan_none_u64(words: Seq<u64>)"},{"highlight_end":91,"highlight_start":1,"text":"    requires forall|index: int| 0 <= index < words.len() ==> #[trigger] words[index] == 0,"},{"highlight_end":40,"highlight_start":1,"text":"    ensures word_value_u64(words) == 0,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":41,"highlight_start":1,"text":"    let digits = word_digits_u64(words);"},{"highlight_end":99,"highlight_start":1,"text":"    assert forall|index: int| 0 <= index < digits.len() implies #[trigger] digits[index] == 0 by {"},{"highlight_end":35,"highlight_start":1,"text":"        assert(words[index] == 0);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":56,"highlight_start":1,"text":"    digit_prefix_zero(digits, 64, digits.len() as int);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":61,"highlight_start":1,"text":"pub(crate) proof fn typed_one_scan_none_u64(words: Seq<u64>)"},{"highlight_end":98,"highlight_start":1,"text":"    requires forall|index: int| 0 <= index < words.len() ==> #[trigger] words[index] == u64::MAX,"},{"highlight_end":73,"highlight_start":1,"text":"    ensures has_odd_factor(word_value_u64(words) + 1, 64 * words.len()),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":41,"highlight_start":1,"text":"    let digits = word_digits_u64(words);"},{"highlight_end":19,"highlight_start":1,"text":"    lemma2_to64();"},{"highlight_end":110,"highlight_start":1,"text":"    assert forall|index: int| 0 <= index < digits.len() implies #[trigger] digits[index] + 1 == pow2(64) by {"},{"highlight_end":42,"highlight_start":1,"text":"        assert(words[index] == u64::MAX);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":40,"highlight_start":1,"text":"    all_full_digits_factor(digits, 64);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":83,"highlight_start":1,"text":"pub(crate) proof fn typed_zero_suffix_truncation_u64(words: Seq<u64>, length: int)"},{"highlight_end":41,"highlight_start":1,"text":"    requires 0 <= length <= words.len(),"},{"highlight_end":46,"highlight_start":1,"text":"        length == 0 || words[length - 1] > 0,"},{"highlight_end":91,"highlight_start":1,"text":"        forall|index: int| length <= index < words.len() ==> #[trigger] words[index] == 0,"},{"highlight_end":80,"highlight_start":1,"text":"    ensures word_value_u64(words.subrange(0, length)) == word_value_u64(words),"},{"highlight_end":51,"highlight_start":1,"text":"        normalized_u64(words.subrange(0, length)),"},{"highlight_end":2,"highligh