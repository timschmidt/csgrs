r) <= subtotal(products, scale, negative, upper),"},{"highlight_end":29,"highlight_start":1,"text":"    decreases upper - lower,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":89,"highlight_start":1,"text":"    if upper > lower { subtotal_monotone(products, scale, negative, lower, upper - 1); }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":90,"highlight_start":1,"text":"pub(crate) proof fn subtotals_denote_sum(products: Seq<Product>, scale: nat, length: int)"},{"highlight_end":44,"highlight_start":1,"text":"    requires 0 <= length <= products.len(),"},{"highlight_end":48,"highlight_start":1,"text":"    ensures signed_sum(products, scale, length)"},{"highlight_end":109,"highlight_start":1,"text":"        == subtotal(products, scale, false, length) as int - subtotal(products, scale, true, length) as int,"},{"highlight_end":22,"highlight_start":1,"text":"    decreases length,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":73,"highlight_start":1,"text":"    if length > 0 { subtotals_denote_sum(products, scale, length - 1); }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":85,"highlight_start":1,"text":"/// Each aligned numerator denotes the original product over its binary denominator."},{"highlight_end":79,"highlight_start":1,"text":"pub(crate) proof fn alignment_preserves_fraction(product: Product, scale: nat)"},{"highlight_end":41,"highlight_start":1,"text":"    requires exponent(product) <= scale,"},{"highlight_end":107,"highlight_start":1,"text":"    ensures pow2(exponent(product)) == pow2(product.left_shift as nat) * pow2(product.right_shift as nat),"},{"highlight_end":84,"highlight_start":1,"text":"        signed(product.negative, aligned(product, scale)) * pow2(exponent(product))"},{"highlight_end":71,"highlight_start":1,"text":"        == signed(product.negative, magnitude(product)) * pow2(scale),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":76,"highlight_start":1,"text":"    lemma_pow2_adds(product.left_shift as nat, product.right_shift as nat);"},{"highlight_end":76,"highlight_start":1,"text":"    lemma_pow2_adds(exponent(product), (scale - exponent(product)) as nat);"},{"highlight_end":87,"highlight_start":1,"text":"    assert(signed(product.negative, aligned(product, scale)) * pow2(exponent(product))"},{"highlight_end":92,"highlight_start":1,"text":"        == signed(product.negative, magnitude(product)) * pow2(scale)) by (nonlinear_arith)"},{"highlight_end":100,"highlight_start":1,"text":"        requires pow2(scale) == pow2(exponent(product)) * pow2((scale - exponent(product)) as nat);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":76,"highlight_start":1,"text":"/// Raising the common denominator rescales the complete numerator exactly."},{"highlight_end":93,"highlight_start":1,"text":"pub(crate) proof fn rescale_sum(products: Seq<Product>, lower: nat, upper: nat, length: int)"},{"highlight_end":94,"highlight_start":1,"text":"    requires 0 <= length <= products.len(), common_scale(products, length) <= lower <= upper,"},{"highlight_end":48,"highlight_start":1,"text":"    ensures signed_sum(products, upper, length)"},{"highlight_end":79,"highlight_start":1,"text":"        == signed_sum(products, lower, length) * pow2((upper - lower) as nat),"},{"highlight_end":22,"highlight_start":1,"text":"    decreases length,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":20,"highlight_start":1,"text":"    if length > 0 {"},{"highlight_end":57,"highlight_start":1,"text":"        rescale_sum(products, lower, upper, length - 1);"},{"highlight_end":44,"highlight_start":1,"text":"        let product = products[length - 1];"},{"highlight_end":69,"highlight_start":1,"text":"        let lower_factor = pow2((lower - exponent(produ