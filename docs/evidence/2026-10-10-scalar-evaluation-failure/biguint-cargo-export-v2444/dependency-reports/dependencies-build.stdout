,"highlight_start":1,"text":"        leading_zeros_determine_word_bit_length(top);"},{"highlight_end":57,"highlight_start":1,"text":"        let bits = (64 - u64_leading_zeros(top)) as nat;"},{"highlight_end":41,"highlight_start":1,"text":"        let lower = prefix(words, last);"},{"highlight_end":40,"highlight_start":1,"text":"        let unit = weight(last as nat);"},{"highlight_end":35,"highlight_start":1,"text":"        prefix_bound(words, last);"},{"highlight_end":42,"highlight_start":1,"text":"        lemma_pow2_pos(64 * last as nat);"},{"highlight_end":62,"highlight_start":1,"text":"        lemma_pow2_adds(64 * last as nat, (bits - 1) as nat);"},{"highlight_end":49,"highlight_start":1,"text":"        lemma_pow2_adds(64 * last as nat, bits);"},{"highlight_end":52,"highlight_start":1,"text":"        assert(value(words) == lower + top * unit);"},{"highlight_end":73,"highlight_start":1,"text":"        assert(pow2((limb_bit_length(words) - 1) as nat) <= value(words)"},{"highlight_end":81,"highlight_start":1,"text":"            && value(words) < pow2(limb_bit_length(words))) by (nonlinear_arith)"},{"highlight_end":21,"highlight_start":1,"text":"            requires"},{"highlight_end":45,"highlight_start":1,"text":"                unit > 0, 0 <= lower < unit,"},{"highlight_end":66,"highlight_start":1,"text":"                pow2((bits - 1) as nat) <= top, top < pow2(bits),"},{"highlight_end":52,"highlight_start":1,"text":"                value(words) == lower + top * unit,"},{"highlight_end":93,"highlight_start":1,"text":"                pow2((limb_bit_length(words) - 1) as nat) == unit * pow2((bits - 1) as nat),"},{"highlight_end":67,"highlight_start":1,"text":"                pow2(limb_bit_length(words)) == unit * pow2(bits);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":75,"highlight_start":1,"text":"/// A positive normalized integer's exact bit length grows by the complete"},{"highlight_end":76,"highlight_start":1,"text":"/// mathematical shift. This is the width test used before a borrowed scan."},{"highlight_end":83,"highlight_start":1,"text":"pub(crate) proof fn binary_shift_bit_length(magnitude: nat, bits: nat, shift: nat)"},{"highlight_end":46,"highlight_start":1,"text":"    requires has_bit_length(magnitude, bits),"},{"highlight_end":67,"highlight_start":1,"text":"    ensures has_bit_length(magnitude * pow2(shift), bits + shift),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":27,"highlight_start":1,"text":"    lemma_pow2_pos(shift);"},{"highlight_end":47,"highlight_start":1,"text":"    lemma_pow2_adds((bits - 1) as nat, shift);"},{"highlight_end":34,"highlight_start":1,"text":"    lemma_pow2_adds(bits, shift);"},{"highlight_end":70,"highlight_start":1,"text":"    assert(pow2((bits + shift - 1) as nat) <= magnitude * pow2(shift)"},{"highlight_end":78,"highlight_start":1,"text":"        && magnitude * pow2(shift) < pow2(bits + shift)) by (nonlinear_arith)"},{"highlight_end":34,"highlight_start":1,"text":"        requires pow2(shift) > 0,"},{"highlight_end":86,"highlight_start":1,"text":"            pow2((bits + shift - 1) as nat) == pow2((bits - 1) as nat) * pow2(shift),"},{"highlight_end":60,"highlight_start":1,"text":"            pow2(bits + shift) == pow2(bits) * pow2(shift),"},{"highlight_end":63,"highlight_start":1,"text":"            pow2((bits - 1) as nat) <= magnitude < pow2(bits);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":76,"highlight_start":1,"text":"/// Distinct exact widths determine magnitude order without scanning limbs."},{"highlight_end":104,"highlight_start":1,"text":"pub(crate) proof fn bit_lengths_determine_order(left: nat, right: nat, left_bits: nat, right_bits: nat)"},{"highlight_end":105,"highlight_start":1,"text":"    requires has_bit_length(left, left_bits), has_bit_length(right, right_bits), left_bits < right_bits,"},{"highlight_end":26,"highlight_start":1,"text":"    ensures left < right,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":36,"highlight_start":1,"text":"    if left_bits < right_bits - 1 {"},{"highlight_end":75,"highlight_start":1,"text":"        lemma_pow2_strictly_increases(left_bits, (right_bits - 1) as nat);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":58,"highlight_start":1,"text":"pub(crate) proof fn trailing_zeros_factor_u32(value: u32)"},{"highlight_end":24,"highlight_start":1,"text":"    requires value > 0,"},{"highlight_end":12,"highlight_start":1,"text":"    ensures"},{"highlight_end":40,"highlight_start":1,"text":"        u32_trailing_zeros(value) < 32,"},{"highlight_end":59,"highlight_start":1,"text":"        0 < (value >> u32_trailing_zeros(value)) <= value,"},{"highlight_end":55,"highlight_start":1,"text":"        (value >> u32_trailing_zeros(value)) % 2 == 1,"},{"highlight_end":96,"highlight_start":1,"text":"        value == (value >> u32_trailing_zeros(value)) * pow2(u32_trailing_zeros(value) as nat),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":37,"highlight_start":1,"text":"    axiom_u32_trailing_zeros(value);"},{"highlight_end":50,"highlight_start":1,"text":"    let shift = u32_trailing_zeros(value) as u32;"},{"highlight_end":30,"highlight_start":1,"text":"    let odd = value >> shift;"},{"highlight_end":54,"highlight_start":1,"text":"    assert((value >> shift) % 2 == 1) by (bit_vector)"},{"highlight_end":50,"highlight_start":1,"text":"        requires (value >> shift) & 1u32 == 1u32;"},{"highlight_end":45,"highlight_start":1,"text":"    assert(0 < odd <= value) by (bit_vector)"},{"highlight_end":54,"highlight_start":1,"text":"        requires odd == value >> shift, odd % 2 == 1;"},{"highlight_end":74,"highlight_start":1,"text":"    vstd::bits::lemma_u32_mul_pow2_le_max_iff_max_shr(odd, shift, value);"},{"highlight_end":50,"highlight_start":1,"text":"    vstd::bits::lemma_u32_shl_is_mul(odd, shift);"},{"highlight_end":63,"highlight_start":1,"text":"    assert((value >> shift) << shift == value) by (bit_vector)"},{"highlight_end":66,"highlight_start":1,"text":"        requires shift < 32, value << ((32 - shift) as u32) == 0;"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":56,"highlight_start":1,"text":"pub(crate) proof fn trailing_ones_factor_u32(word: u32)"},{"highlight_end":12,"highlight_start":1,"text":"    ensures"},{"highlight_end":39,"highlight_start":1,"text":"        u32_trailing_ones(word) <= 32,"},{"highlight_end":59,"highlight_start":1,"text":"        ({let unit = pow2(u32_trailing_ones(word) as nat);"},{"highlight_end":43,"highlight_start":1,"text":"          let magnitude = word as nat + 1;"},{"highlight_end":35,"highlight_start":1,"text":"          &&& magnitude / unit > 0"},{"highlight_end":42,"highlight_start":1,"text":"          &&& (magnitude / unit) % 2 == 1"},{"highlight_end":56,"highlight_start":1,"text":"          &&& magnitude == (magnitude / unit) * unit}),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":35,"highlight_start":1,"text":"    axiom_u32_trailing_ones(word);"},{"highlight_end":28,"highlight_start":1,"text":"    let complement = !word;"},{"highlight_end":42,"highlight_start":1,"text":"    axiom_u32_trailing_zeros(complement);"},{"highlight_end":48,"highlight_start":1,"text":"    let shift = u32_trailing_ones(word) as nat;"},{"highlight_end":19,"highlight_start":1,"text":"    lemma2_to64();"},{"highlight_end":27,"highlight_start":1,"text":"    lemma_pow2_pos(shift);"},{"highlight_end":28,"highlight_start":1,"text":"    let unit = pow2(shift);"},{"highlight_end":37,"highlight_start":1,"text":"    let magnitude = word as nat + 1;"},{"highlight_end":86,"highlight_start":1,"text":"    assert((word as u128) + (complement as u128) == u32::MAX as u128) by (bit_vector)"},{"highlight_end":38,"highlight_start":1,"text":"        requires complement == !word;"},{"highlight_end":25,"highlight_start":1,"text":"    if complement == 0 {"},{"highlight_end":29,"highlight_start":1,"text":"        assert(shift == 32);"},{"highlight_end":35,"highlight_start":1,"text":"        assert(magnitude == unit);"},{"highlight_end":40,"highlight_start":1,"text":"        lemma_div_by_self(unit as int);"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":47,"highlight_start":1,"text":"        trailing_zeros_factor_u32(complement);"},{"highlight_end":73,"highlight_start":1,"text":"        let odd = (complement >> u32_trailing_zeros(complement)) as nat;"},{"highlight_end":47,"highlight_start":1,"text":"        let other = pow2((32 - shift) as nat);"},{"highlight_end":53,"highlight_start":1,"text":"        lemma_pow2_adds(shift, (32 - shift) as nat);"},{"highlight_end":85,"highlight_start":1,"text":"        assert(magnitude == (other as int - odd as int) * unit) by (nonlinear_arith)"},{"highlight_end":66,"highlight_start":1,"text":"            requires word as nat + complement as nat == u32::MAX,"},{"highlight_end":46,"highlight_start":1,"text":"                magnitude == word as nat + 1,"},{"highlight_end":42,"highlight_start":1,"text":"                complement == odd * unit,"},{"highlight_end":49,"highlight_start":1,"text":"                pow2(32) == u32::MAX as nat + 1,"},{"highlight_end":42,"highlight_start":1,"text":"                pow2(32) == unit * other;"},{"highlight_end":49,"highlight_start":1,"text":"        assert(other > odd) by (nonlinear_arith)"},{"highlight_end":46,"highlight_start":1,"text":"            requires magnitude > 0, unit > 0,"},{"highlight_end":65,"highlight_start":1,"text":"                magnitude == (other as int - odd as int) * unit;"},{"highlight_end":45,"highlight_start":1,"text":"        let quotient = (other - odd) as nat;"},{"highlight_end":99,"highlight_start":1,"text":"        lemma_fundamental_div_mod_converse_div(magnitude as int, unit as int, quotient as int, 0);"},{"highlight_end":48,"highlight_start":1,"text":"        lemma_pow2_unfold((32 - shift) as nat);"},{"highlight_end":46,"highlight_start":1,"text":"        let half = pow2((31 - shift) as nat);"},{"highlight_end":50,"highlight_start":1,"text":"        lemma_fundamental_div_mod(odd as int, 2);"},{"highlight_end":81,"highlight_start":1,"text":"        assert(quotient as int == 2 * (half as int - (odd as int) / 2 - 1) + 1);"},{"highlight_end":78,"highlight_start":1,"text":"        lemma_mod_multiples_vanish(half as int - (odd as int) / 2 - 1, 1, 2);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":56,"highlight_start":1,"text":"pub(crate) proof fn trailing_ones_factor_u64(word: u64)"},{"highlight_end":12,"highlight_start":1,"text":"    ensures"},{"highlight_end":39,"highlight_start":1,"text":"        u64_trailing_ones(word) <= 64,"},{"highlight_end":59,"highlight_start":1,"text":"        ({let unit = pow2(u64_trailing_ones(word) as nat);"},{"highlight_end":43,"highlight_start":1,"text":"          let magnitude = word as nat + 1;"},{"highlight_end":35,"highlight_start":1,"text":"          &&& magnitude / unit > 0"},{"highlight_end":42,"highlight_start":1,"text":"          &&& (magnitude / unit) % 2 == 1"},{"highlight_end":56,"highlight_start":1,"text":"          &&& magnitude == (magnitude / unit) * unit}),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":35,"highlight_start":1,"text":"    axiom_u64_trailing_ones(word);"},{"highlight_end":28,"highlight_start":1,"text":"    let complement = !word;"},{"highlight_end":42,"highlight_start":1,"text":"    axiom_u64_trailing_zeros(complement);"},{"highlight_end":48,"highlight_start":1,"text":"    let shift = u64_trailing_ones(word) as nat;"},{"highlight_end":19,"highlight_start":1,"text":"    lemma2_to64();"},{"highlight_end":27,"highlight_start":1,"text":"    lemma_pow2_pos(shift);"},{"highlight_end":28,"highlight_start":1,"text":"    let unit = pow2(shift);"},{"highlight_end":37,"highlight_start":1,"text":"    let magnitude = word as nat + 1;"},{"highlight_end":86,"highlight_start":1,"text":"    assert((word as u128) + (complement as u128) == u64::MAX as u128) by (bit_vector)"},{"highlight_end":38,"highlight_start":1,"text":"        requires complement == !word;"},{"highlight_end":25,"highlight_start":1,"text":"    if complement == 0 {"},{"highlight_end":29,"highlight_start":1,"text":"        assert(shift == 64);"},{"highlight_end":35,"highlight_start":1,"text":"        assert(magnitude == unit);"},{"highlight_end":40,"highlight_start":1,"text":"        lemma_div_by_self(unit as int);"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":69,"highlight_start":1,"text":"        crate::verified::gcd::trailing_zeros_factor_u64(complement);"},{"highlight_end":73,"highlight_start":1,"text":"        let odd = (complement >> u64_trailing_zeros(complement)) as nat;"},{"highlight_end":47,"highlight_start":1,"text":"        let other = pow2((64 - shift) as nat);"},{"highlight_end":53,"highlight_start":1,"text":"        lemma_pow2_adds(shift, (64 - shift) as nat);"},{"highlight_end":85,"highlight_start":1,"text":"        assert(magnitude == (other as int - odd as int) * unit) by (nonlinear_arith)"},{"highlight_end":66,"highlight_start":1,"text":"            requires word as nat + complement as nat == u64::MAX,"},{"highlight_end":46,"highlight_start":1,"text":"                magnitude == word as nat + 1,"},{"highlight_end":42,"highlight_start":1,"text":"                complement == odd * unit,"},{"highlight_end":49,"highlight_start":1,"text":"                pow2(64) == u64::MAX as nat + 1,"},{"highlight_end":42,"highlight_start":1,"text":"                pow2(64) == unit * other;"},{"highlight_end":49,"highlight_start":1,"text":"        assert(other > odd) by (nonlinear_arith)"},{"highlight_end":46,"highlight_start":1,"text":"            requires magnitude > 0, unit > 0,"},{"highlight_end":65,"highlight_start":1,"text":"                magnitude == (other as int - odd as int) * unit;"},{"highlight_end":45,"highlight_start":1,"text":"        let quotient = (other - odd) as nat;"},{"highlight_end":99,"highlight_start":1,"text":"        lemma_fundamental_div_mod_converse_div(magnitude as int, unit as int, quotient as int, 0);"},{"highlight_end":48,"highlight_start":1,"text":"        lemma_pow2_unfold((64 - shift) as nat);"},{"highlight_end":46,"highlight_start":1,"text":"        let half = pow2((63 - shift) as nat);"},{"highlight_end":50,"highlight_start":1,"text":"        lemma_fundamental_div_mod(odd as int, 2);"},{"highlight_end":81,"highlight_start":1,"text":"        assert(quotient as int == 2 * (half as int - (odd as int) / 2 - 1) + 1);"},{"highlight_end":78,"highlight_start":1,"text":"        lemma_mod_multiples_vanish(half as int - (odd as int) / 2 - 1, 1, 2);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":81,"highlight_start":1,"text":"// These arithmetic bridges consume an odd-factor certificate. Actual dependency"},{"highlight_end":78,"highlight_start":1,"text":"// storage, first-match scans and machine-width metadata imports remain open."},{"highlight_end":85,"highlight_start":1,"text":"pub(crate) proof fn odd_factor_of_power_is_unit(odd: nat, shift: nat, exponent: nat)"},{"highlight_end":36,"highlight_start":1,"text":"    requires odd > 0, odd % 2 == 1,"},{"highlight_end":45,"highlight_start":1,"text":"        odd * pow2(shift) == pow2(exponent),"},{"highlight_end":41,"highlight_start":1,"text":"    ensures odd == 1, shift == exponent,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":27,"highlight_start":1,"text":"    lemma_pow2_pos(shift);"},{"highlight_end":30,"highlight_start":1,"text":"    lemma_pow2_pos(exponent);"},{"highlight_end":26,"highlight_start":1,"text":"    if shift > exponent {"},{"highlight_end":56,"highlight_start":1,"text":"        lemma_pow2_strictly_increases(exponent, shift);"},{"highlight_end":43,"highlight_start":1,"text":"        assert(false) by (nonlinear_arith)"},{"highlight_end":60,"highlight_start":1,"text":"            requires odd > 0, pow2(shift) > pow2(exponent),"},{"highlight_end":70,"highlight_start":1,"text":"                pow2(shift) > 0, odd * pow2(shift) == pow2(exponent);"},{"highlight_end":33,"highlight_start":1,"text":"    } else if shift < exponent {"},{"highlight_end":52,"highlight_start":1,"text":"        let difference = (exponent - shift) as nat;"},{"highlight_end":44,"highlight_start":1,"text":"        lemma_pow2_adds(shift, difference);"},{"highlight_end":61,"highlight_start":1,"text":"        assert(odd == pow2(difference)) by (nonlinear_arith)"},{"highlight_end":38,"highlight_start":1,"text":"            requires pow2(shift) > 0,"},{"highlight_end":53,"highlight_start":1,"text":"                odd * pow2(shift) == pow2(exponent),"},{"highlight_end":66,"highlight_start":1,"text":"                pow2(exponent) == pow2(shift) * pow2(difference);"},{"highlight_end":39,"highlight_start":1,"text":"        lemma_pow2_unfold(difference);"},{"highlight_end":50,"highlight_start":1,"text":"        let half = pow2((difference - 1) as nat);"},{"highlight_end":55,"highlight_start":1,"text":"        lemma_mod_multiples_vanish(half as int, 0, 2);"},{"highlight_end":30,"highlight_start":1,"text":"        assert(odd % 2 == 0);"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":46,"highlight_start":1,"text":"        assert(odd == 1) by (nonlinear_arith)"},{"highlight_end":72,"highlight_start":1,"text":"            requires pow2(shift) > 0, odd * pow2(shift) == pow2(shift);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":59,"highlight_start":1,"text":"pub(crate) proof fn trailing_zeros_determine_power_of_two("},{"highlight_end":53,"highlight_start":1,"text":"    magnitude: nat, bits: nat, zeros: nat, odd: nat,"},{"highlight_end":2,"highlight_start":1,"text":")"},{"highlight_end":46,"highlight_start":1,"text":"    requires has_bit_length(magnitude, bits),"},{"highlight_end":63,"highlight_start":1,"text":"        odd > 0, odd % 2 == 1, magnitude == odd * pow2(zeros),"},{"highlight_end":84,"highlight_start":1,"text":"    ensures (zeros == (bits - 1) as nat) == (magnitude == pow2((bits - 1) as nat)),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":38,"highlight_start":1,"text":"    let exponent = (bits - 1) as nat;"},{"highlight_end":30,"highlight_start":1,"text":"    lemma_pow2_pos(exponent);"},{"highlight_end":29,"highlight_start":1,"text":"    lemma_pow2_unfold(bits);"},{"highlight_end":27,"highlight_start":1,"text":"    if zeros == exponent {"},{"highlight_end":45,"highlight_start":1,"text":"        assert(odd < 2) by (nonlinear_arith)"},{"highlight_end":56,"highlight_start":1,"text":"            requires magnitude == odd * pow2(exponent),"},{"highlight_end":68,"highlight_start":1,"text":"                magnitude < 2 * pow2(exponent), pow2(exponent) > 0;"},{"highlight_end":26,"highlight_start":1,"text":"        assert(odd == 1);"},{"highlight_end":44,"highlight_start":1,"text":"    } else if magnitude == pow2(exponent) {"},{"highlight_end":59,"highlight_start":1,"text":"        odd_factor_of_power_is_unit(odd, zeros, exponent);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":54,"highlight_start":1,"text":"pub(crate) proof fn trailing_ones_determine_all_ones("},{"highlight_end":52,"highlight_start":1,"text":"    magnitude: nat, bits: nat, ones: nat, odd: nat,"},{"highlight_end":2,"highlight_start":1,"text":")"},{"highlight_end":46,"highlight_start":1,"text":"    requires has_bit_length(magnitude, bits),"},{"highlight_end":66,"highlight_start":1,"text":"        odd > 0, odd % 2 == 1, magnitude + 1 == odd * pow2(ones),"},{"highlight_end":61,"highlight_start":1,"text":"    ensures (ones == bits) == (magnitude + 1 == pow2(bits)),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":26,"highlight_start":1,"text":"    lemma_pow2_pos(bits);"},{"highlight_end":22,"highlight_start":1,"text":"    if ones == bits {"},{"highlight_end":46,"highlight_start":1,"text":"        assert(odd <= 1) by (nonlinear_arith)"},{"highlight_end":56,"highlight_start":1,"text":"            requires magnitude + 1 == odd * pow2(bits),"},{"highlight_end":61,"highlight_start":1,"text":"                magnitude + 1 <= pow2(bits), pow2(bits) > 0;"},{"highlight_end":26,"highlight_start":1,"text":"        assert(odd == 1);"},{"highlight_end":44,"highlight_start":1,"text":"    } else if magnitude + 1 == pow2(bits) {"},{"highlight_end":54,"highlight_start":1,"text":"        odd_factor_of_power_is_unit(odd, ones, bits);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":2,"highlight_start":1,"text":"}"}]}},"file_name":"/home/tim/Documents/GitHub/workspace/csgrs/target/scalar-evaluation-candidate/source/crates/hyperreal/verification/bit_length_model.rs","is_primary":true,"label":null,"line_end":298,"line_start":10,"suggested_replacement":null,"suggestion_applicability":null,"text":[{"highlight_end":9,"highlight_start":1,"text":"verus! {"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":78,"highlight_start":1,"text":"/// The recursive standard-library specification determines the exact binade,"},{"highlight_end":69,"highlight_start":1,"text":"/// including a word whose top bit occupies the entire native width."},{"highlight_end":71,"highlight_start":1,"text":"pub(crate) proof fn leading_zeros_determine_word_bit_length(word: u64)"},{"highlight_end":12,"highlight_start":1,"text":"    ensures"},{"highlight_end":44,"highlight_start":1,"text":"        0 <= u64_leading_zeros(word) <= 64,"},{"highlight_end":54,"highlight_start":1,"text":"        word == 0 <==> u64_leading_zeros(word) == 64,"},{"highlight_end":89,"highlight_start":1,"text":"        word > 0 ==> has_bit_length(word as nat, (64 - u64_leading_zeros(word)) as nat),"},{"highlight_end":20,"highlight_start":1,"text":"    decreases word,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":35,"highlight_start":1,"text":"    axiom_u64_leading_zeros(word);"},{"highlight_end":31,"highlight_start":1,"text":"    reveal(u64_leading_zeros);"},{"highlight_end":19,"highlight_start":1,"text":"    if word == 1 {"},{"highlight_end":35,"highlight_start":1,"text":"        reveal(u64_leading_zeros);"},{"highlight_end":23,"highlight_start":1,"text":"        lemma2_to64();"},{"highlight_end":25,"highlight_start":1,"text":"    } else if word > 1 {"},{"highlight_end":29,"highlight_start":1,"text":"        let half = word / 2;"},{"highlight_end":55,"highlight_start":1,"text":"        leading_zeros_determine_word_bit_length(half);"},{"highlight_end":62,"highlight_start":1,"text":"        let previous = (64 - u64_leading_zeros(half)) as nat;"},{"highlight_end":30,"highlight_start":1,"text":"        assert(previous > 0);"},{"highlight_end":51,"highlight_start":1,"text":"        lemma_fundamental_div_mod(word as int, 2);"},{"highlight_end":41,"highlight_start":1,"text":"        lemma_mod_bound(word as int, 2);"},{"highlight_end":37,"highlight_start":1,"text":"        lemma_pow2_unfold(previous);"},{"highlight_end":41,"highlight_start":1,"text":"        lemma_pow2_unfold(previous + 1);"},{"highlight_end":89,"highlight_start":1,"text":"        assert(pow2(previous) <= word && word < pow2(previous + 1)) by (nonlinear_arith)"},{"highlight_end":21,"highlight_start":1,"text":"            requires"},{"highlight_end":67,"highlight_start":1,"text":"                pow2(previous) == 2 * pow2((previous - 1) as nat),"},{"highlight_end":58,"highlight_start":1,"text":"                pow2(previous + 1) == 2 * pow2(previous),"},{"highlight_end":76,"highlight_start":1,"text":"                pow2((previous - 1) as nat) <= half, half < pow2(previous),"},{"highlight_end":70,"highlight_start":1,"text":"                word as int == 2 * (half as int) + (word as int) % 2,"},{"highlight_end":44,"highlight_start":1,"text":"                0 <= (word as int) % 2 < 2;"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":68,"highlight_start":1,"text":"pub(crate) open spec fn normalized_words(words: Seq<u64>) -> bool {"},{"highlight_end":51,"highlight_start":1,"text":"    words.len() == 0 || words[words.len() - 1] > 0"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":66,"highlight_start":1,"text":"pub(crate) open spec fn limb_bit_length(words: Seq<u64>) -> nat {"},{"highlight_end":30,"highlight_start":1,"text":"    if words.len() == 0 { 0 }"},{"highlight_end":94,"highlight_start":1,"text":"    else { (64 * (words.len() - 1) + 64 - u64_leading_zeros(words[words.len() - 1])) as nat }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":74,"highlight_start":1,"text":"/// There is no machine-width truncation in this mathematical length. The"},{"highlight_end":81,"highlight_start":1,"text":"/// dependency import still must establish canonical top limbs and range checks."},{"highlight_end":64,"highlight_start":1,"text":"pub(crate) proof fn normalized_limb_bit_length(words: Seq<u64>)"},{"highlight_end":38,"highlight_start":1,"text":"    requires normalized_words(words),"},{"highlight_end":12,"highlight_start":1,"text":"    ensures"},{"highlight_end":79,"highlight_start":1,"text":"        words.len() == 0 ==> value(words) == 0 && limb_bit_length(words) == 0,"},{"highlight_end":82,"highlight_start":1,"text":"        words.len() > 0 ==> has_bit_length(value(words), limb_bit_length(words)),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":25,"highlight_start":1,"text":"    if words.len() > 0 {"},{"highlight_end":43,"highlight_start":1,"text":"        let last = words.len() as int - 1;"},{"highlight_end":31,"highlight_start":1,"text":"        let top = words[last];"},{"highlight_end":54,"highlight_start":1,"text":"        leading_zeros_determine_word_bit_length(top);"},{"highlight_end":57,"highlight_start":1,"text":"        let bits = (64 - u64_leading_zeros(top)) as nat;"},{"highlight_end":41,"highlight_start":1,"text":"        let lower = prefix(words, last);"},{"highlight_end":40,"highlight_start":1,"text":"        let unit = weight(last as nat);"},{"highlight_end":35,"highlight_start":1,"text":"        prefix_bound(words, last);"},{"highlight_end":42,"highlight_start":1,"text":"        lemma_pow2_pos(64 * last as nat);"},{"highlight_end":62,"highlight_start":1,"text":"        lemma_pow2_adds(64 * last as nat, (bits - 1) as nat);"},{"highlight_end":49,"highlight_start":1,"text":"        lemma_pow2_adds(64 * last as nat, bits);"},{"highlight_end":52,"highlight_start":1,"text":"        assert(value(words) == lower + top * unit);"},{"highlight_end":73,"highlight_start":1,"text":"        assert(pow2((limb_bit_length(words) - 1) as nat) <= value(words)"},{"highlight_end":81,"highlight_start":1,"text":"            && value(words) < pow2(limb_bit_length(words))) by (nonlinear_arith)"},{"highlight_end":21,"highlight_start":1,"text":"            requires"},{"highlight_end":45,"highlight_start":1,"text":"                unit > 0, 0 <= lower < unit,"},{"highlight_end":66,"highlight_start":1,"text":"                pow2((bits - 1) as nat) <= top, top < pow2(bits),"},{"highlight_end":52,"highlight_start":1,"text":"                value(words) == lower + top * unit,"},{"highlight_end":93,"highlight_start":1,"text":"                pow2((limb_bit_length(words) - 1) as nat) == unit * pow2((bits - 1) as nat),"},{"highlight_end":67,"highlight_start":1,"text":"                pow2(limb_bit_length(words)) == unit * pow2(bits);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":75,"highlight_start":1,"text":"/// A positive normalized integer's exact bit length grows by the complete"},{"highlight_end":76,"highlight_start":1,"text":"/// mathematical shift. This is the width test used before a borrowed scan."},{"highlight_end":83,"highlight_start":1,"text":"pub(crate) proof fn binary_shift_bit_length(magnitude: nat, bits: nat, shift: nat)"},{"highlight_end":46,"highlight_start":1,"text":"    requires has_bit_length(magnitude, bits),"},{"highlight_end":67,"highlight_start":1,"text":"    ensures has_bit_length(magnitude * pow2(shift), bits + shift),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":27,"highlight_start":1,"text":"    lemma_pow2_pos(shift);"},{"highlight_end":47,"highlight_start":1,"text":"    lemma_pow2_adds((bits - 1) as nat, shift);"},{"highlight_end":34,"highlight_start":1,"text":"    lemma_pow2_adds(bits, shift);"},{"highlight_end":70,"highlight_start":1,"text":"    assert(pow2((bits + shift - 1) as nat) <= magnitude * pow2(shift)"},{"highlight_end":78,"highlight_start":1,"text":"        && magnitude * pow2(shift) < pow2(bits + shift)) by (nonlinear_arith)"},{"highlight_end":34,"highlight_start":1,"text":"        requires pow2(shift) > 0,"},{"highlight_end":86,"highlight_start":1,"text":"            pow2((bits + shift - 1) as nat) == pow2((bits - 1) as nat) * pow2(shift),"},{"highlight_end":60,"highlight_start":1,"text":"            pow2(bits + shift) == pow2(bits) * pow2(shift),"},{"highlight_end":63,"highlight_start":1,"text":"            pow2((bits - 1) as nat) <= magnitude < pow2(bits);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":76,"highlight_start":1,"text":"/// Distinct exact widths determine magnitude order without scanning limbs."},{"highlight_end":104,"highlight_start":1,"text":"pub(crate) proof fn bit_lengths_determine_order(left: nat, right: nat, left_bits: nat, right_bits: nat)"},{"highlight_end":105,"highlight_start":1,"text":"    requires has_bit_length(left, left_bits), has_bit_length(right, right_bits), left_bits < right_bits,"},{"highlight_end":26,"highlight_start":1,"text":"    ensures left < right,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":36,"highlight_start":1,"text":"    if left_bits < right_bits - 1 {"},{"highlight_end":75,"highlight_start":1,"text":"        lemma_pow2_strictly_increases(left_bits, (right_bits - 1) as nat);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":58,"highlight_start":1,"text":"pub(crate) proof fn trailing_zeros_factor_u32(value: u32)"},{"highlight_end":24,"highlight_start":1,"text":"    requires value > 0,"},{"highlight_end":12,"highlight_start":1,"text":"    ensures"},{"highlight_end":40,"highlight_start":1,"text":"        u32_trailing_zeros(value) < 32,"},{"highlight_end":59,"highlight_start":1,"text":"        0 < (value >> u32_trailing_zeros(value)) <= value,"},{"highlight_end":55,"highlight_start":1,"text":"        (value >> u32_trailing_zeros(value)) % 2 == 1,"},{"highlight_end":96,"highlight_start":1,"text":"        value == (value >> u32_trailing_zeros(value)) * pow2(u32_trailing_zeros(value) as nat),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":37,"highlight_start":1,"text":"    axiom_u32_trailing_zeros(value);"},{"highlight_end":50,"highlight_start":1,"text":"    let shift = u32_trailing_zeros(value) as u32;"},{"highlight_end":30,"highlight_start":1,"text":"    let odd = value >> shift;"},{"highlight_end":54,"highlight_start":1,"text":"    assert((value >> shift) % 2 == 1) by (bit_vector)"},{"highlight_end":50,"highlight_start":1,"text":"        requires (value >> shift) & 1u32 == 1u32;"},{"highlight_end":45,"highlight_start":1,"text":"    assert(0 < odd <= value) by (bit_vector)"},{"highlight_end":54,"highlight_start":1,"text":"        requires odd == value >> shift, odd % 2 == 1;"},{"highlight_end":74,"highlight_start":1,"text":"    vstd::bits::lemma_u32_mul_pow2_le_max_iff_max_shr(odd, shift, value);"},{"highlight_end":50,"highlight_start":1,"text":"    vstd::bits::lemma_u32_shl_is_mul(odd, shift);"},{"highlight_end":63,"highlight_start":1,"text":"    assert((value >> shift) << shift == value) by (bit_vector)"},{"highlight_end":66,"highlight_start":1,"text":"        requires shift < 32, value << ((32 - shift) as u32) == 0;"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":56,"highlight_start":1,"text":"pub(crate) proof fn trailing_ones_factor_u32(word: u32)"},{"highlight_end":12,"highlight_start":1,"text":"    ensures"},{"highlight_end":39,"highlight_start":1,"text":"        u32_trailing_ones(word) <= 32,"},{"highlight_end":59,"highlight_start":1,"text":"        ({let unit = pow2(u32_trailing_ones(word) as nat);"},{"highlight_end":43,"highlight_start":1,"text":"          let magnitude = word as nat + 1;"},{"highlight_end":35,"highlight_start":1,"text":"          &&& magnitude / unit > 0"},{"highlight_end":42,"highlight_start":1,"text":"          &&& (magnitude / unit) % 2 == 1"},{"highlight_end":56,"highlight_start":1,"text":"          &&& magnitude == (magnitude / unit) * unit}),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":35,"highlight_start":1,"text":"    axiom_u32_trailing_ones(word);"},{"highlight_end":28,"highlight_start":1,"text":"    let complement = !word;"},{"highlight_end":42,"highlight_start":1,"text":"    axiom_u32_trailing_zeros(complement);"},{"highlight_end":48,"highlight_start":1,"text":"    let shift = u32_trailing_ones(word) as nat;"},{"highlight_end":19,"highlight_start":1,"text":"    lemma2_to64();"},{"highlight_end":27,"highlight_start":1,"text":"    lemma_pow2_pos(shift);"},{"highlight_end":28,"highlight_start":1,"text":"    let unit = pow2(shift);"},{"highlight_end":37,"highlight_start":1,"text":"    let magnitude = word as nat + 1;"},{"highlight_end":86,"highlight_start":1,"text":"    assert((word as u128) + (complement as u128) == u32::MAX as u128) by (bit_vector)"},{"highlight_end":38,"highlight_start":1,"text":"        requires complement == !word;"},{"highlight_end":25,"highlight_start":1,"text":"    if complement == 0 {"},{"highlight_end":29,"highlight_start":1,"text":"        assert(shift == 32);"},{"highlight_end":35,"highlight_start":1,"text":"        assert(magnitude == unit);"},{"highlight_end":40,"highlight_start":1,"text":"        lemma_div_by_self(unit as int);"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":47,"highlight_start":1,"text":"        trailing_zeros_factor_u32(complement);"},{"highlight_end":73,"highlight_start":1,"text":"        let odd = (complement >> u32_trailing_zeros(complement)) as nat;"},{"highlight_end":47,"highlight_start":1,"text":"        let other = pow2((32 - shift) as nat);"},{"highlight_end":53,"highlight_start":1,"text":"        lemma_pow2_adds(shift, (32 - shift) as nat);"},{"highlight_end":85,"highlight_start":1,"text":"        assert(magnitude == (other as int - odd as int) * unit) by (nonlinear_arith)"},{"highlight_end":66,"highlight_start":1,"text":"            requires word as nat + complement as nat == u32::MAX,"},{"highlight_end":46,"highlight_start":1,"text":"                magnitude == word as nat + 1,"},{"highlight_end":42,"highlight_start":1,"text":"                complement == odd * unit,"},{"highlight_end":49,"highlight_start":1,"text":"                pow2(32) == u32::MAX as nat + 1,"},{"highlight_end":42,"highlight_start":1,"text":"                pow2(32) == unit * other;"},{"highlight_end":49,"highlight_start":1,"text":"        assert(other > odd) by (nonlinear_arith)"},{"highlight_end":46,"highlight_start":1,"text":"            requires magnitude > 0, unit > 0,"},{"highlight_end":65,"highlight_start":1,"text":"                magnitude == (other as int - odd as int) * unit;"},{"highlight_end":45,"highlight_start":1,"text":"        let quotient = (other - odd) as nat;"},{"highlight_end":99,"highlight_start":1,"text":"        lemma_fundamental_div_mod_converse_div(magnitude as int, unit as int, quotient as int, 0);"},{"highlight_end":48,"highlight_start":1,"text":"        lemma_pow2_unfold((32 - shift) as nat);"},{"highlight_end":46,"highlight_start":1,"text":"        let half = pow2((31 - shift) as nat);"},{"highlight_end":50,"highlight_start":1,"text":"        lemma_fundamental_div_mod(odd as int, 2);"},{"highlight_end":81,"highlight_start":1,"text":"        assert(quotient as int == 2 * (half as int - (odd as int) / 2 - 1) + 1);"},{"highlight_end":78,"highlight_start":1,"text":"        lemma_mod_multiples_vanish(half as int - (odd as int) / 2 - 1, 1, 2);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":56,"highlight_start":1,"text":"pub(crate) proof fn trailing_ones_factor_u64(word: u64)"},{"highlight_end":12,"highlight_start":1,"text":"    ensures"},{"highlight_end":39,"highlight_start":1,"text":"        u64_trailing_ones(word) <= 64,"},{"highlight_end":59,"highlight_start":1,"text":"        ({let unit = pow2(u64_trailing_ones(word) as nat);"},{"highlight_end":43,"highlight_start":1,"text":"          let magnitude = word as nat + 1;"},{"highlight_end":35,"highlight_start":1,"text":"          &&& magnitude / unit > 0"},{"highlight_end":42,"highlight_start":1,"text":"          &&& (magnitude / unit) % 2 == 1"},{"highlight_end":56,"highlight_start":1,"text":"          &&& magnitude == (magnitude / unit) * unit}),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":35,"highlight_start":1,"text":"    axiom_u64_trailing_ones(word);"},{"highlight_end":28,"highlight_start":1,"text":"    let complement = !word;"},{"highlight_end":42,"highlight_start":1,"text":"    axiom_u64_trailing_zeros(complement);"},{"highlight_end":48,"highlight_start":1,"text":"    let shift = u64_trailing_ones(word) as nat;"},{"highlight_end":19,"highlight_start":1,"text":"    lemma2_to64();"},{"highlight_end":27,"highlight_start":1,"text":"    lemma_pow2_pos(shift);"},{"highlight_end":28,"highlight_start":1,"text":"    let unit = pow2(shift);"},{"highlight_end":37,"highlight_start":1,"text":"    let magnitude = word as nat + 1;"},{"highlight_end":86,"highlight_start":1,"text":"    assert((word as u128) + (complement as u128) == u64::MAX as u128) by (bit_vector)"},{"highlight_end":38,"highlight_start":1,"text":"        requires complement == !word;"},{"highlight_end":25,"highlight_start":1,"text":"    if complement == 0 {"},{"highlight_end":29,"highlight_start":1,"text":"        assert(shift == 64);"},{"highlight_end":35,"highlight_start":1,"text":"        assert(magnitude == unit);"},{"highlight_end":40,"highlight_start":1,"text":"        lemma_div_by_self(unit as int);"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":69,"highlight_start":1,"text":"        crate::verified::gcd::trailing_zeros_factor_u64(complement);"},{"highlight_end":73,"highlight_start":1,"text":"        let odd = (complement >> u64_trailing_zeros(complement)) as nat;"},{"highlight_end":47,"highlight_start":1,"text":"        let other = pow2((64 - shift) as nat);"},{"highlight_end":53,"highlight_start":1,"text":"        lemma_pow2_adds(shift, (64 - shift) as nat);"},{"highlight_end":85,"highlight_start":1,"text":"        assert(magnitude == (other as int - odd as int) * unit) by (nonlinear_arith)"},{"highlight_end":66,"highlight_start":1,"text":"            requires word as nat + complement as nat == u64::MAX,"},{"highlight_end":46,"highlight_start":1,"text":"                magnitude == word as nat + 1,"},{"highlight_end":42,"highlight_start":1,"text":"                complement == odd * unit,"},{"highlight_end":49,"highlight_start":1,"text":"                pow2(64) == u64::MAX as nat + 1,"},{"highlight_end":42,"highlight_start":1,"text":"                pow2(64) == unit * other;"},{"highlight_end":49,"highlight_start":1,"text":"        assert(other > odd) by (nonlinear_arith)"},{"highlight_end":46,"highlight_start":1,"text":"            requires magnitude > 0, unit > 0,"},{"highlight_end":65,"highlight_start":1,"text":"                magnitude == (other as int - odd as int) * unit;"},{"highlight_end":45,"highlight_start":1,"text":"        let quotient = (other - odd) as nat;"},{"highlight_end":99,"highlight_start":1,"text":"        lemma_fundamental_div_mod_converse_div(magnitude as int, unit as int, quotient as int, 0);"},{"highlight_end":48,"highlight_start":1,"text":"        lemma_pow2_unfold((64 - shift) as nat);"},{"highlight_end":46,"highlight_start":1,"text":"        let half = pow2((63 - shift) as nat);"},{"highlight_end":50,"highlight_start":1,"text":"        lemma_fundamental_div_mod(odd as int, 2);"},{"highlight_end":81,"highlight_start":1,"text":"        assert(quotient as int == 2 * (half as int - (odd as int) / 2 - 1) + 1);"},{"highlight_end":78,"highlight_start":1,"text":"        lemma_mod_multiples_vanish(half as int - (odd as int) / 2 - 1, 1, 2);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":81,"highlight_start":1,"text":"// These arithmetic bridges consume an odd-factor certificate. Actual dependency"},{"highlight_end":78,"highlight_start":1,"text":"// storage, first-match scans and machine-width metadata imports remain open."},{"highlight_end":85,"highlight_start":1,"text":"pub(crate) proof fn odd_factor_of_power_is_unit(odd: nat, shift: nat, exponent: nat)"},{"highlight_end":36,"highlight_start":1,"text":"    requires odd > 0, odd % 2 == 1,"},{"highlight_end":45,"highlight_start":1,"text":"        odd * pow2(shift) == pow2(exponent),"},{"highlight_end":41,"highlight_start":1,"text":"    ensures odd == 1, shift == exponent,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":27,"highlight_start":1,"text":"    lemma_pow2_pos(shift);"},{"highlight_end":30,"highlight_start":1,"text":"    lemma_pow2_pos(exponent);"},{"highlight_end":26,"highlight_start":1,"text":"    if shift > exponent {"},{"highlight_end":56,"highlight_start":1,"text":"        lemma_pow2_strictly_increases(exponent, shift);"},{"highlight_end":43,"highlight_start":1,"text":"        assert(false) by (nonlinear_arith)"},{"highlight_end":60,"highlight_start":1,"text":"            requires odd > 0, pow2(shift) > pow2(exponent),"},{"highlight_end":70,"highlight_start":1,"text":"                pow2(shift) > 0, odd * pow2(shift) == pow2(exponent);"},{"highlight_end":33,"highlight_start":1,"text":"    } else if shift < exponent {"},{"highlight_end":52,"highlight_start":1,"text":"        let difference = (exponent - shift) as nat;"},{"highlight_end":44,"highlight_start":1,"text":"        lemma_pow2_adds(shift, difference);"},{"highlight_end":61,"highlight_start":1,"text