ctor * (odd * remaining);"},{"highlight_end":76,"highlight_start":1,"text":"    lemma_fundamental_div_mod_converse_div(magnitude as int, factor as int,"},{"highlight_end":38,"highlight_start":1,"text":"        (odd * remaining) as int, 0);"},{"highlight_end":86,"highlight_start":1,"text":"    assert(odd * remaining > 0) by (nonlinear_arith) requires odd > 0, remaining > 0;"},{"highlight_end":76,"highlight_start":1,"text":"    assert(magnitude == (magnitude / factor) * factor) by (nonlinear_arith)"},{"highlight_end":97,"highlight_start":1,"text":"        requires magnitude == factor * (odd * remaining), magnitude / factor == odd * remaining;"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":78,"highlight_start":1,"text":"/// Exact cancellation preserves the signed fraction by cross multiplication."},{"highlight_end":50,"highlight_start":1,"text":"pub(crate) proof fn reduction_preserves_fraction("},{"highlight_end":82,"highlight_start":1,"text":"    negative: bool, before: nat, after: nat, before_shift: nat, after_shift: nat,"},{"highlight_end":2,"highlight_start":1,"text":")"},{"highlight_end":42,"highlight_start":1,"text":"    requires after_shift <= before_shift,"},{"highlight_end":69,"highlight_start":1,"text":"        before == after * pow2((before_shift - after_shift) as nat),"},{"highlight_end":57,"highlight_start":1,"text":"    ensures signed(negative, after) * pow2(before_shift)"},{"highlight_end":57,"highlight_start":1,"text":"        == signed(negative, before) * pow2(after_shift),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":71,"highlight_start":1,"text":"    lemma_pow2_adds(after_shift, (before_shift - after_shift) as nat);"},{"highlight_end":56,"highlight_start":1,"text":"    assert(signed(negative, after) * pow2(before_shift)"},{"highlight_end":78,"highlight_start":1,"text":"        == signed(negative, before) * pow2(after_shift)) by (nonlinear_arith)"},{"highlight_end":78,"highlight_start":1,"text":"        requires before == after * pow2((before_shift - after_shift) as nat),"},{"highlight_end":97,"highlight_start":1,"text":"            pow2(before_shift) == pow2(after_shift) * pow2((before_shift - after_shift) as nat);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":69,"highlight_start":1,"text":"pub(crate) proof fn canonical_is_reduced(magnitude: nat, shift: nat)"},{"highlight_end":47,"highlight_start":1,"text":"    requires shift == 0 || magnitude % 2 == 1,"},{"highlight_end":46,"highlight_start":1,"text":"    ensures gcd(magnitude, pow2(shift)) == 1,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":32,"highlight_start":1,"text":"    assert(magnitude % 1 == 0);"},{"highlight_end":28,"highlight_start":1,"text":"    assert(gcd(1, 0) == 1);"},{"highlight_end":36,"highlight_start":1,"text":"    assert(gcd(magnitude, 1) == 1);"},{"highlight_end":20,"highlight_start":1,"text":"    if shift == 0 {"},{"highlight_end":23,"highlight_start":1,"text":"        lemma2_to64();"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":60,"highlight_start":1,"text":"        super::gcd::gcd_odd_power_two(magnitude, 1, shift);"},{"highlight_end":72,"highlight_start":1,"text":"        assert(1nat * pow2(shift) == pow2(shift)) by (nonlinear_arith);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":2,"highlight_start":1,"text":"}"}]}],"code":{"code":"unexpected_cfgs","explanation":null}}}
