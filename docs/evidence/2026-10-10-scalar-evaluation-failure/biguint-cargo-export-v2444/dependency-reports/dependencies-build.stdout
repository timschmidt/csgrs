ight_start":1,"text":"{"},{"highlight_end":82,"highlight_start":1,"text":"    if lower < higher { lemma_pow2_strictly_increases(64 * lower, 64 * higher); }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":76,"highlight_start":1,"text":"/// The highest retained digit, including a possible shifted-out high part,"},{"highlight_end":71,"highlight_start":1,"text":"/// determines exactly the first buffer width that can hold the value."},{"highlight_end":76,"highlight_start":1,"text":"pub(crate) proof fn shifted_extent(source: Seq<u64>, last: int, shift: u64)"},{"highlight_end":57,"highlight_start":1,"text":"    requires 0 <= last < source.len(), source[last] > 0,"},{"highlight_end":90,"highlight_start":1,"text":"        forall|index: int| last < index < source.len() ==> #[trigger] source[index] == 0,"},{"highlight_end":15,"highlight_start":1,"text":"    ensures ({"},{"highlight_end":40,"highlight_start":1,"text":"        let bits = (shift % 64) as u32;"},{"highlight_end":74,"highlight_start":1,"text":"        let high = bits > 0 && source[last] >> ((64 - bits) as u32) != 0;"},{"highlight_end":72,"highlight_start":1,"text":"        let end = last + (if high { 1int } else { 0int }) + shift / 64;"},{"highlight_end":92,"highlight_start":1,"text":"        weight(end as nat) <= value(source) * pow2(shift as nat) < weight((end + 1) as nat)"},{"highlight_end":8,"highlight_start":1,"text":"    }),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":63,"highlight_start":1,"text":"    extend_prefix_zero(source, last + 1, source.len() as int);"},{"highlight_end":32,"highlight_start":1,"text":"    prefix_bound(source, last);"},{"highlight_end":36,"highlight_start":1,"text":"    prefix_bound(source, last + 1);"},{"highlight_end":36,"highlight_start":1,"text":"    let bits = (shift % 64) as u32;"},{"highlight_end":37,"highlight_start":1,"text":"    let words = (shift / 64) as nat;"},{"highlight_end"