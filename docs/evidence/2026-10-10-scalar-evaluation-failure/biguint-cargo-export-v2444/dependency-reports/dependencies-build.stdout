1,"text":"            requires denominator > 0, b > 0, d > 0,"},{"highlight_end":36,"highlight_start":1,"text":"                2 * a * d <= c * b,"},{"highlight_end":53,"highlight_start":1,"text":"                numerator * b < 2 * a * denominator,"},{"highlight_end":50,"highlight_start":1,"text":"                c * denominator <= numerator * d;"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":73,"highlight_start":1,"text":"/// Connect the executable helper's shared exponent specification to the"},{"highlight_end":79,"highlight_start":1,"text":"/// rational interval. The BigUint caller must still prove the two bit lengths"},{"highlight_end":56,"highlight_start":1,"text":"/// and the meaning of its borrowed shifted comparison."},{"highlight_end":60,"highlight_start":1,"text":"pub(crate) proof fn checked_exponent_denotes_scaled_binade("},{"highlight_end":82,"highlight_start":1,"text":"    numerator: nat, denominator: nat, numerator_bits: u64, denominator_bits: u64,"},{"highlight_end":30,"highlight_start":1,"text":"    below: bool, offset: i32,"},{"highlight_end":2,"highlight_start":1,"text":")"},{"highlight_end":63,"highlight_start":1,"text":"    requires has_bit_length(numerator, numerator_bits as nat),"},{"highlight_end":62,"highlight_start":1,"text":"        has_bit_length(denominator, denominator_bits as nat),"},{"highlight_end":104,"highlight_start":1,"text":"        below == below_aligned(numerator, denominator, numerator_bits as nat, denominator_bits as nat),"},{"highlight_end":116,"highlight_start":1,"text":"    ensures in_binade(numerator * binary_numerator(offset as int), denominator * binary_denominator(offset as int),"},{"highlight_end":97,"highlight_start":1,"text":"        crate::verified::word::bit_length_msd(numerator_bits, denominator_bits, below, offset)),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end