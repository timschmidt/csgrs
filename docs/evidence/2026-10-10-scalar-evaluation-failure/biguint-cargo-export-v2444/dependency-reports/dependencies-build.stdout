tart":1,"text":"    lemma_fundamental_div_mod(left as int, right as int);"},{"highlight_end":83,"highlight_start":1,"text":"    lemma_mul_mod_noop_right((left / right) as int, right as int, divisor as int);"},{"highlight_end":60,"highlight_start":1,"text":"    lemma_mod_twice((left % right) as int, divisor as int);"},{"highlight_end":94,"highlight_start":1,"text":"    lemma_add_mod_noop((left / right * right) as int, (left % right) as int, divisor as int);"},{"highlight_end":33,"highlight_start":1,"text":"    lemma_small_mod(0, divisor);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":73,"highlight_start":1,"text":"pub(crate) proof fn gcd_preserves_common_divisors(left: nat, right: nat)"},{"highlight_end":49,"highlight_start":1,"text":"    ensures forall|divisor: nat| divisor > 0 ==>"},{"highlight_end":54,"highlight_start":1,"text":"        (#[trigger] (gcd(left, right) % divisor) == 0"},{"highlight_end":63,"highlight_start":1,"text":"            <==> left % divisor == 0 && right % divisor == 0),"},{"highlight_end":21,"highlight_start":1,"text":"    decreases right,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":20,"highlight_start":1,"text":"    if right != 0 {"},{"highlight_end":60,"highlight_start":1,"text":"        gcd_preserves_common_divisors(right, left % right);"},{"highlight_end":56,"highlight_start":1,"text":"        assert forall|divisor: nat| divisor > 0 implies"},{"highlight_end":58,"highlight_start":1,"text":"            (#[trigger] (gcd(left, right) % divisor) == 0"},{"highlight_end":71,"highlight_start":1,"text":"                <==> left % divisor == 0 && right % divisor == 0) by {"},{"highlight_end":66,"highlight_start":1,"text":"            assert(gcd(left, right) == gcd(right, left % right));"},{"highlight_end":61,"highlight_start":1,"text":"            assert((gcd(right, left % right) % divisor == 0)"},{"highlight_end":77,"highlight_start":1,"text":"                <==> right % divisor == 0 && (left % right) % divisor == 0);"},{"highlight_end":38,"highlight_start":1,"text":"            if right % divisor == 0 {"},{"highlight_end":60,"highlight_start":1,"text":"                common_divisors_step(left, right, divisor);"},{"highlight_end":14,"highlight_start":1,"text":"            }"},{"highlight_end":10,"highlight_start":1,"text":"        }"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":56,"highlight_start":1,"text":"pub(crate) proof fn gcd_positive(left: nat, right: nat)"},{"highlight_end":38,"highlight_start":1,"text":"    requires left != 0 || right != 0,"},{"highlight_end":34,"highlight_start":1,"text":"    ensures gcd(left, right) > 0,"},{"highlight_end":21,"highlight_start":1,"text":"    decreases right,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":20,"highlight_start":1,"text":"    if right != 0 {"},{"highlight_end":43,"highlight_start":1,"text":"        gcd_positive(right, left % right);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":76,"highlight_start":1,"text":"/// The recursive specification really is the greatest common divisor, with"},{"highlight_end":82,"highlight_start":1,"text":"/// the conventional gcd(0, 0) = 0. Thus preserving it has a mathematical meaning"},{"highlight_end":57,"highlight_start":1,"text":"/// independent of the optimized machine implementation."},{"highlight_end":64,"highlight_start":1,"text":"pub(crate) proof fn gcd_characterization(left: nat, right: nat)"},{"highlight_end":12,"highlight_start":1,"text":"    ensures"},{"highlight_end":60,"highlight_start":1,"text":"        gcd(left, right) == 0 <==> left == 0 && right == 0,"},{"highlight_end":96,"highlight_start":1,"text":"        gcd(left, right) > 0 ==> left % gcd(left, right) == 0 && right % gcd(left, right) == 0,"},{"highlight_end":101,"highlight_start":1,"text":"        forall|divisor: nat| divisor > 0 && #[trigger] (left % divisor) == 0 && right % divisor == 0"},{"highlight_end":69,"highlight_start":1,"text":"            && gcd(left, right) > 0 ==> divisor <= gcd(left, right),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":35,"highlight_start":1,"text":"    let result = gcd(left, right);"},{"highlight_end":48,"highlight_start":1,"text":"    gcd_preserves_common_divisors(left, right);"},{"highlight_end":33,"highlight_start":1,"text":"    if left != 0 || right != 0 {"},{"highlight_end":35,"highlight_start":1,"text":"        gcd_positive(left, right);"},{"highlight_end":41,"highlight_start":1,"text":"        lemma_mod_self_0(result as int);"},{"highlight_end":108,"highlight_start":1,"text":"        assert forall|divisor: nat| divisor > 0 && #[trigger] (left % divisor) == 0 && right % divisor == 0"},{"highlight_end":57,"highlight_start":1,"text":"            && result > 0 implies divisor <= result by {"},{"highlight_end":34,"highlight_start":1,"text":"            if divisor > result {"},{"highlight_end":50,"highlight_start":1,"text":"                lemma_small_mod(result, divisor);"},{"highlight_end":47,"highlight_start":1,"text":"                assert(result % divisor == 0);"},{"highlight_end":14,"highlight_start":1,"text":"            }"},{"highlight_end":10,"highlight_start":1,"text":"        }"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":52,"highlight_start":1,"text":"proof fn gcd_swap_increasing(left: nat, right: nat)"},{"highlight_end":27,"highlight_start":1,"text":"    requires left < right,"},{"highlight_end":50,"highlight_start":1,"text":"    ensures gcd(left, right) == gcd(right, left),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":34,"highlight_start":1,"text":"    lemma_small_mod(left, right);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":81,"highlight_start":1,"text":"/// An upper bound on a divisor's high limb gives a lower bound on the quotient."},{"highlight_end":54,"highlight_start":1,"text":"proof fn high_quotient_bound(left: u128, right: u128)"},{"highlight_end":13,"highlight_start":1,"text":"    requires"},{"highlight_end":26,"highlight_start":1,"text":"        right > u64::MAX,"},{"highlight_end":34,"highlight_start":1,"text":"        left >= 5 * right as int,"},{"highlight_end":12,"highlight_start":1,"text":"    ensures"},{"highlight_end":34,"highlight_start":1,"text":"        (right >> 64) < u64::MAX,"},{"highlight_end":81,"highlight_start":1,"text":"        0 <= ((left >> 64) as int / ((right >> 64) as int + 1)) * right <= left,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":45,"highlight_start":1,"text":"    let base: int = 0x1_0000_0000_0000_0000;"},{"highlight_end":80,"highlight_start":1,"text":"    assert((left >> 64) == left / 0x1_0000_0000_0000_0000u128) by (bit_vector);"},{"highlight_end":82,"highlight_start":1,"text":"    assert((right >> 64) == right / 0x1_0000_0000_0000_0000u128) by (bit_vector);"},{"highlight_end":41,"highlight_start":1,"text":"    let high_left = (left >> 64) as int;"},{"highlight_end":43,"highlight_start":1,"text":"    let high_right = (right >> 64) as int;"},{"highlight_end":49,"highlight_start":1,"text":"    let quotient = high_left / (high_right + 1);"},{"highlight_end":50,"highlight_start":1,"text":"    lemma_fundamental_div_mod(left as int, base);"},{"highlight_end":51,"highlight_start":1,"text":"    lemma_fundamental_div_mod(right as int, base);"},{"highlight_end":58,"highlight_start":1,"text":"    lemma_fundamental_div_mod(high_left, high_right + 1);"},{"highlight_end":55,"highlight_start":1,"text":"    assert(high_right < u64::MAX) by (no