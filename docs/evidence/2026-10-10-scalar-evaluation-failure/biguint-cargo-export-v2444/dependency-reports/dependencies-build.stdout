ght_start":1,"text":""},{"highlight_end":90,"highlight_start":1,"text":"proof fn aligned_support(source: Seq<u64>, last: int, words: nat, bits: u32, length: nat)"},{"highlight_end":50,"highlight_start":1,"text":"    requires bits < 64, 0 <= last < source.len(),"},{"highlight_end":90,"highlight_start":1,"text":"        forall|index: int| last < index < source.len() ==> #[trigger] source[index] == 0,"},{"highlight_end":12,"highlight_start":1,"text":"    ensures"},{"highlight_end":64,"highlight_start":1,"text":"        forall|index: int| 0 <= index < words && index < length"},{"highlight_end":77,"highlight_start":1,"text":"            ==> #[trigger] aligned(source, words, bits, length)[index] == 0,"},{"highlight_end":116,"highlight_start":1,"text":"        forall|index: int| last + (if bits > 0 && source[last] >> ((64 - bits) as u32) != 0 { 1int } else { 0int })"},{"highlight_end":41,"highlight_start":1,"text":"                + words < index < length"},{"highlight_end":77,"highlight_start":1,"text":"            ==> #[trigger] aligned(source, words, bits, length)[index] == 0,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":55,"highlight_start":1,"text":"    let output = aligned(source, words, bits, length);"},{"highlight_end":70,"highlight_start":1,"text":"    let high = bits > 0 && source[last] >> ((64 - bits) as u32) != 0;"},{"highlight_end":75,"highlight_start":1,"text":"    assert forall|index: int| 0 <= index < words && index < length implies"},{"highlight_end":43,"highlight_start":1,"text":"        #[trigger] output[index] == 0 by {"},{"highlight_end":22,"highlight_start":1,"text":"        if bits > 0 {"},{"highlight_end":90,"highlight_start":1,"text":"            assert((0u64 << bits) | (0u64 >> ((64 - bits) as u32)) == 0) by (bit_vector);"},{"highlight_end":10,"highlight_start":1,"text":"        }"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":103,"highlight_start":1,"text":"    assert forall|index: int| last + (if high { 1int } else { 0int }) + words < index < length implies"},{"highlight_end":43,"highlight_start":1,"text":"        #[trigger] output[index] == 0 by {"},{"highlight_end":36,"highlight_start":1,"text":"        let offset = index - words;"},{"highlight_end":43,"highlight_start":1,"text":"        assert(limb(source, offset) == 0);"},{"highlight_end":22,"highlight_start":1,"text":"        if bits > 0 {"},{"highlight_end":53,"highlight_start":1,"text":"            let previous = limb(source, offset - 1);"},{"highlight_end":36,"highlight_start":1,"text":"            if offset != last + 1 {"},{"highlight_end":39,"highlight_start":1,"text":"                assert(previous == 0);"},{"highlight_end":75,"highlight_start":1,"text":"                assert(0u64 >> ((64 - bits) as u32) == 0) by (bit_vector);"},{"highlight_end":14,"highlight_start":1,"text":"            }"},{"highlight_end":59,"highlight_start":1,"text":"            assert(previous >> ((64 - bits) as u32) == 0);"},{"highlight_end":93,"highlight_start":1,"text":"            assert((0u64 << bits) | (previous >> ((64 - bits) as u32)) == 0) by (bit_vector)"},{"highlight_end":64,"highlight_start":1,"text":"                requires previous >> ((64 - bits) as u32) == 0;"},{"highlight_end":10,"highlight_start":1,"text":"        }"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":104,"highlight_start":1,"text":"proof fn addition_update(words: Seq<u64>, index: int, digit: u64, addend: u64, carry: bool, next: bool)"},{"highlight_end":39,"highlight_start":1,"text":"    requires 0 <= index < words.len(),"},{"highlight_end":66,"highlight_start":1,"text":"        digit as int + (if next { radix() as int } else { 0int })"},{"highlight_end":88,"highlight_start":1,"text":"            == words[index] as int + addend as int + (if carry { 1int } else { 0int }),"},{"highlight_end":101,"highlight_start":1,"