cts: Seq<Product>, length: int) -> nat"},{"highlight_end":46,"highlight_start":1,"text":"    recommends 0 <= length <= products.len(),"},{"highlight_end":22,"highlight_start":1,"text":"    decreases length,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":32,"highlight_start":1,"text":"    if length <= 0 { 0 } else {"},{"highlight_end":59,"highlight_start":1,"text":"        let previous = common_scale(products, length - 1);"},{"highlight_end":54,"highlight_start":1,"text":"        let current = exponent(products[length - 1]);"},{"highlight_end":60,"highlight_start":1,"text":"        if previous > current { previous } else { current }"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":71,"highlight_start":1,"text":"pub(crate) open spec fn aligned(product: Product, scale: nat) -> nat {"},{"highlight_end":66,"highlight_start":1,"text":"    magnitude(product) * pow2((scale - exponent(product)) as nat)"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":84,"highlight_start":1,"text":"pub(crate) open spec fn native_product_fits(product: Product, scale: nat) -> bool {"},{"highlight_end":25,"highlight_start":1,"text":"    !product.active || ("},{"highlight_end":89,"highlight_start":1,"text":"        (match product.left { Magnitude::Word(_) => true, Magnitude::Wide(_) => false })"},{"highlight_end":73,"highlight_start":1,"text":"        && exponent(product) <= scale && scale - exponent(product) < 128"},{"highlight_end":83,"highlight_start":1,"text":"        && magnitude(product) <= u128::MAX && aligned(product, scale) <= u128::MAX"},{"highlight_end":6,"highlight_start":1,"text":"    )"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":105,"highlight_start":1,"text":"pub(crate) open spec fn subtotal(products: Seq<Product>, scale: nat, negative: bool, length: int) -> nat"},{"highlight_end":46,"highlight_start":1,"text":"    recommends 0 <= length <= products.len(),"},{"highlight_end":22,"highlight_start":1,"text":"    decreases length,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":32,"highlight_start":1,"text":"    if length <= 0 { 0 } else {"},{"highlight_end":56,"highlight_start":1,"text":"        subtotal(products, scale, negative, length - 1)"},{"highlight_end":92,"highlight_start":1,"text":"            + if products[length - 1].active && products[length - 1].negative == negative {"},{"highlight_end":53,"highlight_start":1,"text":"                aligned(products[length - 1], scale)"},{"highlight_end":25,"highlight_start":1,"text":"            } else { 0 }"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":91,"highlight_start":1,"text":"pub(crate) open spec fn signed_sum(products: Seq<Product>, scale: nat, length: int) -> int"},{"highlight_end":46,"highlight_start":1,"text":"    recommends 0 <= length <= products.len(),"},{"highlight_end":22,"highlight_start":1,"text":"    decreases length,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":32,"highlight_start":1,"text":"    if length <= 0 { 0 } else {"},{"highlight_end":48,"highlight_start":1,"text":"        signed_sum(products, scale, length - 1)"},{"highlight_end":47,"highlight_start":1,"text":"            + if products[length - 1].active {"},{"highlight_end":92,"highlight_start":1,"text":"                signed(products[length - 1].negative, aligned(products[length - 1], scale))"},{"highlight_end":25,"highlight_start":1,"text":"            } else { 0 }"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":70,"highlight_start":1,"text":"pub(crate) proof fn scale_bounds(products: Seq<Product>, length: int)"},{"highlight_end":44,"highlight_start":1,"text":"    requires 0 <= length <= products.len(),"},{"highlight_end":51,"highlight_start":1,"text":"    ensures forall|index: int| 0 <= index < length"},{"highlight_end":84,"highlight_start":1,"text":"        ==> exponent(#[trigger] products[index]) <= common_scale(products, length),"},{"highlight_end":22,"highlight_start":1,"text":"    decreases length,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":20,"highlight_start":1,"text":"    if length > 0 {"},{"highlight_end":44,"highlight_start":1,"text":"        scale_bounds(products, length - 1);"},{"highlight_end":62,"highlight_start":1,"text":"        assert forall|index: int| 0 <= index < length implies"},{"highlight_end":88,"highlight_start":1,"text":"            exponent(#[trigger] products[index]) <= common_scale(products, length) by {"},{"highlight_end":36,"highlight_start":1,"text":"            if index < length - 1 {"},{"highlight_end":89,"highlight_start":1,"text":"                assert(exponent(products[index]) <= common_scale(products, length - 1));"},{"highlight_end":14,"highlight_start":1,"text":"            }"},{"highlight_end":10,"highlight_start":1,"text":"        }"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":114,"highlight_start":1,"text":"pub(crate) proof fn subtotal_monotone(products: Seq<Product>, scale: nat, negative: bool, lower: int, upper: int)"},{"highlight_end":52,"highlight_start":1,"text":"    requires 0 <= lower <= upper <= products.len(),"},{"highlight_end":102,"highlight_start":1,"text":"    ensures subtotal(products, scale, negative, lower) <= subtotal(products, scale, negative, upper),"},{"highlight_end":29,"highlight_start":1,"text":"    decreases upper - lower,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":89,"highlight_start":1,"text":"    if upper > lower { subtotal_monotone(products, scale, negative, lower, upper - 1); }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":90,"highlight_start":1,"text":"pub(crate) proof fn subtotals_denote_sum(products: Seq<Product>, scale: nat, length: int)"},{"highlight_end":44,"highlight_start":1,"text":"    requires 0 <= length <= products.len(),"},{"highlight_end":48,"highlight_start":1,"text":"    ensures signed_sum(products, scale, length)"},{"highlight_end":109,"highlight_start":1,"text":"        == subtotal(products, scale, false, length) as int - subtotal(products, scale, true, length) as int,"},{"highlight_end":22,"highlight_start":1,"text":"    decreases length,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":73,"highlight_start":1,"text":"    if length > 0 { subtotals_denote_sum(products, scale, length - 1); }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":85,"highlight_start":1,"text":"/// Each aligned numerator denotes the original product over its binary denominator."},{"highlight_end":79,"highlight_start":1,"text":"pub(crate) proof fn alignment_preserves_fraction(product: Product, scale: nat)"},{"highlight_end":41,"highlight_start":1,"text":"    requires exponent(product) <= scale,"},{"highlight_end":107,"highlight_start":1,"text":"    ensures pow2(exponent(product)) == pow2(product.left_shift as nat) * pow2(product.right_shift as nat),"},{"highlight_end":84,"highlight_start":1,"text":"        signed(product.negative, aligned(product, scale)) * pow2(exponent(product))"},{"highlight_end":71,"highlight_start":1,"text":"        == signed(product.negative, magnitude(product)) * pow2(scale),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":76,"highlight_start":1,"text":"    lemma_pow2_adds(product.left_shift as nat, product.right_shift as nat);"},{"highlight_end":76,"highlight_start":1,"text":"    lemma_pow2_adds(exponent(product), (scale - exponent(product)) as nat);"},{"highlight_end":87,"highlight_start":1,"text":"    assert(signed(product.negative, aligned(product, scale)) * pow2(exponent(product))"},{"highlight_end":92,"highlight_start":1,"text":"        == signed(product.negative, magnitude(product)) * pow2(scale)) by (nonlinear_arith)"},{"highlight_end":100,"highlight_start":1,"text":"        requires pow2(scale) == pow2(exponent(product)) * pow2((scale - exponent(product)) as nat);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":76,"highlight_start":1,"text":"/// Raising the common denominator rescales the complete numerator exactly."},{"highlight_end":93,"highlight_start":1,"text":"pub(crate) proof fn rescale_sum(products: Seq<Product>, lower: nat, upper: nat, length: int)"},{"highlight_end":94,"highlight_start":1,"text":"    requires 0 <= length <= products.len(), common_scale(products, length) <= lower <= upper,"},{"highlight_end":48,"highlight_start":1,"text":"    ensures signed_sum(products, upper, length)"},{"highlight_end":79,"highlight_start":1,"text":"        == signed_sum(products, lower, length) * pow2((upper - lower) as nat),"},{"highlight_end":22,"highlight_start":1,"text":"    decreases length,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":20,"highlight_start":1,"text":"    if length > 0 {"},{"highlight_end":57,"highlight_start":1,"text":"        rescale_sum(products, lower, upper, length - 1);"},{"highlight_end":44,"highlight_start":1,"text":"        let product = products[length - 1];"},{"highlight_end":69,"highlight_start":1,"text":"        let lower_factor = pow2((lower - exponent(product)) as nat);"},{"highlight_end":51,"highlight_start":1,"text":"        let factor = pow2((upper - lower) as nat);"},{"highlight_end":69,"highlight_start":1,"text":"        let upper_factor = pow2((upper - exponent(product)) as nat);"},{"highlight_end":85,"highlight_start":1,"text":"        lemma_pow2_adds((lower - exponent(product)) as nat, (upper - lower) as nat);"},{"highlight_end":97,"highlight_start":1,"text":"        assert(aligned(product, upper) == aligned(product, lower) * factor) by (nonlinear_arith)"},{"highlight_end":60,"highlight_start":1,"text":"            requires upper_factor == lower_factor * factor,"},{"highlight_end":78,"highlight_start":1,"text":"                aligned(product, upper) == magnitude(product) * upper_factor,"},{"highlight_end":78,"highlight_start":1,"text":"                aligned(product, lower) == magnitude(product) * lower_factor;"},{"highlight_end":112,"highlight_start":1,"text":"        let lower_term = if product.active { signed(product.negative, aligned(product, lower)) } else { 0int };"},{"highlight_end":112,"highlight_start":1,"text":"        let upper_term = if product.active { signed(product.negative, aligned(product, upper)) } else { 0int };"},{"highlight_end":71,"highlight_start":1,"text":"        assert(upper_term == lower_term * factor) by (nonlinear_arith)"},{"highlight_end":82,"highlight_start":1,"text":"            requires aligned(product, upper) == aligned(product, lower) * factor,"},{"highlight_end":119,"highlight_start":1,"text":"                upper_term == (if product.active { signed(product.negative, aligned(product, upper)) } else { 0int }),"},{"highlight_end":119,"highlight_start":1,"text":"                lower_term == (if product.active { signed(product.negative, aligned(product, lower)) } else { 0int });"},{"highlight_end":51,"highlight_start":1,"text":"        assert(signed_sum(products, upper, length)"},{"highlight_end":82,"highlight_start":1,"text":"            == signed_sum(products, lower, length) * factor) by (nonlinear_arith)"},{"highlight_end":61,"highlight_start":1,"text":"            requires signed_sum(products, upper, length - 1)"},{"highlight_end":69,"highlight_start":1,"text":"                == signed_sum(products, lower, length - 1) * factor,"},{"highlight_end":109,"highlight_start":1,"text":"                signed_sum(products, upper, length) == signed_sum(products, upper, length - 1) + upper_term,"},{"highlight_end":109,"highlight_start":1,"text":"                signed_sum(products, lower, length) == signed_sum(products, lower, length - 1) + lower_term,"},{"highlight_end":51,"highlight_start":1,"text":"                upper_term == lower_term * factor;"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":82,"highlight_start":1,"text":"        assert(0int * pow2((upper - lower) as nat) == 0int) by (nonlinear_arith);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":2,"highlight_start":1,"text":"}"}]}},"file_name":"/home/tim/Documents/GitHub/workspace/csgrs/target/scalar-evaluation-candidate/source/crates/hyperreal/src/verified/aggregate.rs","is_primary":true,"label":null,"line_end":173,"line_start":31,"suggested_replacement":null,"suggestion_applicability":null,"text":[{"highlight_end":9,"highlight_start":1,"text":"verus! {"},{"highlight_end":61,"highlight_start":1,"text":"pub(crate) open spec fn magnitude(product: Product) -> nat {"},{"highlight_end":26,"highlight_start":1,"text":"    (match product.left {"},{"highlight_end":46,"highlight_start":1,"text":"        Magnitude::Word(word) => word as nat,"},{"highlight_end":49,"highlight_start":1,"text":"        Magnitude::Wide(words) => value(words@),"},{"highlight_end":30,"highlight_start":1,"text":"    }) * product.right as nat"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":60,"highlight_start":1,"text":"pub(crate) open spec fn exponent(product: Product) -> nat {"},{"highlight_end":59,"highlight_start":1,"text":"    product.left_shift as nat + product.right_shift as nat"},{"highlight_end":2