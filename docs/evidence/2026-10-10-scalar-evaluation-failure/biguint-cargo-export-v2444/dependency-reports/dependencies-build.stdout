end":36,"highlight_start":1,"text":"    let bits = (shift % 64) as u32;"},{"highlight_end":70,"highlight_start":1,"text":"    let high = bits > 0 && source[last] >> ((64 - bits) as u32) != 0;"},{"highlight_end":70,"highlight_start":1,"text":"    let end = (last + if high { 1int } else { 0int }) as nat + words;"},{"highlight_end":69,"highlight_start":1,"text":"    let padded = Seq::new(length, |index: int| limb(source, index));"},{"highlight_end":44,"highlight_start":1,"text":"    prefix_equal(padded, source, last + 1);"},{"highlight_end":63,"highlight_start":1,"text":"    extend_prefix_zero(source, last + 1, source.len() as int);"},{"highlight_end":57,"highlight_start":1,"text":"    extend_prefix_zero(padded, last + 1, length as int);"},{"highlight_end":72,"highlight_start":1,"text":"    extend_prefix_zero(padded, (length - words) as int, length as int);"},{"highlight_end":50,"highlight_start":1,"text":"    let moved = word_left_shifted(padded, words);"},{"highlight_end":42,"highlight_start":1,"text":"    word_left_shift_value(padded, words);"},{"highlight_end":55,"highlight_start":1,"text":"    let output = aligned(source, words, bits, length);"},{"highlight_end":36,"highlight_start":1,"text":"    let factor = pow2(bits as nat);"},{"highlight_end":42,"highlight_start":1,"text":"    let other = pow2((64 - bits) as nat);"},{"highlight_end":41,"highlight_start":1,"text":"    shifted_extent(source, last, shift);"},{"highlight_end":38,"highlight_start":1,"text":"    weight_monotone(end + 1, length);"},{"highlight_end":49,"highlight_start":1,"text":"    lemma_fundamental_div_mod(shift as int, 64);"},{"highlight_end":46,"highlight_start":1,"text":"    lemma_pow2_adds(64 * words, bits as nat);"},{"highlight_end":33,"highlight_start":1,"text":"    lemma_pow2_pos(bits as nat);"},{"highlight_end":40,"highlight_start":1,"text":"    lemma_pow2_pos((64 - bits) as nat);"},{"highlight_end":93,"highlight_start":1,"text":"    assert(value(moved) * factor == value(source) * pow2(shift as nat)) by (nonlinear_arith)"},{"highlight_end":64,"highlight_start":1,"text":"        requires value(moved) == value(source) * weight(words),"},{"highlight_end":58,"highlight_start":1,"text":"            pow2(shift as nat) == weight(words) * factor;"},{"highlight_end":19,"highlight_start":1,"text":"    if bits == 0 {"},{"highlight_end":23,"highlight_start":1,"text":"        lemma2_to64();"},{"highlight_end":52,"highlight_start":1,"text":"        prefix_equal(output, moved, length as int);"},{"highlight_end":97,"highlight_start":1,"text":"        assert(value(moved) * factor == value(moved)) by (nonlinear_arith) requires factor == 1;"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":62,"highlight_start":1,"text":"        assert forall|index: int| 0 <= index < length implies"},{"highlight_end":81,"highlight_start":1,"text":"            #[trigger] output[index] + ((moved[index] as nat) / other) * radix()"},{"highlight_end":88,"highlight_start":1,"text":"                == moved[index] * factor + (limb(moved, index - 1) as nat) / other by {"},{"highlight_end":79,"highlight_start":1,"text":"            assert(limb(moved, index - 1) == limb(source, index - words - 1));"},{"highlight_end":84,"highlight_start":1,"text":"            left_shifted_digit_correct(moved[index], limb(moved, index - 1), bits);"},{"highlight_end":10,"highlight_start":1,"text":"        }"},{"highlight_end":56,"highlight_start":1,"text":"        left_shift_value(moved, output, factor, other);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":90,"highlight_start":1,"text":"proof fn aligned_support(source: Seq<u64>, last: int, words: nat, bits: u32, length: nat)"},{"highlight_end":50,"highlight_start":1,"text":"    requires bits < 64, 0 <= last < source.len(),"},{"highlight_end":90,"highlight_start":1,"text":"        forall|index: int| last < index < source.len() ==> #[trigger] source[index] == 0,"},{"highlight_end":12,"highlight_start":1,"text":"    ensures"},{"highlight_end":64,"highlight_start":1,"text":"        forall|index: int| 0 <= index < words && index < length"},{"highlight_end":77,"highlight_start":1,"text":"            ==> #[trigger] aligned(source, words, bits, length)[index] == 0,"},{"highlight_end":116,"highlight_start":1,"text":"        forall|index: int| last + (if bits > 0 && source[last] >> ((64 - bits) as u32) != 0 { 1int } else { 0int })"},{"highlight_end":41,"highlight_start":1,"text":"                + words < index < length"},{"highlight_end":77,"highlight_start":1,"text":"            ==> #[trigger] aligned(source, words, bits, length)[index] == 0,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":55,"highlight_start":1,"text":"    let output = aligned(source, words, bits, length);"},{"highlight_end":70,"highlight_start":1,"text":"    let high = bits > 0 && source[last] >> ((64 - bits) as u32) != 0;"},{"highlight_end":75,"highlight_start":1,"text":"    assert forall|index: int| 0 <= index < words && index < length implies"},{"highlight_end":43,"highlight_start":1,"text":"        #[trigger] output[index] == 0 by {"},{"highlight_end":22,"highlight_start":1,"text":"        if bits > 0 {"},{"highlight_end":90,"highlight_start":1,"text":"            assert((0u64 << bits) | (0u64 >> ((64 - bits) as u32)) == 0) by (bit_vector);"},{"highlight_end":10,"highlight_start":1,"text":"        }"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":103,"highlight_start":1,"text":"    assert forall|index: int| last + (if high { 1int } else { 0int }) + words < index < length implies"},{"highlight_end":43,"highlight_start":1,"text":"        #[trigger] output[index] == 0 by {"},{"highlight_end":36,"highlight_start":1,"text":"        let offset = index - words;"},{"highlight_end":43,"highlight_start":1,"text":"        assert(limb(source, offset) == 0);"},{"highlight_end":22,"highlight_start":1,"text":"        if bits > 0 {"},{"highlight_end":53,"highlight_start":1,"text":"            let previous = limb(source, offset - 1);"},{"highlight_end":36,"highlight_start":1,"text":"            if offset != last + 1 {"},{"highlight_end":39,"highlight_start":1,"text":"                assert(previous == 0);"},{"highlight_end":75,"highlight_start":1,"text":"                assert(0u64 >> ((64 - bits) as u32) == 0) by (bit_vector);"},{"highlight_end":14,"highlight_start":1,"text":"            }"},{"highlight_end":59,"highlight_start":1,"text":"            assert(previous >> ((64 - bits) as u32) == 0);"},{"highlight_end":93,"highlight_start":1,"text":"            assert((0u64 << bits) | (previous >> ((64 - bits) as u32)) == 0) by (bit_vector)"},{"highlight_end":64,"highlight_start":1,"text":"                requires previous >> ((64 - bits) as u32) == 0;"},{"highlight_end":10,"highlight_start":1,"text":"        }"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":104,"highlight_start":1,"text":"proof fn addition_update(words: Seq<u64>, index: int, digit: u64, addend: u64, carry: bool, next: bool)"},{"highlight_end":39,"highlight_start":1,"text":"    requires 0 <= index < words.len(),"},{"highlight_end":66,"highlight_start":1,"text":"        digit as int + (if next { radix() as int } else { 0int })"},{"highlight_end":88,"highlight_start":1,"text":"            == words[index] as int + addend as int + (if carry { 1int } else { 0int }),"},{"highlight_end":101,"highlight_start":1,"text":"    ensures value(words.update(index, digit)) + (if next { weight(index as nat + 1) } else { 0nat })"},{"highlight_end":109,"highlight_start":1,"text":"        == value(words) + addend * weight(index as nat) + (if carry { weight(index as nat) } else { 0nat }),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":76,"highlight_start":1,"text":"    super::product::prefix_update(words, index, digit, words.len() as int);"},{"highlight_end":31,"highlight_start":1,"text":"    weight_step(index as nat);"},{"highlight_end":100,"highlight_start":1,"text":"    assert(value(words.update(index, digit)) + (if next { weight(index as nat + 1) } else { 0nat })"},{"highlight_end":109,"highlight_start":1,"text":"        == value(words) + addend * weight(index as nat) + (if carry { weight(index as nat) } else { 0nat }))"},{"highlight_end":29,"highlight_start":1,"text":"        by (nonlinear_arith)"},{"highlight_end":89,"highlight_start":1,"text":"        requires value(words.update(index, digit)) + words[index] * weight(index as nat)"},{"highlight_end":64,"highlight_start":1,"text":"                == value(words) + digit * weight(index as nat),"},{"highlight_end":70,"highlight_start":1,"text":"            digit as int + (if next { radix() as int } else { 0int })"},{"highlight_end":92,"highlight_start":1,"text":"                == words[index] as int + addend as int + (if carry { 1int } else { 0int }),"},{"highlight_end":72,"highlight_start":1,"text":"            weight(index as nat + 1) == weight(index as nat) * radix();"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":2,"highlight_start":1,"text":"}"}]}},"file_name":"/home/tim/Documents/GitHub/workspace/csgrs/target/scalar-evaluation-candidate/source/crates/hyperreal/src/verified/accumulate.rs","is_primary":true,"label":null,"line_end":190,"line_start":11,"suggested_replacement":null,"suggestion_applicability":null,"text":[{"highlight_end":9,"highlight_start":1,"text":"verus! {"},{"highlight_end":110,"highlight_start":1,"text":"pub(crate) open spec fn aligned(source: Seq<u64>, word_shift: nat, bit_shift: u32, length: nat) -> Seq<u64> {"},{"highlight_end":92,"highlight_start":1,"text":"    Seq::new(length, |index: int| left_shifted_limb(source, index - word_shift, bit_shift))"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":50,"highlight_start":1,"text":"proof fn weight_monotone(lower: nat, higher: nat)"},{"highlight_end":30,"highlight_start":1,"text":"    requires lower <= higher,"},{"highlight_end":45,"highlight_start":1,"text":"    ensures weight(lower) <= weight(higher),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":82,"highlight_start":1,"text":"    if lower < higher { lemma_pow2_strictly_increases(64 * lower, 64 * higher); }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":76,"highlight_start":1,"text":"/// The highest retained digit, including a possible shifted-out high part,"},{"highlight_end":71,"highlight_start":1,"text":"/// determines exactly the first buffer width that can hold the value."},{"highlight_end":76,"highlight_start":1,"text":"pub(crate) proof fn shifted_extent(source: Seq<u64>, last: int, shift: u64)"},{"highlight_end":57,"highlight_start":1,"text":"    requires 0 <= last < source.len(), source[last] > 0,"},{"highlight_end":90,"highlight_start":1,"text":"        forall|index: int| last < index < source.len() ==> #[trigger] source[index] == 0,"},{"highlight_end":15,"highlight_start":1,"text":"    ensures ({"},{"highlight_end":40,"highlight_start":1,"text":"        let bits = (shift % 64) as u32;"},{"highlight_end":74,"highlight_start":1,"text":"        let high = bits > 0 && source[last] >> ((64 - bits) as u32) != 0;"},{"highlight_end":72,"highlight_start":1,"text":"        let end = last + (if high { 1int } else { 0int }) + shift / 64;"},{"highlight_end":92,"highlight_start":1,"text":"        weight(end as nat) <= value(source) * pow2(shift as nat) < weight((end + 1) as nat)"},{"highlight_end":8,"highlight_start":1,"text":"    }),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":63,"highlight_start":1,"text":"    extend_prefix_zero(source, last + 1, source.len() as int);"},{"highlight_end":32,"highlight_start":1,"text":"    prefix_bound(source, last);"},{"highlight_end":36,"highlight_start":1,"text":"    prefix_bound(source, last + 1);"},{"highlight_end":36,"highlight_start":1,"text":"    let bits = (shift % 64) as u32;"},{"highlight_end":37,"highlight_start":1,"text":"    let words = (shift / 64) as nat;"},{"highlight_end":36,"highlight_start":1,"text":"    let factor = pow2(bits as nat);"},{"highlight_end":42,"highlight_start":1,"text":"    let other = pow2((64 - bits) as nat);"},{"highlight_end":70,"highlight_start":1,"text":"    let high = bits > 0 && source[last] >> ((64 - bits) as u32) != 0;"},{"highlight_end":35,"highlight_start":1,"text":"    let top = source[last] as nat;"},{"highlight_end":36,"highlight_start":1,"text":"    let low = prefix(source, last);"},{"highlight_end":33,"highlight_start":1,"text":"    let w = weight(last as nat);"},{"highlight_end":19,"highlight_start":1,"text":"    lemma2_to64();"},{"highlight_end":30,"highlight_start":1,"text":"    weight_step(last as nat);"},{"highlight_end":34,"highlight_start":1,"text":"    weight_step(last as nat + 1);"},{"highlight_end":33,"highlight_start":1,"text":"    lemma_pow2_pos(bits as nat);"},{"highlight_end":40,"highlight_start":1,"text":"    lemma_pow2_pos((64 - bits) as nat);"},{"highlight_end":54,"highlight_start":1,"text":"    lemma_pow2_adds(bits as nat, (64 - bits) as nat);"},{"highlight_end":52,"highlight_start":1,"text":"    lemma_pow2_strictly_increases(bits as nat, 64);"},{"highlight_end":18,"highlight_start":1,"text":"    if bits > 0 {"},{"highlight_end":76,"highlight_start":1,"text":"        vstd::bits::lemma_u64_shr_is_div(source[last], (64 - bits) as u64);"},{"highlight_end":61,"highlight_start":1,"text":"        lemma_fundamental_div_mod(top as int, other as int);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":44,"highlight_start":1,"text":"    assert(value(source) == low + top * w);"},{"highlight_end":14,"highlight_start":1,"text":"    if high {"},{"highlight_end":70,"highlight_start":1,"text":"        if top < other { lemma_basic_div(top as int, other as int); }"},{"highlight_end":61,"highlight_start":1,"text":"        assert(top * factor >= radix()) by (nonlinear_arith)"},{"highlight_end":74,"highlight_start":1,"text":"            requires top >= other, factor > 0, other * factor == radix();"},{"highlight_end":92,"highlight_start":1,"text":"        assert(weight(last as nat + 1) <= value(source) * factor < weight(last as nat + 2))"},{"highlight_end":33,"highlight_start":1,"text":"            by (nonlinear_arith)"},{"highlight_end":70,"highlight_start":1,"text":"            requires value(source) == low + top * w, low >= 0, w > 0,"},{"highlight_end":63,"highlight_start":1,"text":"                top * factor >= radix(), 0 < factor < radix(),"},{"highlight_end":57,"highlight_start":1,"text":"                value(source) < weight(last as nat + 1),"},{"highlight_end":56,"highlight_start":1,"text":"                weight(last as nat + 1) == w * radix(),"},{"highlight_end":78,"highlight_start":1,"text":"                weight(last as nat + 2) == weight(last as nat + 1) * radix();"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":29,"highlight_start":1,"text":"        assert(top < other);"},{"highlight_end":91,"highlight_start":1,"text":"        assert(w <= value(source) * factor < weight(last as nat + 1)) by (nonlinear_arith)"},{"highlight_end":74,"highlight_start":1,"text":"            requires value(source) == low + top * w, 0 <= low < w, w > 0,"},{"highlight_end":73,"highlight_start":1,"text":"                0 < top < other, factor >= 1, other * factor == radix(),"},{"highlight_end":56,"highlight_start":1,"text":"                weight(last as nat + 1) == w * radix();"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":65,"highlight_start":1,"text":"    let offset = (last + if high { 1int } else { 0int }) as nat;"},{"highlight_end":49,"highlight_start":1,"text":"    lemma_fundamental_div_mod(shift as int, 64);"},{"highlight_end":46,"highlight_start":1,"text":"    lemma_pow2_adds(64 * words, bits as nat);"},{"highlight_end":24,"highlight_start":1,"text":"    weight_step(words);"},{"highlight_end":31,"highlight_start":1,"text":"    weight_add(offset, words);"},{"highlight_end":35,"highlight_start":1,"text":"    weight_add(offset + 1, words);"},{"highlight_end":72,"highlight_start":1,"text":"    assert(weight(offset + words) <= value(source) * pow2(shift as nat)"},{"highlight_end":59,"highlight_start":1,"text":"        < weight(offset + words + 1)) by (nonlinear_arith)"},{"highlight_end":80,"highlight_start":1,"text":"        requires weight(offset) <= value(source) * factor < weight(offset + 1),"},{"highlight_end":77,"highlight_start":1,"text":"            weight(words) > 0, pow2(shift as nat) == weight(words) * factor,"},{"highlight_end":70,"highlight_start":1,"text":"            weight(offset + words) == weight(offset) * weight(words),"},{"highlight_end":78,"highlight_start":1,"text":"            weight(offset + words + 1) == weight(offset + 1) * weight(words);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":88,"highlight_start":1,"text":"pub(crate) proof fn aligned_value(source: Seq<u64>, last: int, shift: u64, length: nat)"},{"highlight_end":57,"highlight_start":1,"text":"    requires 0 <= last < source.len(), source[last] > 0,"},{"highlight_end":90,"highlight_start":1,"text":"        forall|index: int| last < index < source.len() ==> #[trigger] source[index] == 0,"},{"highlight_end":43,"highlight_start":1,"text":"        ({ let bits = (shift % 64) as u32;"},{"highlight_end":100,"highlight_start":1,"text":"           last + (if bits > 0 && source[last] >> ((64 - bits) as u32) != 0 { 1int } else { 0int })"},{"highlight_end":41,"highlight_start":1,"text":"               + shift / 64 < length }),"},{"highlight_end":85,"highlight_start":1,"text":"    ensures value(aligned(source, (shift / 64) as nat, (shift % 64) as u32, length))"},{"highlight_end":47,"highlight_start":1,"text":"        == value(source) * pow2(shift as nat),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":37,"highlight_start":1,"text":"    let words = (shift / 64) as nat;"},{"highlight_end":36,"highlight_start":1,"text":"    let bits = (shift % 64) as u32;"},{"highlight_end":70,"highlight_start":1,"text":"    let high = bits > 0 && source[last] >> ((64 - bits) as u32) != 0;"},{"highlight_end":70,"highlight_start":1,"text":"    let end = (last + if high { 1int } else { 0int }) as nat + words;"},{"highlight_end":69,"highlight_start":1,"text":"    let padded = Seq::new(length, |index: int| limb(source, index));"},{"highlight_end":44,"highlight_start":1,"text":"    prefix_equal(padded, source, last + 1);"},{"highlight_end":63,"highlight_start":1,"text":"    extend_prefix_zero(source, last + 1, source.len() as int);"},{"highlight_end":57,"highlight_start":1,"text":"    extend_prefix_zero(padded, last + 1, length as int);"},{"highlight_end":72,"highlight_start":1,"text":"    extend_prefix_zero(padded, (length - words) as int, length as int);"},{"highlight_end":50,"highlight_start":1,"text":"    let moved = word_left_shifted(padded, words);"},{"highlight_end":42,"highlight_start":1,"text":"    word_left_shift_value(padded, words);"},{"highlight_end":55,"highlight_start":1,"text":"    let output = aligned(source, words, bits, length);"},{"highlight_end":36,"highlight_start":1,"text":"    let factor = pow2(bits as nat);"},{"highlight_end":42,"highlight_start":1,"text":"    let other = pow2((64 - bits) as nat);"},{"highlight_end":41,"highlight_start":1,"text":"    shifted_extent(source, last, shift);"},{"highlight_end":38,"highlight_start":1,"text":"    weight_monotone(end + 1, length);"},{"highlight_end":49,"highlight_start":1,"text":"    lemma_fundamental_div_mod(shift as int, 64);"},{"highlight_end":46,"highlight_start":1,"text":"    lemma_pow2_adds(64 * words, bits as nat);"},{"highlight_end":33,"highlight_start":1,"text":"    lemma_pow2_pos(bits as nat);"},{"highlight_end":40,"highlight_start":1,"text":"    lemma_pow2_pos((64 - bits) as nat);"},{"highlight_end":93,"highlight_start":1,"text":"    assert(value(moved) * factor == value(source) * pow2(shift as nat)) by (nonlinear_arith)"},{"highlight_end":64,"highlight_start":1,"text":"        requires value(moved) == value(source) * weight(words),"},{"highlight_end":58,"highlight_start":1,"text":"            pow2(shift as nat) == weight(words) * factor;"},{"highlight_end":19,"highlight_start":1,"text":"    if bits == 0 {"},{"highlight_end":23,"highlight_start":1,"text":"        lemma2_to64();"},{"highlight_end":52,"highlight_start":1,"text":"        prefix_equal(output, moved, length as int);"},{"highlight_end":97,"highlight_start":1,"text":"        assert(value(moved) * factor == value(moved)) by (nonlinear_arith) requires factor == 1;"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":62,"highlight_start":1,"text":"        assert forall|index: int| 0 <= index < length implies"},{"highlight_end":81,"highlight_start":1,"text":"            #[trigger] output[index] + ((moved[index] as nat) / other) * radix()"},{"highlight_end":88,"highlight_start":1,"text":"                == moved[index] * factor + (limb(moved, index - 1) as nat) / other by {"},{"highlight_end":79,"highlight_start":1,"text":"            assert(limb(moved, index - 1) == limb(source, index - words - 1));"},{"highlight_end":84,"highlight_start":1,"text":"            left_shifted_digit_correct(moved[index], limb(moved, index - 1), bits);"},{"highlight_end":10,"highlight_start":1,"text":"        }"},{"highlight_end":56,"highlight_start":1,"text":"        left_shift_value(moved, output, factor, other);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":90,"highlight_start":1,"text":"proof fn aligned_support(source: Seq<u64>, last: int, words: nat, bits: u32, length: nat)"},{"highlight_end":50,"highlight_start":1,"text":"    requires bits < 64, 0 <= last < source.len(),"},{"highlight_end":90,"highlight_start":1,"text":"        forall|index: int| last < index < source.len() ==> #[trigger] source[index] == 0,"},{"highlight_end":12,"highlight_start":1,"text":"    ensures"},{"highlight_end":64,"highlight_start":1,"text":"        forall|index: int| 0 <= index < words && index < length"},{"highlight_end":77,"highlight_start":1,"text":"            ==> #[trigger] aligned(source, words, bits, length)[index] == 0,"},{"highlight_end":116,"highlight_start":1,"text":"        forall|index: int| last + (if bits > 0 && source[last] >> ((64 - bits) as u32) != 0 { 1int } else { 0int })"},{"highlight_end":41,"highlight_start":1,"text":"                + words < index < length"},{"highlight_end":77,"highlight_start":1,"text":"            ==> #[trigger] aligned(source, words, bits, length)[index] == 0,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":55,"highlight_start":1,"text":"    let output = aligned(source, words, bits, length);"},{"highlight_end":70,"highlight_start":1,"text":"    let high = bits > 0 && source[last] >> ((64 - bits) as u32) != 0;"},{"highlight_end":75,"highlight_start":1,"text":"    assert forall|index: int| 0 <= index < words && index < length implies"},{"highlight_end":43,"highlight_start":1,"text":"        #[trigger] output[index] == 0 by {"},{"highlight_end":22,"highlight_start":1,"text":"        if bits > 0 {"},{"highlight_end":90,"highlight_start":1,"text":"            assert((0u64 << bits) | (0u64 >> ((64 - bits) as u32)) == 0) by (bit_vector);"},{"highlight_end":10,"highlight_start":1,"text":"        }"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":103,"highlight_start":1,"text":"    assert forall|index: int| last + (if high { 1int } else { 0int }) + words < index < length implies"},{"highlight_end":43,"highlight_start":1,"text":"        #[trigger] output[index] == 0 by {"},{"highlight_end":36,"highlight_start":1,"text":"        let offset = index - words;"},{"highlight_end":43,"highlight_start":1,"text":"        assert(limb(source, offset) == 0);"},{"highlight_end":22,"highlight_start":1,"text":"        if bits > 0 {"},{"highlight_end":53,"highlight_start":1,"text":"            let previous = limb(source, offset - 1);"},{"highlight_end":36,"highlight_start":1,"text":"            if offset != last + 1 {"},{"highlight_end":39,"highlight_start":1,"text":"                assert(previous == 0);"},{"highlight_end":75,"highlight_start":1,"text":"                assert(0u64 >> ((64 - bits) as u32) == 0) by (bit_vector);"},{"highlight_end":14,"highlight_start":1,"text":"            }"},{"highlight_end":59,"highlight_start":1,"text":"            assert(previous >> ((64 - bits) as u32) == 0);"},{"highlight_end":93,"highlight_start":1,"text":"            assert((0u64 << bits) | (previous >> ((64 - bits) as u32)) == 0) by (bit_vector)"},{"highlight_end":64,"highlight_start":1,"text":"                requires previous >> ((64 - bits) as u32) == 0;"},{"highlight_end":10,"highlight_start":1,"text":"        }"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":104,"highlight_start":1,"text":"proof fn addition_update(words: Seq<u64>, index: int, digit: u64, addend: u64, carry: bool, next: bool)"},{"highlight_end":39,"highlight_start":1,"text":"    requires 0 <= index < words.len(),"},{"highlight_end":66,"highlight_start":1,"text":"        digit as int + (if next { radix() as int } else { 0int })"},{"highlight_end":88,"highlight_start":1,"text":"            == words[index] as int + addend as int + (if carry { 1int } else { 0int }),"},{"highlight_end":101,"highlight_start":1,"text":"    ensures value(words.update(index, digit)) + (if next { weight(index as nat + 1) } else { 0nat })"},{"highlight_end":109,"highlight_start":1,"text":"        == value(words) + addend * weight(index as nat) + (if carry { weight(index as nat) } else { 0nat }),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":76,"highlight_start":1,"text":"    super::product::prefix_update(words, index, digit, words.len() as int);"},{"highlight_end":31,"highlight_start":1,"text":"    weight_step(index as nat);"},{"highlight_end":100,"highlight_start":1,"text":"    assert(value(words.update(index, digit)) + (if next { weight(index as nat + 1) } else { 0nat })"},{"highlight_end":109,"highlight_start":1,"text":"        == value(words) + addend * weight(index as nat) + (if carry { weight(index as nat) } else { 0nat }))"},{"highlight_end":29,"highlight_start":1,"text":"        by (nonlinear_arith)"},{"highlight_end":89,"highlight_start":1,"text":"        requires value(words.update(index, digit)) + words[index] * weight(index as nat)"},{"highlight_end":64,"highlight_start":1,"text":"                == value(words) + digit * weight(index as nat),"},{"highlight_end":70,"highlight_start":1,"text":"            digit as int + (if next { radix() as int } else { 0int })"},{"highlight_end":92,"highlight_start":1,"text":"                == words[index] as int + addend as int + (if carry { 1int } else { 0int }),"},{"highlight_end":72,"highlight_start":1,"text":"            weight(index as nat + 1) == weight(index as nat) * radix();"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":2,"highlight_start":1,"text":"}"}]}],"code":{"code":"unexpected_cfgs","explanation":null}}}
