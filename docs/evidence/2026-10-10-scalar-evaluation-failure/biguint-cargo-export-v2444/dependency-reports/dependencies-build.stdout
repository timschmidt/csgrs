ght_end":62,"highlight_start":1,"text":"            requires value * pow2(shift as nat) <= u128::MAX,"},{"highlight_end":79,"highlight_start":1,"text":"                pow2(shift as nat) == 2 * previous, previous >= 0, value >= 0;"},{"highlight_end":59,"highlight_start":1,"text":"        shift_left_u128_is_mul(value, (shift - 1) as u32);"},{"highlight_end":66,"highlight_start":1,"text":"        assert((value << ((shift - 1) as u32)) <= u128::MAX / 2);"},{"highlight_end":88,"highlight_start":1,"text":"        assert((value << shift) == 2 * (value << ((shift - 1) as u32))) by (bit_vector)"},{"highlight_end":38,"highlight_start":1,"text":"            requires 0 < shift < 128,"},{"highlight_end":66,"highlight_start":1,"text":"                (value << ((shift - 1) as u32)) <= u128::MAX / 2;"},{"highlight_end":69,"highlight_start":1,"text":"        assert(value * pow2(shift as nat) == 2 * (value * previous))"},{"highlight_end":78,"highlight_start":1,"text":"            by (nonlinear_arith) requires pow2(shift as nat) == 2 * previous;"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":2,"highlight_start":1,"text":"}"}]}],"code":{"code":"unexpected_cfgs","explanation":null}}}
