en() implies"},{"highlight_end":68,"highlight_start":1,"text":"        gcd(#[trigger] numerators[i] as nat, denominator) == 1 by {"},{"highlight_end":46,"highlight_start":1,"text":"        let numerator = numerators[i] as nat;"},{"highlight_end":28,"highlight_start":1,"text":"        if numerator == 0 {"},{"highlight_end":107,"highlight_start":1,"text":"            assert forall|j: int| 0 <= j < denominators.len() implies #[trigger] denominators[j] == 1 by {"},{"highlight_end":69,"highlight_start":1,"text":"                assert(gcd(numerator, denominators[j] as nat) == 1);"},{"highlight_end":60,"highlight_start":1,"text":"                lemma_small_mod(0, denominators[j] as nat);"},{"highlight_end":42,"highlight_start":1,"text":"                reveal_with_fuel(gcd, 2);"},{"highlight_end":75,"highlight_start":1,"text":"                assert(gcd(0, denominators[j] as nat) == denominators[j]);"},{"highlight_end":14,"highlight_start":1,"text":"            }"},{"highlight_end":67,"highlight_start":1,"text":"            factors_unit(denominators, denominators.len() as int);"},{"highlight_end":68,"highlight_start":1,"text":"            assert(gcd(0, 1) == 1) by { reveal_with_fuel(gcd, 2); }"},{"highlight_end":17,"highlight_start":1,"text":"        } else {"},{"highlight_end":70,"highlight_start":1,"text":"            assert forall|j: int| 0 <= j < denominators.len() implies"},{"highlight_end":76,"highlight_start":1,"text":"                gcd(#[trigger] denominators[j] as nat, numerator) == 1 by {"},{"highlight_end":78,"highlight_start":1,"text":"                super::gcd::gcd_symmetric(numerator, denominators[j] as nat);"},{"highlight_end":14,"highlight_start":1,"text":"            }"},{"highlight_end":81,"highlight_start":1,"text":"            coprime_factors(denominators, numerator, denominators.len() as int);"},{"highlight_end":63,"highlight_start":1,"text":"            super::gcd::gcd_symmetric(denominator, numerator);"},{"highlight_end":10,"highlight_start":1,"