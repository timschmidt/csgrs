,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":73,"highlight_start":1,"text":"pub(crate) proof fn magnitude_row(left: nat, right: nat, a: int, b: int)"},{"highlight_end":65,"highlight_start":1,"text":"    ensures abs(a * left + b * right) == if (a < 0) == (b < 0) {"},{"highlight_end":39,"highlight_start":1,"text":"        abs(a) * left + abs(b) * right"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":44,"highlight_start":1,"text":"        abs(abs(a) * left - abs(b) * right)"},{"highlight_end":7,"highlight_start":1,"text":"    },"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":64,"highlight_start":1,"text":"    assert(abs(a * left + b * right) == if (a < 0) == (b < 0) {"},{"highlight_end":39,"highlight_start":1,"text":"        abs(a) * left + abs(b) * right"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":44,"highlight_start":1,"text":"        abs(abs(a) * left - abs(b) * right)"},{"highlight_end":60,"highlight_start":1,"text":"    }) by (nonlinear_arith) requires left >= 0, right >= 0;"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":78,"highlight_start":1,"text":"pub(crate) open spec fn alternating(a: int, b: int, c: int, d: int) -> bool {"},{"highlight_end":43,"highlight_start":1,"text":"    (a >= 0 && b <= 0 && c <= 0 && d >= 0)"},{"highlight_end":50,"highlight_start":1,"text":"        || (a <= 0 && b >= 0 && c >= 0 && d <= 0)"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":68,"highlight_start":1,"text":"proof fn opposite_coefficient_growth(a: int, c: int, quotient: int)"},{"highlight_end":69,"highlight_start":1,"text":"    requires quotient > 0, (a >= 0 && c <= 0) || (a <= 0 && c >= 0),"},{"highlight_end":65,"highlight_start":1,"text":"    ensures abs(a - quotient * c) == abs(a) + quotient * abs(c),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":85,"highlight_start":1,"text":"    assert(abs(a - quotient * c) == abs(a) + quotient * abs(c)) by (nonlinear_arith)"},{"highlight_end":73,"highlight_start":1,"text":"        requires quotient > 0, (a >= 0 && c <= 0) || (a <= 0 && c >= 0);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":79,"highlight_start":1,"text":"proof fn row_growth(a: int, b: int, c: int, d: int, quotient: int, steps: nat)"},{"highlight_end":52,"highlight_start":1,"text":"    requires quotient > 0, alternating(a, b, c, d),"},{"highlight_end":44,"highlight_start":1,"text":"        abs(a) + abs(b) >= pow2(steps / 2),"},{"highlight_end":50,"highlight_start":1,"text":"        abs(c) + abs(d) >= pow2((steps + 1) / 2),"},{"highlight_end":12,"highlight_start":1,"text":"    ensures"},{"highlight_end":63,"highlight_start":1,"text":"        alternating(c, d, a - quotient * c, b - quotient * d),"},{"highlight_end":50,"highlight_start":1,"text":"        abs(c) + abs(d) >= pow2((steps + 1) / 2),"},{"highlight_end":80,"highlight_start":1,"text":"        abs(a - quotient * c) + abs(b - quotient * d) >= pow2((steps + 2) / 2),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":49,"highlight_start":1,"text":"    opposite_coefficient_growth(a, c, quotient);"},{"highlight_end":49,"highlight_start":1,"text":"    opposite_coefficient_growth(b, d, quotient);"},{"highlight_end":87,"highlight_start":1,"text":"    assert(alternating(c, d, a - quotient * c, b - quotient * d)) by (nonlinear_arith)"},{"highlight_end":56,"highlight_start":1,"text":"        requires quotient > 0, alternating(a, b, c, d);"},{"highlight_end":24,"highlight_start":1,"text":"    if steps % 2 == 0 {"},{"highlight_end":44,"highlight_start":1,"text":"        lemma_pow2_unfold((steps + 2) / 2);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":31,"highlight_start":1,"text":"    let top = abs(a) + abs(b);"},{"highlight_end":34,"highlight_start":1,"text":"    let bottom = abs(c) + abs(d);"},{"highlight_end":62,"highlight_start":1,"text":"    let next = abs(a - quotient * c) + abs(b - quotient * d);"},{"highlight_end":65,"highlight_start":1,"text":"    assert(next == top + quotient * bottom) by (nonlinear_arith)"},{"highlight_end":70,"highlight_start":1,"text":"        requires abs(a - quotient * c) == abs(a) + quotient * abs(c),"},{"highlight_end":65,"highlight_start":1,"text":"            abs(b - quotient * d) == abs(b) + quotient * abs(d),"},{"highlight_end":67,"highlight_start":1,"text":"            next == abs(a - quotient * c) + abs(b - quotient * d),"},{"highlight_end":63,"highlight_start":1,"text":"            top == abs(a) + abs(b), bottom == abs(c) + abs(d);"},{"highlight_end":24,"highlight_start":1,"text":"    if steps % 2 == 0 {"},{"highlight_end":67,"highlight_start":1,"text":"        assert(next >= pow2((steps + 2) / 2)) by (nonlinear_arith)"},{"highlight_end":69,"highlight_start":1,"text":"            requires next == top + quotient * bottom, quotient >= 1,"},{"highlight_end":80,"highlight_start":1,"text":"                top >= pow2(steps / 2), bottom >= pow2(steps / 2), bottom >= 0,"},{"highlight_end":62,"highlight_start":1,"text":"                pow2((steps + 2) / 2) == 2 * pow2(steps / 2);"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":52,"highlight_start":1,"text":"        assert(next >= bottom) by (nonlinear_arith)"},{"highlight_end":92,"highlight_start":1,"text":"            requires next == top + quotient * bottom, quotient >= 1, top >= 0, bottom >= 0;"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":75,"highlight_start":1,"text":"/// The bounded coefficients double in magnitude at least every two steps."},{"highlight_end":77,"highlight_start":1,"text":"/// Their word-size bound therefore keeps the existing u8 counter below 129."},{"highlight_end":55,"highlight_start":1,"text":"proof fn step_counter_bound(c: int, d: int, steps: u8)"},{"highlight_end":53,"highlight_start":1,"text":"    requires abs(c) <= u64::MAX, abs(d) <= u64::MAX,"},{"highlight_end":57,"highlight_start":1,"text":"        abs(c) + abs(d) >= pow2((steps as nat + 1) / 2),"},{"highlight_end":25,"highlight_start":1,"text":"    ensures steps < 129,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":22,"highlight_start":1,"text":"    if steps >= 129 {"},{"highlight_end":47,"highlight_start":1,"text":"        let exponent = (steps as nat + 1) / 2;"},{"highlight_end":23,"highlight_start":1,"text":"        lemma2_to64();"},{"highlight_end":31,"highlight_start":1,"text":"        lemma_pow2_unfold(65);"},{"highlight_end":74,"highlight_start":1,"text":"        if exponent > 65 { lemma_pow2_strictly_increases(65, exponent); }"},{"highlight_end":44,"highlight_start":1,"text":"        assert(pow2(exponent) >= pow2(65));"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":66,"highlight_start":1,"text":"pub(crate) open spec fn valid_matrix(matrix: [i128; 4]) -> bool {"},{"highlight_end":94,"highlight_start":1,"text":"    (determinant(matrix[0] as int, matrix[1] as int, matrix[2] as int, matrix[3] as int) == 1"},{"highlight_end":102,"highlight_start":1,"text":"        || determinant(matrix[0] as int, matrix[1] as int, matrix[2] as int, matrix[3] as int) == -1)"},{"highlight_end":98,"highlight_start":1,"text":"        && forall|index: int| 0 <= index < 4 ==> abs(#[trigger] matrix[index] as int) <= u64::MAX"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":73,"highlight_start":1,"text":"proof fn determinant_step(a: int, b: int, c: int, d: int, quotient: int)"},{"highlight_end":95,"highlight_start":1,"text":"    ensures determinant(c, d, a - quotient * c, b - quotient * d) == -determinant(a, b, c, d),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":80,"highlight_start":1,"text":"    assert(c * (b - quotient * d) - d * (a - quotient * c) == -(a * d - b * c))"},{"highlight_end":30,"highlight_start":1,"text":"        by (nonlinear_arith);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":109,"highlight_start":1,"text":"pub(crate) open spec fn finish(a: int, b: int, c: int, d: int, steps: nat) -> Option<(int, int, int, int)> {"},{"highlight_end":55,"highlight_start":1,"text":"    if steps >= 2 { Some((a, b, c, d)) } else { None }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":71,"highlight_start":1,"text":"/// A bounded recursive model of endpoint agreement using mathematical"},{"highlight_end":76,"highlight_start":1,"text":"/// integers. Coefficient growth proves that 129 guard evaluations suffice;"},{"highlight_end":70,"highlight_start":1,"text":"/// the executable loop never exhausts this model's recursion budget."},{"highlight_end":20,"highlight_start":1,"text":"#[verifier::opaque]"},{"highlight_end":36,"highlight_start":1,"text":"pub(crate) open spec fn batch_spec("},{"highlight_end":86,"highlight_start":1,"text":"    larger: int, smaller: int, a: int, b: int, c: int, d: int, steps: nat, fuel: nat,"},{"highlight_end":34,"highlight_start":1,"text":") -> Option<(int, int, int, int)>"},{"highlight_end":20,"highlight_start":1,"text":"    decreases fuel,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":47,"highlight_start":1,"text":"    if fuel == 0 || larger < 0 || smaller <= 0"},{"highlight_end":86,"highlight_start":1,"text":"        || larger + a < 0 || larger + b < 0 || smaller + c <= 0 || smaller + d <= 0 {"},{"highlight_end":34,"highlight_start":1,"text":"        finish(a, b, c, d, steps)"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":53,"highlight_start":1,"text":"        let quotient = (larger + a) / (smaller + c);"},{"highlight_end":39,"highlight_start":1,"text":"        let next_c = a - quotient * c;"},{"highlight_end":39,"highlight_start":1,"text":"        let next_d = b - quotient * d;"},{"highlight_end":56,"highlight_start":1,"text":"        let next_smaller = larger - quotient * smaller;"},{"highlight_end":69,"highlight_start":1,"text":"        if quotient == 0 || quotient != (larger + b) / (smaller + d)"},{"highlight_end":74,"highlight_start":1,"text":"            || next_smaller < 0 || abs(c) > u64::MAX || abs(d) > u64::MAX"},{"highlight_end":66,"highlight_start":1,"text":"            || abs(next_c) > u64::MAX || abs(next_d) > u64::MAX {"},{"highlight_end":38,"highlight_start":1,"text":"            finish(a, b, c, d, steps)"},{"highlight_end":17,"highlight_start":1,"text":"        } else {"},{"highlight_end":98,"highlight_start":1,"text":"            batch_spec(smaller, next_smaller, c, d, next_c, next_d, steps + 1, (fuel - 1) as nat)"},{"highlight_end":10,"highlight_start":1,"text":"        }"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":97,"highlight_start":1,"text":"pub(crate) open spec fn matrix_view(result: Option<[i128; 4]>) -> Option<(int, int, int, int)> {"},{"highlight_end":19,"highlight_start":1,"text":"    match result {"},{"highlight_end":104,"highlight_start":1,"text":"        Some(matrix) => Some((matrix[0] as int, matrix[1] as int, matrix[2] as int, matrix[3] as int)),"},{"highlight_end":22,"highlight_start":1,"text":"        None => None,"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":83,"highlight_start":1,"text":"proof fn quotient_bound(larger: int, smaller: int, a: int, b: int, c: int, d: int)"},{"highlight_end":65,"highlight_start":1,"text":"    requires larger >= 0, smaller >= 0, alternating(a, b, c, d),"},{"highlight_end":76,"highlight_start":1,"text":"        larger + a >= 0, larger + b >= 0, smaller + c > 0, smaller + d > 0,"},{"highlight_end":70,"highlight_start":1,"text":"        (larger + a) / (smaller + c) == (larger + b) / (smaller + d),"},{"highlight_end":57,"highlight_start":1,"text":"    ensures 0 <= (larger + a) / (smaller + c) <= larger,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":26,"highlight_start":1,"text":"    if a <= 0 && c >= 0 {"},{"highlight_end":58,"highlight_start":1,"text":"        lemma_div_nonincreasing(larger + a, smaller + c);"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":58,"highlight_start":1,"text":"        lemma_div_nonincreasing(larger + b, smaller + d);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":2,"highlight_start":1,"text":"}"}]}},"file_name":"/home/tim/Documents/GitHub/workspace/csgrs/target/scalar-evaluation-candidate/source/crates/hyperreal/src/verified/lehmer.rs","is_primary":true,"label":null,"line_end":229,"line_start":13,"suggested_replacement":null,"suggestion_applicability":null,"text":[{"highlight_end":9,"highlight_start":1,"text":"verus! {"},{"highlight_end":77,"highlight_start":1,"text":"pub(crate) open spec fn determinant(a: int, b: int, c: int, d: int) -> int {"},{"highlight_end":18,"highlight_start":1,"text":"    a * d - b * c"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":52,"highlight_start":1,"text":"proof fn abs_divisibility(value: int, divisor: nat)"},{"highlight_end":26,"highlight_start":1,"text":"    requires divisor > 0,"},{"highlight_end":74,"highlight_start":1,"text":"    ensures abs(value) % divisor == 0 <==> value % (divisor as int) == 0,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":19,"highlight_start":1,"text":"    if value < 0 {"},{"highlight_end":61,"highlight_start":1,"text":"        lemma_mul_mod_noop_right(-1, value, divisor as int);"},{"highlight_end":62,"highlight_start":1,"text":"        lemma_mul_mod_noop_right(-1, -value, divisor as int);"},{"highlight_end":37,"highlight_start":1,"text":"        lemma_small_mod(0, divisor);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":91,"highlight_start":1,"text":"proof fn linear_combination_divisible(left: int, right: int, a: int, b: int, divisor: nat)"},{"highlight_end":87,"highlight_start":1,"text":"    requires divisor > 0, left % (divisor as int) == 0, right % (divisor as int) == 0,"},{"highlight_end":60,"highlight_start":1,"text":"    ensures (a * left + b * right) % (divisor as int) == 0,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":53,"highlight_start":1,"text":"    lemma_fundamental_div_mod(left, divisor as int);"},{"highlight_end":54,"highlight_start":1,"text":"    lemma_fundamental_div_mod(right, divisor as int);"},{"highlight_end":37,"highlight_start":1,"text":"    let l = left / (divisor as int);"},{"highlight_end":38,"highlight_start":1,"text":"    let r = right / (divisor as int);"},{"highlight_end":83,"highlight_start":1,"text":"    assert(a * left + b * right == (a * l + b * r) * divisor) by (nonlinear_arith)"},{"highlight_end":60,"highlight_start":1,"text":"        requires left == divisor * l, right == divisor * r;"},{"highlight_end":62,"highlight_start":1,"text":"    lemma_mod_multiples_basic(a * l + b * r, divisor as int);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":77,"highlight_start":1,"text":"/// A unit determinant supplies an integer inverse, so taking the magnitudes"},{"highlight_end":77,"highlight_start":1,"text":"/// of the transformed rows preserves exactly the original greatest divisor."},{"highlight_end":100,"highlight_start":1,"text":"pub(crate) proof fn unimodular_preserves_gcd(left: nat, right: nat, a: int, b: int, c: int, d: int)"},{"highlight_end":76,"highlight_start":1,"text":"    requires determinant(a, b, c, d) == 1 || determinant(a, b, c, d) == -1,"},{"highlight_end":91,"highlight_start":1,"text":"    ensures gcd(abs(a * left + b * right), abs(c * left + d * right)) == gcd(left, right),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":38,"highlight_start":1,"text":"    let first = a * left + b * right;"},{"highlight_end":39,"highlight_start":1,"text":"    let second = c * left + d * right;"},{"highlight_end":39,"highlight_start":1,"text":"    let det = determinant(a, b, c, d);"},{"highlight_end":67,"highlight_start":1,"text":"    assert(d * (a * left + b * right) - b * (c * left + d * right)"},{"highlight_end":57,"highlight_start":1,"text":"        == (a * d - b * c) * left) by (nonlinear_arith);"},{"highlight_end":68,"highlight_start":1,"text":"    assert(-c * (a * left + b * right) + a * (c * left + d * right)"},{"highlight_end":58,"highlight_start":1,"text":"        == (a * d - b * c) * right) by (nonlinear_arith);"},{"highlight_end":86,"highlight_start":1,"text":"    assert(abs(det * left) == left && abs(det * right) == right) by (nonlinear_arith)"},{"highlight_end":63,"highlight_start":1,"text":"        requires det == 1 || det == -1, left >= 0, right >= 0;"},{"highlight_end":39,"highlight_start":1,"text":"    gcd_characterization(left, right);"},{"highlight_end":51,"highlight_start":1,"text":"    gcd_characterization(abs(first), abs(second));"},{"highlight_end":33,"highlight_start":1,"text":"    if left == 0 && right == 0 {"},{"highlight_end":63,"highlight_start":1,"text":"        assert(first == 0 && second == 0) by (nonlinear_arith)"},{"highlight_end":84,"highlight_start":1,"text":"            requires first == a * left + b * right, second == c * left + d * right,"},{"highlight_end":39,"highlight_start":1,"text":"                left == 0, right == 0;"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":63,"highlight_start":1,"text":"        assert(first != 0 || second != 0) by (nonlinear_arith)"},{"highlight_end":59,"highlight_start":1,"text":"            requires d * first - b * second == det * left,"},{"highlight_end":56,"highlight_start":1,"text":"                -c * first + a * second == det * right,"},{"highlight_end":64,"highlight_start":1,"text":"                det == 1 || det == -1, left != 0 || right != 0;"},{"highlight_end":39,"highlight_start":1,"text":"        let before = gcd(left, right);"},{"highlight_end":50,"highlight_start":1,"text":"        let after = gcd(abs(first), abs(second));"},{"highlight_end":79,"highlight_start":1,"text":"        linear_combination_divisible(left as int, right as int, a, b, before);"},{"highlight_end":79,"highlight_start":1,"text":"        linear_combination_divisible(left as int, right as int, c, d, before);"},{"highlight_end":41,"highlight_start":1,"text":"        abs_divisibility(first, before);"},{"highlight_end":42,"highlight_start":1,"text":"        abs_divisibility(second, before);"},{"highlight_end":33,"highlight_start":1,"text":"        assert(before <= after);"},{"highlight_end":40,"highlight_start":1,"text":"        abs_divisibility(first, after);"},{"highlight_end":41,"highlight_start":1,"text":"        abs_divisibility(second, after);"},{"highlight_end":67,"highlight_start":1,"text":"        linear_combination_divisible(first, second, d, -b, after);"},{"highlight_end":67,"highlight_start":1,"text":"        linear_combination_divisible(first, second, -c, a, after);"},{"highlight_end":77,"highlight_start":1,"text":"        assert(d * first + (-b) * second == det * left) by (nonlinear_arith)"},{"highlight_end":59,"highlight_start":1,"text":"            requires d * first - b * second == det * left;"},{"highlight_end":45,"highlight_start":1,"text":"        abs_divisibility(det * left, after);"},{"highlight_end":46,"highlight_start":1,"text":"        abs_divisibility(det * right, after);"},{"highlight_end":57,"highlight_start":1,"text":"        assert(left % after == 0 && right % after == 0);"},{"highlight_end":33,"highlight_start":1,"text":"        assert(after <= before);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":73,"highlight_start":1,"text":"pub(crate) proof fn magnitude_row(left: nat, right: nat, a: int, b: int)"},{"highlight_end":65,"highlight_start":1,"text":"    ensures abs(a * left + b * right) == if (a < 0) == (b < 0) {"},{"highlight_end":39,"highlight_start":1,"text":"        abs(a) * left + abs(b) * right"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":44,"highlight_start":1,"text":"        abs(abs(a) * left - abs(b) * right)"},{"highlight_end":7,"highlight_start":1,"text":"    },"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":64,"highlight_start":1,"text":"    assert(abs(a * left + b * right) == if (a < 0) == (b < 0) {"},{"highlight_end":39,"highlight_start":1,"text":"        abs(a) * left + abs(b) * right"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":44,"highlight_start":1,"text":"        abs(abs(a) * left - abs(b) * right)"},{"highlight_end":60,"highlight_start":1,"text":"    }) by (nonlinear_arith) requires left >= 0, right >= 0;"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":78,"highlight_start":1,"text":"pub(crate) open spec fn alternating(a: int, b: int, c: int, d: int) -> bool {"},{"highlight_end":43,"highlight_start":1,"text":"    (a >= 0 && b <= 0 && c <= 0 && d >= 0)"},{"highlight_end":50,"highlight_start":1,"text":"        || (a <= 0 && b >= 0 && c >= 0 && d <= 0)"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":68,"highlight_start":1,"text":"proof fn opposite_coefficient_growth(a: int, c: int, quotient: int)"},{"highlight_end":69,"highlight_start":1,"text":"    requires quotient > 0, (a >= 0 && c <= 0) || (a <= 0 && c >= 0),"},{"highlight_end":65,"highlight_start":1,"text":"    ensures abs(a - quotient * c) == abs(a) + quotient * abs(c),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":85,"highlight_start":1,"text":"    assert(abs(a - quotient * c) == abs(a) + quotient * abs(c)) by (nonlinear_arith)"},{"highlight_end":73,"highlight_start":1,"text":"        requires quotient > 0, (a >= 0 && c <= 0) || (a <= 0 && c >= 0);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":79,"highlight_start":1,"text":"proof fn row_growth(a: int, b: int, c: int, d: int, quotient: int, steps: nat)"},{"highlight_end":52,"highlight_start":1,"text":"    requires quotient > 0, alternating(a, b, c, d),"},{"highlight_end":44,"highlight_start":1,"text":"        abs(a) + abs(b) >= pow2(steps / 2),"},{"highlight_end":50,"highlight_start":1,"text":"        abs(c) + abs(d) >= pow2((steps + 1) / 2),"},{"highlight_end":12,"highlight_start":1,"text":"    ensures"},{"highlight_end":63,"highlight_start":1,"text":"        alternating(c, d, a - quotient * c, b - quotient * d),"},{"highlight_end":50,"highlight_start":1,"text":"        abs(c) + abs(d) >= pow2((steps + 1) / 2),"},{"highlight_end":80,"highlight_start":1,"text":"        abs(a - quotient * c) + abs(b - quotient * d) >= pow2((steps + 2) / 2),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":49,"highlight_start":1,"text":"    opposite_coefficient_growth(a, c, quotient);"},{"highlight_end":49,"highlight_start":1,"text":"    opposite_coefficient_growth(b, d, quotient);"},{"highlight_end":87,"highlight_start":1,"text":"    assert(alternating(c, d, a - quotient * c, b - quotient * d)) by (nonlinear_arith)"},{"highlight_end":56,"highlight_start":1,"text":"        requires quotient > 0, alternating(a, b, c, d);"},{"highlight_end":24,"highlight_start":1,"text":"    if steps % 2 == 0 {"},{"highlight_end":44,"highlight_start":1,"text":"        lemma_pow2_unfold((steps + 2) / 2);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":31,"highlight_start":1,"text":"    let top = abs(a) + abs(b);"},{"highlight_end":34,"highlight_start":1,"text":"    let bottom = abs(c) + abs(d);"},{"highlight_end":62,"highlight_start":1,"text":"    let next = abs(a - quotient * c) + abs(b - quotient * d);"},{"highlight_end":65,"highlight_start":1,"text":"    assert(next == top + quotient * bottom) by (nonlinear_arith)"},{"highlight_end":70,"highlight_start":1,"text":"        requires abs(a - quotient * c) == abs(a) + quotient * abs(c),"},{"highlight_end":65,"highlight_start":1,"text":"            abs(b - quotient * d) == abs(b) + quotient * abs(d),"},{"highlight_end":67,"highlight_start":1,"text":"            next == abs(a - quotient * c) + abs(b - quotient * d),"},{"highlight_end":63,"highlight_start":1,"text":"            top == abs(a) + abs(b), bottom == abs(c) + abs(d);"},{"highlight_end":24,"highlight_start":1,"text":"    if steps % 2 == 0 {"},{"highlight_end":67,"highlight_start":1,"text":"        assert(next >= pow2((steps + 2) / 2)) by (nonlinear_arith)"},{"highlight_end":69,"highlight_start":1,"text":"            requires next == top + quotient * bottom, quotient >= 1,"},{"highlight_end":80,"highlight_start":1,"text":"                top >= pow2(steps / 2), bottom >= pow2(steps / 2), bottom >= 0,"},{"highlight_end":62,"highlight_start":1,"text":"                pow2((steps + 2) / 2) == 2 * pow2(steps / 2);"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":52,"highlight_start":1,"text":"        assert(next >= bottom) by (nonlinear_arith)"},{"highlight_end":92,"highlight_start":1,"text":"            requires next == top + quotient * bottom, quotient >= 1, top >= 0, bottom >= 0;"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":75,"highlight_start":1,"text":"/// The bounded coefficients double in magnitude at least every two steps."},{"highlight_end":77,"highlight_start":1,"text":"/// Their word-size bound therefore keeps the existing u8 counter below 129."},{"highlight_end":55,"highlight_start":1,"text":"proof fn step_counter_bound(c: int, d: int, steps: u8)"},{"highlight_end":53,"highlight_start":1,"text":"    requires abs(c) <= u64::MAX, abs(d) <= u64::MAX,"},{"highlight_end":57,"highlight_start":1,"text":"        abs(c) + abs(d) >= pow2((steps as nat + 1) / 2),"},{"highlight_end":25,"highlight_start":1,"text":"    ensures steps < 129,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":22,"highlight_start":1,"text":"    if steps >= 129 {"},{"highlight_end":47,"highlight_start":1,"text":"        let exponent = (steps as nat + 1) / 2;"},{"highlight_end":23,"highlight_start":1,"text":"        lemma2_to64();"},{"highlight_end":31,"highlight_start":1,"text":"        lemma_pow2_unfold(65);"},{"highlight_end":74,"highlight_start":1,"text":"        if exponent > 65 { lemma_pow2_strictly_increases(65, exponent); }"},{"highlight_end":44,"highlight_start":1,"text":"        assert(pow2(exponent) >= pow2(65));"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":66,"highlight_start":1,"text":"pub(crate) open spec fn valid_matrix(matrix: [i128; 4]) -> bool {"},{"highlight_end":94,"highlight_start":1,"text":"    (determinant(matrix[0] as int, matrix[1] as int, matrix[2] as int, matrix[3] as int) == 1"},{"highlight_end":102,"highlight_start":1,"text":"        || determinant(matrix[0] as int, matrix[1] as int, matrix[2] as int, matrix[3] as int) == -1)"},{"highlight_end":98,"highlight_start":1,"text":"        && forall|index: int| 0 <= index < 4 ==> abs(#[trigger] matrix[index] as int) <= u64::MAX"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":73,"highlight_start":1,"text":"proof fn determinant_step(a: int, b: int, c: int, d: int, quotient: int)"},{"highlight_end":95,"highlight_start":1,"text":"    ensures determinant(c, d, a - quotient * c, b - quotient * d) == -determinant(a, b, c, d),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":80,"highlight_start":1,"text":"    assert(c * (b - quotient * d) - d * (a - quotient * c) == -(a * d - b * c))"},{"highlight_end":30,"highlight_start":1,"text":"        by (nonlinear_arith);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":109,"highlight_start":1,"text":"pub(crate) open spec fn finish(a: int, b: int, c: int, d: int, steps: nat) -> Option<(int, int, int, int)> {"},{"highlight_end":55,"highlight_start":1,"text":"    if steps >= 2 { Some((a, b, c, d)) } else { None }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":71,"highlight_start":1,"text":"/// A bounded recursive model of endpoint agreement using mathematical"},{"highlight_end":76,"highlight_start":1,"text":"/// integers. Coefficient growth proves that 129 guard evaluations suffice;"},{"highlight_end":70,"highlight_start":1,"text":"/// the executable loop never exhausts this model's recursion budget."},{"highlight_end":20,"highlight_start":1,"text":"#[verifier::opaque]"},{"highlight_end":36,"highlight_start":1,"text":"pub(crate) open spec fn batch_spec("},{"highlight_end":86,"highlight_start":1,"text":"    larger: int, smaller: int, a: int, b: int, c: int, d: int, steps: nat, fuel: nat,"},{"highlight_end":34,"highlight_start":1,"text":") -> Option<(int, int, int, int)>"},{"highlight_end":20,"highlight_start":1,"text":"    decreases fuel,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":47,"highlight_start":1,"text":"    if fuel == 0 || larger < 0 || smaller <= 0"},{"highlight_end":86,"highlight_start":1,"text":"        || larger + a < 0 || larger + b < 0 || smaller + c <= 0 || smaller + d <= 0 {"},{"highlight_end":34,"highlight_start":1,"text":"        finish(a, b, c, d, steps)"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":53,"highlight_start":1,"text":"        let quotient = (larger + a) / (smaller + c);"},{"highlight_end":39,"highlight_start":1,"text":"        let next_c = a - quotient * c;"},{"highlight_end":39,"highlight_start":1,"text":"        let next_d = b - quotient * d;"},{"highlight_end":56,"highlight_start":1,"text":"        let next_smaller = larger - quotient * smaller;"},{"highlight_end":69,"highlight_start":1,"text":"        if quotient == 0 || quotient != (larger + b) / (smaller + d)"},{"highlight_end":74,"highlight_start":1,"text":"            || next_smaller < 0 || abs(c) > u64::MAX || abs(d) > u64::MAX"},{"highlight_end":66,"highlight_start":1,"text":"            || abs(next_c) > u64::MAX || abs(next_d) > u64::MAX {"},{"highlight_end":38,"highlight_start":1,"text":"            finish(a, b, c, d, steps)"},{"highlight_end":17,"highlight_start":1,"text":"        } else {"},{"highlight_end":98,"highlight_start":1,"text":"            batch_spec(smaller, next_smaller, c, d, next_c, next_d, steps + 1, (fuel - 1) as nat)"},{"highlight_end":10,"highlight_start":1,"text":"        }"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":97,"highlight_start":1,"text":"pub(crate) open spec fn matrix_view(result: Option<[i128; 4]>) -> Option<(int, int, int, int)> {"},{"highlight_end":19,"highlight_start":1,"text":"    match result {"},{"highlight_end":104,"highlight_start":1,"text":"        Some(matrix) => Some((matrix[0] as int, matrix[1] as int, matrix[2] as int, matrix[3] as int)),"},{"highlight_end":22,"highlight_start":1,"text":"        None => None,"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":83,"highlight_start":1,"text":"proof fn quotient_bound(larger: int, smaller: int, a: int, b: int, c: int, d: int)"},{"highlight_end":65,"highlight_start":1,"text":"    requires larger >= 0, smaller >= 0, alternating(a, b, c, d),"},{"highlight_end":76,"highlight_start":1,"text":"        larger + a >= 0, larger + b >= 0, smaller + c > 0, smaller + d > 0,"},{"highlight_end":70,"highlight_start":1,"text":"        (larger + a) / (smaller + c) == (larger + b) / (smaller + d),"},{"highlight_end":57,"highlight_start":1,"text":"    ensures 0 <= (larger + a) / (smaller + c) <= larger,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":26,"highlight_start":1,"text":"    if a <= 0 && c >= 0 {"},{"highlight_end":58,"highlight_start":1,"text":"        lemma_div_nonincreasing(larger + a, smaller + c);"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":58,"highlight_start":1,"text":"        lemma_div_nonincreasing(larger + b, smaller + d);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":2,"highlight_start":1,"text":"}"}]}],"code":{"code":"unexpected_cfgs","explanation":null}}}
