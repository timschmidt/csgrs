at) == gcd(left, right),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":32,"highlight_start":1,"text":"    gcd_symmetric(left, right);"},{"highlight_end":48,"highlight_start":1,"text":"    gcd_symmetric(left, (right - left) as nat);"},{"highlight_end":63,"highlight_start":1,"text":"    lemma_mod_sub_multiples_vanish(right as int, left as int);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":67,"highlight_start":1,"text":"pub(crate) proof fn gcd_scaled(left: nat, right: nat, factor: nat)"},{"highlight_end":25,"highlight_start":1,"text":"    requires factor > 0,"},{"highlight_end":77,"highlight_start":1,"text":"    ensures gcd(left * factor, right * factor) == gcd(left, right) * factor,"},{"highlight_end":21,"highlight_start":1,"text":"    decreases right,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":20,"highlight_start":1,"text":"    if right != 0 {"},{"highlight_end":38,"highlight_start":1,"text":"        let remainder = left % right;"},{"highlight_end":37,"highlight_start":1,"text":"        let quotient = left / right;"},{"highlight_end":62,"highlight_start":1,"text":"        lemma_fundamental_div_mod(left as int, right as int);"},{"highlight_end":78,"highlight_start":1,"text":"        assert(0 <= remainder * factor < right * factor) by (nonlinear_arith)"},{"highlight_end":57,"highlight_start":1,"text":"            requires 0 <= remainder < right, factor > 0;"},{"highlight_end":82,"highlight_start":1,"text":"        assert(left * factor == quotient * (right * factor) + remainder * factor)"},{"highlight_end":33,"highlight_start":1,"text":"            by (nonlinear_arith)"},{"highlight_end":59,"highlight_start":1,"text":"            requires left == quotient * right + remainder;"},{"highlight_end":48,"highlight_start":1,"text":"        lemma_fundamental_div_mod_converse_mod("},{"highlight_end":61,"highlight_start":1,"text":"            (left * factor) as int, (right * factor) as int,"},{"highlight_end":59,"highlight_start":1,"text":"            quotient as int, (remainder * factor) as int);"},{"highlight_end":46,"highlight_start":1,"text":"        gcd_scaled(right, remainder, factor);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":78,"highlight_start":1,"text":"/// Cancel the complete common factor without changing the represented ratio."},{"highlight_end":73,"highlight_start":1,"text":"/// This also covers a zero numerator, whose reduced denominator is one."},{"highlight_end":68,"highlight_start":1,"text":"pub(crate) proof fn gcd_reduction(numerator: nat, denominator: nat)"},{"highlight_end":30,"highlight_start":1,"text":"    requires denominator > 0,"},{"highlight_end":12,"highlight_start":1,"text":"    ensures"},{"highlight_end":41,"highlight_start":1,"text":"        gcd(numerator, denominator) > 0,"},{"highlight_end":92,"highlight_start":1,"text":"        numerator / gcd(numerator, denominator) * gcd(numerator, denominator) == numerator,"},{"highlight_end":96,"highlight_start":1,"text":"        denominator / gcd(numerator, denominator) * gcd(numerator, denominator) == denominator,"},{"highlight_end":70,"highlight_start":1,"text":"        0 < denominator / gcd(numerator, denominator) <= denominator,"},{"highlight_end":62,"highlight_start":1,"text":"        numerator / gcd(numerator, denominator) <= numerator,"},{"highlight_end":102,"highlight_start":1,"text":"        gcd(numerator / gcd(numerator, denominator), denominator / gcd(numerator, denominator)) == 1,"},{"highlight_end":62,"highlight_start":1,"text":"        numerator / gcd(numerator, denominator) * denominator"},{"highlight_end":72,"highlight_start":1,"text":"            == numerator * (denominator / gcd(numerator, denominator)),"},{"highlight_end":76,"highlight_start":1,"text":"        (numerator / gcd(numerator, denominator) == 0 <==> numerator == 0),"},{"highlight_end":75,"highlight_start":1,"text":"        numerator == 0 ==> denominator / gcd(numerator, denominator) == 1,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":50,"highlight_start":1,"text":"    gcd_characterization(numerator, denominator);"},{"highlight_end":47,"highlight_start":1,"text":"    let divisor = gcd(numerator, denominator);"},{"highlight_end":49,"highlight_start":1,"text":"    let reduced_numerator = numerator / divisor;"},{"highlight_end":53,"highlight_start":1,"text":"    let reduced_denominator = denominator / divisor;"},{"highlight_end":65,"highlight_start":1,"text":"    lemma_fundamental_div_mod(numerator as int, divisor as int);"},{"highlight_end":67,"highlight_start":1,"text":"    lemma_fundamental_div_mod(denominator as int, divisor as int);"},{"highlight_end":52,"highlight_start":1,"text":"    assert(numerator == reduced_numerator * divisor"},{"highlight_end":78,"highlight_start":1,"text":"        && denominator == reduced_denominator * divisor) by (nonlinear_arith)"},{"highlight_end":105,"highlight_start":1,"text":"        requires numerator == divisor * reduced_numerator, denominator == divisor * reduced_denominator;"},{"highlight_end":84,"highlight_start":1,"text":"    assert(0 < reduced_denominator <= denominator && reduced_numerator <= numerator"},{"highlight_end":78,"highlight_start":1,"text":"        && (reduced_numerator == 0 <==> numerator == 0)) by (nonlinear_arith)"},{"highlight_end":97,"highlight_start":1,"text":"        requires divisor > 0, denominator > 0, reduced_numerator >= 0, reduced_denominator >= 0,"},{"highlight_end":100,"highlight_start":1,"text":"            numerator == reduced_numerator * divisor, denominator == reduced_denominator * divisor;"},{"highlight_end":65,"highlight_start":1,"text":"    gcd_scaled(reduced_numerator, reduced_denominator, divisor);"},{"highlight_end":82,"highlight_start":1,"text":"    assert(gcd(reduced_numerator, reduced_denominator) == 1) by (nonlinear_arith)"},{"highlight_end":96,"highlight_start":1,"text":"        requires divisor > 0, divisor == gcd(reduced_numerator, reduced_denominator) * divisor;"},{"highlight_end":100,"highlight_start":1,"text":"    assert(reduced_numerator * denominator == numerator * reduced_denominator) by (nonlinear_arith)"},{"highlight_end":105,"highlight_start":1,"text":"        requires numerator == reduced_numerator * divisor, denominator == reduced_denominator * divisor;"},{"highlight_end":24,"highlight_start":1,"text":"    if numerator == 0 {"},{"highlight_end":41,"highlight_start":1,"text":"        lemma_small_mod(0, denominator);"},{"highlight_end":34,"highlight_start":1,"text":"        reveal_with_fuel(gcd, 2);"},{"highlight_end":40,"highlight_start":1,"text":"        assert(divisor == denominator);"},{"highlight_end":47,"highlight_start":1,"text":"        lemma_div_by_self(denominator as int);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":53,"highlight_start":1,"text":"pub(crate) proof fn gcd_bound(left: nat, right: nat)"},{"highlight_end":12,"highlight_start":1,"text":"    ensures"},{"highlight_end":47,"highlight_start":1,"text":"        left > 0 ==> gcd(left, right) <= left,"},{"highlight_end":49,"highlight_start":1,"text":"        right > 0 ==> gcd(left, right) <= right,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":39,"highlight_start":1,"text":"    gcd_characterization(left, right);"},{"highlight_end":36,"highlight_start":1,"text":"    let divisor = gcd(left, right);"},{"highlight_end":36,"highlight_start":1,"text":"    if left > 0 && divisor > left {"},{"highlight_end":40,"highlight_start":1,"text":"        lemma_small_mod(left, divisor);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":38,"highlight_start":1,"text":"    if right > 0 && divisor > right {"},{"highlight_end":41,"highlight_start":1,"text":"        lemma_small_mod(right, divisor);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":57,"highlight_start":1,"text":"proof fn divisor_of_odd_is_odd(value: nat, divisor: nat)"},{"highlight_end":64,"highlight_start":1,"text":"    requires value % 2 == 1, divisor > 0, value % divisor == 0,"},{"highlight_end":30,"highlight_start":1,"text":"    ensures divisor % 2 == 1,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":61,"highlight_start":1,"text":"    lemma_fundamental_div_mod(value as int, divisor as int);"},{"highlight_end":70,"highlight_start":1,"text":"    assert(value == (value / divisor) * divisor) by (nonlinear_arith)"},{"highlight_end":95,"highlight_start":1,"text":"        requires value == divisor * (value / divisor) + value % divisor, value % divisor == 0;"},{"highlight_end":69,"highlight_start":1,"text":"    lemma_mul_mod_noop((value / divisor) as int, divisor as int, 2);"},{"highlight_end":26,"highlight_start":1,"text":"    if divisor % 2 == 0 {"},{"highlight_end":82,"highlight_start":1,"text":"        assert(((value / divisor) % 2) * (divisor % 2) == 0) by (nonlinear_arith)"},{"highlight_end":39,"highlight_start":1,"text":"            requires divisor % 2 == 0;"},{"highlight_end":32,"highlight_start":1,"text":"        assert(value % 2 == 0);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":59,"highlight_start":1,"text":"proof fn odd_divisor_cancels_two(value: nat, divisor: nat)"},{"highlight_end":72,"highlight_start":1,"text":"    requires divisor > 0, divisor % 2 == 1, (2 * value) % divisor == 0,"},{"highlight_end":34,"highlight_start":1,"text":"    ensures value % divisor == 0,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":40,"highlight_start":1,"text":"    let quotient = 2 * value / divisor;"},{"highlight_end":67,"highlight_start":1,"text":"    lemma_fundamental_div_mod((2 * value) as int, divisor as int);"},{"highlight_end":60,"highlight_start":1,"text":"    lemma_mul_mod_noop(quotient as int, divisor as int, 2);"},{"highlight_end":48,"highlight_start":1,"text":"    lemma_mod_multiples_basic(value as int, 2);"},{"highlight_end":51,"highlight_start":1,"text":"    lemma_fundamental_div_mod(quotient as int, 2);"},{"highlight_end":67,"highlight_start":1,"text":"    assert(value == (quotient / 2) * divisor) by (nonlinear_arith)"},{"highlight_end":82,"highlight_start":1,"text":"        requires 2 * value == quotient * divisor, quotient == 2 * (quotient / 2);"},{"highlight_end":70,"highlight_start":1,"text":"    lemma_mod_multiples_basic((quotient / 2) as int, divisor as int);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":47,"highlight_start":1,"text":"proof fn gcd_odd_double(left: nat, right: nat)"},{"highlight_end":28,"highlight_start":1,"text":"    requires left % 2 == 1,"},{"highlight_end":54,"highlight_start":1,"text":"    ensures gcd(left, 2 * right) == gcd(left, right),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":39,"highlight_start":1,"text":"    gcd_characterization(left, right);"},{"highlight_end":43,"highlight_start":1,"text":"    gcd_characterization(left, 2 * right);"},{"highlight_end":37,"highlight_start":1,"text":"    let original = gcd(left, right);"},{"highlight_end":40,"highlight_start":1,"text":"    let doubled = gcd(left, 2 * right);"},{"highlight_end":64,"highlight_start":1,"text":"    lemma_mul_mod_noop_right(2, right as int, original as int);"},{"highlight_end":34,"highlight_start":1,"text":"    lemma_small_mod(0, original);"},{"highlight_end":41,"highlight_start":1,"text":"    assert((2 * right) % original == 0);"},{"highlight_end":42,"highlight_start":1,"text":"    divisor_of_odd_is_odd(left, doubled);"},{"highlight_end":45,"highlight_start":1,"text":"    odd_divisor_cancels_two(right, doubled);"},{"highlight_end":33,"highlight_start":1,"text":"    assert(original <= doubled);"},{"highlight_end":33,"highlight_start":1,"text":"    assert(doubled <= original);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":73,"highlight_start":1,"text":"pub(crate) proof fn gcd_odd_power_two(left: nat, right: nat, shift: nat)"},{"highlight_end":28,"highlight_start":1,"text":"    requires left % 2 == 1,"},{"highlight_end":64,"highlight_start":1,"text":"    ensures gcd(left, right * pow2(shift)) == gcd(left, right),"},{"highlight_end":21,"highlight_start":1,"text":"    decreases shift,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":20,"highlight_start":1,"text":"    if shift == 0 {"},{"highlight_end":23,"highlight_start":1,"text":"        lemma_pow0(2);"},{"highlight_end":34,"highlight_start":1,"text":"        assert(pow2(shift) == 1);"},{"highlight_end":66,"highlight_start":1,"text":"        assert(right * pow2(shift) == right) by (nonlinear_arith)"},{"highlight_end":39,"highlight_start":1,"text":"            requires pow2(shift) == 1;"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":34,"highlight_start":1,"text":"        lemma_pow2_unfold(shift);"},{"highlight_end":49,"highlight_start":1,"text":"        let previous = pow2((shift - 1) as nat);"},{"highlight_end":83,"highlight_start":1,"text":"        assert(right * pow2(shift) == 2 * (right * previous)) by (nonlinear_arith)"},{"highlight_end":50,"highlight_start":1,"text":"            requires pow2(shift) == 2 * previous;"},{"highlight_end":48,"highlight_start":1,"text":"        gcd_odd_double(left, right * previous);"},{"highlight_end":60,"highlight_start":1,"text":"        gcd_odd_power_two(left, right, (shift - 1) as nat);"},{"highlight_end":79,"highlight_start":1,"text":"        assert(gcd(left, right * pow2(shift)) == gcd(left, right * previous));"},{"highlight_end":65,"highlight_start":1,"text":"        assert(gcd(left, right * previous) == gcd(left, right));"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":83,"highlight_start":1,"text":"proof fn gcd_power_two_factors_ordered(left: nat, right: nat, low: nat, high: nat)"},{"highlight_end":41,"highlight_start":1,"text":"    requires left % 2 == 1, low <= high,"},{"highlight_end":87,"highlight_start":1,"text":"    ensures gcd(left * pow2(low), right * pow2(high)) == gcd(left, right) * pow2(low),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":37,"highlight_start":1,"text":"    let extra = (high - low) as nat;"},{"highlight_end":25,"highlight_start":1,"text":"    lemma_pow2_pos(low);"},{"highlight_end":33,"highlight_start":1,"text":"    lemma_pow2_adds(extra, low);"},{"highlight_end":68,"highlight_start":1,"text":"    assert(right * pow2(high) == (right * pow2(extra)) * pow2(low))"},{"highlight_end":77,"highlight_start":1,"text":"        by (nonlinear_arith) requires pow2(high) == pow2(extra) * pow2(low);"},{"highlight_end":54,"highlight_start":1,"text":"    gcd_scaled(left, right * pow2(extra), pow2(low));"},{"highlight_end":43,"highlight_start":1,"text":"    gcd_odd_power_two(left, right, extra);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":100,"highlight_start":1,"text":"pub(crate) proof fn gcd_power_two_factors(left: nat, right: nat, left_shift: nat, right_shift: nat)"},{"highlight_end":44,"highlight_start":1,"text":"    requires left % 2 == 1, right % 2 == 1,"},{"highlight_end":68,"highlight_start":1,"text":"    ensures gcd(left * pow2(left_shift), right * pow2(right_shift))"},{"highlight_end":101,"highlight_start":1,"text":"        == gcd(left, right) * pow2(if left_shift < right_shift { left_shift } else { right_shift }),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":35,"highlight_start":1,"text":"    if left_shift <= right_shift {"},{"highlight_end":77,"highlight_start":1,"text":"        gcd_power_two_factors_ordered(left, right, left_shift, right_shift);"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":77,"highlight_start":1,"text":"        gcd_power_two_factors_ordered(right, left, right_shift, left_shift);"},{"highlight_end":75,"highlight_start":1,"text":"        gcd_symmetric(left * pow2(left_shift), right * pow2(right_shift));"},{"highlight_end":36,"highlight_start":1,"text":"        gcd_symmetric(left, right);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":79,"highlight_start":1,"text":"/// Connect the standard-library trailing-zero specification to exact division"},{"highlight_end":78,"highlight_start":1,"text":"/// by a mathematical power of two, including the value's odd remaining part."},{"highlight_end":58,"highlight_start":1,"text":"pub(crate) proof fn trailing_zeros_factor_u64(value: u64)"},{"highlight_end":24,"highlight_start":1,"text":"    requires value > 0,"},{"highlight_end":12,"highlight_start":1,"text":"    ensures"},{"highlight_end":40,"highlight_start":1,"text":"        u64_trailing_zeros(value) < 64,"},{"highlight_end":59,"highlight_start":1,"text":"        0 < (value >> u64_trailing_zeros(value)) <= value,"},{"highlight_end":55,"highlight_start":1,"text":"        (value >> u64_trailing_zeros(value)) % 2 == 1,"},{"highlight_end":96,"highlight_start":1,"text":"        value == (value >> u64_trailing_zeros(value)) * pow2(u64_trailing_zeros(value) as nat),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":37,"highlight_start":1,"text":"    axiom_u64_trailing_zeros(value);"},{"highlight_end":50,"highlight_start":1,"text":"    let shift = u64_trailing_zeros(value) as u64;"},{"highlight_end":30,"highlight_start":1,"text":"    let odd = value >> shift;"},{"highlight_end":54,"highlight_start":1,"text":"    assert((value >> shift) % 2 == 1) by (bit_vector)"},{"highlight_end":50,"highlight_start":1,"text":"        requires (value >> shift) & 1u64 == 1u64;"},{"highlight_end":45,"highlight_start":1,"text":"    assert(0 < odd <= value) by (bit_vector)"},{"highlight_end":54,"highlight_start":1,"text":"        requires odd == value >> shift, odd % 2 == 1;"},{"highlight_end":74,"highlight_start":1,"text":"    vstd::bits::lemma_u64_mul_pow2_le_max_iff_max_shr(odd, shift, value);"},{"highlight_end":50,"highlight_start":1,"text":"    vstd::bits::lemma_u64_shl_is_mul(odd, shift);"},{"highlight_end":63,"highlight_start":1,"text":"    assert((value >> shift) << shift == value) by (bit_vector)"},{"highlight_end":66,"highlight_start":1,"text":"        requires shift < 64, value << ((64 - shift) as u64) == 0;"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":71,"highlight_start":1,"text":"pub(crate) open spec fn trailing_zeros_u128_spec(value: u128) -> u32 {"},{"highlight_end":27,"highlight_start":1,"text":"    if value as u64 != 0 {"},{"highlight_end":41,"highlight_start":1,"text":"        u64_trailing_zeros(value as u64)"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":63,"highlight_start":1,"text":"        (64 + u64_trailing_zeros((value >> 64) as u64)) as u32"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":60,"highlight_start":1,"text":"pub(crate) proof fn trailing_zeros_factor_u128(value: u128)"},{"highlight_end":12,"highlight_start":1,"text":"    ensures"},{"highlight_end":48,"highlight_start":1,"text":"        trailing_zeros_u128_spec(value) <= 128,"},{"highlight_end":66,"highlight_start":1,"text":"        (trailing_zeros_u128_spec(value) == 128 <==> value == 0),"},{"highlight_end":24,"highlight_start":1,"text":"        value > 0 ==> ("},{"highlight_end":68,"highlight_start":1,"text":"            0 < (value >> trailing_zeros_u128_spec(value)) <= value"},{"highlight_end":67,"highlight_start":1,"text":"            && (value >> trailing_zeros_u128_spec(value)) % 2 == 1"},{"highlight_end":67,"highlight_start":1,"text":"            && value == (value >> trailing_zeros_u128_spec(value))"},{"highlight_end":65,"highlight_start":1,"text":"                * pow2(trailing_zeros_u128_spec(value) as nat)),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":28,"highlight_start":1,"text":"    let low = value as u64;"},{"highlight_end":37,"highlight_start":1,"text":"    let high = (value >> 64) as u64;"},{"highlight_end":35,"highlight_start":1,"text":"    axiom_u64_trailing_zeros(low);"},{"highlight_end":36,"highlight_start":1,"text":"    axiom_u64_trailing_zeros(high);"},{"highlight_end":49,"highlight_start":1,"text":"    let shift = trailing_zeros_u128_spec(value);"},{"highlight_end":66,"highlight_start":1,"text":"    assert(value == 0 <==> low == 0 && high == 0) by (bit_vector)"},{"highlight_end":68,"highlight_start":1,"text":"        requires low == value as u64, high == (value >> 64) as u64;"},{"highlight_end":19,"highlight_start":1,"text":"    if value > 0 {"},{"highlight_end":22,"highlight_start":1,"text":"        if low != 0 {"},{"highlight_end":73,"highlight_start":1,"text":"            assert(value << ((128 - shift) as u32) == 0) by (bit_vector)"},{"highlight_end":58,"highlight_start":1,"text":"                requires shift < 64, low == value as u64,"},{"highlight_end":55,"highlight_start":1,"text":"                    low << ((64 - shift) as u64) == 0;"},{"highlight_end":70,"highlight_start":1,"text":"            assert((value >> shift) & 1u128 == 1u128) by (bit_vector)"},{"highlight_end":58,"highlight_start":1,"text":"                requires shift < 64, low == value as u64,"},{"highlight_end":51,"highlight_start":1,"text":"                    (low >> shift) & 1u64 == 1u64;"},{"highlight_end":17,"highlight_start":1,"text":"        } else {"},{"highlight_end":56,"highlight_start":1,"text":"            let upper_shift = u64_trailing_zeros(high);"},{"highlight_end":73,"highlight_start":1,"text":"            assert(value << ((128 - shift) as u32) == 0) by (bit_vector)"},{"highlight_end":70,"highlight_start":1,"text":"                requires upper_shift < 64, shift == 64 + upper_shift,"},{"highlight_end":69,"highlight_start":1,"text":"                    value as u64 == 0, high == (value >> 64) as u64,"},{"highlight_end":62,"highlight_start":1,"text":"                    high << ((64 - upper_shift) as u64) == 0;"},{"highlight_end":70,"highlight_start":1,"text":"            assert((value >> shift) & 1u128 == 1u128) by (bit_vector)"},{"highlight_end":70,"highlight_start":1,"text":"                requires upper_shift < 64, shift == 64 + upper_shift,"},{"highlight_end":50,"highlight_start":1,"text":"                    high == (value >> 64) as u64,"},{"highlight_end":58,"highlight_start":1,"text":"                    (high >> upper_shift) & 1u64 == 1u64;"},{"highlight_end":10,"highlight_start":1,"text":"        }"},{"highlight_end":34,"highlight_start":1,"text":"        let odd = value >> shift;"},{"highlight_end":65,"highlight_start":1,"text":"        assert(0 < odd <= value && odd % 2 == 1) by (bit_vector)"},{"highlight_end":66,"highlight_start":1,"text":"            requires odd == value >> shift, odd & 1u128 == 1u128;"},{"highlight_end":38,"highlight_start":1,"text":"        lemma_pow2_pos(shift as nat);"},{"highlight_end":65,"highlight_start":1,"text":"        vstd::bits::lemma_u128_shr_is_div(value, shift as u128);"},{"highlight_end":76,"highlight_start":1,"text":"        lemma_fundamental_div_mod(value as int, pow2(shift as nat) as int);"},{"highlight_end":71,"highlight_start":1,"text":"        assert(odd * pow2(shift as nat) <= value) by (nonlinear_arith)"},{"highlight_end":63,"highlight_start":1,"text":"            requires odd == value as nat / pow2(shift as nat),"},{"highlight_end":82,"highlight_start":1,"text":"                value == pow2(shift as nat) * (value as nat / pow2(shift as nat))"},{"highlight_end":57,"highlight_start":1,"text":"                    + value as nat % pow2(shift as nat),"},{"highlight_end":56,"highlight_start":1,"text":"                value as nat % pow2(shift as nat) >= 0;"},{"highlight_end":57,"highlight_start":1,"text":"        super::word::shift_left_u128_is_mul(odd, shift);"},{"highlight_end":67,"highlight_start":1,"text":"        assert((value >> shift) << shift == value) by (bit_vector)"},{"highlight_end":72,"highlight_start":1,"text":"            requires shift < 128, value << ((128 - shift) as u32) == 0;"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":52,"highlight_start":1,"text":"proof fn power_of_two_has_unit_odd_part(value: u64)"},{"highlight_end":59,"highlight_start":1,"text":"    requires value > 0, value & ((value - 1) as u64) == 0,"},{"highlight_end":55,"highlight_start":1,"text":"    ensures (value >> u64_trailing_zeros(value)) == 1,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":37,"highlight_start":1,"text":"    axiom_u64_trailing_zeros(value);"},{"highlight_end":43,"highlight_start":1,"text":"    let shift = u64_trailing_zeros(value);"},{"highlight_end":50,"highlight_start":1,"text":"    assert((value >> shift) == 1) by (bit_vector)"},{"highlight_end":63,"highlight_start":1,"text":"        requires value > 0, value & ((value - 1) as u64) == 0,"},{"highlight_end":57,"highlight_start":1,"text":"            shift < 64, (value >> shift) & 1u64 == 1u64;"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":73,"highlight_start":1,"text":"/// Any common prefix of the two trailing-zero counts is an exact common"},{"highlight_end":77,"highlight_start":1,"text":"/// factor. This also covers the two-limb path that keeps non-odd quotients."},{"highlight_end":73,"highlight_start":1,"text":"proof fn common_shift_preserves_gcd(left: u128, right: u128, shift: u32)"},{"highlight_end":34,"highlight_start":1,"text":"    requires left > 0, right > 0,"},{"highlight_end":91,"highlight_start":1,"text":"        shift <= trailing_zeros_u128_spec(left), shift <= trailing_zeros_u128_spec(right),"},{"highlight_end":25,"highlight_start":1,"text":"    ensures shift < 128,"},{"highlight_end":39,"highlight_start":1,"text":"        gcd(left as nat, right as nat)"},{"highlight_end":90,"highlight_start":1,"text":"            == gcd((left >> shift) as nat, (right >> shift) as nat) * pow2(shift as nat),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":38,"highlight_start":1,"text":"    trailing_zeros_factor_u128(left);"},{"highlight_end":39,"highlight_start":1,"text":"    trailing_zeros_factor_u128(right);"},{"highlight_end":41,"highlight_start":1,"text":"    divide_trailing_factor(left, shift);"},{"highlight_end":42,"highlight_start":1,"text":"    divide_trailing_factor(right, shift);"},{"highlight_end":34,"highlight_start":1,"text":"    lemma_pow2_pos(shift as nat);"},{"highlight_end":85,"highlight_start":1,"text":"    gcd_scaled((left >> shift) as nat, (right >> shift) as nat, pow2(shift as nat));"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":68,"highlight_start":1,"text":"pub(crate) proof fn divide_trailing_factor(value: u128, shift: u32)"},{"highlight_end":66,"highlight_start":1,"text":"    requires value > 0, shift <= trailing_zeros_u128_spec(value),"},{"highlight_end":45,"highlight_start":1,"text":"    ensures shift < 128, 0 < value >> shift,"},{"highlight_end":56,"highlight_start":1,"text":"        value == (value >> shift) * pow2(shift as nat),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":39,"highlight_start":1,"text":"    trailing_zeros_factor_u128(value);"},{"highlight_end":49,"highlight_start":1,"text":"    let total = trailing_zeros_u128_spec(value);"},{"highlight_end":39,"highlight_start":1,"text":"    let odd = (value >> total) as nat;"},{"highlight_end":40,"highlight_start":1,"text":"    let extra = (total - shift) as nat;"},{"highlight_end":42,"highlight_start":1,"text":"    lemma_pow2_adds(extra, shift as nat);"},{"highlight_end":34,"highlight_start":1,"text":"    lemma_pow2_pos(shift as nat);"},{"highlight_end":83,"highlight_start":1,"text":"    assert(value == (odd * pow2(extra)) * pow2(shift as nat)) by (nonlinear_arith)"},{"highlight_end":52,"highlight_start":1,"text":"        requires value == odd * pow2(total as nat),"},{"highlight_end":68,"highlight_start":1,"text":"            pow2(total as nat) == pow2(extra) * pow2(shift as nat);"},{"highlight_end":80,"highlight_start":1,"text":"    lemma_fundamental_div_mod_converse(value as int, pow2(shift as nat) as int,"},{"highlight_end":40,"highlight_start":1,"text":"        (odd * pow2(extra)) as int, 0);"},{"highlight_end":61,"highlight_start":1,"text":"    vstd::bits::lemma_u128_shr_is_div(value, shift as u128);"},{"highlight_end":27,"highlight_start":1,"text":"    lemma_pow2_pos(extra);"},{"highlight_end":55,"highlight_start":1,"text":"    assert(odd * pow2(extra) > 0) by (nonlinear_arith)"},{"highlight_end":43,"highlight_start":1,"text":"        requires odd > 0, pow2(extra) > 0;"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":67,"highlight_start":1,"text":"proof fn gcd_power_of_two_word(left: u64, right: u128, shift: u32)"},{"highlight_end":67,"highlight_start":1,"text":"    requires left > 0, right > 0, left & ((left - 1) as u64) == 0,"},{"highlight_end":81,"highlight_start":1,"text":"        shift == if u64_trailing_zeros(left) < trailing_zeros_u128_spec(right) {"},{"highlight_end":37,"highlight_start":1,"text":"            u64_trailing_zeros(left)"},{"highlight_end":52,"highlight_start":1,"text":"        } else { trailing_zeros_u128_spec(right) },"},{"highlight_end":24,"highlight_start":1,"text":"    ensures shift < 64,"},{"highlight_end":62,"highlight_start":1,"text":"        gcd(left as nat, right as nat) == pow2(shift as nat),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":37,"highlight_start":1,"text":"    trailing_zeros_factor_u64(left);"},{"highlight_end":39,"highlight_start":1,"text":"    trailing_zeros_factor_u128(right);"},{"highlight_end":42,"highlight_start":1,"text":"    power_of_two_has_unit_odd_part(left);"},{"highlight_end":65,"highlight_start":1,"text":"    let odd = (right >> trailing_zeros_u128_spec(right)) as nat;"},{"highlight_end":67,"highlight_start":1,"text":"    gcd_power_two_factors(1, odd, u64_trailing_zeros(left) as nat,"},{"highlight_end":49,"highlight_start":1,"text":"        trailing_zeros_u128_spec(right) as nat);"},{"highlight_end":27,"highlight_start":1,"text":"    gcd_symmetric(1, odd);"},{"highlight_end":38,"highlight_start":1,"text":"    assert(gcd(odd, 1) == gcd(1, 0));"},{"highlight_end":30,"highlight_start":1,"text":"    assert(gcd(1, odd) == 1);"},{"highlight_end":83,"highlight_start":1,"text":"    assert(1 * pow2(u64_trailing_zeros(left) as nat) == left) by (nonlinear_arith)"},{"highlight_end":101,"highlight_start":1,"text":"        requires left == (left >> u64_trailing_zeros(left)) * pow2(u64_trailing_zeros(left) as nat),"},{"highlight_end":53,"highlight_start":1,"text":"            (left >> u64_trailing_zeros(left)) == 1;"},{"highlight_end":88,"highlight_start":1,"text":"    assert(gcd(1, odd) * pow2(shift as nat) == pow2(shift as nat)) by (nonlinear_arith)"},{"highlight_end":35,"highlight_start":1,"text":"        requires gcd(1, odd) == 1;"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":2,"highlight_start":1,"text":"}"}]}},"file_name":"/home/tim/Documents/GitHub/workspace/csgrs/target/scalar-evaluation-candidate/source/crates/hyperreal/src/verified/gcd.rs","is_primary":true,"label":null,"line_end":361,"line_start":11,"suggested_replacement":null,"suggestion_applicability":null,"text":[{"highlight_end":9,"highlight_start":1,"text":"verus! {"},{"highlight_end":57,"highlight_start":1,"text":"pub(crate) proof fn gcd_symmetric(left: nat, right: nat)"},{"highlight_end":50,"highlight_start":1,"text":"    ensures gcd(left, right) == gcd(right, left),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":22,"highlight_start":1,"text":"    if left < right {"},{"highlight_end":38,"highlight_start":1,"text":"        lemma_small_mod(left, right);"},{"highlight_end":29,"highlight_start":1,"text":"    } else if right < left {"},{"highlight_end":38,"highlight_start":1,"text":"        lemma_small_mod(right, left);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":56,"highlight_start":1,"text":"pub(crate) proof fn gcd_subtract(left: nat, right: nat)"},{"highlight_end":32,"highlight_start":1,"text":"    requires 0 < left <= right,"},{"highlight_end":66,"highlight_start":1,"text":"    ensures gcd(left, (right - left) as nat) == gcd(left, right),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":32,"highlight_start":1,"text":"    gcd_symmetric(left, right);"},{"highlight_end":48,"highlight_start":1,"text":"    gcd_symmetric(left, (right - left) as nat);"},{"highlight_end":63,"highlight_start":1,"text":"    lemma_mod_sub_multiples_vanish(right as int, left as int);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":67,"highlight_start":1,"text":"pub(crate) proof fn gcd_scaled(left: nat, right: nat, factor: nat)"},{"highlight_end":25,"highlight_start":1,"text":"    requires factor > 0,"},{"highlight_end":77,"highlight_start":1,"text":"    ensures gcd(left * factor, right * factor) == gcd(left, right) * factor,"},{"highlight_end":21,"highlight_start":1,"text":"    decreases right,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":20,"highlight_start":1,"text":"    if right != 0 {"},{"highlight_end":38,"highlight_start":1,"text":"        let remainder = left % right;"},{"highlight_end":37,"highlight_start":1,"text":"        let quotient = left / right;"},{"highlight_end":62,"highlight_start":1,"text":"        lemma_fundamental_div_mod(left as int, right as int);"},{"highlight_end":78,"highlight_start":1,"text":"        assert(0 <= remainder * factor < right * factor) by (nonlinear_arith)"},{"highlight_end":57,"highlight_start":1,"text":"            requires 0 <= remainder < right, factor > 0;"},{"highlight_end":82,"highlight_start":1,"text":"        assert(left * factor == quotient * (right * factor) + remainder * factor)"},{"highlight_end":33,"highlight_start":1,"text":"            by (nonlinear_arith)"},{"highlight_end":59,"highlight_start":1,"text":"            requires left == quotient * right + remainder;"},{"highlight_end":48,"highlight_start":1,"text":"        lemma_fundamental_div_mod_converse_mod("},{"highlight_end":61,"highlight_start":1,"text":"            (left * factor) as int, (right * factor) as int,"},{"highlight_end":59,"highlight_start":1,"text":"            quotient as int, (remainder * factor) as int);"},{"highlight_end":46,"highlight_start":1,"text":"        gcd_scaled(right, remainder, factor);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":78,"highlight_start":1,"text":"/// Cancel the complete common factor without changing the represented ratio."},{"highlight_end":73,"highlight_start":1,"text":"/// This also covers a zero numerator, whose reduced denominator is one."},{"highlight_end":68,"highlight_start":1,"text":"pub(crate) proof fn gcd_reduction(numerator: nat, denominator: nat)"},{"highlight_end":30,"highlight_start":1,"text":"    requires denominator > 0,"},{"highlight_end":12,"highlight_start":1,"text":"    ensures"},{"highlight_end":41,"highlight_start":1,"text":"        gcd(numerator, denominator) > 0,"},{"highlight_end":92,"highlight_start":1,"text":"        numerator / gcd(numerator, denominator) * gcd(numerator, denominator) == numerator,"},{"highlight_end":96,"highlight_start":1,"text":"        denominator / gcd(numerator, denominator) * gcd(numerator, denominator) == denominator,"},{"highlight_end":70,"highlight_start":1,"text":"        0 < denominator / gcd(numerator, denominator) <= denominator,"},{"highlight_end":62,"highlight_start":1,"text":"        numerator / gcd(numerator, denominator) <= numerator,"},{"highlight_end":102,"highlight_start":1,"text":"        gcd(numerator / gcd(numerator, denominator), denominator / gcd(numerator, denominator)) == 1,"},{"highlight_end":62,"highlight_start":1,"text":"        numerator / gcd(numerator, denominator) * denominator"},{"highlight_end":72,"highlight_start":1,"text":"            == numerator * (denominator / gcd(numerator, denominator)),"},{"highlight_end":76,"highlight_start":1,"text":"        (numerator / gcd(numerator, denominator) == 0 <==> numerator == 0),"},{"highlight_end":75,"highlight_start":1,"text":"        numerator == 0 ==> denominator / gcd(numerator, denominator) == 1,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":50,"highlight_start":1,"text":"    gcd_characterization(numerator, denominator);"},{"highlight_end":47,"highlight_start":1,"text":"    let divisor = gcd(numerator, denominator);"},{"highlight_end":49,"highlight_start":1,"text":"    let reduced_numerator = numerator / divisor;"},{"highlight_end":53,"highlight_start":1,"text":"    let reduced_denominator = denominator / divisor;"},{"highlight_end":65,"highlight_start":1,"text":"    lemma_fundamental_div_mod(numerator as int, divisor as int);"},{"highlight_end":67,"highlight_start":1,"text":"    lemma_fundamental_div_mod(denominator as int, divisor as int);"},{"highlight_end":52,"highlight_start":1,"text":"    assert(numerator == reduced_numerator * divisor"},{"highlight_end":78,"highlight_start":1,"text":"        && denominator == reduced_denominator * divisor) by (nonlinear_arith)"},{"highlight_end":105,"highlight_start":1,"text":"        requires numerator == divisor * reduced_numerator, denominator == divisor * reduced_denominator;"},{"highlight_end":84,"highlight_start":1,"text":"    assert(0 < reduced_denominator <= denominator && reduced_numerator <= numerator"},{"highlight_end":78,"highlight_start":1,"text":"        && (reduced_numerator == 0 <==> numerator == 0)) by (nonlinear_arith)"},{"highlight_end":97,"highlight_start":1,"text":"        requires divisor > 0, denominator > 0, reduced_numerator >= 0, reduced_denominator >= 0,"},{"highlight_end":100,"highlight_start":1,"text":"            numerator == reduced_numerator * divisor, denominator == reduced_denominator * divisor;"},{"highlight_end":65,"highlight_start":1,"text":"    gcd_scaled(reduced_numerator, reduced_denominator, divisor);"},{"highlight_end":82,"highlight_start":1,"text":"    assert(gcd(reduced_numerator, reduced_denominator) == 1) by (nonlinear_arith)"},{"highlight_end":96,"highlight_start":1,"text":"        requires divisor > 0, divisor == gcd(reduced_numerator, reduced_denominator) * divisor;"},{"highlight_end":100,"highlight_start":1,"text":"    assert(reduced_numerator * denominator == numerator * reduced_denominator) by (nonlinear_arith)"},{"highlight_end":105,"highlight_start":1,"text":"        requires numerator == reduced_numerator * divisor, denominator == reduced_denominator * divisor;"},{"highlight_end":24,"highlight_start":1,"text":"    if numerator == 0 {"},{"highlight_end":41,"highlight_start":1,"text":"        lemma_small_mod(0, denominator);"},{"highlight_end":34,"highlight_start":1,"text":"        reveal_with_fuel(gcd, 2);"},{"highlight_end":40,"highlight_start":1,"text":"        assert(divisor == denominator);"},{"highlight_end":47,"highlight_start":1,"text":"        lemma_div_by_self(denominator as int);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":53,"highlight_start":1,"text":"pub(crate) proof fn gcd_bound(left: nat, right: nat)"},{"highlight_end":12,"highlight_start":1,"text":"    ensures"},{"highlight_end":47,"highlight_start":1,"text":"        left > 0 ==> gcd(left, right) <= left,"},{"highlight_end":49,"highlight_start":1,"text":"        right > 0 ==> gcd(left, right) <= right,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":39,"highlight_start":1,"text":"    gcd_characterization(left, right);"},{"highlight_end":36,"highlight_start":1,"text":"    let divisor = gcd(left, right);"},{"highlight_end":36,"highlight_start":1,"text":"    if left > 0 && divisor > left {"},{"highlight_end":40,"highlight_start":1,"text":"        lemma_small_mod(left, divisor);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":38,"highlight_start":1,"text":"    if right > 0 && divisor > right {"},{"highlight_end":41,"highlight_start":1,"text":"        lemma_small_mod(right, divisor);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":57,"highlight_start":1,"text":"proof fn divisor_of_odd_is_odd(value: nat, divisor: nat)"},{"highlight_end":64,"highlight_start":1,"text":"    requires value % 2 == 1, divisor > 0, value % divisor == 0,"},{"highlight_end":30,"highlight_start":1,"text":"    ensures divisor % 2 == 1,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":61,"highlight_start":1,"text":"    lemma_fundamental_div_mod(value as int, divisor as int);"},{"highlight_end":70,"highlight_start":1,"text":"    assert(value == (value / divisor) * divisor) by (nonlinear_arith)"},{"highlight_end":95,"highlight_start":1,"text":"        requires value == divisor * (value / divisor) + value % divisor, value % divisor == 0;"},{"highlight_end":69,"highlight_start":1,"text":"    lemma_mul_mod_noop((value / divisor) as int, divisor as int, 2);"},{"highlight_end":26,"highlight_start":1,"text":"    if divisor % 2 == 0 {"},{"highlight_end":82,"highlight_start":1,"text":"        assert(((value / divisor) % 2) * (divisor % 2) == 0) by (nonlinear_arith)"},{"highlight_end":39,"highlight_start":1,"text":"            requires divisor % 2 == 0;"},{"highlight_end":32,"highlight_start":1,"text":"        assert(value % 2 == 0);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":59,"highlight_start":1,"text":"proof fn odd_divisor_cancels_two(value: nat, divisor: nat)"},{"highlight_end":72,"highlight_start":1,"text":"    requires divisor > 0, divisor % 2 == 1, (2 * value) % divisor == 0,"},{"highlight_end":34,"highlight_start":1,"text":"    ensures value % divisor == 0,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":40,"highlight_start":1,"text":"    let quotient = 2 * value / divisor;"},{"highlight_end":67,"highlight_start":1,"text":"    lemma_fundamental_div_mod((2 * value) as int, divisor as int);"},{"highlight_end":60,"highlight_start":1,"text":"    lemma_mul_mod_noop(quotient as int, divisor as int, 2);"},{"highlight_end":48,"highlight_start":1,"text":"    lemma_mod_multiples_basic(value as int, 2);"},{"highlight_end":51,"highlight_start":1,"text":"    lemma_fundamental_div_mod(quotient as int, 2);"},{"highlight_end":67,"highlight_start":1,"text":"    assert(value == (quotient / 2) * divisor) by (nonlinear_arith)"},{"highlight_end":82,"highlight_start":1,"text":"        requires 2 * value == quotient * divisor, quotient == 2 * (quotient / 2);"},{"highlight_end":70,"highlight_start":1,"text":"    lemma_mod_multiples_basic((quotient / 2) as int, divisor as int);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":47,"highlight_start":1,"text":"proof fn gcd_odd_double(left: nat, right: nat)"},{"highlight_end":28,"highlight_start":1,"text":"    requires left % 2 == 1,"},{"highlight_end":54,"highlight_start":1,"text":"    ensures gcd(left, 2 * right) == gcd(left, right),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":39,"highlight_start":1,"text":"    gcd_characterization(left, right);"},{"highlight_end":43,"highlight_start":1,"text":"    gcd_characterization(left, 2 * right);"},{"highlight_end":37,"highlight_start":1,"text":"    let original = gcd(left, right);"},{"highlight_end":40,"highlight_start":1,"text":"    let doubled = gcd(left, 2 * right);"},{"highlight_end":64,"highlight_start":1,"text":"    lemma_mul_mod_noop_right(2, right as int, original as int);"},{"highlight_end":34,"highlight_start":1,"text":"    lemma_small_mod(0, original);"},{"highlight_end":41,"highlight_start":1,"text":"    assert((2 * right) % original == 0);"},{"highlight_end":42,"highlight_start":1,"text":"    divisor_of_odd_is_odd(left, doubled);"},{"highlight_end":45,"highlight_start":1,"text":"    odd_divisor_cancels_two(right, doubled);"},{"highlight_end":33,"highlight_start":1,"text":"    assert(original <= doubled);"},{"highlight_end":33,"highlight_start":1,"text":"    assert(doubled <= original);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":73,"highlight_start":1,"text":"pub(crate) proof fn gcd_odd_power_two(left: nat, right: nat, shift: nat)"},{"highlight_end":28,"highlight_start":1,"text":"    requires left % 2 == 1,"},{"highlight_end":64,"highlight_start":1,"text":"    ensures gcd(left, right * pow2(shift)) == gcd(left, right),"},{"highlight_end":21,"highlight_start":1,"text":"    decreases shift,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":20,"highlight_start":1,"text":"    if shift == 0 {"},{"highlight_end":23,"highlight_start":1,"text":"        lemma_pow0(2);"},{"highlight_end":34,"highlight_start":1,"text":"        assert(pow2(shift) == 1);"},{"highlight_end":66,"highlight_start":1,"text":"        assert(right * pow2(shift) == right) by (nonlinear_arith)"},{"highlight_end":39,"highlight_start":1,"text":"            requires pow2(shift) == 1;"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":34,"highlight_start":1,"text":"        lemma_pow2_unfold(shift);"},{"highlight_end":49,"highlight_start":1,"text":"        let previous = pow2((shift - 1) as nat);"},{"highlight_end":83,"highlight_start":1,"text":"        assert(right * pow2(shift) == 2 * (right * previous)) by (nonlinear_arith)"},{"highlight_end":50,"highlight_start":1,"text":"            requires pow2(shift) == 2 * previous;"},{"highlight_end":48,"highlight_start":1,"text":"        gcd_odd_double(left, right * previous);"},{"highlight_end":60,"highlight_start":1,"text":"        gcd_odd_power_two(left, right, (shift - 1) as nat);"},{"highlight_end":79,"highlight_start":1,"text":"        assert(gcd(left, right * pow2(shift)) == gcd(left, right * previous));"},{"highlight_end":65,"highlight_start":1,"text":"        assert(gcd(left, right * previous) == gcd(left, right));"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":83,"highlight_start":1,"text":"proof fn gcd_power_two_factors_ordered(left: nat, right: nat, low: nat, high: nat)"},{"highlight_end":41,"highlight_start":1,"text":"    requires left % 2 == 1, low <= high,"},{"highlight_end":87,"highlight_start":1,"text":"    ensures gcd(left * pow2(low), right * pow2(high)) == gcd(left, right) * pow2(low),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":37,"highlight_start":1,"text":"    let extra = (high - low) as nat;"},{"highlight_end":25,"highlight_start":1,"text":"    lemma_pow2_pos(low);"},{"highlight_end":33,"highlight_start":1,"text":"    lemma_pow2_adds(extra, low);"},{"highlight_end":68,"highlight_start":1,"text":"    assert(right * pow2(high) == (right * pow2(extra)) * pow2(low))"},{"highlight_end":77,"highlight_start":1,"text":"        by (nonlinear_arith) requires pow2(high) == pow2(extra) * pow2(low);"},{"highlight_end":54,"highlight_start":1,"text":"    gcd_scaled(left, right * pow2(extra), pow2(low));"},{"highlight_end":43,"highlight_start":1,"text":"    gcd_odd_power_two(left, right, extra);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":100,"highlight_start":1,"text":"pub(crate) proof fn gcd_power_two_factors(left: nat, right: nat, left_shift: nat, right_shift: nat)"},{"highlight_end":44,"highlight_start":1,"text":"    requires left % 2 == 1, right % 2 == 1,"},{"highlight_end":68,"highlight_start":1,"text":"    ensures gcd(left * pow2(left_shift), right * pow2(right_shift))"},{"highlight_end":101,"highlight_start":1,"text":"        == gcd(left, right) * pow2(if left_shift < right_shift { left_shift } else { right_shift }),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":35,"highlight_start":1,"text":"    if left_shift <= right_shift {"},{"highlight_end":77,"highlight_start":1,"text":"        gcd_power_two_factors_ordered(left, right, left_shift, right_shift);"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":77,"highlight_start":1,"text":"        gcd_power_two_factors_ordered(right, left, right_shift, left_shift);"},{"highlight_end":75,"highlight_start":1,"text":"        gcd_symmetric(left * pow2(left_shift), right * pow2(right_shift));"},{"highlight_end":36,"highlight_start":1,"text":"        gcd_symmetric(left, right);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":79,"highlight_start":1,"text":"/// Connect the standard-library trailing-zero specification to exact division"},{"highlight_end":78,"highlight_start":1,"text":"/// by a mathematical power of two, including the value's odd remaining part."},{"highlight_end":58,"highlight_start":1,"text":"pub(crate) proof fn trailing_zeros_factor_u64(value: u64)"},{"highlight_end":24,"highlight_start":1,"text":"    requires value > 0,"},{"highlight_end":12,"highlight_start":1,"text":"    ensures"},{"highlight_end":40,"highlight_start":1,"text":"        u64_trailing_zeros(value) < 64,"},{"highlight_end":59,"highlight_start":1,"text":"        0 < (value >> u64_trailing_zeros(value)) <= value,"},{"highlight_end":55,"highlight_start":1,"text":"        (value >> u64_trailing_zeros(value)) % 2 == 1,"},{"highlight_end":96,"highlight_start":1,"text":"        value == (value >> u64_trailing_zeros(value)) * pow2(u64_trailing_zeros(value) as nat),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":37,"highlight_start":1,"text":"    axiom_u64_trailing_zeros(value);"},{"highlight_end":50,"highlight_start":1,"text":"    let shift = u64_trailing_zeros(value) as u64;"},{"highlight_end":30,"highlight_start":1,"text":"    let odd = value >> shift;"},{"highlight_end":54,"highlight_start":1,"text":"    assert((value >> shift) % 2 == 1) by (bit_vector)"},{"highlight_end":50,"highlight_start":1,"text":"        requires (value >> shift) & 1u64 == 1u64;"},{"highlight_end":45,"highlight_start":1,"text":"    assert(0 < odd <= value) by (bit_vector)"},{"highlight_end":54,"highlight_start":1,"text":"        requires odd == value >> shift, odd % 2 == 1;"},{"highlight_end":74,"highlight_start":1,"text":"    vstd::bits::lemma_u64_mul_pow2_le_max_iff_max_shr(odd, shift, value);"},{"highlight_end":50,"highlight_start":1,"text":"    vstd::bits::lemma_u64_shl_is_mul(odd, shift);"},{"highlight_end":63,"highlight_start":1,"text":"    assert((value >> shift) << shift == value) by (bit_vector)"},{"highlight_end":66,"highlight_start":1,"text":"        requires shift < 64, value << ((64 - shift) as u64) == 0;"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":71,"highlight_start":1,"text":"pub(crate) open spec fn trailing_zeros_u128_spec(value: u128) -> u32 {"},{"highlight_end":27,"highlight_start":1,"text":"    if value as u64 != 0 {"},{"highlight_end":41,"highlight_start":1,"text":"        u64_trailing_zeros(value as u64)"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":63,"highlight_start":1,"text":"        (64 + u64_trailing_zeros((value >> 64) as u64)) as u32"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":60,"highlight_start":1,"text":"pub(crate) proof fn trailing_zeros_factor_u128(value: u128)"},{"highlight_end":12,"highlight_start":1,"text":"    ensures"},{"highlight_end":48,"highlight_start":1,"text":"        trailing_zeros_u128_spec(value) <= 128,"},{"highlight_end":66,"highlight_start":1,"text":"        (trailing_zeros_u128_spec(value) == 128 <==> value == 0),"},{"highlight_end":24,"highlight_start":1,"text":"        value > 0 ==> ("},{"highlight_end":68,"highlight_start":1,"text":"            0 < (value >> trailing_zeros_u128_spec(value)) <= value"},{"highlight_end":67,"highlight_start":1,"text":"            && (value >> trailing_zeros_u128_spec(value)) % 2 == 1"},{"highlight_end":67,"highlight_start":1,"text":"            && value == (value >> trailing_zeros_u128_spec(value))"},{"highlight_end":65,"highlight_start":1,"text":"                * pow2(trailing_zeros_u128_spec(value) as nat)),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":28,"highlight_start":1,"text":"    let low = value as u64;"},{"highlight_end":37,"highlight_start":1,"text":"    let high = (value >> 64) as u64;"},{"highlight_end":35,"highlight_start":1,"text":"    axiom_u64_trailing_zeros(low);"},{"highlight_end":36,"highlight_start":1,"text":"    axiom_u64_trailing_zeros(high);"},{"highlight_end":49,"highlight_start":1,"text":"    let shift = trailing_zeros_u128_spec(value);"},{"highlight_end":66,"highlight_start":1,"text":"    assert(value == 0 <==> low == 0 && high == 0) by (bit_vector)"},{"highlight_end":68,"highlight_start":1,"text":"        requires low == value as u64, high == (value >> 64) as u64;"},{"highlight_end":19,"highlight_start":1,"text":"    if value > 0 {"},{"highlight_end":22,"highlight_start":1,"text":"        if low != 0 {"},{"highlight_end":73,"highlight_start":1,"text":"            assert(value << ((128 - shift) as u32) == 0) by (bit_vector)"},{"highlight_end":58,"highlight_start":1,"text":"                requires shift < 64, low == value as u64,"},{"highlight_end":55,"highlight_start":1,"text":"                    low << ((64 - shift) as u64) == 0;"},{"highlight_end":70,"highlight_start":1,"text":"            assert((value >> shift) & 1u128 == 1u128) by (bit_vector)"},{"highlight_end":58,"highlight_start":1,"text":"                requires shift < 64, low == value as u64,"},{"highlight_end":51,"highlight_start":1,"text":"                    (low >> shift) & 1u64 == 1u64;"},{"highlight_end":17,"highlight_start":1,"text":"        } else {"},{"highlight_end":56,"highlight_start":1,"text":"            let upper_shift = u64_trailing_zeros(high);"},{"highlight_end":73,"highlight_start":1,"text":"            assert(value << ((128 - shift) as u32) == 0) by (bit_vector)"},{"highlight_end":70,"highlight_start":1,"text":"                requires upper_shift < 64, shift == 64 + upper_shift,"},{"highlight_end":69,"highlight_start":1,"text":"                    value as u64 == 0, high == (value >> 64) as u64,"},{"highlight_end":62,"highlight_start":1,"text":"                    high << ((64 - upper_shift) as u64) == 0;"},{"highlight_end":70,"highlight_start":1,"text":"            assert((value >> shift) & 1u128 == 1u128) by (bit_vector)"},{"highlight_end":70,"highlight_start":1,"text":"                requires upper_shift < 64, shift == 64 + upper_shift,"},{"highlight_end":50,"highlight_start":1,"text":"                    high == (value >> 64) as u64,"},{"highlight_end":58,"highlight_start":1,"text":"                    (high >> upper_shift) & 1u64 == 1u64;"},{"highlight_end":10,"highlight_start":1,"text":"        }"},{"highlight_end":34,"highlight_start":1,"text":"        let odd = value >> shift;"},{"highlight_end":65,"highlight_start":1,"text":"        assert(0 < odd <= value && odd % 2 == 1) by (bit_vector)"},{"highlight_end":66,"highlight_start":1,"text":"            requires odd == value >> shift, odd & 1u128 == 1u128;"},{"highlight_end":38,"highlight_start":1,"text":"        lemma_pow2_pos(shift as nat);"},{"highlight_end":65,"highlight_start":1,"text":"        vstd::bits::lemma_u128_shr_is_div(value, shift as u128);"},{"highlight_end":76,"highlight_start":1,"text":"        lemma_fundamental_div_mod(value as int, pow2(shift as nat) as int);"},{"highlight_end":71,"highlight_start":1,"text":"        assert(odd * pow2(shift as nat) <= value) by (nonlinear_arith)"},{"highlight_end":63,"highlight_start":1,"text":"            requires odd == value as nat / pow2(shift as nat),"},{"highlight_end":82,"highlight_start":1,"text":"                value == pow2(shift as nat) * (value as nat / pow2(shift as nat))"},{"highlight_end":57,"highlight_start":1,"text":"                    + value as nat % pow2(shift as nat),"},{"highlight_end":56,"highlight_start":1,"text":"                value as nat % pow2(shift as nat) >= 0;"},{"highlight_end":57,"highlight_start":1,"text":"        super::word::shift_left_u128_is_mul(odd, shift);"},{"highlight_end":67,"highlight_start":1,"text":"        assert((value >> shift) << shift == value) by (bit_vector)"},{"highlight_end":72,"highlight_start":1,"text":"            requires shift < 128, value << ((128 - shift) as u32) == 0;"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":52,"highlight_start":1,"text":"proof fn power_of_two_has_unit_odd_part(value: u64)"},{"highlight_end":59,"highlight_start":1,"text":"    requires value > 0, value & ((value - 1) as u64) == 0,"},{"highlight_end":55,"highlight_start":1,"text":"    ensures (value >> u64_trailing_zeros(value)) == 1,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":37,"highlight_start":1,"text":"    axiom_u64_trailing_zeros(value);"},{"highlight_end":43,"highlight_start":1,"text":"    let shift = u64_trailing_zeros(value);"},{"highlight_end":50,"highlight_start":1,"text":"    assert((value >> shift) == 1) by (bit_vector)"},{"highlight_end":63,"highlight_start":1,"text":"        requires value > 0, value & ((value - 1) as u64) == 0,"},{"highlight_end":57,"highlight_start":1,"text":"            shift < 64, (value >> shift) & 1u64 == 1u64;"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":73,"highlight_start":1,"text":"/// Any common prefix of the two trailing-zero counts is an exact common"},{"highlight_end":77,"highlight_start":1,"text":"/// factor. This also covers the two-limb path that keeps non-odd quotients."},{"highlight_end":73,"highlight_start":1,"text":"proof fn common_shift_preserves_gcd(left: u128, right: u128, shift: u32)"},{"highlight_end":34,"highlight_start":1,"text":"    requires left > 0, right > 0,"},{"highlight_end":91,"highlight_start":1,"text":"        shift <= trailing_zeros_u128_spec(left), shift <= trailing_zeros_u128_spec(right),"},{"highlight_end":25,"highlight_start":1,"text":"    ensures shift < 128,"},{"highlight_end":39,"highlight_start":1,"text":"        gcd(left as nat, right as nat)"},{"highlight_end":90,"highlight_start":1,"text":"            == gcd((left >> shift) as nat, (right >> shift) as nat) * pow2(shift as nat),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":38,"highlight_start":1,"text":"    trailing_zeros_factor_u128(left);"},{"highlight_end":39,"highlight_start":1,"text":"    trailing_zeros_factor_u128(right);"},{"highlight_end":41,"highlight_start":1,"text":"    divide_trailing_factor(left, shift);"},{"highlight_end":42,"highlight_start":1,"text":"    divide_trailing_factor(right, shift);"},{"highlight_end":34,"highlight_start":1,"text":"    lemma_pow2_pos(shift as nat);"},{"highlight_end":85,"highlight_start":1,"text":"    gcd_scaled((left >> shift) as nat, (right >> shift) as nat, pow2(shift as nat));"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":68,"highlight_start":1,"text":"pub(crate) proof fn divide_trailing_factor(value: u128, shift: u32)"},{"highlight_end":66,"highlight_start":1,"text":"    requires value > 0, shift <= trailing_zeros_u128_spec(value),"},{"highlight_end":45,"highlight_start":1,"text":"    ensures shift < 128, 0 < value >> shift,"},{"highlight_end":56,"highlight_start":1,"text":"        value == (value >> shift) * pow2(shift as nat),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":39,"highlight_start":1,"text":"    trailing_zeros_factor_u128(value);"},{"highlight_end":49,"highlight_start":1,"text":"    let total = trailing_zeros_u128_spec(value);"},{"highlight_end":39,"highlight_start":1,"text":"    let odd = (value >> total) as nat;"},{"highlight_end":40,"highlight_start":1,"text":"    let extra = (total - shift) as nat;"},{"highlight_end":42,"highlight_start":1,"text":"    lemma_pow2_adds(extra, shift as nat);"},{"highlight_end":34,"highlight_start":1,"text":"    lemma_pow2_pos(shift as nat);"},{"highlight_end":83,"highlight_start":1,"text":"    assert(value == (odd * pow2(extra)) * pow2(shift as nat)) by (nonlinear_arith)"},{"highlight_end":52,"highlight_start":1,"text":"        requires value == odd * pow2(total as nat),"},{"highlight_end":68,"highlight_start":1,"text":"            pow2(total as nat) == pow2(extra) * pow2(shift as nat);"},{"highlight_end":80,"highlight_start":1,"text":"    lemma_fundamental_div_mod_converse(value as int, pow2(shift as nat) as int,"},{"highlight_end":40,"highlight_start":1,"text":"        (odd * pow2(extra)) as int, 0);"},{"highlight_end":61,"highlight_start":1,"text":"    vstd::bits::lemma_u128_shr_is_div(value, shift as u128);"},{"highlight_end":27,"highlight_start":1,"text":"    lemma_pow2_pos(extra);"},{"highlight_end":55,"highlight_start":1,"text":"    assert(odd * pow2(extra) > 0) by (nonlinear_arith)"},{"highlight_end":43,"highlight_start":1,"text":"        requires odd > 0, pow2(extra) > 0;"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":67,"highlight_start":1,"text":"proof fn gcd_power_of_two_word(left: u64, right: u128, shift: u32)"},{"highlight_end":67,"highlight_start":1,"text":"    requires left > 0, right > 0, left & ((left - 1) as u64) == 0,"},{"highlight_end":81,"highlight_start":1,"text":"        shift == if u64_trailing_zeros(left) < trailing_zeros_u128_spec(right) {"},{"highlight_end":37,"highlight_start":1,"text":"            u64_trailing_zeros(left)"},{"highlight_end":52,"highlight_start":1,"text":"        } else { trailing_zeros_u128_spec(right) },"},{"highlight_end":24,"highlight_start":1,"text":"    ensures shift < 64,"},{"highlight_end":62,"highlight_start":1,"text":"        gcd(left as nat, right as nat) == pow2(shift as nat),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":37,"highlight_start":1,"text":"    trailing_zeros_factor_u64(left);"},{"highlight_end":39,"highlight_start":1,"text":"    trailing_zeros_factor_u128(right);"},{"highlight_end":42,"highlight_start":1,"text":"    power_of_two_has_unit_odd_part(left);"},{"highlight_end":65,"highlight_start":1,"text":"    let odd = (right >> trailing_zeros_u128_spec(right)) as nat;"},{"highlight_end":67,"highlight_start":1,"text":"    gcd_power_two_factors(1, odd, u64_trailing_zeros(left) as nat,"},{"highlight_end":49,"highlight_start":1,"text":"        trailing_zeros_u128_spec(right) as nat);"},{"highlight_end":27,"highlight_start":1,"text":"    gcd_symmetric(1, odd);"},{"highlight_end":38,"highlight_start":1,"text":"    assert(gcd(odd, 1) == gcd(1, 0));"},{"highlight_end":30,"highlight_start":1,"text":"    assert(gcd(1, odd) == 1);"},{"highlight_end":83,"highlight_start":1,"text":"    assert(1 * pow2(u64_trailing_zeros(left) as nat) == left) by (nonlinear_arith)"},{"highlight_end":101,"highlight_start":1,"text":"        requires left == (left >> u64_trailing_zeros(left)) * pow2(u64_trailing_zeros(left) as nat),"},{"highlight_end":53,"highlight_start":1,"text":"            (left >> u64_trailing_zeros(left)) == 1;"},{"highlight_end":88,"highlight_start":1,"text":"    assert(gcd(1, odd) * pow2(shift as nat) == pow2(shift as nat)) by (nonlinear_arith)"},{"highlight_end":35,"highlight_start":1,"text":"        requires gcd(1, odd) == 1;"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":2,"highlight_start":1,"text":"}"}]}],"code":{"code":"unexpected_cfgs","explanation":null}}}
