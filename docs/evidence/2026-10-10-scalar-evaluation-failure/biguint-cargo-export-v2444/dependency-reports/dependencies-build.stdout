_b == 2 * previous_a * b,"},{"highlight_end":86,"highlight_start":1,"text":"                a * denominator < 2 * numerator * b, numerator * b < a * denominator;"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":66,"highlight_start":1,"text":"/// Signed binary scales compose for arbitrary integer exponents."},{"highlight_end":58,"highlight_start":1,"text":"pub proof fn binary_scales_compose(left: int, right: int)"},{"highlight_end":100,"highlight_start":1,"text":"    ensures binary_numerator(left + right) * (binary_denominator(left) * binary_denominator(right))"},{"highlight_end":98,"highlight_start":1,"text":"        == (binary_numerator(left) * binary_numerator(right)) * binary_denominator(left + right),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":54,"highlight_start":1,"text":"    let lp = if left >= 0 { left as nat } else { 0 };"},{"highlight_end":56,"highlight_start":1,"text":"    let ln = if left < 0 { (-left) as nat } else { 0 };"},{"highlight_end":56,"highlight_start":1,"text":"    let rp = if right >= 0 { right as nat } else { 0 };"},{"highlight_end":58,"highlight_start":1,"text":"    let rn = if right < 0 { (-right) as nat } else { 0 };"},{"highlight_end":72,"highlight_start":1,"text":"    let sp = if left + right >= 0 { (left + right) as nat } else { 0 };"},{"highlight_end":72,"highlight_start":1,"text":"    let sn = if left + right < 0 { (-left - right) as nat } else { 0 };"},{"highlight_end":42,"highlight_start":1,"text":"    assert(sp + ln + rn == lp + rp + sn);"},{"highlight_end":29,"highlight_start":1,"text":"    lemma_pow2_adds(ln, rn);"},{"highlight_end":34,"highlight_start":1,"text":"    lemma_pow2_adds(sp, ln + rn);"},{"highlight_end":29,"highlight_start":1,"text":"    lemma_pow2_adds(lp, rp);"},{"highlight_end":34,"highlight_start":1,"text":"    lemma_pow2_adds(lp + rp, sn);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":72,"highlight_start":1,"text":"/// Binary scaling moves a binade by exactly the signed scale exponent."},{"highlight_end":105,"highlight_start":1,"text":"pub proof fn binary_scale_preserves_binade(numerator: nat, denominator: nat, exponent: int, offset: int)"},{"highlight_end":58,"highlight_start":1,"text":"    requires in_binade(numerator, denominator, exponent),"},{"highlight_end":122,"highlight_start":1,"text":"    ensures in_binade(numerator * binary_numerator(offset), denominator * binary_denominator(offset), exponent + offset),"},{"highlight_end":59,"highlight_start":1,"text":"        (is_binary_scale(numerator, denominator, exponent)"},{"highlight_end":134,"highlight_start":1,"text":"            <==> is_binary_scale(numerator * binary_numerator(offset), denominator * binary_denominator(offset), exponent + offset)),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":31,"highlight_start":1,"text":"    binary_positive(exponent);"},{"highlight_end":29,"highlight_start":1,"text":"    binary_positive(offset);"},{"highlight_end":40,"highlight_start":1,"text":"    binary_positive(exponent + offset);"},{"highlight_end":45,"highlight_start":1,"text":"    binary_scales_compose(exponent, offset);"},{"highlight_end":40,"highlight_start":1,"text":"    let a = binary_numerator(exponent);"},{"highlight_end":42,"highlight_start":1,"text":"    let b = binary_denominator(exponent);"},{"highlight_end":38,"highlight_start":1,"text":"    let c = binary_numerator(offset);"},{"highlight_end":40,"highlight_start":1,"text":"    let d = binary_denominator(offset);"},{"highlight_end":49,"highlight_start":1,"text":"    let p = binary_numerator(exponent + offset);"},{"highlight_end":51,"highlight_start":1,"text":"    let q = binary_denominator(exponent + offset);"},{"highlight_end":86,"highlight_start":1,"text":"    assert(denominator * d > 0) by (nonlinear_arith) requires denominator > 0, d > 0;"},{"highlight_end":56,"highlight_start":1,"text":"    assert(p * (denominator * d) <= (numerator * c) * q"},{"highlight_end":81,"highlight_start":1,"text":"        && (numerator * c) * q < 2 * p * (denominator * d)) by (nonlinear_arith)"},{"highlight_end":59,"highlight_start":1,"text":"        requires a > 0, b > 0, c > 0, d > 0, p > 0, q > 0,"},{"highlight_end":40,"highlight_start":1,"text":"            p * (b * d) == (a * c) * q,"},{"highlight_end":83,"highlight_start":1,"text":"            a * denominator <= numerator * b, numerator * b < 2 * a * denominator;"},{"highlight_end":46,"highlight_start":1,"text":"    assert((numerator * b == a * denominator)"},{"highlight_end":80,"highlight_start":1,"text":"        <==> (numerator * c) * q == p * (denominator * d)) by (nonlinear_arith)"},{"highlight_end":59,"highlight_start":1,"text":"        requires a > 0, b > 0, c > 0, d > 0, p > 0, q > 0,"},{"highlight_end":40,"highlight_start":1,"text":"            p * (b * d) == (a * c) * q;"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":56,"highlight_start":1,"text":"proof fn separated_binary_scales(left: int, right: int)"},{"highlight_end":27,"highlight_start":1,"text":"    requires left < right,"},{"highlight_end":67,"highlight_start":1,"text":"    ensures 2 * binary_numerator(left) * binary_denominator(right)"},{"highlight_end":63,"highlight_start":1,"text":"        <= binary_numerator(right) * binary_denominator(left),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":54,"highlight_start":1,"text":"    let lp = if left >= 0 { left as nat } else { 0 };"},{"highlight_end":56,"highlight_start":1,"text":"    let ln = if left < 0 { (-left) as nat } else { 0 };"},{"highlight_end":56,"highlight_start":1,"text":"    let rp = if right >= 0 { right as nat } else { 0 };"},{"highlight_end":58,"highlight_start":1,"text":"    let rn = if right < 0 { (-right) as nat } else { 0 };"},{"highlight_end":36,"highlight_start":1,"text":"    assert(lp + rn + 1 <= rp + ln);"},{"highlight_end":29,"highlight_start":1,"text":"    lemma_pow2_adds(lp, rn);"},{"highlight_end":29,"highlight_start":1,"text":"    lemma_pow2_adds(rp, ln);"},{"highlight_end":36,"highlight_start":1,"text":"    lemma_pow2_unfold(lp + rn + 1);"},{"highlight_end":31,"highlight_start":1,"text":"    if lp + rn + 1 < rp + ln {"},{"highlight_end":61,"highlight_start":1,"text":"        lemma_pow2_strictly_increases(lp + rn + 1, rp + ln);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":66,"highlight_start":1,"text":"    assert(2 * binary_numerator(left) * binary_denominator(right)"},{"highlight_end":84,"highlight_start":1,"text":"        <= binary_numerator(right) * binary_denominator(left)) by (nonlinear_arith)"},{"highlight_end":57,"highlight_start":1,"text":"        requires pow2(lp + rn + 1) == 2 * pow2(lp + rn),"},{"highlight_end":48,"highlight_start":1,"text":"            pow2(lp + rn + 1) <= pow2(rp + ln),"},{"highlight_end":81,"highlight_start":1,"text":"            pow2(lp + rn) == binary_numerator(left) * binary_denominator(right),"},{"highlight_end":81,"highlight_start":1,"text":"            pow2(rp + ln) == binary_numerator(right) * binary_denominator(left);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":77,"highlight_start":1,"text":"/// Disjoint adjacent power-of-two intervals make the floor exponent unique."},{"highlight_end":87,"highlight_start":1,"text":"pub proof fn binade_is_unique(numerator: nat, denominator: nat, left: int, right: int)"},{"highlight_end":96,"highlight_start":1,"text":"    requires in_binade(numerator, denominator, left), in_binade(numerator, denominator, right),"},{"highlight_end":27,"highlight_start":1,"text":"    ensures left == right,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":27,"highlight_start":1,"text":"    binary_positive(left);"},{"highlight_end":28,"highlight_start":1,"text":"    binary_positive(right);"},{"highlight_end":23,"highlight_start":1,"text":"    if left != right {"},{"highlight_end":63,"highlight_start":1,"text":"        let smaller = if left < right { left } else { right };"},{"highlight_end":62,"highlight_start":1,"text":"        let larger = if left < right { right } else { left };"},{"highlight_end":50,"highlight_start":1,"text":"        separated_binary_scales(smaller, larger);"},{"highlight_end":43,"highlight_start":1,"text":"        let a = binary_numerator(smaller);"},{"highlight_end":45,"highlight_start":1,"text":"        let b = binary_denominator(smaller);"},{"highlight_end":42,"highlight_start":1,"text":"        let c = binary_numerator(larger);"},{"highlight_end":44,"highlight_start":1,"text":"        let d = binary_denominator(larger);"},{"highlight_end":43,"highlight_start":1,"text":"        assert(false) by (nonlinear_arith)"},{"highlight_end":52,"highlight_start":1,"text":"            requires denominator > 0, b > 0, d > 0,"},{"highlight_end":36,"highlight_start":1,"text":"                2 * a * d <= c * b,"},{"highlight_end":53,"highlight_start":1,"text":"                numerator * b < 2 * a * denominator,"},{"highlight_end":50,"highlight_start":1,"text":"                c * denominator <= numerator * d;"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":73,"highlight_start":1,"text":"/// Connect the executable helper's shared exponent specification to the"},{"highlight_end":79,"highlight_start":1,"text":"/// rational interval. The BigUint caller must still prove the two bit lengths"},{"highlight_end":56,"highlight_start":1,"text":"/// and the meaning of its borrowed shifted comparison."},{"highlight_end":60,"highlight_start":1,"text":"pub(crate) proof fn checked_exponent_denotes_scaled_binade("},{"highlight_end":82,"highlight_start":1,"text":"    numerator: nat, denominator: nat, numerator_bits: u64, denominator_bits: u64,"},{"highlight_end":30,"highlight_start":1,"text":"    below: bool, offset: i32,"},{"highlight_end":2,"highlight_start":1,"text":")"},{"highlight_end":63,"highlight_start":1,"text":"    requires has_bit_length(numerator, numerator_bits as nat),"},{"highlight_end":62,"highlight_start":1,"text":"        has_bit_length(denominator, denominator_bits as nat),"},{"highlight_end":104,"highlight_start":1,"text":"        below == below_aligned(numerator, denominator, numerator_bits as nat, denominator_bits as nat),"},{"highlight_end":116,"highlight_start":1,"text":"    ensures in_binade(numerator * binary_numerator(offset as int), denominator * binary_denominator(offset as int),"},{"highlight_end":97,"highlight_start":1,"text":"        crate::verified::word::bit_length_msd(numerator_bits, denominator_bits, below, offset)),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":106,"highlight_start":1,"text":"    bit_lengths_determine_binade(numerator, denominator, numerator_bits as nat, denominator_bits as nat);"},{"highlight_end":104,"highlight_start":1,"text":"    let exponent = aligned_msd(numerator, denominator, numerator_bits as nat, denominator_bits as nat);"},{"highlight_end":84,"highlight_start":1,"text":"    binary_scale_preserves_binade(numerator, denominator, exponent, offset as int);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":2,"highlight_start":1,"text":"} // verus!"}]}},"file_name":"/home/tim/Documents/GitHub/workspace/csgrs/target/scalar-evaluation-candidate/source/crates/hyperreal/verification/magnitude_model.rs","is_primary":true,"label":null,"line_end":269,"line_start":6,"suggested_replacement":null,"suggestion_applicability":null,"text":[{"highlight_end":9,"highlight_start":1,"text":"verus! {"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":58,"highlight_start":1,"text":"pub open spec fn binary_numerator(exponent: int) -> nat {"},{"highlight_end":58,"highlight_start":1,"text":"    pow2(if exponent >= 0 { exponent as nat } else { 0 })"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":60,"highlight_start":1,"text":"pub open spec fn binary_denominator(exponent: int) -> nat {"},{"highlight_end":60,"highlight_start":1,"text":"    pow2(if exponent < 0 { (-exponent) as nat } else { 0 })"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":65,"highlight_start":1,"text":"pub open spec fn has_bit_length(value: nat, bits: nat) -> bool {"},{"highlight_end":71,"highlight_start":1,"text":"    bits > 0 && pow2((bits - 1) as nat) <= value && value < pow2(bits)"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":86,"highlight_start":1,"text":"pub open spec fn in_binade(numerator: nat, denominator: nat, exponent: int) -> bool {"},{"highlight_end":20,"highlight_start":1,"text":"    denominator > 0"},{"highlight_end":96,"highlight_start":1,"text":"        && binary_numerator(exponent) * denominator <= numerator * binary_denominator(exponent)"},{"highlight_end":99,"highlight_start":1,"text":"        && numerator * binary_denominator(exponent) < 2 * binary_numerator(exponent) * denominator"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":92,"highlight_start":1,"text":"pub open spec fn is_binary_scale(numerator: nat, denominator: nat, exponent: int) -> bool {"},{"highlight_end":20,"highlight_start":1,"text":"    denominator > 0"},{"highlight_end":96,"highlight_start":1,"text":"        && numerator * binary_denominator(exponent) == binary_numerator(exponent) * denominator"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":119,"highlight_start":1,"text":"pub open spec fn below_aligned(numerator: nat, denominator: nat, numerator_bits: nat, denominator_bits: nat) -> bool {"},{"highlight_end":70,"highlight_start":1,"text":"    let difference = numerator_bits as int - denominator_bits as int;"},{"highlight_end":92,"highlight_start":1,"text":"    numerator * binary_denominator(difference) < binary_numerator(difference) * denominator"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":116,"highlight_start":1,"text":"pub open spec fn aligned_msd(numerator: nat, denominator: nat, numerator_bits: nat, denominator_bits: nat) -> int {"},{"highlight_end":52,"highlight_start":1,"text":"    numerator_bits as int - denominator_bits as int"},{"highlight_end":108,"highlight_start":1,"text":"        - if below_aligned(numerator, denominator, numerator_bits, denominator_bits) { 1int } else { 0int }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":40,"highlight_start":1,"text":"proof fn binary_positive(exponent: int)"},{"highlight_end":78,"highlight_start":1,"text":"    ensures binary_numerator(exponent) > 0, binary_denominator(exponent) > 0,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":69,"highlight_start":1,"text":"    lemma_pow2_pos(if exponent >= 0 { exponent as nat } else { 0 });"},{"highlight_end":71,"highlight_start":1,"text":"    lemma_pow2_pos(if exponent < 0 { (-exponent) as nat } else { 0 });"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":36,"highlight_start":1,"text":"proof fn binary_step(exponent: int)"},{"highlight_end":74,"highlight_start":1,"text":"    ensures binary_numerator(exponent) * binary_denominator(exponent - 1)"},{"highlight_end":78,"highlight_start":1,"text":"        == 2 * binary_numerator(exponent - 1) * binary_denominator(exponent),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":44,"highlight_start":1,"text":"    vstd::arithmetic::power::lemma_pow0(2);"},{"highlight_end":22,"highlight_start":1,"text":"    if exponent > 0 {"},{"highlight_end":44,"highlight_start":1,"text":"        lemma_pow2_unfold(exponent as nat);"},{"highlight_end":30,"highlight_start":1,"text":"    } else if exponent == 0 {"},{"highlight_end":30,"highlight_start":1,"text":"        lemma_pow2_unfold(1);"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":50,"highlight_start":1,"text":"        lemma_pow2_unfold((1 - exponent) as nat);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":73,"highlight_start":1,"text":"    assert(binary_numerator(exponent) * binary_denominator(exponent - 1)"},{"highlight_end":99,"highlight_start":1,"text":"        == 2 * binary_numerator(exponent - 1) * binary_denominator(exponent)) by (nonlinear_arith)"},{"highlight_end":31,"highlight_start":1,"text":"        requires pow2(0) == 1,"},{"highlight_end":104,"highlight_start":1,"text":"            exponent > 0 ==> binary_denominator(exponent) == 1 && binary_denominator(exponent - 1) == 1"},{"highlight_end":85,"highlight_start":1,"text":"                && binary_numerator(exponent) == 2 * binary_numerator(exponent - 1),"},{"highlight_end":101,"highlight_start":1,"text":"            exponent <= 0 ==> binary_numerator(exponent) == 1 && binary_numerator(exponent - 1) == 1"},{"highlight_end":89,"highlight_start":1,"text":"                && binary_denominator(exponent - 1) == 2 * binary_denominator(exponent);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":75,"highlight_start":1,"text":"/// Aligned bit lengths bound the ratio strictly between one half and two."},{"highlight_end":113,"highlight_start":1,"text":"proof fn aligned_bit_length_bounds(numerator: nat, denominator: nat, numerator_bits: nat, denominator_bits: nat)"},{"highlight_end":103,"highlight_start":1,"text":"    requires has_bit_length(numerator, numerator_bits), has_bit_length(denominator, denominator_bits),"},{"highlight_end":44,"highlight_start":1,"text":"    ensures numerator > 0, denominator > 0,"},{"highlight_end":67,"highlight_start":1,"text":"        ({let e = numerator_bits as int - denominator_bits as int;"},{"highlight_end":90,"highlight_start":1,"text":"            &&& binary_numerator(e) * denominator < 2 * numerator * binary_denominator(e)"},{"highlight_end":93,"highlight_start":1,"text":"            &&& numerator * binary_denominator(e) < 2 * binary_numerator(e) * denominator}),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":44,"highlight_start":1,"text":"    vstd::arithmetic::power::lemma_pow0(2);"},{"highlight_end":49,"highlight_start":1,"text":"    lemma_pow2_pos((numerator_bits - 1) as nat);"},{"highlight_end":51,"highlight_start":1,"text":"    lemma_pow2_pos((denominator_bits - 1) as nat);"},{"highlight_end":39,"highlight_start":1,"text":"    lemma_pow2_unfold(numerator_bits);"},{"highlight_end":41,"highlight_start":1,"text":"    lemma_pow2_unfold(denominator_bits);"},{"highlight_end":51,"highlight_start":1,"text":"    let low_n = pow2((numerator_bits - 1) as nat);"},{"highlight_end":53,"highlight_start":1,"text":"    let low_d = pow2((denominator_bits - 1) as nat);"},{"highlight_end":44,"highlight_start":1,"text":"    if numerator_bits >= denominator_bits {"},{"highlight_end":64,"highlight_start":1,"text":"        let shift = (numerator_bits - denominator_bits) as nat;"},{"highlight_end":31,"highlight_start":1,"text":"        lemma_pow2_pos(shift);"},{"highlight_end":63,"highlight_start":1,"text":"        lemma_pow2_adds((denominator_bits - 1) as nat, shift);"},{"highlight_end":46,"highlight_start":1,"text":"        assert(low_n == low_d * pow2(shift));"},{"highlight_end":57,"highlight_start":1,"text":"        assert(pow2(shift) * denominator < 2 * numerator"},{"highlight_end":79,"highlight_start":1,"text":"            && numerator < 2 * pow2(shift) * denominator) by (nonlinear_arith)"},{"highlight_end":79,"highlight_start":1,"text":"            requires low_d > 0, pow2(shift) > 0, low_n == low_d * pow2(shift),"},{"highlight_end":59,"highlight_start":1,"text":"                low_n <= numerator, numerator < 2 * low_n,"},{"highlight_end":63,"highlight_start":1,"text":"                low_d <= denominator, denominator < 2 * low_d;"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":64,"highlight_start":1,"text":"        let shift = (denominator_bits - numerator_bits) as nat;"},{"highlight_end":31,"highlight_start":1,"text":"        lemma_pow2_pos(shift);"},{"highlight_end":61,"highlight_start":1,"text":"        lemma_pow2_adds((numerator_bits - 1) as nat, shift);"},{"highlight_end":46,"highlight_start":1,"text":"        assert(low_d == low_n * pow2(shift));"},{"highlight_end":57,"highlight_start":1,"text":"        assert(denominator < 2 * numerator * pow2(shift)"},{"highlight_end":79,"highlight_start":1,"text":"            && numerator * pow2(shift) < 2 * denominator) by (nonlinear_arith)"},{"highlight_end":79,"highlight_start":1,"text":"            requires low_n > 0, pow2(shift) > 0, low_d == low_n * pow2(shift),"},{"highlight_end":59,"highlight_start":1,"text":"                low_n <= numerator, numerator < 2 * low_n,"},{"highlight_end":63,"highlight_start":1,"text":"                low_d <= denominator, denominator < 2 * low_d;"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":61,"highlight_start":1,"text":"    let e = numerator_bits as int - denominator_bits as int;"},{"highlight_end":44,"highlight_start":1,"text":"    if numerator_bits >= denominator_bits {"},{"highlight_end":64,"highlight_start":1,"text":"        let shift = (numerator_bits - denominator_bits) as nat;"},{"highlight_end":52,"highlight_start":1,"text":"        assert(binary_numerator(e) == pow2(shift));"},{"highlight_end":44,"highlight_start":1,"text":"        assert(binary_denominator(e) == 1);"},{"highlight_end":89,"highlight_start":1,"text":"        assert(binary_numerator(e) * denominator < 2 * numerator * binary_denominator(e)"},{"highlight_end":111,"highlight_start":1,"text":"            && numerator * binary_denominator(e) < 2 * binary_numerator(e) * denominator) by (nonlinear_arith)"},{"highlight_end":85,"highlight_start":1,"text":"            requires binary_numerator(e) == pow2(shift), binary_denominator(e) == 1,"},{"highlight_end":59,"highlight_start":1,"text":"                pow2(shift) * denominator < 2 * numerator,"},{"highlight_end":59,"highlight_start":1,"text":"                numerator < 2 * pow2(shift) * denominator;"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":64,"highlight_start":1,"text":"        let shift = (denominator_bits - numerator_bits) as nat;"},{"highlight_end":42,"highlight_start":1,"text":"        assert(binary_numerator(e) == 1);"},{"highlight_end":54,"highlight_start":1,"text":"        assert(binary_denominator(e) == pow2(shift));"},{"highlight_end":89,"highlight_start":1,"text":"        assert(binary_numerator(e) * denominator < 2 * numerator * binary_denominator(e)"},{"highlight_end":111,"highlight_start":1,"text":"            && numerator * binary_denominator(e) < 2 * binary_numerator(e) * denominator) by (nonlinear_arith)"},{"highlight_end":85,"highlight_start":1,"text":"            requires binary_numerator(e) == 1, binary_denominator(e) == pow2(shift),"},{"highlight_end":59,"highlight_start":1,"text":"                denominator < 2 * numerator * pow2(shift),"},{"highlight_end":59,"highlight_start":1,"text":"                numerator * pow2(shift) < 2 * denominator;"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":75,"highlight_start":1,"text":"/// The one-comparison correction returns the exact floor binary exponent."},{"highlight_end":73,"highlight_start":1,"text":"/// Equality of the aligned operands certifies precisely a binary scale,"},{"highlight_end":57,"highlight_start":1,"text":"/// including unreduced numerator and denominator pairs."},{"highlight_end":120,"highlight_start":1,"text":"pub proof fn bit_lengths_determine_binade(numerator: nat, denominator: nat, numerator_bits: nat, denominator_bits: nat)"},{"highlight_end":103,"highlight_start":1,"text":"    requires has_bit_length(numerator, numerator_bits), has_bit_length(denominator, denominator_bits),"},{"highlight_end":12,"highlight_start":1,"text":"    ensures"},{"highlight_end":114,"highlight_start":1,"text":"        in_binade(numerator, denominator, aligned_msd(numerator, denominator, numerator_bits, denominator_bits)),"},{"highlight_end":120,"highlight_start":1,"text":"        (is_binary_scale(numerator, denominator, aligned_msd(numerator, denominator, numerator_bits, denominator_bits))"},{"highlight_end":97,"highlight_start":1,"text":"            <==> numerator * binary_denominator(numerator_bits as int - denominator_bits as int)"},{"highlight_end":101,"highlight_start":1,"text":"                == binary_numerator(numerator_bits as int - denominator_bits as int) * denominator),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":89,"highlight_start":1,"text":"    aligned_bit_length_bounds(numerator, denominator, numerator_bits, denominator_bits);"},{"highlight_end":70,"highlight_start":1,"text":"    let difference = numerator_bits as int - denominator_bits as int;"},{"highlight_end":33,"highlight_start":1,"text":"    binary_positive(difference);"},{"highlight_end":81,"highlight_start":1,"text":"    if below_aligned(numerator, denominator, numerator_bits, denominator_bits) {"},{"highlight_end":41,"highlight_start":1,"text":"        binary_positive(difference - 1);"},{"highlight_end":33,"highlight_start":1,"text":"        binary_step(difference);"},{"highlight_end":46,"highlight_start":1,"text":"        let a = binary_numerator(difference);"},{"highlight_end":48,"highlight_start":1,"text":"        let b = binary_denominator(difference);"},{"highlight_end":59,"highlight_start":1,"text":"        let previous_a = binary_numerator(difference - 1);"},{"highlight_end":61,"highlight_start":1,"text":"        let previous_b = binary_denominator(difference - 1);"},{"highlight_end":65,"highlight_start":1,"text":"        assert(previous_a * denominator < numerator * previous_b"},{"highlight_end":91,"highlight_start":1,"text":"            && numerator * previous_b < 2 * previous_a * denominator) by (nonlinear_arith)"},{"highlight_end":67,"highlight_start":1,"text":"            requires a > 0, b > 0, previous_a > 0, previous_b > 0,"},{"highlight_end":54,"highlight_start":1,"text":"                a * previous_b == 2 * previous_a * b,"},{"highlight_end":86,"highlight_start":1,"text":"                a * denominator < 2 * numerator * b, numerator * b < a * denominator;"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":66,"highlight_start":1,"text":"/// Signed binary scales compose for arbitrary integer exponents."},{"highlight_end":58,"highlight_start":1,"text":"pub proof fn binary_scales_compose(left: int, right: int)"},{"highlight_end":100,"highlight_start":1,"text":"    ensures binary_numerator(left + right) * (binary_denominator(left) * binary_denominator(right))"},{"highlight_end":98,"highlight_start":1,"text":"        == (binary_numerator(left) * binary_numerator(right)) * binary_denominator(left + right),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":54,"highlight_start":1,"text":"    let lp = if left >= 0 { left as nat } else { 0 };"},{"highlight_end":56,"highlight_start":1,"text":"    let ln = if left < 0 { (-left) as nat } else { 0 };"},{"highlight_end":56,"highlight_start":1,"text":"    let rp = if right >= 0 { right as nat } else { 0 };"},{"highlight_end":58,"highlight_start":1,"text":"    let rn = if right < 0 { (-right) as nat } else { 0 };"},{"highlight_end":72,"highlight_start":1,"text":"    let sp = if left + right >= 0 { (left + right) as nat } else { 0 };"},{"highlight_end":72,"highlight_start":1,"text":"    let sn = if left + right < 0 { (-left - right) as nat } else { 0 };"},{"highlight_end":42,"highlight_start":1,"text":"    assert(sp + ln + rn == lp + rp + sn);"},{"highlight_end":29,"highlight_start":1,"text":"    lemma_pow2_adds(ln, rn);"},{"highlight_end":34,"highlight_start":1,"text":"    lemma_pow2_adds(sp, ln + rn);"},{"highlight_end":29,"highlight_start":1,"text":"    lemma_pow2_adds(lp, rp);"},{"highlight_end":34,"highlight_start":1,"text":"    lemma_pow2_adds(lp + rp, sn);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":72,"highlight_start":1,"text":"/// Binary scaling moves a binade by exactly the signed scale exponent."},{"highlight_end":105,"highlight_start":1,"text":"pub proof fn binary_scale_preserves_binade(numerator: nat, denominator: nat, exponent: int, offset: int)"},{"highlight_end":58,"highlight_start":1,"text":"    requires in_binade(numerator, denominator, exponent),"},{"highlight_end":122,"highlight_start":1,"text":"    ensures in_binade(numerator * binary_numerator(offset), denominator * binary_denominator(offset), exponent + offset),"},{"highlight_end":59,"highlight_start":1,"text":"        (is_binary_scale(numerator, denominator, exponent)"},{"highlight_end":134,"highlight_start":1,"text":"            <==> is_binary_scale(numerator * binary_numerator(offset), denominator * binary_denominator(offset), exponent + offset)),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":31,"highlight_start":1,"text":"    binary_positive(exponent);"},{"highlight_end":29,"highlight_start":1,"text":"    binary_positive(offset);"},{"highlight_end":40,"highlight_start":1,"text":"    binary_positive(exponent + offset);"},{"highlight_end":45,"highlight_start":1,"text":"    binary_scales_compose(exponent, offset);"},{"highlight_end":40,"highlight_start":1,"text":"    let a = binary_numerator(exponent);"},{"highlight_end":42,"highlight_start":1,"text":"    let b = binary_denominator(exponent);"},{"highlight_end":38,"highlight_start":1,"text":"    let c = binary_numerator(offset);"},{"highlight_end":40,"highlight_start":1,"text":"    let d = binary_denominator(offset);"},{"highlight_end":49,"highlight_start":1,"text":"    let p = binary_numerator(exponent + offset);"},{"highlight_end":51,"highlight_start":1,"text":"    let q = binary_denominator(exponent + offset);"},{"highlight_end":86,"highlight_start":1,"text":"    assert(denominator * d > 0) by (nonlinear_arith) requires denominator > 0, d > 0;"},{"highlight_end":56,"highlight_start":1,"text":"    assert(p * (denominator * d) <= (numerator * c) * q"},{"highlight_end":81,"highlight_start":1,"text":"        && (numerator * c) * q < 2 * p * (denominator * d)) by (nonlinear_arith)"},{"highlight_end":59,"highlight_start":1,"text":"        requires a > 0, b > 0, c > 0, d > 0, p > 0, q > 0,"},{"highlight_end":40,"highlight_start":1,"text":"            p * (b * d) == (a * c) * q,"},{"highlight_end":83,"highlight_start":1,"text":"            a * denominator <= numerator * b, numerator * b < 2 * a * denominator;"},{"highlight_end":46,"highlight_start":1,"text":"    assert((numerator * b == a * denominator)"},{"highlight_end":80,"highlight_start":1,"text":"        <==> (numerator * c) * q == p * (denominator * d)) by (nonlinear_arith)"},{"highlight_end":59,"highlight_start":1,"text":"        requires a > 0, b > 0, c > 0, d > 0, p > 0, q > 0,"},{"highlight_end":40,"highlight_start":1,"text":"            p * (b * d) == (a * c) * q;"},{"highlight_end":2,"highlight_