highlight_start":1,"text":"                    index < length,"},{"highlight_end":53,"highlight_start":1,"text":"                    factors_product(updated, length)"},{"highlight_end":94,"highlight_start":1,"text":"                        == factors_product(updated, length - 1) * updated[length - 1] as nat,"},{"highlight_end":53,"highlight_start":1,"text":"                    factors_product(factors, length)"},{"highlight_end":94,"highlight_start":1,"text":"                        == factors_product(factors, length - 1) * factors[length - 1] as nat,"},{"highlight_end":76,"highlight_start":1,"text":"                    index == length - 1 ==> updated[length - 1] == quotient"},{"highlight_end":104,"highlight_start":1,"text":"                        && factors_product(updated, length - 1) == factors_product(factors, length - 1)"},{"highlight_end":84,"highlight_start":1,"text":"                        && factors[length - 1] as nat == quotient as nat * divisor,"},{"highlight_end":86,"highlight_start":1,"text":"                    index < length - 1 ==> updated[length - 1] == factors[length - 1]"},{"highlight_end":74,"highlight_start":1,"text":"                        && factors_product(updated, length - 1) * divisor"},{"highlight_end":69,"highlight_start":1,"text":"                            == factors_product(factors, length - 1);"},{"highlight_end":10,"highlight_start":1,"text":"        }"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":82,"highlight_start":1,"text":"/// Cross-cancelling any numerator/denominator pair preserves the whole fraction."},{"highlight_end":55,"highlight_start":1,"text":"pub(crate) proof fn cancel_preserves_product_fraction("},{"highlight_end":70,"highlight_start":1,"text":"    numerators: Seq<u128>, denominators: Seq<u128>, ni: int, di: int,"},{"highlight_end":2,"highlight_start":1,"text":")"},{"highlight_end":93,"highlight_start":1,"text":"    requires 0 <= ni < numerators.len(), 0 <= di < denominators.len(), denominators[di] > 0,"},{"highlight_end":15,"highlight_start":1,"text":"    ensures ({"},{"highlight_end":75,"highlight_start":1,"text":"        let divisor = gcd(numerators[ni] as nat, denominators[di] as nat);"},{"highlight_end":83,"highlight_start":1,"text":"        let ns = numerators.update(ni, (numerators[ni] as nat / divisor) as u128);"},{"highlight_end":87,"highlight_start":1,"text":"        let ds = denominators.update(di, (denominators[di] as nat / divisor) as u128);"},{"highlight_end":104,"highlight_start":1,"text":"        factors_product(ns, ns.len() as int) * factors_product(denominators, denominators.len() as int)"},{"highlight_end":107,"highlight_start":1,"text":"            == factors_product(numerators, numerators.len() as int) * factors_product(ds, ds.len() as int)"},{"highlight_end":8,"highlight_start":1,"text":"    }),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":71,"highlight_start":1,"text":"    let divisor = gcd(numerators[ni] as nat, denominators[di] as nat);"},{"highlight_end":79,"highlight_start":1,"text":"    super::gcd::gcd_reduction(numerators[ni] as nat, denominators[di] as nat);"},{"highlight_end":55,"highlight_start":1,"text":"    let n = (numerators[ni] as nat / divisor) as u128;"},{"highlight_end":57,"highlight_start":1,"text":"    let d = (denominators[di] as nat / divisor) as u128;"},{"highlight_end":70,"highlight_start":1,"text":"    lemma_fundamental_div_mod(numerators[ni] as int, divisor as int);"},{"highlight_end":72,"highlight_start":1,"text":"    lemma_fundamental_div_mod(denominators[di] as int, divisor as int);"},{"highlight_end":82,"highlight_start":1,"text":"    factors_update_quotient(numerators, ni, n, divisor, numerators.len() as int);"},{"highlight_end":86,"highlight_start":1,"text":"    factors_update_quotient(denominators, di, d, divisor, denominators.len() as int);"},{"highlight_end":39,"highlight_start":1,"text":"    let ns = numerators.update(ni, n);"},{"highlight_end":41,"highlight_start":1,"text":"    let ds = denominators.update(di, d);"},{"highlight_end":107,"highlight_start":1,"text":"    assert(factors_product(ns, ns.len() as int) * factors_product(denominators, denominators.len() as int)"},{"highlight_end":104,"highlight_start":1,"text":"        == factors_product(numerators, numerators.len() as int) * factors_product(ds, ds.len() as int))"},{"highlight_end":38,"highlight_start":1,"text":"        by (nonlinear_arith) requires"},{"highlight_end":116,"highlight_start":1,"text":"            factors_product(ns, ns.len() as int) * divisor == factors_product(numerators, numerators.len() as int),"},{"highlight_end":120,"highlight_start":1,"text":"            factors_product(ds, ds.len() as int) * divisor == factors_product(denominators, denominators.len() as int);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":87,"highlight_start":1,"text":"pub(crate) proof fn coprime_factors(factors: Seq<u128>, denominator: nat, length: int)"},{"highlight_end":60,"highlight_start":1,"text":"    requires denominator > 0, 0 <= length <= factors.len(),"},{"highlight_end":96,"highlight_start":1,"text":"        forall|i: int| 0 <= i < length ==> gcd(#[trigger] factors[i] as nat, denominator) == 1,"},{"highlight_end":69,"highlight_start":1,"text":"    ensures gcd(factors_product(factors, length), denominator) == 1,"},{"highlight_end":22,"highlight_start":1,"text":"    decreases length,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":21,"highlight_start":1,"text":"    if length == 0 {"},{"highlight_end":51,"highlight_start":1,"text":"        super::gcd::gcd_symmetric(1, denominator);"},{"highlight_end":50,"highlight_start":1,"text":"        assert(gcd(denominator, 1) == gcd(1, 0));"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":59,"highlight_start":1,"text":"        coprime_factors(factors, denominator, length - 1);"},{"highlight_end":104,"highlight_start":1,"text":"        coprime_product(factors_product(factors, length - 1), factors[length - 1] as nat, denominator);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":83,"highlight_start":1,"text":"/// Pairwise cross-coprimality gives a reduced product, including zero numerators."},{"highlight_end":94,"highlight_start":1,"text":"pub(crate) proof fn mutually_coprime_products(numerators: Seq<u128>, denominators: Seq<u128>)"},{"highlight_end":13,"highlight_start":1,"text":"    requires"},{"highlight_end":87,"highlight_start":1,"text":"        forall|j: int| 0 <= j < denominators.len() ==> #[trigger] denominators[j] > 0,"},{"highlight_end":88,"highlight_start":1,"text":"        forall|i: int, j: int| 0 <= i < numerators.len() && 0 <= j < denominators.len()"},{"highlight_end":94,"highlight_start":1,"text":"            ==> gcd(#[trigger] numerators[i] as nat, #[trigger] denominators[j] as nat) == 1,"},{"highlight_end":70,"highlight_start":1,"text":"    ensures gcd(factors_product(numerators, numerators.len() as int),"},{"highlight_end":72,"highlight_start":1,"text":"        factors_product(denominators, denominators.len() as int)) == 1,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":63,"highlight_start":1,"text":"    factors_positive(denominators, denominators.len() as int);"},{"highlight_end":80,"highlight_start":1,"text":"    let denominator = factors_product(denominators, denominators.len() as int);"},{"highlight_end":60,"highlight_start":1,"text":"    assert forall|i: int| 0 <= i < numerators.len() implies"},{"highlight_end":68,"highlight_start":1,"text":"        gcd(#[trigger] numerators[i] as nat, denominator) == 1 by {"},{"highlight_end":46,"highlight_start":1,"text":"        let numerator = numerators[i] as nat;"},{"highlight_end":28,"highlight_start":1,"text":"        if numerator == 0 {"},{"highlight_end":107,"highlight_start":1,"text":"            assert forall|j: int| 0 <= j < denominators.len() implies #[trigger] denominators[j] == 1 by {"},{"highlight_end":69,"highlight_start":1,"text":"                assert(gcd(numerator, denominators[j] as nat) == 1);"},{"highlight_end":60,"highlight_start":1,"text":"                lemma_small_mod(0, denominators[j] as nat);"},{"highlight_end":42,"highlight_start":1,"text":"                reveal_with_fuel(gcd, 2);"},{"highlight_end":75,"highlight_start":1,"text":"                assert(gcd(0, denominators[j] as nat) == denominators[j]);"},{"highlight_end":14,"highlight_start":1,"text":"            }"},{"highlight_end":67,"highlight_start":1,"text":"            factors_unit(denominators, denominators.len() as int);"},{"highlight_end":68,"highlight_start":1,"text":"            assert(gcd(0, 1) == 1) by { reveal_with_fuel(gcd, 2); }"},{"highlight_end":17,"highlight_start":1,"text":"        } else {"},{"highlight_end":70,"highlight_start":1,"text":"            assert forall|j: int| 0 <= j < denominators.len() implies"},{"highlight_end":76,"highlight_start":1,"text":"                gcd(#[trigger] denominators[j] as nat, numerator) == 1 by {"},{"highlight_end":78,"highlight_start":1,"text":"                super::gcd::gcd_symmetric(numerator, denominators[j] as nat);"},{"highlight_end":14,"highlight_start":1,"text":"            }"},{"highlight_end":81,"highlight_start":1,"text":"            coprime_factors(denominators, numerator, denominators.len() as int);"},{"highlight_end":63,"highlight_start":1,"text":"            super::gcd::gcd_symmetric(denominator, numerator);"},{"highlight_end":10,"highlight_start":1,"text":"        }"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":71,"highlight_start":1,"text":"    coprime_factors(numerators, denominator, numerators.len() as int);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":75,"highlight_start":1,"text":"/// Reducing the next pair preserves every already-processed coprime pair."},{"highlight_end":74,"highlight_start":1,"text":"/// This is the induction step for the numerator-major cancellation loop."},{"highlight_end":60,"highlight_start":1,"text":"pub(crate) proof fn cancel_preserves_processed_coprimality("},{"highlight_end":70,"highlight_start":1,"text":"    numerators: Seq<u128>, denominators: Seq<u128>, ni: int, di: int,"},{"highlight_end":2,"highlight_start":1,"text":")"},{"highlight_end":13,"highlight_start":1,"text":"    requires"},{"highlight_end":66,"highlight_start":1,"text":"        0 <= ni < numerators.len(), 0 <= di < denominators.len(),"},{"highlight_end":87,"highlight_start":1,"text":"        forall|j: int| 0 <= j < denominators.len() ==> #[trigger] denominators[j] > 0,"},{"highlight_end":88,"highlight_start":1,"text":"        forall|i: int, j: int| 0 <= i < numerators.len() && 0 <= j < denominators.len()"},{"highlight_end":45,"highlight_start":1,"text":"            && (i < ni || i == ni && j < di)"},{"highlight_end":94,"highlight_start":1,"text":"            ==> gcd(#[trigger] numerators[i] as nat, #[trigger] denominators[j] as nat) == 1,"},{"highlight_end":15,"highlight_start":1,"text":"    ensures ({"},{"highlight_end":75,"highlight_start":1,"text":"        let divisor = gcd(numerators[ni] as nat, denominators[di] as nat);"},{"highlight_end":83,"highlight_start":1,"text":"        let ns = numerators.update(ni, (numerators[ni] as nat / divisor) as u128);"},{"highlight_end":87,"highlight_start":1,"text":"        let ds = denominators.update(di, (denominators[di] as nat / divisor) as u128);"},{"highlight_end":70,"highlight_start":1,"text":"        &&& forall|j: int| 0 <= j < ds.len() ==> #[trigger] ds[j] > 0"},{"highlight_end":74,"highlight_start":1,"text":"        &&& forall|i: int, j: int| 0 <= i < ns.len() && 0 <= j < ds.len()"},{"highlight_end":46,"highlight_start":1,"text":"            && (i < ni || i == ni && j <= di)"},{"highlight_end":75,"highlight_start":1,"text":"            ==> gcd(#[trigger] ns[i] as nat, #[trigger] ds[j] as nat) == 1"},{"highlight_end":8,"highlight_start":1,"text":"    }),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":43,"highlight_start":1,"text":"    let numerator = numerators[ni] as nat;"},{"highlight_end":47,"highlight_start":1,"text":"    let denominator = denominators[di] as nat;"},{"highlight_end":47,"highlight_start":1,"text":"    let divisor = gcd(numerator, denominator);"},{"highlight_end":55,"highlight_start":1,"text":"    super::gcd::gcd_reduction(numerator, denominator);"},{"highlight_end":67,"highlight_start":1,"text":"    super::division::gcd_characterization(numerator, denominator);"},{"highlight_end":43,"highlight_start":1,"text":"    let n = (numerator / divisor) as u128;"},{"highlight_end":45,"highlight_start":1,"text":"    let d = (denominator / divisor) as u128;"},{"highlight_end":39,"highlight_start":1,"text":"    let ns = numerators.update(ni, n);"},{"highlight_end":41,"highlight_start":1,"text":"    let ds = denominators.update(di, d);"},{"highlight_end":78,"highlight_start":1,"text":"    assert forall|j: int| 0 <= j < ds.len() implies #[trigger] ds[j] > 0 by {"},{"highlight_end":57,"highlight_start":1,"text":"        if j != di { assert(ds[j] == denominators[j]); }"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":73,"highlight_start":1,"text":"    assert forall|i: int, j: int| 0 <= i < ns.len() && 0 <= j < ds.len()"},{"highlight_end":42,"highlight_start":1,"text":"        && (i < ni || i == ni && j <= di)"},{"highlight_end":80,"highlight_start":1,"text":"        implies gcd(#[trigger] ns[i] as nat, #[trigger] ds[j] as nat) == 1 by {"},{"highlight_end":32,"highlight_start":1,"text":"        if i == ni && j == di {"},{"highlight_end":50,"highlight_start":1,"text":"            assert(gcd(n as nat, d as nat) == 1);"},{"highlight_end":17,"highlight_start":1,"text":"        } else {"},{"highlight_end":76,"highlight_start":1,"text":"            assert(gcd(numerators[i] as nat, denominators[j] as nat) == 1);"},{"highlight_end":25,"highlight_start":1,"text":"            if i == ni {"},{"highlight_end":82,"highlight_start":1,"text":"                coprime_quotients(numerator, denominators[j] as nat, divisor, 1);"},{"highlight_end":32,"highlight_start":1,"text":"            } else if j == di {"},{"highlight_end":82,"highlight_start":1,"text":"                coprime_quotients(numerators[i] as nat, denominator, 1, divisor);"},{"highlight_end":14,"highlight_start":1,"text":"            }"},{"highlight_end":10,"highlight_start":1,"text":"        }"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":2,"highlight_start":1,"text":"}"}]}},"file_name":"/home/tim/Documents/GitHub/workspace/csgrs/target/scalar-evaluation-candidate/source/crates/hyperreal/src/verified/fraction.rs","is_primary":true,"label":null,"line_end":327,"line_start":32,"suggested_replacement":null,"suggestion_applicability":null,"text":[{"highlight_end":9,"highlight_start":1,"text":"verus! {"},{"highlight_end":88,"highlight_start":1,"text":"pub(crate) open spec fn bezout_witness(left: nat, right: nat, x: int, y: int) -> bool {"},{"highlight_end":45,"highlight_start":1,"text":"    gcd(left, right) == x * left + y * right"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":60,"highlight_start":1,"text":"/// Euclid's GCD has an integer linear-combination witness."},{"highlight_end":54,"highlight_start":1,"text":"pub(crate) proof fn gcd_bezout(left: nat, right: nat)"},{"highlight_end":81,"highlight_start":1,"text":"    ensures exists|x: int, y: int| #[trigger] bezout_witness(left, right, x, y),"},{"highlight_end":21,"highlight_start":1,"text":"    decreases right,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":20,"highlight_start":1,"text":"    if right == 0 {"},{"highlight_end":78,"highlight_start":1,"text":"        assert(gcd(left, right) == 1 * left + 0 * right) by (nonlinear_arith)"},{"highlight_end":59,"highlight_start":1,"text":"            requires right == 0, gcd(left, right) == left;"},{"highlight_end":51,"highlight_start":1,"text":"        assert(bezout_witness(left, right, 1, 0));"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":37,"highlight_start":1,"text":"        let quotient = left / right;"},{"highlight_end":38,"highlight_start":1,"text":"        let remainder = left % right;"},{"highlight_end":38,"highlight_start":1,"text":"        gcd_bezout(right, remainder);"},{"highlight_end":95,"highlight_start":1,"text":"        let (x, y) = choose|x: int, y: int| #[trigger] bezout_witness(right, remainder, x, y);"},{"highlight_end":62,"highlight_start":1,"text":"        lemma_fundamental_div_mod(left as int, right as int);"},{"highlight_end":44,"highlight_start":1,"text":"        let coefficient = x - y * quotient;"},{"highlight_end":97,"highlight_start":1,"text":"        assert(y * left + coefficient * right == x * right + y * remainder) by (nonlinear_arith)"},{"highlight_end":92,"highlight_start":1,"text":"            requires left == right * quotient + remainder, coefficient == x - y * quotient;"},{"highlight_end":61,"highlight_start":1,"text":"        assert(bezout_witness(left, right, y, coefficient));"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":91,"highlight_start":1,"text":"proof fn linear_combination_divisible(left: int, right: int, divisor: int, x: int, y: int)"},{"highlight_end":69,"highlight_start":1,"text":"    requires divisor > 0, left % divisor == 0, right % divisor == 0,"},{"highlight_end":51,"highlight_start":1,"text":"    ensures (x * left + y * right) % divisor == 0,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":46,"highlight_start":1,"text":"    lemma_fundamental_div_mod(left, divisor);"},{"highlight_end":47,"highlight_start":1,"text":"    lemma_fundamental_div_mod(right, divisor);"},{"highlight_end":68,"highlight_start":1,"text":"    let coefficient = x * (left / divisor) + y * (right / divisor);"},{"highlight_end":79,"highlight_start":1,"text":"    assert(x * left + y * right == coefficient * divisor) by (nonlinear_arith)"},{"highlight_end":91,"highlight_start":1,"text":"        requires left == divisor * (left / divisor), right == divisor * (right / divisor),"},{"highlight_end":73,"highlight_start":1,"text":"            coefficient == x * (left / divisor) + y * (right / divisor);"},{"highlight_end":53,"highlight_start":1,"text":"    lemma_mod_multiples_basic(coefficient, divisor);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":66,"highlight_start":1,"text":"/// A divisor coprime to one factor must divide the other factor."},{"highlight_end":81,"highlight_start":1,"text":"pub(crate) proof fn coprime_divides_product(left: nat, right: nat, divisor: nat)"},{"highlight_end":82,"highlight_start":1,"text":"    requires divisor > 0, gcd(left, divisor) == 1, (left * right) % divisor == 0,"},{"highlight_end":34,"highlight_start":1,"text":"    ensures right % divisor == 0,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":31,"highlight_start":1,"text":"    gcd_bezout(left, divisor);"},{"highlight_end":88,"highlight_start":1,"text":"    let (x, y) = choose|x: int, y: int| #[trigger] bezout_witness(left, divisor, x, y);"},{"highlight_end":38,"highlight_start":1,"text":"    lemma_mod_self_0(divisor as int);"},{"highlight_end":103,"highlight_start":1,"text":"    linear_combination_divisible((left * right) as int, divisor as int, divisor as int, x, y * right);"},{"highlight_end":85,"highlight_start":1,"text":"    assert(x * (left * right) + (y * right) * divisor == right) by (nonlinear_arith)"},{"highlight_end":46,"highlight_start":1,"text":"        requires x * left + y * divisor == 1;"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":75,"highlight_start":1,"text":"/// Multiplication preserves coprimality to a common positive denominator."},{"highlight_end":77,"highlight_start":1,"text":"pub(crate) proof fn coprime_product(left: nat, right: nat, denominator: nat)"},{"highlight_end":89,"highlight_start":1,"text":"    requires denominator > 0, gcd(left, denominator) == 1, gcd(right, denominator) == 1,"},{"highlight_end":49,"highlight_start":1,"text":"    ensures gcd(left * right, denominator) == 1,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":70,"highlight_start":1,"text":"    super::division::gcd_characterization(left * right, denominator);"},{"highlight_end":63,"highlight_start":1,"text":"    super::division::gcd_characterization(right, denominator);"},{"highlight_end":50,"highlight_start":1,"text":"    let divisor = gcd(left * right, denominator);"},{"highlight_end":35,"highlight_start":1,"text":"    gcd_bezout(left, denominator);"},{"highlight_end":92,"highlight_start":1,"text":"    let (x, y) = choose|x: int, y: int| #[trigger] bezout_witness(left, denominator, x, y);"},{"highlight_end":107,"highlight_start":1,"text":"    linear_combination_divisible((left * right) as int, denominator as int, divisor as int, x, y * right);"},{"highlight_end":89,"highlight_start":1,"text":"    assert(x * (left * right) + (y * right) * denominator == right) by (nonlinear_arith)"},{"highlight_end":50,"highlight_start":1,"text":"        requires x * left + y * denominator == 1;"},{"highlight_end":34,"highlight_start":1,"text":"    assert(right % divisor == 0);"},{"highlight_end":48,"highlight_start":1,"text":"    assert(divisor <= gcd(right, denominator));"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":79,"highlight_start":1,"text":"/// Dividing either part cannot introduce a common factor into a reduced pair."},{"highlight_end":111,"highlight_start":1,"text":"pub(crate) proof fn coprime_quotients(numerator: nat, denominator: nat, left_divisor: nat, right_divisor: nat)"},{"highlight_end":64,"highlight_start":1,"text":"    requires denominator > 0, gcd(numerator, denominator) == 1,"},{"highlight_end":45,"highlight_start":1,"text":"        left_divisor > 0, right_divisor > 0,"},{"highlight_end":73,"highlight_start":1,"text":"        numerator % left_divisor == 0, denominator % right_divisor == 0,"},{"highlight_end":77,"highlight_start":1,"text":"    ensures gcd(numerator / left_divisor, denominator / right_divisor) == 1,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":70,"highlight_start":1,"text":"    lemma_fundamental_div_mod(numerator as int, left_divisor as int);"},{"highlight_end":73,"highlight_start":1,"text":"    lemma_fundamental_div_mod(denominator as int, right_divisor as int);"},{"highlight_end":54,"highlight_start":1,"text":"    let reduced_numerator = numerator / left_divisor;"},{"highlight_end":59,"highlight_start":1,"text":"    let reduced_denominator = denominator / right_divisor;"},{"highlight_end":57,"highlight_start":1,"text":"    assert(reduced_denominator > 0) by (nonlinear_arith)"},{"highlight_end":86,"highlight_start":1,"text":"        requires denominator > 0, denominator == right_divisor * reduced_denominator;"},{"highlight_end":83,"highlight_start":1,"text":"    super::division::gcd_characterization(reduced_numerator, reduced_denominator);"},{"highlight_end":63,"highlight_start":1,"text":"    let divisor = gcd(reduced_numerator, reduced_denominator);"},{"highlight_end":40,"highlight_start":1,"text":"    gcd_bezout(numerator, denominator);"},{"highlight_end":97,"highlight_start":1,"text":"    let (x, y) = choose|x: int, y: int| #[trigger] bezout_witness(numerator, denominator, x, y);"},{"highlight_end":103,"highlight_start":1,"text":"    linear_combination_divisible(reduced_numerator as int, reduced_denominator as int, divisor as int,"},{"highlight_end":46,"highlight_start":1,"text":"        x * left_divisor, y * right_divisor);"},{"highlight_end":100,"highlight_start":1,"text":"    assert((x * left_divisor) * reduced_numerator + (y * right_divisor) * reduced_denominator == 1)"},{"highlight_end":76,"highlight_start":1,"text":"        by (nonlinear_arith) requires x * numerator + y * denominator == 1,"},{"highlight_end":111,"highlight_start":1,"text":"            numerator == left_divisor * reduced_numerator, denominator == right_divisor * reduced_denominator;"},{"highlight_end":33,"highlight_start":1,"text":"    assert(1nat % divisor == 0);"},{"highlight_end":21,"highlight_start":1,"text":"    if divisor > 1 {"},{"highlight_end":37,"highlight_start":1,"text":"        lemma_small_mod(1, divisor);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":83,"highlight_start":1,"text":"/// Prefix products retain the ordering relevant to checked native multiplication."},{"highlight_end":80,"highlight_start":1,"text":"pub(crate) open spec fn factors_product(factors: Seq<u128>, length: int) -> nat"},{"highlight_end":45,"highlight_start":1,"text":"    recommends 0 <= length <= factors.len(),"},{"highlight_end":22,"highlight_start":1,"text":"    decreases length,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":32,"highlight_start":1,"text":"    if length <= 0 { 1 } else {"},{"highlight_end":74,"highlight_start":1,"text":"        factors_product(factors, length - 1) * factors[length - 1] as nat"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":70,"highlight_start":1,"text":"pub(crate) proof fn factors_positive(factors: Seq<u128>, length: int)"},{"highlight_end":43,"highlight_start":1,"text":"    requires 0 <= length <= factors.len(),"},{"highlight_end":70,"highlight_start":1,"text":"        forall|i: int| 0 <= i < length ==> #[trigger] factors[i] > 0,"},{"highlight_end":50,"highlight_start":1,"text":"    ensures factors_product(factors, length) > 0,"},{"highlight_end":22,"highlight_start":1,"text":"    decreases length,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":20,"highlight_start":1,"text":"    if length > 0 {"},{"highlight_end":47,"highlight_start":1,"text":"        factors_positive(factors, length - 1);"},{"highlight_end":74,"highlight_start":1,"text":"        assert(factors_product(factors, length) > 0) by (nonlinear_arith)"},{"highlight_end":88,"highlight_start":1,"text":"            requires factors_product(factors, length - 1) > 0, factors[length - 1] > 0,"},{"highlight_end":49,"highlight_start":1,"text":"                factors_product(factors, length)"},{"highlight_end":90,"highlight_start":1,"text":"                    == factors_product(factors, length - 1) * factors[length - 1] as nat;"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":66,"highlight_start":1,"text":"pub(crate) proof fn factors_unit(factors: Seq<u128>, length: int)"},{"highlight_end":43,"highlight_start":1,"text":"    requires 0 <= length <= factors.len(),"},{"highlight_end":71,"highlight_start":1,"text":"        forall|i: int| 0 <= i < length ==> #[trigger] factors[i] == 1,"},{"highlight_end":51,"highlight_start":1,"text":"    ensures factors_product(factors, length) == 1,"},{"highlight_end":22,"highlight_start":1,"text":"    decreases length,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":57,"highlight_start":1,"text":"    if length > 0 { factors_unit(factors, length - 1); }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":81,"highlight_start":1,"text":"/// An exact factor division divides every containing prefix by the same amount."},{"highlight_end":78,"highlight_start":1,"text":"/// This formulation also covers a zero factor, without cancelling that zero."},{"highlight_end":45,"highlight_start":1,"text":"pub(crate) proof fn factors_update_quotient("},{"highlight_end":79,"highlight_start":1,"text":"    factors: Seq<u128>, index: int, quotient: u128, divisor: nat, length: int,"},{"highlight_end":2,"highlight_start":1,"text":")"},{"highlight_end":71,"highlight_start":1,"text":"    requires 0 <= index < factors.len(), 0 <= length <= factors.len(),"},{"highlight_end":60,"highlight_start":1,"text":"        factors[index] as nat == quotient as nat * divisor,"},{"highlight_end":12,"highlight_start":1,"text":"    ensures"},{"highlight_end":94,"highlight_start":1,"text":"        index < length ==> factors_product(factors.update(index, quotient), length) * divisor"},{"highlight_end":49,"highlight_start":1,"text":"            == factors_product(factors, length),"},{"highlight_end":85,"highlight_start":1,"text":"        index >= length ==> factors_product(factors.update(index, quotient), length)"},{"highlight_end":49,"highlight_start":1,"text":"            == factors_product(factors, length),"},{"highlight_end":22,"highlight_start":1,"text":"    decreases length,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":20,"highlight_start":1,"text":"    if length > 0 {"},{"highlight_end":80,"highlight_start":1,"text":"        factors_update_quotient(factors, index, quotient, divisor, length - 1);"},{"highlight_end":55,"highlight_start":1,"text":"        let updated = factors.update(index, quotient);"},{"highlight_end":28,"highlight_start":1,"text":"        if index < length {"},{"highlight_end":99,"highlight_start":1,"text":"            assert(factors_product(updated, length) * divisor == factors_product(factors, length))"},{"highlight_end":46,"highlight_start":1,"text":"                by (nonlinear_arith) requires"},{"highlight_end":36,"highlight_start":1,"text":"                    index < length,"},{"highlight_end":53,"highlight_start":1,"text":"                    factors_product(updated, length)"},{"highlight_end":94,"highlight_start":1,"text":"                        == factors_product(updated, length - 1) * updated[length - 1] as nat,"},{"highlight_end":53,"highlight_start":1,"text":"                    factors_product(factors, length)"},{"highlight_end":94,"highlight_start":1,"text":"                        == factors_product(factors, length - 1) * factors[length - 1] as nat,"},{"highlight_end":76,"highlight_start":1,"text":"                    index == length - 1 ==> updated[length - 1] == quotient"},{"highlight_end":104,"highlight_start":1,"text":"                        && factors_product(updated, length - 1) == factors_product(factors, length - 1)"},{"highlight_end":84,"highlight_start":1,"text":"                        && factors[length - 1] as nat == quotient as nat * divisor,"},{"highlight_end":86,"highlight_start":1,"text":"                    index < length - 1 ==> updated[length - 1] == factors[length - 1]"},{"highlight_end":74,"highlight_start":1,"text":"                        && factors_product(updated, length - 1) * divisor"},{"highlight_end":69,"highlight_start":1,"text":"                            == factors_product(factors, length - 1);"},{"highlight_end":10,"highlight_start":1,"text":"        }"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":82,"highlight_start":1,"text":"/// Cross-cancelling any numerator/denominator pair preserves the whole fraction."},{"highlight_end":55,"highlight_start":1,"text":"pub(crate) proof fn cancel_preserves_product_fraction("},{"highlight_end":70,"highlight_start":1,"text":"    numerators: Seq<u128>, denominators: Seq<u128>, ni: int, di: int,"},{"highlight_end":2,"highlight_start":1,"text":")"},{"highlight_end":93,"highlight_start":1,"text":"    requires 0 <= ni < numerators.len(), 0 <= di < denominators.len(), denominators[di] > 0,"},{"highlight_end":15,"highlight_start":1,"text":"    ensures ({"},{"highlight_end":75,"highlight_start":1,"text":"        let divisor = gcd(numerators[ni] as nat, denominators[di] as nat);"},{"highlight_end":83,"highlight_start":1,"text":"        let ns = numerators.update(ni, (numerators[ni] as nat / divisor) as u128);"},{"highlight_end":87,"highlight_start":1,"text":"        let ds = denominators.update(di, (denominators[di] as nat / divisor) as u128);"},{"highlight_end":104,"highlight_start":1,"text":"        factors_product(ns, ns.len() as int) * factors_product(denominators, denominators.len() as int)"},{"highlight_end":107,"highlight_start":1,"text":"            == factors_product(numerators, numerators.len() as int) * factors_product(ds, ds.len() as int)"},{"highlight_end":8,"highlight_start":1,"text":"    }),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":71,"highlight_start":1,"text":"    let divisor = gcd(numerators[ni] as nat, denominators[di] as nat);"},{"highlight_end":79,"highlight_start":1,"text":"    super::gcd::gcd_reduction(numerators[ni] as nat, denominators[di] as nat);"},{"highlight_end":55,"highlight_start":1,"text":"    let n = (numerators[ni] as nat / divisor) as u128;"},{"highlight_end":57,"highlight_start":1,"text":"    let d = (denominators[di] as nat / divisor) as u128;"},{"highlight_end":70,"highlight_start":1,"text":"    lemma_fundamental_div_mod(numerators[ni] as int, divisor as int);"},{"highlight_end":72,"highlight_start":1,"text":"    lemma_fundamental_div_mod(denominators[di] as int, divisor as int);"},{"highlight_end":82,"highlight_start":1,"text":"    factors_update_quotient(numerators, ni, n, divisor, numerators.len() as int);"},{"highlight_end":86,"highlight_start":1,"text":"    factors_update_quotient(denominators, di, d, divisor, denominators.len() as int);"},{"highlight_end":39,"highlight_start":1,"text":"    let ns = numerators.update(ni, n);"},{"highlight_end":41,"highlight_start":1,"text":"    let ds = denominators.update(di, d);"},{"highlight_end":107,"highlight_start":1,"text":"    assert(factors_product(ns, ns.len() as int) * factors_product(denominators, denominators.len() as int)"},{"highlight_end":104,"highlight_start":1,"text":"        == factors_product(numerators, numerators.len() as int) * factors_product(ds, ds.len() as int))"},{"highlight_end":38,"highlight_start":1,"text":"        by (nonlinear_arith) requires"},{"highlight_end":116,"highlight_start":1,"text":"            factors_product(ns, ns.len() as int) * divisor == factors_product(numerators, numerators.len() as int),"},{"highlight_end":120,"highlight_start":1,"text":"            factors_product(ds, ds.len() as int) * divisor == factors_product(denominators, denominators.len() as int);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":87,"highlight_start":1,"text":"pub(crate) proof fn coprime_factors(factors: Seq<u128>, denominator: nat, length: int)"},{"highlight_end":60,"highlight_start":1,"text":"    requires denominator > 0, 0 <= length <= factors.len(),"},{"highlight_end":96,"highlight_start":1,"text":"        forall|i: int| 0 <= i < length ==> gcd(#[trigger] factors[i] as nat, denominator) == 1,"},{"highlight_end":69,"highlight_start":1,"text":"    ensures gcd(factors_product(factors, length), denominator) == 1,"},{"highlight_end":22,"highlight_start":1,"text":"    decreases length,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":21,"highlight_start":1,"text":"    if length == 0 {"},{"highlight_end":51,"highlight_start":1,"text":"        super::gcd::gcd_sy