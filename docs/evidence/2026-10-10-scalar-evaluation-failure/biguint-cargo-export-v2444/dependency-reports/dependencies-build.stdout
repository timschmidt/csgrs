rt":1,"text":"    ensures gcd(abs(a * left + b * right), abs(c * left + d * right)) == gcd(left, right),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":38,"highlight_start":1,"text":"    let first = a * left + b * right;"},{"highlight_end":39,"highlight_start":1,"text":"    let second = c * left + d * right;"},{"highlight_end":39,"highlight_start":1,"text":"    let det = determinant(a, b, c, d);"},{"highlight_end":67,"highlight_start":1,"text":"    assert(d * (a * left + b * right) - b * (c * left + d * right)"},{"highlight_end":57,"highlight_start":1,"text":"        == (a * d - b * c) * left) by (nonlinear_arith);"},{"highlight_end":68,"highlight_start":1,"text":"    assert(-c * (a * left + b * right) + a * (c * left + d * right)"},{"highlight_end":58,"highlight_start":1,"text":"        == (a * d - b * c) * right) by (nonlinear_arith);"},{"highlight_end":86,"highlight_start":1,"text":"    assert(abs(det * left) == left && abs(det * right) == right) by (nonlinear_arith)"},{"highlight_end":63,"highlight_start":1,"text":"        requires det == 1 || det == -1, left >= 0, right >= 0;"},{"highlight_end":39,"highlight_start":1,"text":"    gcd_characterization(left, right);"},{"highlight_end":51,"highlight_start":1,"text":"    gcd_characterization(abs(first), abs(second));"},{"highlight_end":33,"highlight_start":1,"text":"    if left == 0 && right == 0 {"},{"highlight_end":63,"highlight_start":1,"text":"        assert(first == 0 && second == 0) by (nonlinear_arith)"},{"highlight_end":84,"highlight_start":1,"text":"            requires first == a * left + b * right, second == c * left + d * right,"},{"highlight_end":39,"highlight_start":1,"text":"                left == 0, right == 0;"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":63,"highlight_start":1,"text":"        assert(first != 0 || second != 0) by (nonlinear_arith)"},{"highlight_end":59,"highlight_start":1,"text":"            requires d * first - b * second 