_start":1,"text":"                digit_prefix(digits, width, end - 1) == digit_prefix(digits, width, start)"},{"highlight_end":88,"highlight_start":1,"text":"                    + digit_weight(width, start as nat) * digit_value(previous, width),"},{"highlight_end":73,"highlight_start":1,"text":"                digit_value(tail, width) == digit_value(previous, width)"},{"highlight_end":87,"highlight_start":1,"text":"                    + digits[end - 1] * digit_weight(width, (end - start - 1) as nat),"},{"highlight_end":91,"highlight_start":1,"text":"                digit_weight(width, (end - 1) as nat) == digit_weight(width, start as nat)"},{"highlight_end":69,"highlight_start":1,"text":"                    * digit_weight(width, (end - start - 1) as nat);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":81,"highlight_start":1,"text":"pub(crate) proof fn digit_prefix_zero(digits: Seq<nat>, width: nat, length: int)"},{"highlight_end":42,"highlight_start":1,"text":"    requires 0 <= length <= digits.len(),"},{"highlight_end":58,"highlight_start":1,"text":"    ensures digit_prefix(digits, width, length) == 0 <==>"},{"highlight_end":82,"highlight_start":1,"text":"        forall|index: int| 0 <= index < length ==> #[trigger] digits[index] == 0,"},{"highlight_end":22,"highlight_start":1,"text":"    decreases length,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":20,"highlight_start":1,"text":"    if length > 0 {"},{"highlight_end":54,"highlight_start":1,"text":"        digit_prefix_zero(digits, width, length - 1);"},{"highlight_end":55,"highlight_start":1,"text":"        digit_weight_step(width, (length - 1) as nat);"},{"highlight_end":61,"highlight_start":1,"text":"        assert(digit_prefix(digits, width, length) == 0 <==>"},{"highlight_end":85,"highlight_start":1,"text":"            digit_prefix(digits, width, length - 1) == 0 && digits[length - 1] == 0)"},{"highlight_end":33,"highlight_start":1,"text":"            by (nonlinear_arith)"},{"highlight_end":100,"highlight_start":1,"text":"            requires digit_prefix(digits, width, length) == digit_prefix(digits, width, length - 1)"},{"highlight_end":85,"highlight_start":1,"text":"                    + digits[length - 1] * digit_weight(width, (length - 1) as nat),"},{"highlight_end":87,"highlight_start":1,"text":"                digit_prefix(digits, width, length - 1) >= 0, digits[length - 1] >= 0,"},{"highlight_end":62,"highlight_start":1,"text":"                digit_weight(width, (length - 1) as nat) > 0;"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":81,"highlight_start":1,"text":"pub(crate) proof fn digit_prefix_full(digits: Seq<nat>, width: nat, length: int)"},{"highlight_end":42,"highlight_start":1,"text":"    requires 0 <= length <= digits.len(),"},{"highlight_end":96,"highlight_start":1,"text":"        forall|index: int| 0 <= index < length ==> #[trigger] digits[index] + 1 == pow2(width),"},{"highlight_end":91,"highlight_start":1,"text":"    ensures digit_prefix(digits, width, length) + 1 == digit_weight(width, length as nat),"},{"highlight_end":22,"highlight_start":1,"text":"    decreases length,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":21,"highlight_start":1,"text":"    if length == 0 {"},{"highlight_end":23,"highlight_start":1,"text":"        lemma2_to64();"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":54,"highlight_start":1,"text":"        digit_prefix_full(digits, width, length - 1);"},{"highlight_end":55,"highlight_start":1,"text":"        digit_weight_step(width, (length - 1) as nat);"},{"highlight_end":94,"highlight_start":1,"text":"        assert(digit_prefix(digits, width, length) + 1 == digit_weight(width, length as nat))"},{"highlight_end":33,"highlight_start":1,"text":"            by (nonlinear_arith)"},{"highlight_end":100,"highlight_start":1,"text":"            requires digit_prefix(digits, width, length) == digit_prefix(digits, width, length - 1)"},{"highlight_end":85,"highlight_start":1,"text":"                    + digits[length - 1] * digit_weight(width, (length - 1) as nat),"},{"highlight_end":105,"highlight_start":1,"text":"                digit_prefix(digits, width, length - 1) + 1 == digit_weight(width, (length - 1) as nat),"},{"highlight_end":55,"highlight_start":1,"text":"                digits[length - 1] + 1 == pow2(width),"},{"highlight_end":110,"highlight_start":1,"text":"                digit_weight(width, length as nat) == digit_weight(width, (length - 1) as nat) * pow2(width);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":54,"highlight_start":1,"text":"pub(crate) proof fn upper_digits_preserve_odd_factor("},{"highlight_end":63,"highlight_start":1,"text":"    odd: nat, shift: nat, width: nat, upper: nat, offset: nat,"},{"highlight_end":2,"highlight_start":1,"text":")"},{"highlight_end":51,"highlight_start":1,"text":"    requires odd > 0, odd % 2 == 1, shift < width,"},{"highlight_end":102,"highlight_start":1,"text":"    ensures has_odd_factor((odd * pow2(shift) + pow2(width) * upper) * pow2(offset), offset + shift),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":34,"highlight_start":1,"text":"    let lower_unit = pow2(shift);"},{"highlight_end":46,"highlight_start":1,"text":"    let other = pow2((width - shift) as nat);"},{"highlight_end":37,"highlight_start":1,"text":"    let unit = pow2(offset + shift);"},{"highlight_end":40,"highlight_start":1,"text":"    let quotient = odd + other * upper;"},{"highlight_end":73,"highlight_start":1,"text":"    let value = (odd * lower_unit + pow2(width) * upper) * pow2(offset);"},{"highlight_end":44,"highlight_start":1,"text":"    lemma_pow2_pos((width - shift) as nat);"},{"highlight_end":36,"highlight_start":1,"text":"    lemma_pow2_pos(offset + shift);"},{"highlight_end":52,"highlight_start":1,"text":"    lemma_pow2_adds(shift, (width - shift) as nat);"},{"highlight_end":36,"highlight_start":1,"text":"    lemma_pow2_adds(offset, shift);"},{"highlight_end":58,"highlight_start":1,"text":"    assert(value == quotient * unit) by (nonlinear_arith)"},{"highlight_end":50,"highlight_start":1,"text":"        requires quotient == odd + other * upper,"},{"highlight_end":78,"highlight_start":1,"text":"            value == (odd * lower_unit + pow2(width) * upper) * pow2(offset),"},{"highlight_end":82,"highlight_start":1,"text":"            pow2(width) == lower_unit * other, unit == pow2(offset) * lower_unit;"},{"highlight_end":46,"highlight_start":1,"text":"    assert(quotient > 0) by (nonlinear_arith)"},{"highlight_end":82,"highlight_start":1,"text":"        requires quotient == odd + other * upper, odd > 0, other > 0, upper >= 0;"},{"highlight_end":47,"highlight_start":1,"text":"    lemma_pow2_unfold((width - shift) as nat);"},{"highlight_end":49,"highlight_start":1,"text":"    let half = pow2((width - shift - 1) as nat);"},{"highlight_end":70,"highlight_start":1,"text":"    assert(quotient == 2 * (half * upper) + odd) by (nonlinear_arith)"},{"highlight_end":69,"highlight_start":1,"text":"        requires quotient == odd + other * upper, other == 2 * half;"},{"highlight_end":70,"highlight_start":1,"text":"    lemma_mod_multiples_vanish((half * upper) as int, odd as int, 2);"},{"highlight_end":91,"highlight_start":1,"text":"    lemma_fundamental_div_mod_converse_div(value as int, unit as int, quotient as int, 0);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":86,"highlight_start":1,"text":"// This is the None branch of a first-nonmaximal-digit scan, including empty storage."},{"highlight_end":73,"highlight_start":1,"text":"pub(crate) proof fn all_full_digits_factor(digits: Seq<nat>, width: nat)"},{"highlight_end":58,"highlight_start":1,"text":"    requires forall|index: int| 0 <= index < digits.len()"},{"highlight_end":57,"highlight_start":1,"text":"        ==> #[trigger] digits[index] + 1 == pow2(width),"},{"highlight_end":82,"highlight_start":1,"text":"    ensures has_odd_factor(digit_value(digits, width) + 1, width * digits.len()),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":59,"highlight_start":1,"text":"    digit_prefix_full(digits, width, digits.len() as int);"},{"highlight_end":42,"highlight_start":1,"text":"    lemma_pow2_pos(width * digits.len());"},{"highlight_end":58,"highlight_start":1,"text":"    lemma_div_by_self(pow2(width * digits.len()) as int);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":48,"highlight_start":1,"text":"pub(crate) proof fn first_nonzero_digit_factor("},{"highlight_end":68,"highlight_start":1,"text":"    digits: Seq<nat>, width: nat, index: int, zeros: nat, odd: nat,"},{"highlight_end":2,"highlight_start":1,"text":")"},{"highlight_end":66,"highlight_start":1,"text":"    requires width > 0, 0 <= index < digits.len(), zeros < width,"},{"highlight_end":81,"highlight_start":1,"text":"        forall|lower: int| 0 <= lower < index ==> #[trigger] digits[lower] == 0,"},{"highlight_end":67,"highlight_start":1,"text":"        odd > 0, odd % 2 == 1, digits[index] == odd * pow2(zeros),"},{"highlight_end":86,"highlight_start":1,"text":"    ensures has_odd_factor(digit_value(digits, width), width * index as nat + zeros),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":45,"highlight_start":1,"text":"    digit_prefix_zero(digits, width, index);"},{"highlight_end":71,"highlight_start":1,"text":"    digit_prefix_split(digits, width, index + 1, digits.len() as int);"},{"highlight_end":44,"highlight_start":1,"text":"    digit_weight_step(width, index as nat);"},{"highlight_end":85,"highlight_start":1,"text":"    let upper = digit_value(digits.subrange(index + 1, digits.len() as int), width);"},{"highlight_end":39,"highlight_start":1,"text":"    let offset = width * index as nat;"},{"highlight_end":38,"highlight_start":1,"text":"    assert(digit_value(digits, width)"},{"highlight_end":69,"highlight_start":1,"text":"        == (odd * pow2(zeros) + pow2(width) * upper) * pow2(offset))"},{"highlight_end":29,"highlight_start":1,"text":"        by (nonlinear_arith)"},{"highlight_end":58,"highlight_start":1,"text":"        requires digit_prefix(digits, width, index) == 0,"},{"highlight_end":81,"highlight_start":1,"text":"            digit_value(digits, width) == digit_prefix(digits, width, index + 1)"},{"highlight_end":65,"highlight_start":1,"text":"                + digit_weight(width, index as nat + 1) * upper,"},{"highlight_end":89,"highlight_start":1,"text":"            digit_prefix(digits, width, index + 1) == digit_prefix(digits, width, index)"},{"highlight_end":69,"highlight_start":1,"text":"                + digits[index] * digit_weight(width, index as nat),"},{"highlight_end":99,"highlight_start":1,"text":"            digits[index] == odd * pow2(zeros), digit_weight(width, index as nat) == pow2(offset),"},{"highlight_end":102,"highlight_start":1,"text":"            digit_weight(width, index as nat + 1) == digit_weight(width, index as nat) * pow2(width);"},{"highlight_end":72,"highlight_start":1,"text":"    upper_digits_preserve_odd_factor(odd, zeros, width, upper, offset);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":51,"highlight_start":1,"text":"pub(crate) proof fn first_nonmaximal_digit_factor("},{"highlight_end":67,"highlight_start":1,"text":"    digits: Seq<nat>, width: nat, index: int, ones: nat, odd: nat,"},{"highlight_end":2,"highlight_start":1,"text":")"},{"highlight_end":66,"highlight_start":1,"text":"    requires width > 0, 0 <= index < digits.len(), ones <= width,"},{"highlight_end":95,"highlight_start":1,"text":"        forall|lower: int| 0 <= lower < index ==> #[trigger] digits[lower] + 1 == pow2(width),"},{"highlight_end":41,"highlight_start":1,"text":"        digits[index] + 1 < pow2(width),"},{"highlight_end":70,"highlight_start":1,"text":"        odd > 0, odd % 2 == 1, digits[index] + 1 == odd * pow2(ones),"},{"highlight_end":89,"highlight_start":1,"text":"    ensures has_odd_factor(digit_value(digits, width) + 1, width * index as nat + ones),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":27,"highlight_start":1,"text":"    lemma_pow2_pos(width);"},{"highlight_end":23,"highlight_start":1,"text":"    if ones == width {"},{"highlight_end":43,"highlight_start":1,"text":"        assert(false) by (nonlinear_arith)"},{"highlight_end":61,"highlight_start":1,"text":"            requires digits[index] + 1 == odd * pow2(width),"},{"highlight_end":75,"highlight_start":1,"text":"                digits[index] + 1 < pow2(width), odd > 0, pow2(width) > 0;"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":45,"highlight_start":1,"text":"    digit_prefix_full(digits, width, index);"},{"highlight_end":71,"highlight_start":1,"text":"    digit_prefix_split(digits, width, index + 1, digits.len() as int);"},{"highlight_end":44,"highlight_start":1,"text":"    digit_weight_step(width, index as nat);"},{"highlight_end":85,"highlight_start":1,"text":"    let upper = digit_value(digits.subrange(index + 1, digits.len() as int), width);"},{"highlight_end":39,"highlight_start":1,"text":"    let offset = width * index as nat;"},{"highlight_end":42,"highlight_start":1,"text":"    assert(digit_value(digits, width) + 1"},{"highlight_end":68,"highlight_start":1,"text":"        == (odd * pow2(ones) + pow2(width) * upper) * pow2(offset))"},{"highlight_end":29,"highlight_start":1,"text":"        by (nonlinear_arith)"},{"highlight_end":94,"highlight_start":1,"text":"        requires digit_prefix(digits, width, index) + 1 == digit_weight(width, index as nat),"},{"highlight_end":81,"highlight_start":1,"text":"            digit_value(digits, width) == digit_prefix(digits, width, index + 1)"},{"highlight_end":65,"highlight_start":1,"text":"                + digit_weight(width, index as nat + 1) * upper,"},{"highlight_end":89,"highlight_start":1,"text":"            digit_prefix(digits, width, index + 1) == digit_prefix(digits, width, index)"},{"highlight_end":69,"highlight_start":1,"text":"                + digits[index] * digit_weight(width, index as nat),"},{"highlight_end":102,"highlight_start":1,"text":"            digits[index] + 1 == odd * pow2(ones), digit_weight(width, index as nat) == pow2(offset),"},{"highlight_end":102,"highlight_start":1,"text":"            digit_weight(width, index as nat + 1) == digit_weight(width, index as nat) * pow2(width);"},{"highlight_end":71,"highlight_start":1,"text":"    upper_digits_preserve_odd_factor(odd, ones, width, upper, offset);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":82,"highlight_start":1,"text":"pub(crate) open spec fn normalized_digits(digits: Seq<nat>, width: nat) -> bool {"},{"highlight_end":94,"highlight_start":1,"text":"    (forall|index: int| 0 <= index < digits.len() ==> #[trigger] digits[index] < pow2(width))"},{"highlight_end":63,"highlight_start":1,"text":"        && (digits.len() == 0 || digits[digits.len() - 1] > 0)"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":76,"highlight_start":1,"text":"pub(crate) proof fn normalized_zero_iff_empty(digits: Seq<nat>, width: nat)"},{"highlight_end":47,"highlight_start":1,"text":"    requires normalized_digits(digits, width),"},{"highlight_end":68,"highlight_start":1,"text":"    ensures digit_value(digits, width) == 0 <==> digits.len() == 0,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":59,"highlight_start":1,"text":"    digit_prefix_zero(digits, width, digits.len() as int);"},{"highlight_end":61,"highlight_start":1,"text":"    if digits.len() > 0 && digit_value(digits, width) == 0 {"},{"highlight_end":47,"highlight_start":1,"text":"        assert(digits[digits.len() - 1] == 0);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":93,"highlight_start":1,"text":"pub(crate) proof fn normalized_digit_bit_length(digits: Seq<nat>, width: nat, top_bits: nat)"},{"highlight_end":65,"highlight_start":1,"text":"    requires normalized_digits(digits, width), digits.len() > 0,"},{"highlight_end":84,"highlight_start":1,"text":"        crate::magnitude_model::has_bit_length(digits[digits.len() - 1], top_bits),"},{"highlight_end":79,"highlight_start":1,"text":"    ensures crate::magnitude_model::has_bit_length(digit_value(digits, width),"},{"highlight_end":57,"highlight_start":1,"text":"        width * ((digits.len() - 1) as nat) + top_bits),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":40,"highlight_start":1,"text":"    let last = digits.len() as int - 1;"},{"highlight_end":28,"highlight_start":1,"text":"    let top = digits[last];"},{"highlight_end":51,"highlight_start":1,"text":"    let lower = digit_prefix(digits, width, last);"},{"highlight_end":38,"highlight_start":1,"text":"    let offset = width * last as nat;"},{"highlight_end":49,"highlight_start":1,"text":"    let unit = digit_weight(width, last as nat);"},{"highlight_end":34,"highlight_start":1,"text":"    let bits = offset + top_bits;"},{"highlight_end":45,"highlight_start":1,"text":"    digit_prefix_bound(digits, width, last);"},{"highlight_end":28,"highlight_start":1,"text":"    lemma_pow2_pos(offset);"},{"highlight_end":52,"highlight_start":1,"text":"    lemma_pow2_adds(offset, (top_bits - 1) as nat);"},{"highlight_end":39,"highlight_start":1,"text":"    lemma_pow2_adds(offset, top_bits);"},{"highlight_end":65,"highlight_start":1,"text":"    assert(pow2((bits - 1) as nat) <= digit_value(digits, width)"},{"highlight_end":73,"highlight_start":1,"text":"        && digit_value(digits, width) < pow2(bits)) by (nonlinear_arith)"},{"highlight_end":46,"highlight_start":1,"text":"        requires unit > 0, 0 <= lower < unit,"},{"highlight_end":70,"highlight_start":1,"text":"            pow2((top_bits - 1) as nat) <= top, top < pow2(top_bits),"},{"highlight_end":62,"highlight_start":1,"text":"            digit_value(digits, width) == lower + top * unit,"},{"highlight_end":75,"highlight_start":1,"text":"            pow2((bits - 1) as nat) == unit * pow2((top_bits - 1) as nat),"},{"highlight_end":49,"highlight_start":1,"text":"            pow2(bits) == unit * pow2(top_bits);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":55,"highlight_start":1,"text":"pub(crate) proof fn zero_scan_determines_power_of_two("},{"highlight_end":79,"highlight_start":1,"text":"    digits: Seq<nat>, width: nat, index: int, zeros: nat, odd: nat, bits: nat,"},{"highlight_end":2,"highlight_start":1,"text":")"},{"highlight_end":66,"highlight_start":1,"text":"    requires width > 0, 0 <= index < digits.len(), zeros < width,"},{"highlight_end":81,"highlight_start":1,"text":"        forall|lower: int| 0 <= lower < index ==> #[trigger] digits[lower] == 0,"},{"highlight_end":67,"highlight_start":1,"text":"        odd > 0, odd % 2 == 1, digits[index] == odd * pow2(zeros),"},{"highlight_end":82,"highlight_start":1,"text":"        crate::magnitude_model::has_bit_length(digit_value(digits, width), bits),"},{"highlight_end":64,"highlight_start":1,"text":"    ensures (width * index as nat + zeros == (bits - 1) as nat)"},{"highlight_end":68,"highlight_start":1,"text":"        == (digit_value(digits, width) == pow2((bits - 1) as nat)),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":66,"highlight_start":1,"text":"    first_nonzero_digit_factor(digits, width, index, zeros, odd);"},{"highlight_end":46,"highlight_start":1,"text":"    let count = width * index as nat + zeros;"},{"highlight_end":44,"highlight_start":1,"text":"    let value = digit_value(digits, width);"},{"highlight_end":68,"highlight_start":1,"text":"    crate::bit_length_model::trailing_zeros_determine_power_of_two("},{"highlight_end":50,"highlight_start":1,"text":"        value, bits, count, value / pow2(count));"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":50,"highlight_start":1,"text":"pub(crate) proof fn one_scan_determines_all_ones("},{"highlight_end":78,"highlight_start":1,"text":"    digits: Seq<nat>, width: nat, index: int, ones: nat, odd: nat, bits: nat,"},{"highlight_end":2,"highlight_start":1,"text":")"},{"highlight_end":66,"highlight_start":1,"text":"    requires width > 0, 0 <= index < digits.len(), ones <= width,"},{"highlight_end":95,"highlight_start":1,"text":"        forall|lower: int| 0 <= lower < index ==> #[trigger] digits[lower] + 1 == pow2(width),"},{"highlight_end":41,"highlight_start":1,"text":"        digits[index] + 1 < pow2(width),"},{"highlight_end":70,"highlight_start":1,"text":"        odd > 0, odd % 2 == 1, digits[index] + 1 == odd * pow2(ones),"},{"highlight_end":82,"highlight_start":1,"text":"        crate::magnitude_model::has_bit_length(digit_value(digits, width), bits),"},{"highlight_end":50,"highlight_start":1,"text":"    ensures (width * index as nat + ones == bits)"},{"highlight_end":59,"highlight_start":1,"text":"        == (digit_value(digits, width) + 1 == pow2(bits)),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":68,"highlight_start":1,"text":"    first_nonmaximal_digit_factor(digits, width, index, ones, odd);"},{"highlight_end":45,"highlight_start":1,"text":"    let count = width * index as nat + ones;"},{"highlight_end":44,"highlight_start":1,"text":"    let value = digit_value(digits, width);"},{"highlight_end":63,"highlight_start":1,"text":"    crate::bit_length_model::trailing_ones_determine_all_ones("},{"highlight_end":56,"highlight_start":1,"text":"        value, bits, count, (value + 1) / pow2(count));"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":97,"highlight_start":1,"text":"pub(crate) proof fn full_digit_scan_determines_all_ones(digits: Seq<nat>, width: nat, bits: nat)"},{"highlight_end":58,"highlight_start":1,"text":"    requires forall|index: int| 0 <= index < digits.len()"},{"highlight_end":57,"highlight_start":1,"text":"        ==> #[trigger] digits[index] + 1 == pow2(width),"},{"highlight_end":82,"highlight_start":1,"text":"        crate::magnitude_model::has_bit_length(digit_value(digits, width), bits),"},{"highlight_end":94,"highlight_start":1,"text":"    ensures (width * digits.len() == bits) == (digit_value(digits, width) + 1 == pow2(bits)),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":43,"highlight_start":1,"text":"    all_full_digits_factor(digits, width);"},{"highlight_end":38,"highlight_start":1,"text":"    let count = width * digits.len();"},{"highlight_end":44,"highlight_start":1,"text":"    let value = digit_value(digits, width);"},{"highlight_end":63,"highlight_start":1,"text":"    crate::bit_length_model::trailing_ones_determine_all_ones("},{"highlight_end":56,"highlight_start":1,"text":"        value, bits, count, (value + 1) / pow2(count));"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":52,"highlight_start":1,"text":"pub(crate) proof fn u32_digit_bit_length(word: u32)"},{"highlight_end":12,"highlight_start":1,"text":"    ensures"},{"highlight_end":44,"highlight_start":1,"text":"        0 <= u32_leading_zeros(word) <= 32,"},{"highlight_end":54,"highlight_start":1,"text":"        word == 0 <==> u32_leading_zeros(word) == 32,"},{"highlight_end":89,"highlight_start":1,"text":"        word > 0 ==> has_bit_length(word as nat, (32 - u32_leading_zeros(word)) as nat),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":35,"highlight_start":1,"text":"    axiom_u32_leading_zeros(word);"},{"highlight_end":18,"highlight_start":1,"text":"    if word > 0 {"},{"highlight_end":45,"highlight_start":1,"text":"        let count = u32_leading_zeros(word);"},{"highlight_end":40,"highlight_start":1,"text":"        let bits = (32 - count) as nat;"},{"highlight_end":39,"highlight_start":1,"text":"        let low = (31 - count) as u32;"},{"highlight_end":43,"highlight_start":1,"text":"        lemma_pow2_pos((bits - 1) as nat);"},{"highlight_end":53,"highlight_start":1,"text":"        vstd::bits::lemma_u32_shr_is_div(word, low);"},{"highlight_end":50,"highlight_start":1,"text":"        assert((word >> low) > 0) by (bit_vector)"},{"highlight_end":51,"highlight_start":1,"text":"            requires (word >> low) & 1u32 != 0u32;"},{"highlight_end":45,"highlight_start":1,"text":"        let lower = pow2((bits - 1) as nat);"},{"highlight_end":62,"highlight_start":1,"text":"        lemma_fundamental_div_mod(word as int, lower as int);"},{"highlight_end":52,"highlight_start":1,"text":"        lemma_mod_bound(word as int, lower as int);"},{"highlight_end":51,"highlight_start":1,"text":"        assert(lower <= word) by (nonlinear_arith)"},{"highlight_end":57,"highlight_start":1,"text":"            requires lower > 0, word as nat / lower > 0,"},{"highlight_end":75,"highlight_start":1,"text":"                word as int == (word as int / lower as int) * lower as int"},{"highlight_end":50,"highlight_start":1,"text":"                    + word as int % lower as int,"},{"highlight_end":49,"highlight_start":1,"text":"                word as int % lower as int >= 0;"},{"highlight_end":24,"highlight_start":1,"text":"        if bits == 32 {"},{"highlight_end":27,"highlight_start":1,"text":"            lemma2_to64();"},{"highlight_end":17,"highlight_start":1,"text":"        } else {"},{"highlight_end":36,"highlight_start":1,"text":"            let high = bits as u32;"},{"highlight_end":58,"highlight_start":1,"text":"            vstd::bits::lemma_u32_shr_is_div(word, high);"},{"highlight_end":39,"highlight_start":1,"text":"            assert(word >> high == 0);"},{"highlight_end":36,"highlight_start":1,"text":"            let upper = pow2(bits);"},{"highlight_end":34,"highlight_start":1,"text":"            lemma_pow2_pos(bits);"},{"highlight_end":66,"highlight_start":1,"text":"            lemma_fundamental_div_mod(word as int, upper as int);"},{"highlight_end":56,"highlight_start":1,"text":"            lemma_mod_bound(word as int, upper as int);"},{"highlight_end":10,"highlight_start":1,"text":"        }"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":2,"highlight_start":1,"text":"}"}]}},"file_name":"/home/tim/Documents/GitHub/workspace/csgrs/target/scalar-evaluation-candidate/source/crates/hyperreal/verification/digit_scan_model.rs","is_primary":true,"label":null,"line_end":377,"line_start":8,"suggested_replacement":null,"suggestion_applicability":null,"text":[{"highlight_end":9,"highlight_start":1,"text":"verus! {"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":70,"highlight_start":1,"text":"pub(crate) open spec fn digit_weight(width: nat, index: nat) -> nat {"},{"highlight_end":24,"highlight_start":1,"text":"    pow2(width * index)"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":87,"highlight_start":1,"text":"pub(crate) open spec fn digit_prefix(digits: Seq<nat>, width: nat, length: int) -> nat"},{"highlight_end":44,"highlight_start":1,"text":"    recommends 0 <= length <= digits.len(),"},{"highlight_end":22,"highlight_start":1,"text":"    decreases length,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":32,"highlight_start":1,"text":"    if length <= 0 { 0 } else {"},{"highlight_end":48,"highlight_start":1,"text":"        digit_prefix(digits, width, length - 1)"},{"highlight_end":76,"highlight_start":1,"text":"            + digits[length - 1] * digit_weight(width, (length - 1) as nat)"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":75,"highlight_start":1,"text":"pub(crate) open spec fn digit_value(digits: Seq<nat>, width: nat) -> nat {"},{"highlight_end":53,"highlight_start":1,"text":"    digit_prefix(digits, width, digits.len() as int)"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":76,"highlight_start":1,"text":"pub(crate) open spec fn has_odd_factor(value: nat, exponent: nat) -> bool {"},{"highlight_end":31,"highlight_start":1,"text":"    let unit = pow2(exponent);"},{"highlight_end":33,"highlight_start":1,"text":"    let quotient = value / unit;"},{"highlight_end":66,"highlight_start":1,"text":"    quotient > 0 && quotient % 2 == 1 && value == quotient * unit"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":62,"highlight_start":1,"text":"pub(crate) proof fn digit_weight_step(width: nat, index: nat)"},{"highlight_end":44,"highlight_start":1,"text":"    ensures digit_weight(width, index) > 0,"},{"highlight_end":84,"highlight_start":1,"text":"        digit_weight(width, index + 1) == digit_weight(width, index) * pow2(width),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":35,"highlight_start":1,"text":"    lemma_pow2_pos(width * index);"},{"highlight_end":43,"highlight_start":1,"text":"    lemma_pow2_adds(width * index, width);"},{"highlight_end":79,"highlight_start":1,"text":"    assert(width * (index + 1) == width * index + width) by (nonlinear_arith);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":72,"highlight_start":1,"text":"pub(crate) proof fn digit_weight_add(width: nat, left: nat, right: nat)"},{"highlight_end":46,"highlight_start":1,"text":"    ensures digit_weight(width, left + right)"},{"highlight_end":67,"highlight_start":1,"text":"        == digit_weight(width, left) * digit_weight(width, right),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":50,"highlight_start":1,"text":"    lemma_pow2_adds(width * left, width * right);"},{"highlight_end":89,"highlight_start":1,"text":"    assert(width * (left + right) == width * left + width * right) by (nonlinear_arith);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":82,"highlight_start":1,"text":"pub(crate) proof fn digit_prefix_bound(digits: Seq<nat>, width: nat, length: int)"},{"highlight_end":42,"highlight_start":1,"text":"    requires 0 <= length <= digits.len(),"},{"highlight_end":91,"highlight_start":1,"text":"        forall|index: int| 0 <= index < length ==> #[trigger] digits[index] < pow2(width),"},{"highlight_end":86,"highlight_start":1,"text":"    ensures digit_prefix(digits, width, length) < digit_weight(width, length as nat),"},{"highlight_end":22,"highlight_start":1,"text":"    decreases length,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":21,"highlight_start":1,"text":"    if length == 0 {"},{"highlight_end":23,"highlight_start":1,"text":"        lemma2_to64();"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":55,"highlight_start":1,"text":"        digit_prefix_bound(digits, width, length - 1);"},{"highlight_end":55,"highlight_start":1,"text":"        digit_weight_step(width, (length - 1) as nat);"},{"highlight_end":89,"highlight_start":1,"text":"        assert(digit_prefix(digits, width, length) < digit_weight(width, length as nat))"},{"highlight_end":33,"highlight_start":1,"text":"            by (nonlinear_arith)"},{"highlight_end":57,"highlight_start":1,"text":"            requires digit_prefix(digits, width, length)"},{"highlight_end":63,"highlight_start":1,"text":"                    == digit_prefix(digits, width, length - 1)"},{"highlight_end":89,"highlight_start":1,"text":"                        + digits[length - 1] * digit_weight(width, (length - 1) as nat),"},{"highlight_end":100,"highlight_start":1,"text":"                digit_prefix(digits, width, length - 1) < digit_weight(width, (length - 1) as nat),"},{"highlight_end":55,"highlight_start":1,"text":"                0 <= digits[length - 1] < pow2(width),"},{"highlight_end":62,"highlight_start":1,"text":"                digit_weight(width, (length - 1) as nat) > 0,"},{"highlight_end":110,"highlight_start":1,"text":"                digit_weight(width, length as nat) == digit_weight(width, (length - 1) as nat) * pow2(width);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":97,"highlight_start":1,"text":"pub(crate) proof fn digit_prefix_equal(left: Seq<nat>, right: Seq<nat>, width: nat, length: int)"},{"highlight_end":63,"highlight_start":1,"text":"    requires 0 <= length <= left.len(), length <= right.len(),"},{"highlight_end":91,"highlight_start":1,"text":"        forall|index: int| 0 <= index < length ==> #[trigger] left[index] == right[index],"},{"highlight_end":85,"highlight_start":1,"text":"    ensures digit_prefix(left, width, length) == digit_prefix(right, width, length),"},{"highlight_end":22,"highlight_start":1,"text":"    decreases length,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":20,"highlight_start":1,"text":"    if length > 0 {"},{"highlight_end":60,"highlight_start":1,"text":"        digit_prefix_equal(left, right, width, length - 1);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":91,"highlight_start":1,"text":"pub(crate) proof fn digit_prefix_split(digits: Seq<nat>, width: nat, start: int, end: int)"},{"highlight_end":48,"highlight_start":1,"text":"    requires 0 <= start <= end <= digits.len(),"},{"highlight_end":83,"highlight_start":1,"text":"    ensures digit_prefix(digits, width, end) == digit_prefix(digits, width, start)"},{"highlight_end":95,"highlight_start":1,"text":"        + digit_weight(width, start as nat) * digit_value(digits.subrange(start, end), width),"},{"highlight_end":27,"highlight_start":1,"text":"    decreases end - start,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":22,"highlight_start":1,"text":"    if start == end {"},{"highlight_end":70,"highlight_start":1,"text":"        assert(digit_value(digits.subrange(start, end), width) == 0);"},{"highlight_end":84,"highlight_start":1,"text":"        assert(digit_weight(width, start as nat) * 0nat == 0) by (nonlinear_arith);"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":59,"highlight_start":1,"text":"        digit_prefix_split(digits, width, start, end - 1);"},{"highlight_end":48,"highlight_start":1,"text":"        let tail = digits.subrange(start, end);"},{"highlight_end":56,"highlight_start":1,"text":"        let previous = digits.subrange(start, end - 1);"},{"highlight_end":68,"highlight_start":1,"text":"        digit_prefix_equal(tail, previous, width, end - start - 1);"},{"highlight_end":73,"highlight_start":1,"text":"        digit_weight_add(width, start as nat, (end - start - 1) as nat);"},{"highlight_end":86,"highlight_start":1,"text":"        assert(digit_prefix(digits, width, end) == digit_prefix(digits, width, start)"},{"highlight_end":97,"highlight_start":1,"text":"            + digit_weight(width, start as nat) * digit_value(tail, width)) by (nonlinear_arith)"},{"highlight_end":94,"highlight_start":1,"text":"            requires digit_prefix(digits, width, end) == digit_prefix(digits, width, end - 1)"},{"highlight_end":79,"highlight_start":1,"text":"                    + digits[end - 1] * digit_weight(width, (end - 1) as nat),"},{"highlight_end":91,"highlight_start":1,"text":"                digit_prefix(digits, width, end - 1) == digit_prefix(digits, width, start)"},{"highlight_end":88,"highlight_start":1,"text":"                    + digit_weight(width, start as nat) * digit_value(previous, width),"},{"highlight_end":73,"highlight_start":1,"text":"                digit_value(tail, width) == digit_value(previous, width)"},{"highlight_end":87,"highlight_start":1,"text":"                    + digits[end - 1] * digit_weight(width, (end - start - 1) as nat),"},{"highlight_end":91,"highlight_start":1,"text":"                digit_weight(width, (end - 1) as nat) == digit_weight(width, start as nat)"},{"highlight_end":69,"highlight_start":1,"text":"                    * digit_weight(width, (end - start - 1) as nat);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":81,"highlight_start":1,"text":"pub(crate) proof fn digit_prefix_zero(digits: Seq<nat>, width: nat, length: int)"},{"highlight_end":42,"highlight_start":1,"text":"    requires 0 <= length <= digits.len(),"},{"highlight_end":58,"highlight_start":1,"text":"    ensures digit_prefix(digits, width, length) == 0 <==>"},{"highlight_end":82,"highlight_start":1,"text":"        forall|index: int| 0 <= index < length ==> #[trigger] digits[index] == 0,"},{"highlight_end":22,"highlight_start":1,"text":"    decreases length,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":20,"highlight_start":1,"text":"    if length > 0 {"},{"highlight_end":54,"highlight_start":1,"text":"        digit_prefix_zero(digits, width, length - 1);"},{"highlight_end":55,"highlight_start":1,"text":"        digit_weight_step(width, (length - 1) as nat);"},{"highlight_end":61,"highlight_start":1,"text":"        assert(digit_prefix(digits, width, length) == 0 <==>"},{"highlight_end":85,"highlight_start":1,"text":"            digit_prefix(digits, width, length - 1) == 0 && digits[length - 1] == 0)"},{"highlight_end":33,"highlight_start":1,"text":"            by (nonlinear_arith)"},{"highlight_end":100,"highlight_start":1,"text":"            requires digit_prefix(digits, width, length) == digit_prefix(digits, width, length - 1)"},{"highlight_end":85,"highlight_start":1,"text":"                    + digits[length - 1] * digit_weight(width, (length - 1) as nat),"},{"highlight_end":87,"highlight_start":1,"text":"                digit_prefix(digits, width, length - 1) >= 0, digits[length - 1] >= 0,"},{"highlight_end":62,"highlight_start":1,"text":"                digit_weight(width, (length - 1) as nat) > 0;"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":81,"highlight_start":1,"text":"pub(crate) proof fn digit_prefix_full(digits: Seq<nat>, width: nat, length: int)"},{"highlight_end":42,"highlight_start":1,"text":"    requires 0 <= length <= digits.len(),"},{"highlight_end":96,"highlight_start":1,"text":"        forall|index: int| 0 <= index < length ==> #[trigger] digits[index] + 1 == pow2(width),"},{"highlight_end":91,"highlight_start":1,"text":"    ensures digit_prefix(digits, width, length) + 1 == digit_weight(width, length as nat),"},{"highlight_end":22,"highlight_start":1,"text":"    decreases length,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":21,"highlight_start":1,"text":"    if length == 0 {"},{"highlight_end":23,"highlight_start":1,"text":"        lemma2_to64();"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":54,"highlight_start":1,"text":"        digit_prefix_full(digits, width, length - 1);"},{"highlight_end":55,"highlight_start":1,"text":"        digit_weight_step(width, (length - 1) as nat);"},{"highlight_end":94,"highlight_start":1,"text":"        assert(digit_prefix(digits, width, length) + 1 == digit_weight(width, length as nat))"},{"highlight_end":33,"highlight_start":1,"text":"            by (nonlinear_arith)"},{"highlight_end":100,"highlight_start":1,"text":"            requires digit_prefix(digits, width, length) == digit_prefix(digits, width, length - 1)"},{"highlight_end":85,"highlight_start":1,"text":"                    + digits[length - 1] * digit_weight(width, (length - 1) as nat),"},{"highlight_end":105,"highlight_start":1,"text":"                digit_prefix(digits, width, length - 1) + 1 == digit_weight(width, (length - 1) as nat),"},{"highlight_end":55,"highlight_start":1,"text":"                digits[length - 1] + 1 == pow2(width),"},{"highlight_end":110,"highlight_start":1,"text":"                digit_weight(width, length as nat) == digit_weight(width, (length - 1) as nat) * pow2(width);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":54,"highlight_start":1,"text":"pub(crate) proof fn upper_digits_preserve_odd_factor("},{"highlight_end":63,"highlight_start":1,"text":"    odd: nat, shift: nat, width: nat, upper: nat, offset: nat,"},{"highlight_end":2,"highlight_start":1,"text":")"},{"highlight_end":51,"highlight_start":1,"text":"    requires odd > 0, odd % 2 == 1, shift < width,"},{"highlight_end":102,"highlight_start":1,"text":"    ensures has_odd_factor((odd * pow2(shift) + pow2(width) * upper) * pow2(offset), offset + shift),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":34,"highlight_start":1,"text":"    let lower_unit = pow2(shift);"},{"highlight_end":46,"highlight_start":1,"text":"    let other = pow2((width - shift) as nat);"},{"highlight_end":37,"highlight_start":1,"text":"    let unit = pow2(offset + shift);"},{"highlight_end":40,"highlight_start":1,"text":"    let quotient = odd + other * upper;"},{"highlight_end":73,"highlight_start":1,"text":"    let value = (odd * lower_unit + pow2(width) * upper) * pow2(offset);"},{"highlight_end":44,"highlight_start":1,"text":"    lemma_pow2_pos((width - shift) as nat);"},{"highlight_end":36,"highlight_start":1,"text":"    lemma_pow2_pos(offset + shift);"},{"highlight_end":52,"highlight_start":1,"text":"    lemma_pow2_adds(shift, (width - shift) as nat);"},{"highlight_end":36,"highlight_start":1,"text":"    lemma_pow2_adds(offset, shift);"},{"highlight_end":58,"highlight_start":1,"text":"    assert(value == quotient * unit) by (nonlinear_arith)"},{"highlight_end":50,"highlight_start":1,"text":"        requires quotient == odd + other * upper,"},{"highlight_end":78,"highlight_start":1,"text":"            value == (odd * lower_unit + pow2(width) * upper) * pow2(offset),"},{"highlight_end":82,"highlight_start":1,"text":"            pow2(width) == lower_unit * other, unit == pow2(offset) * lower_unit;"},{"highlight_end":46,"highlight_start":1,"text":"    assert(quotient > 0) by (nonlinear_arith)"},{"highlight_end":82,"highlight_start":1,"text":"        requires quotient == odd + other * upper, odd > 0, other > 0, upper >= 0;"},{"highlight_end":47,"highlight_start":1,"text":"    lemma_pow2_unfold((width - shift) as nat);"},{"highlight_end":49,"highlight_start":1,"text":"    let half = pow2((width - shift - 1) as nat);"},{"highlight_end":70,"highlight_start":1,"text":"    assert(quotient == 2 * (half * upper) + odd) by (nonlinear_arith)"},{"highlight_end":69,"highlight_start":1,"text":"        requires quotient == odd + other * upper, other == 2 * half;"},{"highlight_end":70,"highlight_start":1,"text":"    lemma_mod_multiples_vanish((half * upper) as int, odd as int, 2);"},{"highlight_end":91,"highlight_start":1,"text":"    lemma_fundamental_div_mod_converse_div(value as int, unit as int, quotient as int, 0);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":86,"highlight_start":1,"text":"// This is the None branch of a first-nonmaximal-digit scan, including empty storage."},{"highlight_end":73,"highlight_start":1,"text":"pub(crate) proof fn all_full_digits_factor(digits: Seq<nat>, width: nat)"},{"highlight_end":58,"highlight_start":1,"text":"    requires forall|index: int| 0 <= index < digits.len()"},{"highlight_end":57,"highlight_start":1,"text":"        ==> #[trigger] digits[index] + 1 == pow2(width),"},{"highlight_end":82,"highlight_start":1,"text":"    ensures has_odd_factor(digit_value(digits, width) + 1, width * digits.len()),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":59,"highlight_start":1,"text":"    digit_prefix_full(digits, width, digits.len() as int);"},{"highlight_end":42,"highlight_start":1,"text":"    lemma_pow2_pos(width * digits.len());"},{"highlight_end":58,"highlight_start":1,"text":"    lemma_div_by_self(pow2(width * digits.len()) as int);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":48,"highlight_start":1,"text":"pub(crate) proof fn first_nonzero_digit_factor("},{"highlight_end":68,"highlight_start":1,"text":"    digits: Seq<nat>, width: nat, index: int, zeros: nat, odd: nat,"},{"highlight_end":2,"highlight_start":1,"text":")"},{"highlight_end":66,"highlight_start":1,"text":"    requires width > 0, 0 <= index < digits.len(), zeros < width,"},{"highlight_end":81,"highlight_start":1,"text":"        forall|lower: int| 0 <= lower < index ==> #[trigger] digits[lower] == 0,"},{"highlight_end":67,"highlight_start":1,"text":"        odd > 0, odd % 2 == 1, digits[index] == od