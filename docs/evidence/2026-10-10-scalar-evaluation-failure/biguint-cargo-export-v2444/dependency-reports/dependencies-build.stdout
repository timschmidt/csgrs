ight_start":1,"text":"    lemma_fundamental_div_mod(shift as int, 64);"},{"highlight_end":46,"highlight_start":1,"text":"    lemma_pow2_adds(64 * words, bits as nat);"},{"highlight_end":24,"highlight_start":1,"text":"    weight_step(words);"},{"highlight_end":31,"highlight_start":1,"text":"    weight_add(offset, words);"},{"highlight_end":35,"highlight_start":1,"text":"    weight_add(offset + 1, words);"},{"highlight_end":72,"highlight_start":1,"text":"    assert(weight(offset + words) <= value(source) * pow2(shift as nat)"},{"highlight_end":59,"highlight_start":1,"text":"        < weight(offset + words + 1)) by (nonlinear_arith)"},{"highlight_end":80,"highlight_start":1,"text":"        requires weight(offset) <= value(source) * factor < weight(offset + 1),"},{"highlight_end":77,"highlight_start":1,"text":"            weight(words) > 0, pow2(shift as nat) == weight(words) * factor,"},{"highlight_end":70,"highlight_start":1,"text":"            weight(offset + words) == weight(offset) * weight(words),"},{"highlight_end":78,"highlight_start":1,"text":"            weight(offset + words + 1) == weight(offset + 1) * weight(words);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":88,"highlight_start":1,"text":"pub(crate) proof fn aligned_value(source: Seq<u64>, last: int, shift: u64, length: nat)"},{"highlight_end":57,"highlight_start":1,"text":"    requires 0 <= last < source.len(), source[last] > 0,"},{"highlight_end":90,"highlight_start":1,"text":"        forall|index: int| last < index < source.len() ==> #[trigger] source[index] == 0,"},{"highlight_end":43,"highlight_start":1,"text":"        ({ let bits = (shift % 64) as u32;"},{"highlight_end":100,"highlight_start":1,"text":"           last + (if bits > 0 && source[last] >> ((64 - bits) as u32) != 0 { 1int } else { 0int })"},{"highlight_end":41,"highlight_start":1,"text":"               + shift / 64 < length }),"},{"highlight_end":85,"highlight_start":1,"text":"    ensures value(aligned(source, (shift / 64) as nat, (shift % 64) as u32, length))"},{"highlight_end":47,"highlight_start":1,"text":"        == value(source) * pow2(shift as nat),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":37,"highlight_start":1,"text":"    let words = (shift / 64) as nat;"},{"highlight_end":36,"highlight_start":1,"text":"    let bits = (shift % 64) as u32;"},{"highlight_end":70,"highlight_start":1,"text":"    let high = bits > 0 && source[last] >> ((64 - bits) as u32) != 0;"},{"highlight_end":70,"highlight_start":1,"text":"    let end = (last + if high { 1int } else { 0int }) as nat + words;"},{"highlight_end":69,"highlight_start":1,"text":"    let padded = Seq::new(length, |index: int| limb(source, index));"},{"highlight_end":44,"highlight_start":1,"text":"    prefix_equal(padded, source, last + 1);"},{"highlight_end":63,"highlight_start":1,"text":"    extend_prefix_zero(source, last + 1, source.len() as int);"},{"highlight_end":57,"highlight_start":1,"text":"    extend_prefix_zero(padded, last + 1, length as int);"},{"highlight_end":72,"highlight_start":1,"text":"    extend_prefix_zero(padded, (length - words) as int, length as int);"},{"highlight_end":50,"highlight_start":1,"text":"    let moved = word_left_shifted(padded, words);"},{"highlight_end":42,"highlight_start":1,"text":"    word_left_shift_value(padded, words);"},{"highlight_end":55,"highlight_start":1,"text":"    let output = aligned(source, words, bits, length);"},{"highlight_end":36,"highlight_start":1,"text":"    let factor = pow2(bits as nat);"},{"highlight_end":42,"highlight_start":1,"text":"    let other = pow2((64 - bits) as nat);"},{"highlight_end":41,"highlight_start":1,"text":"    shifted_extent(source, last, shift);"},{"highlight_end":38,"highlight_start":1,"text":"    weight_monotone(end + 1, length);"},{"highlight_end":49,"highlight_start":1,"text":"    lemma_fundamental_div_mod(shift as int, 64);"},{"highlight_end":46,"highlight