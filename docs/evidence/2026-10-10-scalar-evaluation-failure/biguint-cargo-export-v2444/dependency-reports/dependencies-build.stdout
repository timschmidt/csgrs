hlight_end":77,"highlight_start":1,"text":"            low == factor * ((low as nat) / factor) + (low as nat) % factor,"},{"highlight_end":73,"highlight_start":1,"text":"            bottom == (high as nat) % factor, factor * other == radix();"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":78,"highlight_start":1,"text":"pub(crate) proof fn extend_prefix_zero(words: Seq<u64>, start: int, end: int)"},{"highlight_end":47,"highlight_start":1,"text":"    requires 0 <= start <= end <= words.len(),"},{"highlight_end":82,"highlight_start":1,"text":"        forall|index: int| start <= index < end ==> #[trigger] words[index] == 0,"},{"highlight_end":56,"highlight_start":1,"text":"    ensures prefix(words, start) == prefix(words, end),"},{"highlight_end":27,"highlight_start":1,"text":"    decreases end - start,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":21,"highlight_start":1,"text":"    if start < end {"},{"highlight_end":51,"highlight_start":1,"text":"        extend_prefix_zero(words, start, end - 1);"},{"highlight_end":63,"highlight_start":1,"text":"        assert(words[end - 1] * weight((end - 1) as nat) == 0)"},{"highlight_end":63,"highlight_start":1,"text":"            by (nonlinear_arith) requires words[end - 1] == 0;"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":64,"highlight_start":1,"text":"spec fn word_shifted(words: Seq<u64>, shift: nat) -> Seq<u64> {"},{"highlight_end":67,"highlight_start":1,"text":"    Seq::new(words.len(), |index: int| limb(words, index + shift))"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":71,"highlight_start":1,"text":"spec fn shifted_limb(words: Seq<u64>, index: int, shift: u32) -> u64 {"},{"highlight_end":41,"highlight_start":1,"text":"    if shift == 0 { limb(words, index) }"},{"highlight_end":86,"highlight_start":1,"text":"    else { (limb(words, index) >> shift) | (limb(words, index + 1) << (64 - shift)) }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":55,"highlight_start":1,"text":"proof fn word_shift_value(words: Seq<u64>, shift: nat)"},{"highlight_end":34,"highlight_start":1,"text":"    requires shift < words.len(),"},{"highlight_end":79,"highlight_start":1,"text":"    ensures value(word_shifted(words, shift)) == value(words) / weight(shift),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":46,"highlight_start":1,"text":"    let shifted = word_shifted(words, shift);"},{"highlight_end":65,"highlight_start":1,"text":"    let tail = words.subrange(shift as int, words.len() as int);"},{"highlight_end":52,"highlight_start":1,"text":"    prefix_equal(shifted, tail, tail.len() as int);"},{"highlight_end":74,"highlight_start":1,"text":"    extend_prefix_zero(shifted, tail.len() as int, shifted.len() as int);"},{"highlight_end":59,"highlight_start":1,"text":"    prefix_split(words, shift as int, words.len() as int);"},{"highlight_end":39,"highlight_start":1,"text":"    prefix_bound(words, shift as int);"},{"highlight_end":24,"highlight_start":1,"text":"    weight_step(shift);"},{"highlight_end":86,"highlight_start":1,"text":"    assert(value(words) == value(tail) * weight(shift) + prefix(words, shift as int))"},{"highlight_end":29,"highlight_start":1,"text":"        by (nonlinear_arith)"},{"highlight_end":92,"highlight_start":1,"text":"        requires value(words) == prefix(words, shift as int) + weight(shift) * value(tail);"},{"highlight_end":86,"highlight_start":1,"text":"    lemma_fundamental_div_mod_converse_div(value(words) as int, weight(shift) as int,"},{"highlight_end":65,"highlight_start":1,"text":"        value(tail) as int, prefix(words, shift as int) as int);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":90,"highlight_start":1,"text":"proof fn shift_prefix_carry(source: Seq<u64>, output: Seq<u64>, factor: nat, length: int)"},{"highlight_end":84,"highlight_start":1,"text":"    requires factor > 0, source.len() == output.len(), 0 <= length <= source.len(),"},{"highlight_end":51,"highlight_start":1,"text":"        forall|index: int| 0 <= index < length ==>"},{"highlight_end":80,"highlight_start":1,"text":"            #[trigger] output[index] * factor + (source[index] as nat) % factor"},{"highlight_end":90,"highlight_start":1,"text":"                == source[index] + ((limb(source, index + 1) as nat) % factor) * radix(),"},{"highlight_end":80,"highlight_start":1,"text":"    ensures prefix(output, length) * factor + (limb(source, 0) as nat) % factor"},{"highlight_end":102,"highlight_start":1,"text":"        == prefix(source, length) + ((limb(source, length) as nat) % factor) * weight(length as nat),"},{"highlight_end":22,"highlight_start":1,"text":"    decreases length,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":21,"highlight_start":1,"text":"    if length == 0 {"},{"highlight_end":23,"highlight_start":1,"text":"        lemma2_to64();"},{"highlight_end":59,"highlight_start":1,"text":"        let remainder = (limb(source, 0) as nat) % factor;"},{"highlight_end":69,"highlight_start":1,"text":"        assert(prefix(output, 0) * factor == 0) by (nonlinear_arith)"},{"highlight_end":45,"highlight_start":1,"text":"            requires prefix(output, 0) == 0;"},{"highlight_end":72,"highlight_start":1,"text":"        assert(remainder * weight(0) == remainder) by (nonlinear_arith)"},{"highlight_end":37,"highlight_start":1,"text":"            requires weight(0) == 1;"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":64,"highlight_start":1,"text":"        shift_prefix_carry(source, output, factor, length - 1);"},{"highlight_end":42,"highlight_start":1,"text":"        weight_step((length - 1) as nat);"},{"highlight_end":45,"highlight_start":1,"text":"        let w = weight((length - 1) as nat);"},{"highlight_end":44,"highlight_start":1,"text":"        let next_w = weight(length as nat);"},{"highlight_end":58,"highlight_start":1,"text":"        let carry = (source[length - 1] as nat) % factor;"},{"highlight_end":65,"highlight_start":1,"text":"        let next_carry = (limb(source, length) as nat) % factor;"},{"highlight_end":59,"highlight_start":1,"text":"        let remainder = (limb(source, 0) as nat) % factor;"},{"highlight_end":53,"highlight_start":1,"text":"        let old_output = prefix(output, length - 1);"},{"highlight_end":53,"highlight_start":1,"text":"        let old_source = prefix(source, length - 1);"},{"highlight_end":59,"highlight_start":1,"text":"        assert(prefix(output, length) * factor + remainder"},{"highlight_end":82,"highlight_start":1,"text":"            == prefix(source, length) + next_carry * next_w) by (nonlinear_arith)"},{"highlight_end":80,"highlight_start":1,"text":"            requires old_output * factor + remainder == old_source + carry * w,"},{"highlight_end":98,"highlight_start":1,"text":"                output[length - 1] * factor + carry == source[length - 1] + next_carry * radix(),"},{"highlight_end":39,"highlight_start":1,"text":"                next_w == w * radix(),"},{"highlight_end":79,"highlight_start":1,"text":"                prefix(output, length) == old_output + output[length - 1] * w,"},{"highlight_end":79,"highlight_start":1,"text":"                prefix(source, length) == old_source + source[length - 1] * w;"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":70,"highlight_start":1,"text":"proof fn shift_value(source: Seq<u64>, output: Seq<u64>, factor: nat)"},{"highlight_end":55,"highlight_start":1,"text":"    requires factor > 0, source.len() == output.len(),"},{"highlight_end":57,"highlight_start":1,"text":"        forall|index: int| 0 <= index < source.len() ==>"},{"highlight_end":80,"highlight_start":1,"text":"            #[trigger] output[index] * factor + (source[index] as nat) % factor"},{"highlight_end":90,"highlight_start":1,"text":"                == source[index] + ((limb(source, index + 1) as nat) % factor) * radix(),"},{"highlight_end":53,"highlight_start":1,"text":"    ensures value(output) == value(source) / factor,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":69,"highlight_start":1,"text":"    shift_prefix_carry(source, output, factor, source.len() as int);"},{"highlight_end":32,"highlight_start":1,"text":"    lemma_small_mod(0, factor);"},{"highlight_end":69,"highlight_start":1,"text":"    let carry = (limb(source, source.len() as int) as nat) % factor;"},{"highlight_end":88,"highlight_start":1,"text":"    assert(carry * weight(source.len()) == 0) by (nonlinear_arith) requires carry == 0;"},{"highlight_end":80,"highlight_start":1,"text":"    lemma_fundamental_div_mod_converse_div(value(source) as int, factor as int,"},{"highlight_end":75,"highlight_start":1,"text":"        value(output) as int, ((limb(source, 0) as nat) % factor) as int);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":59,"highlight_start":1,"text":"proof fn first_nonzero_factor(words: Seq<u64>, index: int)"},{"highlight_end":57,"highlight_start":1,"text":"    requires 0 <= index < words.len(), words[index] > 0,"},{"highlight_end":80,"highlight_start":1,"text":"        forall|lower: int| 0 <= lower < index ==> #[trigger] words[lower] == 0,"},{"highlight_end":15,"highlight_start":1,"text":"    ensures ({"},{"highlight_end":81,"highlight_start":1,"text":"        let shift = 64 * index as nat + u64_trailing_zeros(words[index]) as nat;"},{"highlight_end":33,"highlight_start":1,"text":"        shift < 64 * words.len()"},{"highlight_end":46,"highlight_start":1,"text":"            && value(words) / pow2(shift) > 0"},{"highlight_end":53,"highlight_start":1,"text":"            && (value(words) / pow2(shift)) % 2 == 1"},{"highlight_end":74,"highlight_start":1,"text":"            && value(words) == (value(words) / pow2(shift)) * pow2(shift)"},{"highlight_end":8,"highlight_start":1,"text":"    }),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":31,"highlight_start":1,"text":"    prefix_zero(words, index);"},{"highlight_end":56,"highlight_start":1,"text":"    prefix_split(words, index + 1, words.len() as int);"},{"highlight_end":31,"highlight_start":1,"text":"    weight_step(index as nat);"},{"highlight_end":29,"highlight_start":1,"text":"    let word = words[index];"},{"highlight_end":49,"highlight_start":1,"text":"    super::gcd::trailing_zeros_factor_u64(word);"},{"highlight_end":49,"highlight_start":1,"text":"    let shift = u64_trailing_zeros(word) as nat;"},{"highlight_end":57,"highlight_start":1,"text":"    let odd = (word >> u64_trailing_zeros(word)) as nat;"},{"highlight_end":70,"highlight_start":1,"text":"    let upper = value(words.subrange(index + 1, words.len() as int));"},{"highlight_end":43,"highlight_start":1,"text":"    let other = pow2((64 - shift) as nat);"},{"highlight_end":40,"highlight_start":1,"text":"    let quotient = odd + other * upper;"},{"highlight_end":48,"highlight_start":1,"text":"    let full_shift = 64 * index as nat + shift;"},{"highlight_end":19,"highlight_start":1,"text":"    lemma2_to64();"},{"highlight_end":27,"highlight_start":1,"text":"    lemma_pow2_pos(shift);"},{"highlight_end":32,"highlight_start":1,"text":"    lemma_pow2_pos(full_shift);"},{"highlight_end":41,"highlight_start":1,"text":"    lemma_pow2_pos((64 - shift) as nat);"},{"highlight_end":49,"highlight_start":1,"text":"    lemma_pow2_adds(shift, (64 - shift) as nat);"},{"highlight_end":47,"highlight_start":1,"text":"    lemma_pow2_adds(64 * index as nat, shift);"},{"highlight_end":77,"highlight_start":1,"text":"    assert(value(words) == quotient * pow2(full_shift)) by (nonlinear_arith)"},{"highlight_end":17,"highlight_start":1,"text":"        requires"},{"highlight_end":89,"highlight_start":1,"text":"            value(words) == prefix(words, index + 1) + weight(index as nat + 1) * upper,"},{"highlight_end":69,"highlight_start":1,"text":"            prefix(words, index + 1) == word * weight(index as nat),"},{"highlight_end":72,"highlight_start":1,"text":"            weight(index as nat + 1) == weight(index as nat) * radix(),"},{"highlight_end":71,"highlight_start":1,"text":"            word == odd * pow2(shift), radix() == pow2(shift) * other,"},{"highlight_end":45,"highlight_start":1,"text":"            quotient == odd + other * upper,"},{"highlight_end":68,"highlight_start":1,"text":"            pow2(full_shift) == weight(index as nat) * pow2(shift);"},{"highlight_end":46,"highlight_start":1,"text":"    assert(quotient > 0) by (nonlinear_arith)"},{"highlight_end":82,"highlight_start":1,"text":"        requires quotient == odd + other * upper, odd > 0, other > 0, upper >= 0;"},{"highlight_end":44,"highlight_start":1,"text":"    lemma_pow2_unfold((64 - shift) as nat);"},{"highlight_end":42,"highlight_start":1,"text":"    let half = pow2((63 - shift) as nat);"},{"highlight_end":70,"highlight_start":1,"text":"    assert(quotient == 2 * (half * upper) + odd) by (nonlinear_arith)"},{"highlight_end":69,"highlight_start":1,"text":"        requires quotient == odd + other * upper, other == 2 * half;"},{"highlight_end":70,"highlight_start":1,"text":"    lemma_mod_multiples_vanish((half * upper) as int, odd as int, 2);"},{"highlight_end":89,"highlight_start":1,"text":"    lemma_fundamental_div_mod_converse_div(value(words) as int, pow2(full_shift) as int,"},{"highlight_end":29,"highlight_start":1,"text":"        quotient as int, 0);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":85,"highlight_start":1,"text":"pub(crate) open spec fn word_left_shifted(words: Seq<u64>, shift: nat) -> Seq<u64> {"},{"highlight_end":67,"highlight_start":1,"text":"    Seq::new(words.len(), |index: int| limb(words, index - shift))"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":92,"highlight_start":1,"text":"pub(crate) open spec fn left_shifted_limb(words: Seq<u64>, index: int, shift: u32) -> u64 {"},{"highlight_end":41,"highlight_start":1,"text":"    if shift == 0 { limb(words, index) }"},{"highlight_end":86,"highlight_start":1,"text":"    else { (limb(words, index) << shift) | (limb(words, index - 1) >> (64 - shift)) }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":71,"highlight_start":1,"text":"pub(crate) proof fn word_left_shift_value(words: Seq<u64>, shift: nat)"},{"highlight_end":34,"highlight_start":1,"text":"    requires shift < words.len(),"},{"highlight_end":51,"highlight_start":1,"text":"    ensures value(word_left_shifted(words, shift))"},{"highlight_end":70,"highlight_start":1,"text":"        == prefix(words, words.len() as int - shift) * weight(shift),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":51,"highlight_start":1,"text":"    let shifted = word_left_shifted(words, shift);"},{"highlight_end":69,"highlight_start":1,"text":"    let tail = shifted.subrange(shift as int, shifted.len() as int);"},{"highlight_end":40,"highlight_start":1,"text":"    prefix_zero(shifted, shift as int);"},{"highlight_end":63,"highlight_start":1,"text":"    prefix_split(shifted, shift as int, shifted.len() as int);"},{"highlight_end":50,"highlight_start":1,"text":"    prefix_equal(tail, words, tail.len() as int);"},{"highlight_end":88,"highlight_start":1,"text":"    assert(value(shifted) == prefix(words, words.len() as int - shift) * weight(shift))"},{"highlight_end":29,"highlight_start":1,"text":"        by (nonlinear_arith)"},{"highlight_end":64,"highlight_start":1,"text":"        requires value(shifted) == weight(shift) * value(tail),"},{"highlight_end":70,"highlight_start":1,"text":"            value(tail) == prefix(words, words.len() as int - shift);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":67,"highlight_start":1,"text":"proof fn prefix_is_value_below_bound(words: Seq<u64>, length: int)"},{"highlight_end":79,"highlight_start":1,"text":"    requires 0 <= length <= words.len(), value(words) < weight(length as nat),"},{"highlight_end":51,"highlight_start":1,"text":"    ensures prefix(words, length) == value(words),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":53,"highlight_start":1,"text":"    prefix_split(words, length, words.len() as int);"},{"highlight_end":32,"highlight_start":1,"text":"    weight_step(length as nat);"},{"highlight_end":66,"highlight_start":1,"text":"    let tail = value(words.subrange(length, words.len() as int));"},{"highlight_end":43,"highlight_start":1,"text":"    assert(tail == 0) by (nonlinear_arith)"},{"highlight_end":87,"highlight_start":1,"text":"        requires value(words) == prefix(words, length) + weight(length as nat) * tail,"},{"highlight_end":78,"highlight_start":1,"text":"            prefix(words, length) >= 0, tail >= 0, weight(length as nat) > 0,"},{"highlight_end":50,"highlight_start":1,"text":"            value(words) < weight(length as nat);"},{"highlight_end":87,"highlight_start":1,"text":"    assert(weight(length as nat) * tail == 0) by (nonlinear_arith) requires tail == 0;"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":88,"highlight_start":1,"text":"pub(crate) proof fn left_shifted_digit_correct(current: u64, previous: u64, shift: u32)"},{"highlight_end":29,"highlight_start":1,"text":"    requires 0 < shift < 64,"},{"highlight_end":12,"highlight_start":1,"text":"    ensures"},{"highlight_end":65,"highlight_start":1,"text":"        ((current << shift) | (previous >> (64 - shift))) as nat"},{"highlight_end":71,"highlight_start":1,"text":"            + ((current as nat) / pow2((64 - shift) as nat)) * radix()"},{"highlight_end":93,"highlight_start":1,"text":"            == current * pow2(shift as nat) + (previous as nat) / pow2((64 - shift) as nat),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":67,"highlight_start":1,"text":"    shifted_digit_correct(previous, current, (64 - shift) as u32);"},{"highlight_end":37,"highlight_start":1,"text":"    let factor = pow2(shift as nat);"},{"highlight_end":43,"highlight_start":1,"text":"    let other = pow2((64 - shift) as nat);"},{"highlight_end":19,"highlight_start":1,"text":"    lemma2_to64();"},{"highlight_end":41,"highlight_start":1,"text":"    lemma_pow2_pos((64 - shift) as nat);"},{"highlight_end":56,"highlight_start":1,"text":"    lemma_pow2_adds(shift as nat, (64 - shift) as nat);"},{"highlight_end":61,"highlight_start":1,"text":"    lemma_fundamental_div_mod(current as int, other as int);"},{"highlight_end":62,"highlight_start":1,"text":"    lemma_fundamental_div_mod(previous as int, other as int);"},{"highlight_end":75,"highlight_start":1,"text":"    let result = (current << shift) | (previous >> ((64 - shift) as u32));"},{"highlight_end":95,"highlight_start":1,"text":"    assert(result == (previous >> ((64 - shift) as u32)) | (current << shift)) by (bit_vector)"},{"highlight_end":85,"highlight_start":1,"text":"        requires result == (current << shift) | (previous >> ((64 - shift) as u32));"},{"highlight_end":41,"highlight_start":1,"text":"    let high = (current as nat) / other;"},{"highlight_end":41,"highlight_start":1,"text":"    let low = (previous as nat) / other;"},{"highlight_end":83,"highlight_start":1,"text":"    assert(result + high * radix() == current * factor + low) by (nonlinear_arith)"},{"highlight_end":17,"highlight_start":1,"text":"        requires"},{"highlight_end":55,"highlight_start":1,"text":"            result * other + (previous as nat) % other"},{"highlight_end":68,"highlight_start":1,"text":"                == previous + ((current as nat) % other) * radix(),"},{"highlight_end":64,"highlight_start":1,"text":"            current == other * high + (current as nat) % other,"},{"highlight_end":65,"highlight_start":1,"text":"            previous == other * low + (previous as nat) % other,"},{"highlight_end":50,"highlight_start":1,"text":"            radix() == factor * other, other > 0;"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":107,"highlight_start":1,"text":"proof fn left_shift_prefix_carry(source: Seq<u64>, output: Seq<u64>, factor: nat, other: nat, length: int)"},{"highlight_end":95,"highlight_start":1,"text":"    requires factor > 0, other > 0, source.len() == output.len(), 0 <= length <= source.len(),"},{"highlight_end":51,"highlight_start":1,"text":"        forall|index: int| 0 <= index < length ==>"},{"highlight_end":82,"highlight_start":1,"text":"            #[trigger] output[index] + ((source[index] as nat) / other) * radix()"},{"highlight_end":86,"highlight_start":1,"text":"                == source[index] * factor + (limb(source, index - 1) as nat) / other,"},{"highlight_end":105,"highlight_start":1,"text":"    ensures prefix(output, length) + ((limb(source, length - 1) as nat) / other) * weight(length as nat)"},{"highlight_end":44,"highlight_start":1,"text":"        == prefix(source, length) * factor,"},{"highlight_end":22,"highlight_start":1,"text":"    decreases length,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":21,"highlight_start":1,"text":"    if length == 0 {"},{"highlight_end":37,"highlight_start":1,"text":"        lemma_div_of0(other as int);"},{"highlight_end":55,"highlight_start":1,"text":"        let carry = (limb(source, -1) as nat) / other;"},{"highlight_end":81,"highlight_start":1,"text":"        assert(carry * weight(0) == 0) by (nonlinear_arith) requires carry == 0;"},{"highlight_end":102,"highlight_start":1,"text":"        assert(prefix(source, 0) * factor == 0) by (nonlinear_arith) requires prefix(source, 0) == 0;"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":76,"highlight_start":1,"text":"        left_shift_prefix_carry(source, output, factor, other, length - 1);"},{"highlight_end":42,"highlight_start":1,"text":"        weight_step((length - 1) as nat);"},{"highlight_end":45,"highlight_start":1,"text":"        let w = weight((length - 1) as nat);"},{"highlight_end":44,"highlight_start":1,"text":"        let next_w = weight(length as nat);"},{"highlight_end":63,"highlight_start":1,"text":"        let carry = (limb(source, length - 2) as nat) / other;"},{"highlight_end":62,"highlight_start":1,"text":"        let next_carry = (source[length - 1] as nat) / other;"},{"highlight_end":53,"highlight_start":1,"text":"        let old_output = prefix(output, length - 1);"},{"highlight_end":53,"highlight_start":1,"text":"        let old_source = prefix(source, length - 1);"},{"highlight_end":60,"highlight_start":1,"text":"        assert(prefix(output, length) + next_carry * next_w"},{"highlight_end":69,"highlight_start":1,"text":"            == prefix(source, length) * factor) by (nonlinear_arith)"},{"highlight_end":68,"highlight_start":1,"text":"            requires old_output + carry * w == old_source * factor,"},{"highlight_end":98,"highlight_start":1,"text":"                output[length - 1] + next_carry * radix() == source[length - 1] * factor + carry,"},{"highlight_end":39,"highlight_start":1,"text":"                next_w == w * radix(),"},{"highlight_end":79,"highlight_start":1,"text":"                prefix(output, length) == old_output + output[length - 1] * w,"},{"highlight_end":79,"highlight_start":1,"text":"                prefix(source, length) == old_source + source[length - 1] * w;"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":98,"highlight_start":1,"text":"pub(crate) proof fn left_shift_value(source: Seq<u64>, output: Seq<u64>, factor: nat, other: nat)"},{"highlight_end":66,"highlight_start":1,"text":"    requires factor > 0, other > 0, source.len() == output.len(),"},{"highlight_end":55,"highlight_start":1,"text":"        value(source) * factor < weight(source.len()),"},{"highlight_end":57,"highlight_start":1,"text":"        forall|index: int| 0 <= index < source.len() ==>"},{"highlight_end":82,"highlight_start":1,"text":"            #[trigger] output[index] + ((source[index] as nat) / other) * radix()"},{"highlight_end":86,"highlight_start":1,"text":"                == source[index] * factor + (limb(source, index - 1) as nat) / other,"},{"highlight_end":53,"highlight_start":1,"text":"    ensures value(output) == value(source) * factor,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":81,"highlight_start":1,"text":"    left_shift_prefix_carry(source, output, factor, other, source.len() as int);"},{"highlight_end":72,"highlight_start":1,"text":"    let carry = (limb(source, source.len() as int - 1) as nat) / other;"},{"highlight_end":31,"highlight_start":1,"text":"    weight_step(source.len());"},{"highlight_end":44,"highlight_start":1,"text":"    assert(carry == 0) by (nonlinear_arith)"},{"highlight_end":89,"highlight_start":1,"text":"        requires value(output) + carry * weight(source.len()) == value(source) * factor,"},{"highlight_end":79,"highlight_start":1,"text":"            value(source) * factor < weight(source.len()), value(output) >= 0,"},{"highlight_end":50,"highlight_start":1,"text":"            carry >= 0, weight(source.len()) > 0;"},{"highlight_end":88,"highlight_start":1,"text":"    assert(carry * weight(source.len()) == 0) by (nonlinear_arith) requires carry == 0;"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":53,"highlight_start":1,"text":"pub(crate) proof fn two_limbs_value(words: Seq<u64>)"},{"highlight_end":31,"highlight_start":1,"text":"    requires words.len() >= 2,"},{"highlight_end":83,"highlight_start":1,"text":"    ensures prefix(words, 2) == ((words[0] as u128) | ((words[1] as u128) << 64)),"},{"highlight_end":43,"highlight_start":1,"text":"        weight(2) == u128::MAX as nat + 1,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":19,"highlight_start":1,"text":"    lemma2_to64();"},{"highlight_end":20,"highlight_start":1,"text":"    weight_step(1);"},{"highlight_end":24,"highlight_start":1,"text":"    let low = words[0];"},{"highlight_end":25,"highlight_start":1,"text":"    let high = words[1];"},{"highlight_end":68,"highlight_start":1,"text":"    assert(prefix(words, 1) == prefix(words, 0) + low * weight(0));"},{"highlight_end":35,"highlight_start":1,"text":"    assert(prefix(words, 0) == 0);"},{"highlight_end":50,"highlight_start":1,"text":"    assert((low as u128 | ((high as u128) << 64))"},{"highlight_end":86,"highlight_start":1,"text":"        == low as u128 + high as u128 * 0x1_0000_0000_0000_0000u128) by (bit_vector);"},{"highlight_end":74,"highlight_start":1,"text":"    assert(prefix(words, 2) == low + high * radix()) by (nonlinear_arith)"},{"highlight_end":74,"highlight_start":1,"text":"        requires prefix(words, 2) == prefix(words, 1) + high * weight(1),"},{"highlight_end":87,"highlight_start":1,"text":"            prefix(words, 1) == low * weight(0), weight(0) == 1, weight(1) == radix();"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":2,"highlight_start":1,"text":"}"}]}},"file_name":"/home/tim/Documents/GitHub/workspace/csgrs/target/scalar-evaluation-candidate/source/crates/hyperreal/src/verified/limbs.rs","is_primary":true,"label":null,"line_end":474,"line_start":11,"suggested_replacement":null,"suggestion_applicability":null,"text":[{"highlight_end":9,"highlight_start":1,"text":"verus! {"},{"highlight_end":67,"highlight_start":1,"text":"pub(crate) open spec fn radix() -> nat { 0x1_0000_0000_0000_0000 }"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":52,"highlight_start":1,"text":"pub(crate) open spec fn weight(index: nat) -> nat {"},{"highlight_end":21,"highlight_start":1,"text":"    pow2(64 * index)"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":65,"highlight_start":1,"text":"/// Denotation of the first `length` little-endian 64-bit limbs."},{"highlight_end":68,"highlight_start":1,"text":"pub(crate) open spec fn prefix(words: Seq<u64>, length: int) -> nat"},{"highlight_end":43,"highlight_start":1,"text":"    recommends 0 <= length <= words.len(),"},{"highlight_end":22,"highlight_start":1,"text":"    decreases length,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":32,"highlight_start":1,"text":"    if length <= 0 { 0 } else {"},{"highlight_end":93,"highlight_start":1,"text":"        prefix(words, length - 1) + (words[length - 1] as nat) * weight((length - 1) as nat)"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":56,"highlight_start":1,"text":"pub(crate) open spec fn value(words: Seq<u64>) -> nat {"},{"highlight_end":38,"highlight_start":1,"text":"    prefix(words, words.len() as int)"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":44,"highlight_start":1,"text":"pub(crate) proof fn weight_step(index: nat)"},{"highlight_end":77,"highlight_start":1,"text":"    ensures weight(index) > 0, weight(index + 1) == weight(index) * radix(),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":32,"highlight_start":1,"text":"    lemma_pow2_pos(64 * index);"},{"highlight_end":37,"highlight_start":1,"text":"    lemma_pow2_adds(64 * index, 64);"},{"highlight_end":19,"highlight_start":1,"text":"    lemma2_to64();"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":54,"highlight_start":1,"text":"pub(crate) proof fn weight_add(left: nat, right: nat)"},{"highlight_end":66,"highlight_start":1,"text":"    ensures weight(left + right) == weight(left) * weight(right),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":44,"highlight_start":1,"text":"    lemma_pow2_adds(64 * left, 64 * right);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":63,"highlight_start":1,"text":"pub(crate) proof fn prefix_bound(words: Seq<u64>, length: int)"},{"highlight_end":41,"highlight_start":1,"text":"    requires 0 <= length <= words.len(),"},{"highlight_end":59,"highlight_start":1,"text":"    ensures prefix(words, length) < weight(length as nat),"},{"highlight_end":22,"highlight_start":1,"text":"    decreases length,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":21,"highlight_start":1,"text":"    if length == 0 {"},{"highlight_end":23,"highlight_start":1,"text":"        lemma2_to64();"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":41,"highlight_start":1,"text":"        prefix_bound(words, length - 1);"},{"highlight_end":42,"highlight_start":1,"text":"        weight_step((length - 1) as nat);"},{"highlight_end":83,"highlight_start":1,"text":"        assert(prefix(words, length) < weight(length as nat)) by (nonlinear_arith)"},{"highlight_end":43,"highlight_start":1,"text":"            requires prefix(words, length)"},{"highlight_end":96,"highlight_start":1,"text":"                == prefix(words, length - 1) + words[length - 1] * weight((length - 1) as nat),"},{"highlight_end":73,"highlight_start":1,"text":"                prefix(words, length - 1) < weight((length - 1) as nat),"},{"highlight_end":50,"highlight_start":1,"text":"                0 <= words[length - 1] < radix(),"},{"highlight_end":49,"highlight_start":1,"text":"                weight((length - 1) as nat) > 0,"},{"highlight_end":80,"highlight_start":1,"text":"                weight(length as nat) == weight((length - 1) as nat) * radix();"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":79,"highlight_start":1,"text":"pub(crate) proof fn prefix_equal(left: Seq<u64>, right: Seq<u64>, length: int)"},{"highlight_end":63,"highlight_start":1,"text":"    requires 0 <= length <= left.len(), length <= right.len(),"},{"highlight_end":91,"highlight_start":1,"text":"        forall|index: int| 0 <= index < length ==> #[trigger] left[index] == right[index],"},{"highlight_end":59,"highlight_start":1,"text":"    ensures prefix(left, length) == prefix(right, length),"},{"highlight_end":22,"highlight_start":1,"text":"    decreases length,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":20,"highlight_start":1,"text":"    if length > 0 {"},{"highlight_end":47,"highlight_start":1,"text":"        prefix_equal(left, right, length - 1);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":77,"highlight_start":1,"text":"/// Equal higher limbs and unequal current limbs determine integer ordering,"},{"highlight_end":35,"highlight_start":1,"text":"/// regardless of all lower limbs."},{"highlight_end":66,"highlight_start":1,"text":"proof fn prefix_less(left: Seq<u64>, right: Seq<u64>, index: int)"},{"highlight_end":65,"highlight_start":1,"text":"    requires 0 <= index < left.len(), left.len() == right.len(),"},{"highlight_end":36,"highlight_start":1,"text":"        left[index] < right[index],"},{"highlight_end":56,"highlight_start":1,"text":"        forall|higher: int| index < higher < left.len()"},{"highlight_end":58,"highlight_start":1,"text":"            ==> #[trigger] left[higher] == right[higher],"},{"highlight_end":40,"highlight_start":1,"text":"    ensures value(left) < value(right),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":31,"highlight_start":1,"text":"    prefix_bound(left, index);"},{"highlight_end":32,"highlight_start":1,"text":"    prefix_bound(right, index);"},{"highlight_end":31,"highlight_start":1,"text":"    weight_step(index as nat);"},{"highlight_end":84,"highlight_start":1,"text":"    assert(prefix(left, index + 1) < prefix(right, index + 1)) by (nonlinear_arith)"},{"highlight_end":66,"highlight_start":1,"text":"        requires 0 <= prefix(left, index) < weight(index as nat),"},{"highlight_end":62,"highlight_start":1,"text":"            0 <= prefix(right, index) < weight(index as nat),"},{"highlight_end":66,"highlight_start":1,"text":"            left[index] < right[index], weight(index as nat) > 0,"},{"highlight_end":97,"highlight_start":1,"text":"            prefix(left, index + 1) == prefix(left, index) + left[index] * weight(index as nat),"},{"highlight_end":100,"highlight_start":1,"text":"            prefix(right, index + 1) == prefix(right, index) + right[index] * weight(index as nat);"},{"highlight_end":67,"highlight_start":1,"text":"    extend_prefix_less(left, right, index + 1, left.len() as int);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":83,"highlight_start":1,"text":"proof fn extend_prefix_less(left: Seq<u64>, right: Seq<u64>, start: int, end: int)"},{"highlight_end":73,"highlight_start":1,"text":"    requires 0 <= start <= end <= left.len(), left.len() == right.len(),"},{"highlight_end":52,"highlight_start":1,"text":"        prefix(left, start) < prefix(right, start),"},{"highlight_end":92,"highlight_start":1,"text":"        forall|index: int| start <= index < end ==> #[trigger] left[index] == right[index],"},{"highlight_end":52,"highlight_start":1,"text":"    ensures prefix(left, end) < prefix(right, end),"},{"highlight_end":27,"highlight_start":1,"text":"    decreases end - start,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":21,"highlight_start":1,"text":"    if start < end {"},{"highlight_end":57,"highlight_start":1,"text":"        extend_prefix_less(left, right, start, end - 1);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":72,"highlight_start":1,"text":"pub(crate) proof fn prefix_split(words: Seq<u64>, start: int, end: int)"},{"highlight_end":47,"highlight_start":1,"text":"    requires 0 <= start <= end <= words.len(),"},{"highlight_end":55,"highlight_start":1,"text":"    ensures prefix(words, end) == prefix(words, start)"},{"highlight_end":68,"highlight_start":1,"text":"        + weight(start as nat) * value(words.subrange(start, end)),"},{"highlight_end":27,"highlight_start":1,"text":"    decreases end - start,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":22,"highlight_start":1,"text":"    if start == end {"},{"highlight_end":56,"highlight_start":1,"text":"        assert(value(words.subrange(start, end)) == 0);"},{"highlight_end":71,"highlight_start":1,"text":"        assert(weight(start as nat) * 0nat == 0) by (nonlinear_arith);"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":45,"highlight_start":1,"text":"        prefix_split(words, start, end - 1);"},{"highlight_end":47,"highlight_start":1,"text":"        let tail = words.subrange(start, end);"},{"highlight_end":55,"highlight_start":1,"text":"        let previous = words.subrange(start, end - 1);"},{"highlight_end":55,"highlight_start":1,"text":"        prefix_equal(tail, previous, end - start - 1);"},{"highlight_end":60,"highlight_start":1,"text":"        weight_add(start as nat, (end - start - 1) as nat);"},{"highlight_end":58,"highlight_start":1,"text":"        assert(prefix(words, end) == prefix(words, start)"},{"highlight_end":71,"highlight_start":1,"text":"            + weight(start as nat) * value(tail)) by (nonlinear_arith)"},{"highlight_end":21,"highlight_start":1,"text":"            requires"},{"highlight_end":61,"highlight_start":1,"text":"                prefix(words, end) == prefix(words, end - 1)"},{"highlight_end":65,"highlight_start":1,"text":"                    + words[end - 1] * weight((end - 1) as nat),"},{"highlight_end":63,"highlight_start":1,"text":"                prefix(words, end - 1) == prefix(words, start)"},{"highlight_end":62,"highlight_start":1,"text":"                    + weight(start as nat) * value(previous),"},{"highlight_end":47,"highlight_start":1,"text":"                value(tail) == value(previous)"},{"highlight_end":73,"highlight_start":1,"text":"                    + words[end - 1] * weight((end - start - 1) as nat),"},{"highlight_end":41,"highlight_start":1,"text":"                weight((end - 1) as nat)"},{"highlight_end":80,"highlight_start":1,"text":"                    == weight(start as nat) * weight((end - start - 1) as nat);"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":62,"highlight_start":1,"text":"pub(crate) proof fn prefix_zero(words: Seq<u64>, length: int)"},{"highlight_end":41,"highlight_start":1,"text":"    requires 0 <= length <= words.len(),"},{"highlight_end":44,"highlight_start":1,"text":"    ensures prefix(words, length) == 0 <==>"},{"highlight_end":81,"highlight_start":1,"text":"        forall|index: int| 0 <= index < length ==> #[trigger] words[index] == 0,"},{"highlight_end":22,"highlight_start":1,"text":"    decreases length,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":20,"highlight_start":1,"text":"    if length > 0 {"},{"highlight_end":40,"highlight_start":1,"text":"        prefix_zero(words, length - 1);"},{"highlight_end":42,"highlight_start":1,"text":"        weight_step((length - 1) as nat);"},{"highlight_end":47,"highlight_start":1,"text":"        assert(prefix(words, length) == 0 <==>"},{"highlight_end":91,"highlight_start":1,"text":"            prefix(words, length - 1) == 0 && words[length - 1] == 0) by (nonlinear_arith)"},{"highlight_end":72,"highlight_start":1,"text":"            requires prefix(words, length) == prefix(words, length - 1)"},{"highlight_end":67,"highlight_start":1,"text":"                + words[length - 1] * weight((length - 1) as nat),"},{"highlight_end":72,"highlight_start":1,"text":"                prefix(words, length - 1) >= 0, words[length - 1] >= 0,"},{"highlight_end":49,"highlight_start":1,"text":"                weight((length - 1) as nat) > 0;"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":67,"highlight_start":1,"text":"pub(crate) open spec fn limb(words: Seq<u64>, index: int) -> u64 {"},{"highlight_end":60,"highlight_start":1,"text":"    if 0 <= index < words.len() { words[index] } else { 0 }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":64,"highlight_start":1,"text":"proof fn shifted_digit_correct(low: u64, high: u64, shift: u32)"},{"highlight_end":29,"highlight_start":1,"text":"    requires 0 < shift < 64,"},{"highlight_end":12,"highlight_start":1,"text":"    ensures"},{"highlight_end":80,"highlight_start":1,"text":"        (((low >> shift) | (high << (64 - shift))) as nat) * pow2(shift as nat)"},{"highlight_end":48,"highlight_start":1,"text":"            + (low as nat) % pow2(shift as nat)"},{"highlight_end":76,"highlight_start":1,"text":"            == low as nat + ((high as nat) % pow2(shift as nat)) * radix(),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":37,"highlight_start":1,"text":"    let factor = pow2(shift as nat);"},{"highlight_end":43,"highlight_start":1,"text":"    let other = pow2((64 - shift) as nat);"},{"highlight_end":19,"highlight_start":1,"text":"    lemma2_to64();"},{"highlight_end":34,"highlight_start":1,"text":"    lemma_pow2_pos(shift as nat);"},{"highlight_end":41,"highlight_start":1,"text":"    lemma_pow2_pos((64 - shift) as nat);"},{"highlight_end":56,"highlight_start":1,"text":"    lemma_pow2_adds(shift as nat, (64 - shift) as nat);"},{"highlight_end":58,"highlight_start":1,"text":"    vstd::bits::lemma_u64_pow2_no_overflow(shift as nat);"},{"highlight_end":51,"highlight_start":1,"text":"    super::word::one_shift_is_power_of_two(shift);"},{"highlight_end":72,"highlight_start":1,"text":"    assert((1u64 << shift) as u128 == (1u128 << shift)) by (bit_vector)"},{"highlight_end":29,"highlight_start":1,"text":"        requires shift < 64;"},{"highlight_end":68,"highlight_start":1,"text":"    vstd::bits::lemma_u64_low_bits_mask_is_mod(high, shift as nat);"},{"highlight_end":47,"highlight_start":1,"text":"    let bottom = high & ((factor - 1) as u64);"},{"highlight_end":46,"highlight_start":1,"text":"    assert(bottom == (high as nat) % factor);"},{"highlight_end":60,"highlight_start":1,"text":"    assert(bottom * other <= u64::MAX) by (nonlinear_arith)"},{"highlight_end":77,"highlight_start":1,"text":"        requires 0 <= bottom < factor, other > 0, factor * other == radix();"},{"highlight_end":67,"highlight_start":1,"text":"    vstd::bits::lemma_u64_shl_is_mul(bottom, (64 - shift) as u64);"},{"highlight_end":93,"highlight_start":1,"text":"    assert(high << ((64 - shift) as u32) == bottom << ((64 - shift) as u32)) by (bit_vector)"},{"highlight_end":82,"highlight_start":1,"text":"        requires 0 < shift < 64, bottom == high & (((1u64 << shift) - 1) as u64);"},{"highlight_end":57,"highlight_start":1,"text":"    vstd::bits::lemma_u64_shr_is_div(low, shift as u64);"},{"highlight_end":58,"highlight_start":1,"text":"    lemma_fundamental_div_mod(low as int, factor as int);"},{"highlight_end":67,"highlight_start":1,"text":"    let result = (low >> shift) | (high << ((64 - shift) as u32));"},{"highlight_end":95,"highlight_start":1,"text":"    assert(result as u128 == (low >> shift) as u128 + (high << ((64 - shift) as u32)) as u128)"},{"highlight_end":24,"highlight_start":1,"text":"        by (bit_vector)"},{"highlight_end":33,"highlight_start":1,"text":"        requires 0 < shift < 64,"},{"highlight_end":72,"highlight_start":1,"text":"            result == (low >> shift) | (high << ((64 - shift) as u32));"},{"highlight_end":51,"highlight_start":1,"text":"    assert(result * factor + (low as nat) % factor"},{"highlight_end":74,"highlight_start":1,"text":"        == low + ((high as nat) % factor) * radix()) by (nonlinear_arith)"},{"highlight_end":67,"highlight_start":1,"text":"        requires result == (low as nat) / factor + bottom * other,"},{"highlight_end":77,"highlight_start":1,"text":"            low == factor * ((low as nat) / factor) + (low as nat) % factor,"},{"highlight_end":73,"highlight_start":1,"text":"            bottom == (high as nat) % factor, factor * other == radix();"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":78,"highlight_start":1,"text":"pub(crate) proof fn extend_prefix_zero(words: Seq<u64>, start: int, end: int)"},{"highlight_end":47,"highlight_start":1,"text":"    requires 0 <= start <= end <= words.len(),"},{"highlight_end":82,"highlight_start":1,"text":"        forall|index: int| start <= index < end ==> #[trigger] words[index] == 0,"},{"highlight_end":56,"highlight_start":1,"text":"    ensures prefix(words, start) == prefix(words, end),"},{"highlight_end":27,"highlight_start":1,"text":"    decreases end - start,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":21,"highlight_start":1,"text":"    if start < end {"},{"highlight_end":51,"highlight_start":1,"text":"        extend_prefix_zero(words, start, end - 1);"},{"highlight_end":63,"highlight_start":1,"text":"        assert(words[end - 1] * weight((end - 1) as nat) == 0)"},{"highlight_end":63,"highlight_start":1,"text":"            by (nonlinear_arith) requires words[end - 1] == 0;"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":64,"highlight_start":1,"text":"spec fn word_shifted(words: Seq<u64>, shift: nat) -> Seq<u64> {"},{"highlight_end":67,"highlight_start":1,"text":"    Seq::new(words.len(), |index: int| limb(words, index + shift))"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":71,"highlight_start":1,"text":"spec fn shifted_limb(words: Seq<u64>, index: int, shift: u32) -> u64 {"},{"highlight_end":41,"highlight_start":1,"text":"    if shift == 0 { limb(words, index) }"},{"highlight_end":86,"highlight_start":1,"text":"    else { (limb(words, index) >> shift) | (limb(words, index + 1) << (64 - shift)) }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":55,"highlight_start":1,"text":"proof fn word_shift_value(words: Seq<u64>, shift: nat)"},{"highlight_end":34,"highlight_start":1,"text":"    requires shift < words.len(),"},{"highlight_end":79,"highlight_start":1,"text":"    ensures value(word_shifted(words, shift)) == value(words) / weight(shift),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":46,"highlight_start":1,"text":"    let shifted = word_shifted(words, shift);"},{"highlight_end":65,"highlight_start":1,"text":"    let tail = words.subrange(shift as int, words.len() as int);"},{"highlight_end":52,"highlight_start":1,"text":"    prefix_equal(shifted, tail, tail.len() as int);"},{"highlight_end":74,"highlight_start":1,"text":"    extend_prefix_zero(shifted, tail.len() as int, shifted.len() as int);"},{"highlight_end":59,"highlight_start":1,"text":"    prefix_split(words, shift as int, words.len() as int);"},{"highlight_end":39,"highlight_start":1,"text":"    prefix_bound(words, shift as int);"},{"highlight_end":24,"highlight_start":1,"text":"    weight_step(shift);"},{"highlight_end":86,"highlight_start":1,"text":"    assert(value(words) == value(tail) * weight(shift) + prefix(words, shift as int))"},{"highlight_end":29,"highlight_start":1,"text":"        by (nonlinear_arith)"},{"highlight_end":92,"highlight_start":1,"text":"        requires value(words) == prefix(words, shift as int) + weight(shift) * value(tail);"},{"highlight_end":86,"highlight_start":1,"text":"    lemma_fundamental_div_mod_converse_div(value(words) as int, weight(shift) as int,"},{"highlight_end":65,"highlight_start":1,"text":"        value(tail) as int, prefix(words, shift as int) as int);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":90,"highlight_start":1,"text":"proof fn shift_prefix_carry(source: Seq<u64>, output: Seq<u64>, factor: nat, length: int)"},{"highlight_end":84,"highlight_start":1,"text":"    requires factor > 0, source.len() == output.len(), 0 <= length <= source.len(),"},{"highlight_end":51,"highlight_start":1,"text":"        forall|index: int| 0 <= index < length ==>"},{"highlight_end":80,"highlight_start":1,"text":"            #[trigger] output[index] * factor + (source[index] as nat) % factor"},{"highlight_end":90,"highlight_start":1,"text":"                == source[index] + ((limb(source, index + 1) as nat) % factor) * radix(),"},{"highlight_end":80,"highlight_start":1,"text":"    ensures prefix(output, length) * factor + (limb(source, 0) as nat) % factor"},{"highlight_end":102,"highlight_start":1,"text":"        == prefix(source, length) + ((limb(source, length) as nat) % factor) * weight(length as nat),"},{"highlight_end":22,"highlight_start":1,"text":"    decreases length,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":21,"highlight_start":1,"text":"    if length == 0 {"},{"highlight_end":23,"highlight_start":1,"text":"        lemma2_to64();"},{"highlight_end":59,"highlight_start":1,"text":"        let remainder = (limb(source, 0) as nat) % factor;"},{"highlight_end":69,"highlight_start":1,"text":"        assert(prefix(output, 0) * factor == 0) by (nonlinear_arith)"},{"highlight_end":45,"highlight_start":1,"text":"            requires prefix(output, 0) == 0;"},{"highlight_end":72,"highlight_start":1,"text":"        assert(remainder * weight(0) == remainder) by (nonlinear_arith)"},{"highlight_end":37,"highlight_start":1,"text":"            requires weight(0) == 1;"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":64,"highlight_start":1,"text":"        shift_prefix_carry(source, output, factor, length - 1);"},{"highlight_end":42,"highlight_start":1,"text":"        weight_step((length - 1) as nat);"},{"highlight_end":45,"highlight_start":1,"text":"        let w = weight((length - 1) as nat);"},{"highlight_end":44,"highlight_start":1,"text":"        let next_w = weight(length as nat);"},{"highlight_end":58,"highlight_start":1,"text":"        let carry = (source[length - 1] as nat) % factor;"},{"highlight_end":65,"highlight_start":1,"text":"        let next_carry = (limb(source, length) as nat) % factor;"},{"highlight_end":59,"highlight_start":1,"text":"        let remainder = (limb(source, 0) as nat) % factor;"},{"highlight_end":53,"highlight_start":1,"text":"        let old_output = prefix(output, length - 1);"},{"highlight_end":53,"highlight_start":1,"text":"        let old_source = prefix(source, length - 1);"},{"highlight_end":59,"highlight_start":1,"text":"        assert(prefix(output, length) * factor + remainder"},{"highlight_end":82,"highlight_start":1,"text":"            == prefix(source, length) + next_carry * next_w) by (nonlinear_arith)"},{"highlight_end":80,"highlight_start":1,"text":"            requires old_output * factor + remainder == old_source + carry * w,"},{"highlight_end":98,"highlight_start":1,"text":"                output[length - 1] * factor + carry == source[length - 1] + next_carry * radix(),"},{"highlight_end":39,"highlight_start":1,"text":"                next_w == w * radix(),"},{"highlight_end":79,"highlight_start":1,"text":"                prefix(output, length) == old_output + output[length - 1] * w,"},{"highlight_end":79,"highlight_start":1,"text":"                prefix(source, length) == old_source + source[length - 1] * w;"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":70,"highlight_start":1,"text":"proof fn shift_value(source: Seq<u64>, output: Seq<u64>, factor: nat)"},{"highlight_end":55,"highlight_start":1,"text":"    requires factor > 0, source.len() == output.len(),"},{"highlight_end":57,"highlight_start":1,"text":"        forall|index: int| 0 <= index < source.len() ==>"},{"highlight_end":80,"highlight_start":1,"text":"            #[trigger] output[index] * factor + (source[index] as nat) % factor"},{"highlight_end":90,"highlight_start":1,"text":"                == source[index] + ((limb(source, index + 1) as nat) % factor) * radix(),"},{"highlight_end":53,"highlight_start":1,"text":"    ensures value(output) == value(source) / factor,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":69,"highlight_start":1,"text":"    shift_prefix_carry(source, output, factor, source.len() as int);"},{"highlight_end":32,"highlight_start":1,"text":"    lemma_small_mod(0, factor);"},{"highlight_end":69,"highlight_start":1,"text":"    let carry = (limb(source, source.len() as int) as nat) % factor;"},{"highlight_end":88,"highlight_start":1,"text":"    assert(carry * weight(source.len()) == 0) by (nonlinear_arith) requires carry == 0;"},{"highlight_end":80,"highlight_start":1,"text":"    lemma_fundamental_div_mod_converse_div(value(source) as int, factor as int,"},{"highlight_end":75,"highlight_start":1,"text":"        value(output) as int, ((limb(source, 0) as nat) % factor) as int);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":59,"highlight_start":1,"text":"proof fn first_nonzero_factor(words: Seq<u64>, index: int)"},{"highlight_end":57,"highlight_start":1,"text":"    requires 0 <= index < words.len(), words[index] > 0,"},{"highlight_end":80,"highlight_start":1,"text":"        forall|lower: int| 0 <= lower < index ==> #[trigger] words[lower] == 0,"},{"highlight_end":15,"highlight_start":1,"text":"    ensures ({"},{"highlight_end":81,"highlight_start":1,"text":"        let shift = 64 * index as nat + u64_trailing_zeros(words[index]) as nat;"},{"highlight_end":33,"highlight_start":1,"text":"        shift < 64 * words.len()"},{"highlight_end":46,"highlight_start":1,"text":"            && value(words) / pow2(shift) > 0"},{"highlight_end":53,"highlight_start":1,"text":"            && (value(words) / pow2(shift)) % 2 == 1"},{"highlight_end":74,"highlight_start":1,"text":"            && value(words) == (value(words) / pow2(shift)) * pow2(shift)"},{"highlight_end":8,"highlight_start":1,"text":"    }),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":31,"highlight_start":1,"text":"    prefix_zero(words, index);"},{"highlight_end":56,"highlight_start":1,"text":"    prefix_split(words, index + 1, words.len() as int);"},{"highlight_end":31,"highlight_start":1,"text":"    weight_step(index as nat);"},{"highlight_end":29,"highlight_start":1,"text":"    let word = words[index];"},{"highlight_end":49,"highlight_start":1,"text":"    super::gcd::trailing_zeros_factor_u64(word);"},{"highlight_end":49,"highlight_start":1,"text":"    let shift = u64_trailing_zeros(word) as nat;"},{"highlight_end":57,"highlight_start":1,"text":"    let odd = (word >> u64_trailing_zeros(word)) as nat;"},{"highlight_end":70,"highlight_start":1,"text":"    let upper = value(words.subrange(index + 1, words.len() as int));"},{"highlight_end":43,"highlight_start":1,"text":"    let other = pow2((64 - shift) as nat);"},{"highlight_end":40,"highlight_start":1,"text":"    let quotient = odd + other * upper;"},{"highlight_end":48,"highlight_start":1,"text":"    let full_shift = 64 * index as nat + shift;"},{"highlight_end":19,"highlight_start":1,"text":"    lemma2_to64();"},{"highlight_end":27,"highlight_start":1,"text":"    lemma_pow2_pos(shift);"},{"highlight_end":32,"highlight_start":1,"text":"    lemma_pow2_pos(full_shift);"},{"highlight_end":41,"highlight_start":1,"text":"    lemma_pow2_pos((64 - shift) as nat);"},{"highlight_end":49,"highlight_start":1,"text":"    lemma_pow2_adds(shift, (64 - shift) as nat);"},{"highlight_end":47,"highlight_start":1,"text":"    lemma_pow2_adds(64 * index as nat, shift);"},{"highlight_end":77,"highlight_start":1,"text":"    assert(value(words) == quotient * pow2(full_shift)) by (nonlinear_arith)"},{"highlight_end":17,"highlight_start":1,"text":"        requires"},{"highlight_end":89,"highlight_start":1,"text":"            value(words) == prefix(words, index + 1) + weight(index as nat + 1) * upper,"},{"highlight_end":69,"highlight_start":1,"text":"            prefix(words, index + 1) == word * weight(index as nat),"},{"highlight_end":72,"highlight_start":1,"text":"            weight(index as nat + 1) == weight(index as nat) * radix(),"},{"highlight_end":71,"highlight_start":1,"text":"            word == odd * pow2(shift), radix() == pow2(shift) * other,"},{"highlight_end":45,"highlight_start":1,"text":"            quotient == odd + other * upper,"},{"highlight_end":68,"highlight_start":1,"text":"            pow2(full_shift) == weight(index as nat) * pow2(shift);"},{"highlight_end":46,"highlight_start":1,"text":"    assert(quotient > 0) by (nonlinear_arith)"},{"highlight_end":82,"highlight_start":1,"text":"        requires quotient == odd + other * upper, odd > 0, other > 0, upper >= 0;"},{"highlight_end":44,"highlight_start":1,"text":"    lemma_pow2_unfold((64 - shift) as nat);"},{"highlight_end":42,"highlight_start":1,"text":"    let half = pow2((63 - shift) as nat);"},{"highlight_end":70,"highlight_start":1,"text":"    assert(quotient == 2 * (half * upper) + odd) by (nonlinear_arith)"},{"highlight_end":69,"highlight_start":1,"text":"        requires quotient == odd + other * upper, other == 2 * half;"},{"highlight_end":70,"highlight_start":1,"text":"    lemma_mod_multiples_vanish((half * upper) as int, odd as int, 2);"},{"highlight_end":89,"highlight_start":1,"text":"    lemma_fundamental_div_mod_converse_div(value(words) as int, pow2(full_shift) as int,"},{"highlight_end":29,"highlight_start":1,"text":"        quotient as int, 0);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":85,"highlight_start":1,"text":"pub(crate) open spec fn word_left_shifted(words: Seq<u64>, shift: nat) -> Seq<u64> {"},{"highlight_end":67,"highlight_start":1,"text":"    Seq::new(words.len(), |index: int| limb(words, index - shift))"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":92,"highlight_start":1,"text":"pub(crate) open spec fn left_shifted_limb(words: Seq<u64>, index: int, shift: u32) -> u64 {"},{"highlight_end":41,"highlight_start":1,"text":"    if shift == 0 { limb(words, index) }"},{"highlight_end":86,"highlight_start":1,"text":"    else { (limb(words, index) << shift) | (limb(words, index - 1) >> (64 - shift)) }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":71,"highlight_start":1,"text":"pub(crate) proof fn word_left_shift_value(words: Seq<u64>, shift: nat)"},{"highlight_end":34,"highlight_start":1,"text":"    requires shift < words.len(),"},{"highlight_end":51,"highlight_start":1,"text":"    ensures value(word_left_shifted(words, shift))"},{"highlight_end":70,"highlight_start":1,"text":"        == prefix(words, words.len() as int - shift) * weight(shift),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":51,"highlight_start":1,"text":"    let shifted = word_left_shifted(words, shift);"},{"highlight_end":69,"highlight_start":1,"text":"    let tail = shifted.subrange(shift as int, shifted.len() as int);"},{"highlight_end":40,"highlight_start":1,"text":"    prefix_zero(shifted, shift as int);"},{"highlight_end":63,"highlight_start":1,"text":"    prefix_split(shifted, shift as int, shifted.len() as int);"},{"highlight_end":50,"highlight_start":1,"text":"    prefix_equal(tail, words, tail.len() as int);"},{"highlight_end":88,"highlight_start":1,"text":"    assert(value(shifted) == prefix(words, words.len() as int - shift) * weight(shift))"},{"highlight_end":29,"highlight_start":1,"text":"        by (nonlinear_arith)"},{"highlight_end":64,"highlight_start":1,"text":"        requires value(shifted) == weight(shift) * value(tail),"},{"highlight_end":70,"highlight_start":1,"text":"            value(tail) == prefix(words, words.len() as int - shift);"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":67,"highlight_start":1,"text":"proof fn prefix_is_value_below_bound(words: Seq<u64>, length: int)"},{"highlight_end":79,"highlight_start":1,"text":"    requires 0 <= length <= words.len(), value(words) < weight(length as nat),"},{"highlight_end":51,"highlight_start":1,"text":"    ensures prefix(words, length) == value(words),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":53,"highlight_start":1,"text":"    prefix_split(words, length, words.len() as int);"},{"highlight_end":32,"highlight_start":1,"text":"    weight_step(length as nat);"},{"highlight_end":66,"highlight_start":1,"text":"    let tail = value(words.subrange(length, words.len() as int));"},{"highlight_end":43,"highlight_start":1,"text":"    assert(tail == 0) by (nonlinear_arith)"},{"highlight_end":87,"highlight_start":1,"text":"        requires value(words) == prefix(words, length) + weight(length as nat) * tail,"},{"highlight_end":78,"highlight_start":1,"text":"            prefix(words, length) >= 0, tail >= 0, weight(length as nat) > 0,"},{"highlight_end":50,"highlight_start":1,"text":"            value(words) < weight(length as nat);"},{"highlight_end":87,"highlight_start":1,"text":"    assert(weight(length as nat) * tail == 0) by (nonlinear_arith) requires tail == 0;"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":88,"highlight_start":1,"text":"pub(crate) proof fn left_shifted_digit_correct(current: u64, previous: u64, shift: u32)"},{"highlight_end":29,"highlight_start":1,"text":"    requires 0 < shift < 64,"},{"highlight_end":12,"highlight_start":1,"text":"    ensures"},{"highlight_end":65,"highlight_start":1,"text":"        ((current << shift) | (previous >> (64 - shift))) as nat"},{"highlight_end":71,"highlight_start":1,"text":"            + ((current as nat) / pow2((64 - shift) as nat)) * radix()"},{"highlight_end":93,"highlight_start":1,"text":"            == current * pow2(shift as nat) + (previous as nat) / pow2((64 - shift) as nat),"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":67,"highlight_start":1,"text":"    shifted_digit_correct(previous, current, (64 - shift) as u32);"},{"highlight_end":37,"highlight_start":1,"text":"    let factor = pow2(shift as nat);"},{"highlight_end":43,"highlight_start":1,"text":"    let other = pow2((64 - shift) as nat);"},{"highlight_end":19,"highlight_start":1,"text":"    lemma2_to64();"},{"highlight_end":41,"highlight_start":1,"text":"    lemma_pow2_pos((64 - shift) as nat);"},{"highlight_end":56,"highlight_start":1,"text":"    lemma_pow2_adds(shift as nat, (64 - shift) as nat);"},{"highlight_end":61,"highlight_start":1,"text":"    lemma_fundamental_div_mod(current as int, other as int);"},{"highlight_end":62,"highlight_start":1,"text":"    lemma_fundamental_div_mod(previous as int, other as int);"},{"highlight_end":75,"highlight_start":1,"text":"    let result = (current << shift) | (previous >> ((64 - shift) as u32));"},{"highlight_end":95,"highlight_start":1,"text":"    assert(result == (previous >> ((64 - shift) as u32)) | (current << shift)) by (bit_vector)"},{"highlight_end":85,"highlight_start":1,"text":"        requires result == (current << shift) | (previous >> ((64 - shift) as u32));"},{"highlight_end":41,"highlight_start":1,"text":"    let high = (current as nat) / other;"},{"highlight_end":41,"highlight_start":1,"text":"    let low = (previous as nat) / other;"},{"highlight_end":83,"highlight_start":1,"text":"    assert(result + high * radix() == current * factor + low) by (nonlinear_arith)"},{"highlight_end":17,"highlight_start":1,"text":"        requires"},{"highlight_end":55,"highlight_start":1,"text":"            result * other + (previous as nat) % other"},{"highlight_end":68,"highlight_start":1,"text":"                == previous + ((current as nat) % other) * radix(),"},{"highlight_end":64,"highlight_start":1,"text":"            current == other * high + (current as nat) % other,"},{"highlight_end":65,"highlight_start":1,"text":"            previous == other * low + (previous as nat) % other,"},{"highlight_end":50,"highlight_start":1,"text":"            radix() == factor * other, other > 0;"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":107,"highlight_start":1,"text":"proof fn left_shift_prefix_carry(source: Seq<u64>, output: Seq<u64>, factor: nat, other: nat, length: int)"},{"highlight_end":95,"highlight_start":1,"text":"    requires factor > 0, other > 0, source.len() == output.len(), 0 <= length <= source.len(),"},{"highlight_end":51,"highlight_start":1,"text":"        forall|index: int| 0 <= index < length ==>"},{"highlight_end":82,"highlight_start":1,"text":"            #[trigger] output[index] + ((source[index] as nat) / other) * radix()"},{"highlight_end":86,"highlight_start":1,"text":"                == source[index] * factor + (limb(source, index - 1) as nat) / other,"},{"highlight_end":105,"highlight_start":1,"text":"    ensures prefix(output, length) + ((limb(source, length - 1) as nat) / other) * weight(length as nat)"},{"highlight_end":44,"highlight_start":1,"text":"        == prefix(source, length) * factor,"},{"highlight_end":22,"highlight_start":1,"text":"    decreases length,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":21,"highlight_start":1,"text":"    if length == 0 {"},{"highlight_end":37,"highlight_start":1,"text":"        lemma_div_of0(other as int);"},{"highlight_end":55,"highlight_start":1,"text":"        let carry = (limb(source, -1) as nat) / other;"},{"highlight_end":81,"highlight_start":1,"text":"        assert(carry * weight(0) == 0) by (nonlinear_arith) requires carry == 0;"},{"highlight_end":102,"highlight_start":1,"text":"        assert(prefix(source, 0) * factor == 0) by (nonlinear_arith) requires prefix(source, 0) == 0;"},{"highlight_end":13,"highlight_start":1,"text":"    } else {"},{"highlight_end":76,"highlight_start":1,"text":"        left_shift_prefix_carry(source, output, factor, other, length - 1);"},{"highlight_end":42,"highlight_start":1,"text":"        weight_step((length - 1) as nat);"},{"highlight_end":45,"highlight_start":1,"text":"        let w = weight((length - 1) as nat);"},{"highlight_end":44,"highlight_start":1,"text":"        let next_w = weight(length as nat);"},{"highlight_end":63,"highlight_start":1,"text":"        let carry = (limb(source, length - 2) as nat) / other;"},{"highlight_end":62,"highlight_start":1,"text":"        let next_carry = (source[length - 1] as nat) / other;"},{"highlight_end":53,"highlight_start":1,"text":"        let old_output = prefix(output, length - 1);"},{"highlight_end":53,"highlight_start":1,"text":"        let old_source = prefix(source, length - 1);"},{"highlight_end":60,"highlight_start":1,"text":"        assert(prefix(output, length) + next_carry * next_w"},{"highlight_end":69,"highlight_start":1,"text":"            == prefix(source, length) * factor) by (nonlinear_arith)"},{"highlight_end":68,"highlight_start":1,"text":"            requires old_output + carry * w == old_source * factor,"},{"highlight_end":98,"highlight_start":1,"text":"                output[length - 1] + next_carry * radix() == source[length - 1] * factor + carry,"},{"highlight_end":39,"highlight_start":1,"text":"                next_w == w * radix(),"},{"highlight_end":79,"highlight_start":1,"text":"                prefix(output, length) == old_output + output[length - 1] * w,"},{"highlight_end":79,"highlight_start":1,"text":"                prefix(source, length) == old_source + source[length - 1] * w;"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":98,"highlight_start":1,"text":"pub(crate) proof fn left_shift_value(source: Seq<u64>, output: Seq<u64>, factor: nat, other: nat)"},{"highlight_end":66,"highlight_start":1,"text":"    requires factor > 0, other > 0, source.len() == output.len(),"},{"highlight_end":55,"highlight_start":1,"text":"        value(source) * factor < weight(source.len()),"},{"highlight_end":57,"highlight_start":1,"text":"        forall|index: int| 0 <= index < source.len() ==>"},{"highlight_end":82,"highlight_start":1,"text":"            #[trigger] output[index] + ((source[index] as nat) / other) * radix()"},{"highlight_end":86,"highlight_start":1,"text":"                == source[index] * factor + (limb(source, index - 1) as nat) / other,"},{"highlight_end":53,"highlight_start":1,"text":"    ensures value(output) == value(source) * factor,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":81,"highlight_start":1,"text":"    left_shift_prefix_carry(source, output, factor, other, source.len() as int);"},{"highlight_end":72,"highlight_start":1,"text":"    let carry = (limb(source, source.len() as int - 1) as nat) / other;"},{"highlight_end":31,"highlight_start":1,"text":"    weight_step(source.len());"},{"highlight_end":44,"highlight_start":1,"text":"    assert(carry == 0) by (nonlinear_arith)"},{"highlight_end":89,"highlight_start":1,"text":"        requires value(output) + carry * weight(source.len()) == value(source) * factor,"},{"highlight_end":79,"highlight_start":1,"text":"            value(source) * factor < weight(source.len()), value(output) >= 0,"},{"highlight_end":50,"highlight_start":1,"text":"            carry >= 0, weight(source.len()) > 0;"},{"highlight_end":88,"highlight_start":1,"text":"    assert(carry * weight(source.len()) == 0) by (nonlinear_arith) requires carry == 0;"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":53,"highlight_start":1,"text":"pub(crate) proof fn two_limbs_value(words: Seq<u64>)"},{"highlight_end":31,"highlight_start":1,"text":"    requires words.len() >= 2,"},{"highlight_end":83,"highlight_start":1,"text":"    ensures prefix(words, 2) == ((words[0] as u128) | ((words[1] as u128) << 64)),"},{"highlight_end":43,"highlight_start":1,"text":"        weight(2) == u128::MAX as nat + 1,"},{"highlight_end":2,"highlight_start":1,"text":"{"},{"highlight_end":19,"highlight_start":1,"text":"    lemma2_to64();"},{"highlight_end":20,"highlight_start":1,"text":"    weight_step(1);"},{"highlight_end":24,"highlight_start":1,"text":"    let low = words[0];"},{"highlight_end":25,"highlight_start":1,"text":"    let high = words[1];"},{"highlight_end":68,"highlight_start":1,"text":"    assert(prefix(words, 1) == prefix(words, 0) + low * weight(0));"},{"highlight_end":35,"highlight_start":1,"text":"    assert(prefix(words, 0) == 0);"},{"highlight_end":50,"highlight_start":1,"text":"    assert((low as u128 | ((high as u128) << 64))"},{"highlight_end":86,"highlight_start":1,"text":"        == low as u128 + high as u128 * 0x1_0000_0000_0000_0000u128) by (bit_vector);"},{"highlight_end":74,"highlight_start":1,"text":"    assert(prefix(words, 2) == low + high * radix()) by (nonlinear_arith)"},{"highlight_end":74,"highlight_start":1,"text":"        requires prefix(words, 2) == prefix(words, 1) + high * weight(1),"},{"highlight_end":87,"highlight_start":1,"text":"            prefix(words, 1) == low * weight(0), weight(0) == 1, weight(1) == radix();"},{"highlight_end":2,"highlight_start":1,"text":"}"},{"highlight_end":2,"highlight_start":1,"text":"}"}]}],"code":{"code":"unexpected_cfgs","explanation":null}}}
