+    #[test]
+    fn normal_form_budget_rational_recognition_and_domain_retries() {
+        let input = || raw(Approximation::Inverse(rational_product(256)));
+        let expected =
+            Rational::from_bigint_fraction(BigInt::one(), (BigUint::one() << 257) + 1_u8).unwrap();
