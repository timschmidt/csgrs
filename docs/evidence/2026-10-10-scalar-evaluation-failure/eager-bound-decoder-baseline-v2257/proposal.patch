+// These lemmas connect the actual decoder's checked result to the word proofs.
+// They establish field preservation, not the truth or publication of a bound.
+proof fn decoded_bound_round_trip(value: BoundCache, encoded: u64, decoded: BoundCache)
+    requires call_ensures(AtomicFacts::encode_bound, (value,), encoded),
+        call_ensures(AtomicFacts::decode_bound, (encoded,), decoded),
+    ensures decoded == value,
+{
+    encoded_bound_round_trip(value, encoded);
+}
+
+proof fn decoded_bound_ignores_other_fields(
+    left: u64, right: u64, left_result: BoundCache, right_result: BoundCache,
+)
+    requires left & 0xffff_ffff_0000_003fu64 == right & 0xffff_ffff_0000_003fu64,
+        call_ensures(AtomicFacts::decode_bound, (left,), left_result),
+        call_ensures(AtomicFacts::decode_bound, (right,), right_result),
+    ensures left_result == right_result,
+{
+    bound_denotation_ignores_other_fields(left, right);
+}
+
+proof fn decoded_bound_update_matches_certificate(
+    current: u64, value: BoundCache, encoded: u64, decoded: BoundCache,
+)
+    requires call_ensures(AtomicFacts::encode_bound, (value,), encoded),
+        call_ensures(AtomicFacts::decode_bound, ((current & AtomicFacts::NON_BOUND_MASK) | encoded,), decoded),
+    ensures decoded == value,
+{
+    bound_update_preserves_other_fields(current, value, encoded);
+}
+
+proof fn decoded_sign_update_preserves_bound(
+    current: u64, value: ExactSignCache, encoded: u64, before: BoundCache, after: BoundCache,
+)
+    requires call_ensures(AtomicFacts::encode_exact_sign, (value,), encoded),
+        call_ensures(AtomicFacts::decode_bound, (current,), before),
+        call_ensures(AtomicFacts::decode_bound, ((current & !AtomicFacts::EXACT_SIGN_MASK) | encoded,), after),
+    ensures after == before,
+{
+    exact_sign_update_preserves_bound(current, value, encoded);
+}
+
+proof fn decoded_finite_real_update_preserves_bound(current: u64, before: BoundCache, after: BoundCache)
+    requires call_ensures(AtomicFacts::decode_bound, (current,), before),
+        call_ensures(AtomicFacts::decode_bound, (current | AtomicFacts::FINITE_REAL,), after),
+    ensures after == before,
+{
+    finite_real_publication_preserves_other_fields(current);
+}
+}
