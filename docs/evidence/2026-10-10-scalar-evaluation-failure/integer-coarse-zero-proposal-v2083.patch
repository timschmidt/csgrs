+                    (_, _, Some(proved), true) => (Some(proved), true),
+                    (Some(known), false, Some(proved), false) => {
+                        (Some(if known < proved { known } else { proved }), false)
+                    }
+                    (Some(known), false, None, _) => (Some(known), false),
+                    (None, _, proved, _) => (proved, false),
+                };
+                BoundInfo::NonZero {
+                    sign: match sign {
+                        Some(_) => sign,
+                        None => proved_sign,
+                    },
+                    msd,
+                    exact_msd,
+                }
+            }
+            (Self::Valid(retained), _) => retained,
+        }
+    }
