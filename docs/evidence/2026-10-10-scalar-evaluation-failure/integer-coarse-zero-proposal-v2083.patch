+    requires real_binade(value, exact), magnitude_upper_bound(value, upper),
+    ensures exact <= upper,
+{
+    if upper < exact {
+        magnitude_upper_bound_is_monotone(value, upper, exact - 1);
+        binary_unit_successor(exact - 1);
+    }
