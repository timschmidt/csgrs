+pub(crate) open spec fn merged_bound(retained: BoundInfo, incoming: BoundInfo) -> BoundInfo {
+    match (retained, incoming) {
+        (BoundInfo::Unknown, other) => other,
+        (other, BoundInfo::Unknown) => other,
+        (BoundInfo::NonZero { sign: ls, msd: lm, exact_msd: le },
+         BoundInfo::NonZero { sign: rs, msd: rm, exact_msd: re }) => {
+            let magnitude = match (lm, le, rm, re) {
+                (Some(l), true, _, _) => (Some(l), true),
+                (_, _, Some(r), true) => (Some(r), true),
+                (Some(l), false, Some(r), false) => (Some(if l < r { l } else { r }), false),
+                (Some(l), false, None, _) => (Some(l), false),
+                (None, _, r, _) => (r, false),
+            };
+            BoundInfo::NonZero {
+                sign: match ls { Some(_) => ls, None => rs },
+                msd: magnitude.0, exact_msd: magnitude.1,
+            }
+        },
+        (other, _) => other,
+    }
+}
