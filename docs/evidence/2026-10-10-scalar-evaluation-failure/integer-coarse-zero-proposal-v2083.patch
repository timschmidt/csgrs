+    fn merge(self, incoming: BoundInfo) -> BoundInfo {
+        match (self, incoming) {
+            (Self::Invalid | Self::Valid(BoundInfo::Unknown), other) => other,
+            (Self::Valid(other), BoundInfo::Unknown) => other,
+            (Self::Valid(BoundInfo::Zero), BoundInfo::Zero) => BoundInfo::Zero,
+            (
+                Self::Valid(BoundInfo::NonZero {
+                    sign,
+                    msd,
+                    exact_msd,
+                }),
