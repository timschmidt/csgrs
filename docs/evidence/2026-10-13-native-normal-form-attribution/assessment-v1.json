  "source_review": [
    {
      "path": "crates/hyperreal/src/computable/node/algebra.rs",
      "sha256": "887aedc2f4d5b1969f12f19d622bfee76cbc7a8ab650bbb037f2070dedc1dcae",
      "finding": "The retained recognizer copies closed forms into owned polynomials. Failed projections that reused certificates drop the first memo before retrying the original recognizer; each pass retains its 512-node bound. Coefficient multiplication retains the original arithmetic and insertion order. The helper series did not remove its rational arithmetic."
    },
    {
      "path": "crates/hyperreal/src/computable/node/structural_analysis.rs",
      "sha256": "fb8788a1dc8723d335d85150638cd2e4bab368806d25b92a9ff5537b007922ca",
      "finding": "Exact quadratic recognition projects after shared normal-form cancellation, covering expressions with intermediate independent radicals. Exact quadratic signs then compare rational squares when signs oppose. A restricted prepass cannot replace this coverage without proof."
    },
    {
      "path": "crates/hypercurve/src/classify.rs",
      "sha256": "6997d26ebfe4c50d3abf7ed296cb9cc121ab70754421172e21693bde005e81df",
      "finding": "Comparison tries exact rationals and already-certified separated enclosures before the predicate cascade. Zero testing and sign classification consult scalar facts; unresolved comparisons retain their difference-sign fallback. This review does not establish duplicate invocation counts."
    },
    {
      "path": "crates/hyperlimit/src/resolve.rs",
      "sha256": "a8b1e52851cb59f9c711146f82ca3db3c482740a35b009184383fd26e9a0b2ca",
      "finding": "The direct sign resolver already avoids a duplicate structural-facts pass and retains exact normal forms, quadratic/radical towers and policy-authorized terminal approximation after bounded refinement. Any proposed omission must preserve certainty and escalation receipts."
    }
  ],
