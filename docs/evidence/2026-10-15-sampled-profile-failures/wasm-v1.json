[
  [
    "wasm-clippy",
    [
      "cargo",
      "clippy",
      "--locked",
      "--profile",
      "wasm",
      "--target",
      "wasm32-unknown-unknown",
      "--no-default-features",
      "--features",
      "wasm",
      "--lib",
      "--",
      "-D",
      "warnings"
    ]
  ],
  [
    "wasm",
    [
      "env",
      "WASM_BINDGEN=/tmp/csgrs-properties-tools/bin/wasm-bindgen",
      "TSC=tests/wasm/node_modules/.bin/tsc",
      "bash",
      "scripts/test-wasm-bindings.sh"
    ]
  ]
]
