+        }
+        assert_eq!(components(&source.terms[0].1), expected);
+        assert_eq!(components(&closed.to_polynomial().terms[0].1), expected);
+        assert!(
+            closed
+                .to_polynomial()
+                .scaled(Rational::zero())
