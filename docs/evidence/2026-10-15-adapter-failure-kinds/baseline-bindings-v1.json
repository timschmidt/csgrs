[
  [
    "ffi-build",
    [
      "cargo",
      "build",
      "--locked",
      "--release",
      "-p",
      "csgrs-ffi"
    ]
  ],
  [
    "c-build",
    [
      "cc",
      "-std=c11",
      "-Wall",
      "-Wextra",
      "-Werror",
      "tests/ffi/boolean_failures.c",
      "-Icrates/csgrs-ffi/include",
      "-Icrates/csgrs-ffi/include",
      "-L/tmp/csgrs-adapter-failure-kinds/baseline-bindings-v1/release",
      "-Wl,-rpath,/tmp/csgrs-adapter-failure-kinds/baseline-bindings-v1/release",
      "-lcsgrs_ffi",
      "-o",
      "/tmp/csgrs-adapter-failure-kinds/baseline-bindings-v1/boolean-failures-c"
    ]
  ],
  [
    "c",
    [
      "/tmp/csgrs-adapter-failure-kinds/baseline-bindings-v1/boolean-failures-c"
    ]
  ],
  [
    "cpp-build",
    [
      "c++",
      "-std=c++17",
      "-Wall",
      "-Wextra",
      "-Werror",
      "tests/ffi/boolean_failures.cpp",
      "-Ibindings/cpp",
      "-Icrates/csgrs-ffi/include",
      "-L/tmp/csgrs-adapter-failure-kinds/baseline-bindings-v1/release",
      "-Wl,-rpath,/tmp/csgrs-adapter-failure-kinds/baseline-bindings-v1/release",
      "-lcsgrs_ffi",
      "-o",
      "/tmp/csgrs-adapter-failure-kinds/baseline-bindings-v1/boolean-failures-cpp"
    ]
  ],
  [
    "cpp",
    [
      "/tmp/csgrs-adapter-failure-kinds/baseline-bindings-v1/boolean-failures-cpp"
    ]
  ],
  [
    "python",
    [
      "env",
      "CSGRS_LIBRARY=/tmp/csgrs-adapter-failure-kinds/baseline-bindings-v1/release/libcsgrs_ffi.so",
      "python3",
      "tests/ffi/boolean_failures.py"
    ]
  ],
  [
    "go-build",
    [
      "env",
      "GO111MODULE=off",
      "GOTOOLCHAIN=local",
      "GOCACHE=/tmp/csgrs-adapter-failure-kinds/baseline-bindings-v1/go-cache",
      "GOPATH=/tmp/csgrs-adapter-failure-kinds/baseline-bindings-v1/go-path",
      "CGO_LDFLAGS=-L/tmp/csgrs-adapter-failure-kinds/baseline-bindings-v1/release -Wl,-rpath,/tmp/csgrs-adapter-failure-kinds/baseline-bindings-v1/release -lcsgrs_ffi",
      "/tmp/csgrs-adapter-failure-kinds/go-tools-v1/go/bin/go",
      "test",
      "-c",
      "-o",
      "/tmp/csgrs-adapter-failure-kinds/baseline-bindings-v1/go-bindings.test",
      "./bindings/go"
    ]
  ],
  [
    "go",
    [
      "/tmp/csgrs-adapter-failure-kinds/baseline-bindings-v1/go-bindings.test",
      "-test.v"
    ]
  ]
]
