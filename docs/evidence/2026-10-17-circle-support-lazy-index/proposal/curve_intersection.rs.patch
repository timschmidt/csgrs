+/// Ordered support values owned by this temporary intersection batch.
+/// Rational hashing uses the scalar carrier's exact numeric equality, including
+/// internally unreduced values. No geometry address or finite projection is a key.
+#[derive(Debug, Eq, Hash, PartialEq)]
+struct ExactCircularSupportPairKey([[Rational; 3]; 2]);
+
+impl ExactCircularSupportPairKey {
+    fn new(first: CircularSupportRef<'_>, second: CircularSupportRef<'_>) -> Option<Self> {
+        let support = |circle: CircularSupportRef<'_>| {
+            let values = [
+                circle.center.x().exact_rational_ref()?,
+                circle.center.y().exact_rational_ref()?,
+                circle.radius_squared.exact_rational_ref()?,
+            ];
+            // This cost hint reads stored bit lengths without reducing values.
+            // Very large coefficients keep the original equality path.
+            if values
+                .iter()
+                .any(|value| value.storage_class() == hyperreal::RationalStorageClass::VeryLarge)
+            {
+                return None;
+            }
+            Some(values.map(Clone::clone))
+        };
+        Some(Self([support(first)?, support(second)?]))
+    }
+}
+
+#[derive(Debug, Default)]
+struct CircularSupportIndex {
+    exact: HashMap<ExactCircularSupportPairKey, usize>,
+    unkeyed: Vec<usize>,
+}
+
+impl CircularSupportIndex {
+    fn from_relations(entries: &[CircularSupportRelationCacheEntry]) -> Self {
+        let mut index = Self::default();
+        for (position, entry) in entries.iter().enumerate() {
+            let first = CircularSupportRef {
+                center: &entry.first.center,
+                radius_squared: &entry.first.radius_squared,
+            };
+            let second = CircularSupportRef {
+                center: &entry.second.center,
+                radius_squared: &entry.second.radius_squared,
+            };
+            if let Some(key) = ExactCircularSupportPairKey::new(first, second) {
+                // Keep the first retained witness if a value has several owners.
+                index.exact.entry(key).or_insert(position);
+            } else {
+                index.unkeyed.push(position);
+            }
+        }
+        index
+    }
+}
